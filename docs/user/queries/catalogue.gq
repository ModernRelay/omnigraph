// The engine catalogue: the built-in `@` node types every omnigraph binary
// answers from its own registries. Read-only, never stored, never declared
// in a user schema; listed here for reference. `omnigraph schema show
// --target SERVER --graph og_catalog` reads the serving binary's declarations.

node @Operator {
    name: String @key
    inputs: [I64]
}

node @Pass {
    name: String @key
    position: I64
}

node @Setting {
    name: String @key
    kind: String
    default: String
    scope: String
}

node @Engine {
    version: String @key
    current_internal_schema_version: I64
    min_supported_internal_schema_version: I64
}

node @LogicalKind {
    name: String @key
    coverage: String
}
