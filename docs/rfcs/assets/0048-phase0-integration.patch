+//! Scope and admission checks for the executable lexical/selection slice.
+use super::*;
+
+pub(super) fn check_supported_query(query: &QueryDecl) -> Result<()> {
+    if query.stages.is_empty() {
+        return Ok(());
+    }
+    fn expr(value: &Expr) -> Result<()> {
+        match value {
+            Expr::Search { .. }
+            | Expr::Fuzzy { .. }
+            | Expr::MatchText { .. }
+            | Expr::Bm25 { .. }
+            | Expr::Nearest { .. }
+            | Expr::Rrf { .. } => Err(CompilerError::Type(
+                "staged retrieval cannot be mixed with legacy search expressions".into(),
+            )),
+            Expr::Aggregate { .. } => Err(CompilerError::Plan(
+                "integration aggregate metric scope is not yet executable".into(),
+            )),
+            _ => Ok(()),
+        }
+    }
+    fn clauses(items: &[Clause]) -> Result<()> {
+        for item in items {
+            match item {
+                Clause::Filter(f) => {
+                    expr(&f.left)?;
+                    expr(&f.right)?;
+                    if let (
+                        Expr::Metric {
+                            source: a,
+                            kind: ak,
+                        },
+                        Expr::Metric {
+                            source: b,
+                            kind: bk,
+                        },
+                    ) = (&f.left, &f.right)
+                        && (a != b || ak != bk)
+                    {
+                        return Err(CompilerError::Type("metric comparison requires one source and metric domain; cross-source policies are not implemented".into()));
+                    }
+                }
+                Clause::Negation(inner) => clauses(inner)?,
+                _ => {}
+            }
+        }
+        Ok(())
+    }
+    clauses(&query.match_clause)?;
+    for stage in &query.stages {
+        if let ReadStage::Match(items) = stage {
+            clauses(items)?;
+        }
+    }
+    for p in &query.return_clause {
+        expr(&p.expr)?;
+    }
+    for o in &query.order_clause {
+        expr(&o.expr)?;
+    }
+    Ok(())
+}
+
+fn integer(
+    expr: &Expr,
+    params: &HashMap<String, PropType>,
+    min: i64,
+    max: i64,
+    name: &str,
+) -> Result<()> {
+    match expr {
+        Expr::Literal(Literal::Integer(n)) if *n >= min && *n <= max => Ok(()),
+        Expr::Variable(p)
+            if params.get(p).is_some_and(|t| {
+                !t.nullable
+                    && !t.list
+                    && matches!(
+                        t.scalar,
+                        ScalarType::I32 | ScalarType::I64 | ScalarType::U32 | ScalarType::U64
+                    )
+            }) =>
+        {
+            Ok(())
+        }
+        _ => Err(CompilerError::Type(format!(
+            "{name} requires a non-null integer in {min}..={max}"
+        ))),
+    }
+}
+
+pub(super) fn check(
+    catalog: &Catalog,
+    stages: &[ReadStage],
+    ctx: &mut TypeContext,
+    params: &HashMap<String, PropType>,
+) -> Result<()> {
+    for stage in stages {
+        match stage {
+            ReadStage::Match(clauses) => {
+                refuse_reserved_variable_names(clauses)?;
+                typecheck_clauses(catalog, clauses, ctx, params, false)?;
+            }
+            ReadStage::Rank(rank) => {
+                if !(1..=16).contains(&rank.sources.len()) {
+                    return Err(CompilerError::Plan(
+                        "rank requires 1..16 sources in this integration".into(),
+                    ));
+                }
+                for source in &rank.sources {
+                    if source.target != rank.target {
+                        return Err(CompilerError::Type(
+                            "rank sources must share the block target".into(),
+                        ));
+                    }
+                    let Some(BoundVariable::Node { type_name }) = ctx.bindings.get(&source.target)
+                    else {
+                        return Err(CompilerError::Type(
+                            "integration lexical target must be a bound node".into(),
+                        ));
+                    };
+                    let Expr::PropAccess { variable, property } = &source.field else {
+                        return Err(CompilerError::Type(
+                            "lexical field must be a property".into(),
+                        ));
+                    };
+                    if variable != &source.target {
+                        return Err(CompilerError::Type(
+                            "lexical field must belong to the rank target".into(),
+                        ));
+                    }
+                    let field = resolve_expr_type(catalog, &source.field, ctx, params)?;
+                    if !matches!(field, ResolvedType::Scalar(ref t) if t.scalar == ScalarType::String && !t.list)
+                        || !catalog.node_types[type_name]
+                            .analyzed_fields
+                            .contains(property)
+                    {
+                        return Err(CompilerError::Type("integration lexical field requires scalar String with bare @analyzed (standard_v1/bm25_v1)".into()));
+                    }
+                    let text = match &source.terms.text {
+                        Expr::Literal(Literal::String(_)) => true,
+                        Expr::Variable(p) => params.get(p).is_some_and(|t| {
+                            t.scalar == ScalarType::String && !t.list && !t.nullable
+                        }),
+                        _ => false,
+                    };
+                    if !text {
+                        return Err(CompilerError::Type(
+                            "terms text requires a non-null String literal or parameter".into(),
+                        ));
+                    }
+                    integer(&source.terms.max_edits, params, 0, 2, "max_edits")?;
+                    integer(&source.candidates, params, 1, 10_000, "candidates")?;
+                    if source.source.starts_with("__")
+                        || ctx
+                            .sources
+                            .insert(source.source.clone(), source.target.clone())
+                            .is_some()
+                    {
+                        return Err(CompilerError::Type(format!(
+                            "duplicate or reserved source `{}`",
+                            source.source
+                        )));
+                    }
+                }
+                if !rank
+                    .sources
+                    .iter()
+                    .any(|source| source.source == rank.output)
+                {
+                    return Err(CompilerError::Type(
+                        "rank output must name a source in the current block".into(),
+                    ));
+                }
+            }
+            ReadStage::Take(take) => {
+                if take.keys.is_empty() {
+                    return Err(CompilerError::Type(
+                        "take requires a nonempty group key".into(),
+                    ));
+                }
+                if !ctx.bindings.contains_key(&take.target) {
+                    return Err(CompilerError::Type("take target is not bound".into()));
+                }
+                integer(&take.limit, params, 0, i64::MAX, "take limit")?;
+                if take.order.is_empty() {
+                    return Err(CompilerError::Plan(
+                        "integration take requires explicit local order".into(),
+                    ));
+                }
+                for key in &take.keys {
+                    let t = resolve_expr_type(catalog, key, ctx, params)?;
+                    if !matches!(key, Expr::PropAccess { .. })
+                        || !matches!(t, ResolvedType::Scalar(ref p) if !p.list && matches!(p.scalar, ScalarType::String | ScalarType::I32 | ScalarType::I64 | ScalarType::U32 | ScalarType::U64 | ScalarType::Bool))
+                    {
+                        return Err(CompilerError::Plan("integration take key must be a scalar String, Bool, or integer property".into()));
+                    }
+                }
+                for order in &take.order {
+                    let t = resolve_expr_type(catalog, &order.expr, ctx, params)?;
+                    let constant_on_pair = match &order.expr {
+                        Expr::PropAccess { variable, .. } => {
+                            variable == &take.target || take.keys.contains(&order.expr)
+                        }
+                        Expr::Metric { source, .. } => ctx.sources[source] == take.target,
+                        _ => false,
+                    };
+                    if !constant_on_pair
+                        || !matches!(t, ResolvedType::Scalar(ref p) if !p.list && matches!(p.scalar, ScalarType::String | ScalarType::I32 | ScalarType::I64 | ScalarType::U32 | ScalarType::U64 | ScalarType::Bool | ScalarType::F64 | ScalarType::F32))
+                    {
+                        return Err(CompilerError::Plan("integration take order requires a scalar constant on each target/group pair".into()));
+                    }
+                }
+            }
+        }
+    }
+    Ok(())
+}
