+    // and refusing that window must release resources without returning rows.
+    #[tokio::test]
+    async fn take_shares_retained_input_budget_and_cleans_up_on_refusal() {
+        let batch = RecordBatch::try_from_iter(vec![
+            (
+                "d.id",
+                Arc::new(StringArray::from_iter_values(
+                    (0..1000).map(|i| format!("d-{:04}", i / 2)),
+                )) as ArrayRef,
+            ),
+            (
+                "g.bucket",
+                Arc::new(Int64Array::from_iter_values((0..1000).map(|i| i / 100))) as ArrayRef,
+            ),
+            (
+                "d.score",
+                Arc::new(Int64Array::from_iter_values((0..1000).map(|i| i / 2))) as ArrayRef,
+            ),
+        ])
+        .unwrap();
+        let selection = TakeIR {
+            target: "d".into(),
+            keys: vec![IRExpr::PropAccess {
+                variable: "g".into(),
+                property: "bucket".into(),
+            }],
+            order: vec![IROrdering {
+                expr: IRExpr::PropAccess {
+                    variable: "d".into(),
+                    property: "score".into(),
+                },
+                descending: true,
+            }],
+            limit: IRExpr::Literal(Literal::Integer(2)),
+        };
+        for memory in [batch.get_array_memory_size() + 1, 128 * 1024 * 1024] {
+            let mut budget = Budget::with_memory(memory, 4).unwrap();
+            let runtime = budget.session.runtime_env();
+            budget.relation(&batch).unwrap();
+            assert_eq!(
+                runtime.memory_pool.reserved(),
+                batch.get_array_memory_size()
+            );
+            let mut result = batch.clone();
+            let outcome = take(&mut result, &selection, &ParamMap::default(), &mut budget).await;
+            if memory == batch.get_array_memory_size() + 1 {
+                let error = outcome.unwrap_err();
+                assert!(matches!(error, OmniError::DataFusion(_)), "{error}");
+                assert!(error.to_string().contains("Resources exhausted"), "{error}");
+                assert_eq!(
+                    result, batch,
+                    "a failed selection must not publish partial bindings"
+                );
+            } else {
+                outcome.unwrap();
+                assert_eq!(
+                    result.num_rows(),
+                    40,
+                    "two targets, each with two paths, in ten groups"
+                );
+            }
+            drop(budget);
+            tokio::time::timeout(std::time::Duration::from_secs(1), async {
+                while runtime.memory_pool.reserved() != 0 {
+                    tokio::task::yield_now().await;
+                }
+            })
+            .await
+            .expect("window reservations must be released");
+            assert_eq!(runtime.disk_manager.used_disk_space(), 0);
+            assert!(runtime.disk_manager.temp_dir_paths().is_empty());
+        }
+    }
+}
