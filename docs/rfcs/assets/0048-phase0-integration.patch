+        let documents: Vec<_> = (0..1024)
+            .map(|i| (format!("doc-{i}"), tokens.clone()))
+            .collect();
+        for edits in 0..=2 {
+            let mut budget = Budget::new().unwrap();
+            let result = term_alternatives(&query, &documents, edits, &mut budget)
+                .await
+                .expect("repeated vocabulary must fit the unchanged work budget");
+            assert_eq!(result.len(), documents.len());
+            let expected = if edits == 0 {
+                vec![(2.0, 0)]
+            } else {
+                vec![(2.0, 0), (3.0, 1)]
+            };
+            assert!(result.iter().all(|found| found == &expected));
+            assert!(budget.work < 2_000_000);
+        }
+    }
