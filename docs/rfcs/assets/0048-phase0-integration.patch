@@ -0,0 +1,790 @@
+//! Executable reference path for RFC 0048 integration. This bounded small-corpus
+//! experiment deliberately performs exact row scoring. It does not qualify an
+//! indexed scorer, global decode/RSS admission, or an optimized physical plan.
+use super::*;
+use datafusion::execution::disk_manager::{DiskManagerBuilder, DiskManagerMode};
+use datafusion::execution::memory_pool::{
+    FairSpillPool, MemoryConsumer, MemoryPool, MemoryReservation,
+};
+use datafusion::execution::runtime_env::RuntimeEnvBuilder;
+use datafusion::functions_window::rank::dense_rank;
+use datafusion::logical_expr::ExprFunctionExt;
+use datafusion::prelude::{SessionConfig, SessionContext, col, lit};
+use lance_index::scalar::InvertedIndexParams;
+use omnigraph_compiler::ir::{LexicalIR, RankIR, SourceId, TakeIR};
+use omnigraph_compiler::query::ast::{MetricKind, TermMode};
+use std::collections::BTreeMap;
+use unicode_normalization::UnicodeNormalization;
+
+pub(super) struct Budget {
+    input_bytes: u64,
+    work: u64,
+    edit_cells_since_yield: usize,
+    query_terms: HashMap<SourceId, Arc<BTreeMap<String, u64>>>,
+    session: SessionContext,
+    resident: MemoryReservation,
+}
+
+pub(super) fn admit(ir: &QueryIR, params: &ParamMap) -> Result<Option<Budget>> {
+    if !ir
+        .pipeline
+        .iter()
+        .any(|op| matches!(op, IROp::Rank(_) | IROp::Take(_)))
+    {
+        return Ok(None);
+    }
+    let mut budget = Budget::new()?;
+    for op in &ir.pipeline {
+        match op {
+            IROp::Rank(rank) => {
+                for source in &rank.sources {
+                    integer(&source.candidates, params, 1, 10_000, "candidates")?;
+                    integer(&source.max_edits, params, 0, 2, "max_edits")?;
+                    let Literal::String(text) = literal(&source.text, params)? else {
+                        return Err(OmniError::manifest("terms text must be a String"));
+                    };
+                    let prepared = terms(text, &mut budget)?;
+                    if prepared.is_empty() {
+                        return Err(OmniError::manifest(
+                            "terms query contains no searchable terms",
+                        ));
+                    }
+                    budget
+                        .query_terms
+                        .insert(source.source.clone(), Arc::new(prepared));
+                }
+            }
+            IROp::Take(take) => {
+                integer(&take.limit, params, 0, i64::MAX as u64, "take limit")?;
+            }
+            _ => {}
+        }
+    }
+    Ok(Some(budget))
+}
+
+impl Budget {
+    pub(super) fn new() -> Result<Self> {
+        Self::with_memory(128 * 1024 * 1024, 4)
+    }
+
+    fn with_memory(memory_bytes: usize, partitions: usize) -> Result<Self> {
+        let pool: Arc<dyn MemoryPool> = Arc::new(FairSpillPool::new(memory_bytes));
+        let resident = MemoryConsumer::new("staged binding relation").register(&pool);
+        let runtime = RuntimeEnvBuilder::new()
+            .with_memory_pool(pool)
+            // No-write means Disabled, not a zero after-write disk limit.
+            .with_disk_manager_builder(
+                DiskManagerBuilder::default().with_mode(DiskManagerMode::Disabled),
+            )
+            .build_arc()
+            .map_err(OmniError::datafusion)?;
+        let config = SessionConfig::new()
+            .with_target_partitions(partitions)
+            .with_batch_size(256)
+            .with_sort_spill_reservation_bytes((memory_bytes / 8).min(1024 * 1024));
+        Ok(Self {
+            input_bytes: 0,
+            work: 0,
+            edit_cells_since_yield: 0,
+            query_terms: HashMap::new(),
+            session: SessionContext::new_with_config_rt(config, runtime),
+            resident,
+        })
+    }
+
+    pub(super) fn relation(&mut self, batch: &RecordBatch) -> Result<()> {
+        if batch.num_rows() > 100_000 {
+            return Err(OmniError::resource_limit(
+                "integration binding rows",
+                100_000,
+                batch.num_rows() as u64,
+            ));
+        }
+        // This accounts for the retained relation while DF operators use the
+        // same pool. Repeated views replace this live reservation rather than
+        // accumulating the backing allocation as processed input. It does not
+        // retroactively bound graph read/decode peaks.
+        self.resident
+            .try_resize(batch.get_array_memory_size())
+            .map_err(OmniError::datafusion)
+    }
+    fn charge(&mut self, input_bytes: u64, work: u64) -> Result<()> {
+        // Cumulative UTF-8 query/document/identity input, not Arrow capacity
+        // or a resident-memory estimate. Repeated source reads spend it again.
+        self.input_bytes = self.input_bytes.saturating_add(input_bytes);
+        self.work = self.work.saturating_add(work);
+        if self.input_bytes > 16 * 1024 * 1024 {
+            return Err(OmniError::resource_limit(
+                "integration cumulative lexical input bytes",
+                16 * 1024 * 1024,
+                self.input_bytes,
+            ));
+        }
+        if self.work > 50_000_000 {
+            return Err(OmniError::resource_limit(
+                "integration lexical work",
+                50_000_000,
+                self.work,
+            ));
+        }
+        Ok(())
+    }
+}
+
+fn literal<'a>(expr: &'a IRExpr, params: &'a ParamMap) -> Result<&'a Literal> {
+    match expr {
+        IRExpr::Literal(value) => Ok(value),
+        IRExpr::Param(name) => params
+            .get(name)
+            .ok_or_else(|| OmniError::manifest(format!("missing parameter {name}"))),
+        _ => Err(OmniError::manifest_internal(
+            "admitted bound is not a literal or parameter",
+        )),
+    }
+}
+
+fn integer(expr: &IRExpr, params: &ParamMap, min: u64, max: u64, name: &str) -> Result<usize> {
+    match literal(expr, params)? {
+        Literal::Integer(n) if *n >= 0 && (*n as u64) >= min && (*n as u64) <= max => {
+            usize::try_from(*n)
+                .map_err(|_| OmniError::manifest(format!("{name} exceeds machine capacity")))
+        }
+        _ => Err(OmniError::manifest(format!(
+            "{name} must be an integer in {min}..={max}"
+        ))),
+    }
+}
+
+fn terms(text: &str, budget: &mut Budget) -> Result<BTreeMap<String, u64>> {
+    // Bound the whole input before NFC: one normalizer.next() can consume an
+    // entire combining sequence. This small experiment rejects large fields.
+    if text.len() > 4096 {
+        return Err(OmniError::resource_limit(
+            "integration lexical input bytes",
+            4096,
+            text.len() as u64,
+        ));
+    }
+    budget.charge(text.len() as u64, text.len() as u64)?;
+    let normalized: String = text.nfc().collect();
+    let params = InvertedIndexParams::default()
+        .base_tokenizer("simple".into())
+        .language("English")
+        .map_err(OmniError::lance_internal)?
+        .lower_case(true)
+        .stem(false)
+        .remove_stop_words(false)
+        .ascii_folding(false)
+        .max_token_length(None);
+    let mut tokenizer = params.build().map_err(OmniError::lance_internal)?;
+    let mut stream = tokenizer.token_stream_for_doc(&normalized);
+    let mut result = BTreeMap::new();
+    while stream.advance() {
+        *result.entry(stream.token().text.clone()).or_default() += 1;
+    }
+    Ok(result)
+}
+
+async fn distance(a: &str, b: &str, budget: &mut Budget) -> Result<usize> {
+    let a: Vec<_> = a.chars().collect();
+    let b: Vec<_> = b.chars().collect();
+    budget.charge(0, (a.len() as u64 + 1) * (b.len() as u64 + 1))?;
+    let mut previous: Vec<_> = (0..=b.len()).collect();
+    let mut next = vec![0; b.len() + 1];
+    for (i, ac) in a.iter().enumerate() {
+        next[0] = i + 1;
+        let mut start = 0;
+        while start < b.len() {
+            // A fixed DP-cell quantum spans token pairs and source stages.
+            // This bounds work between Pending returns in this primitive;
+            // it does not promise scheduler fairness or request cancellation.
+            let end = (start + 4096 - budget.edit_cells_since_yield).min(b.len());
+            for j in start..end {
+                next[j + 1] = (previous[j + 1] + 1)
+                    .min(next[j] + 1)
+                    .min(previous[j] + usize::from(*ac != b[j]));
+            }
+            budget.edit_cells_since_yield += end - start;
+            start = end;
+            if budget.edit_cells_since_yield == 4096 {
+                budget.edit_cells_since_yield = 0;
+                tokio::task::yield_now().await;
+            }
+        }
+        std::mem::swap(&mut previous, &mut next);
+    }
+    Ok(previous[b.len()])
+}
+
+async fn term_alternatives(
+    query_term: &str,
+    documents: &[(String, BTreeMap<String, u64>)],
+    edits: usize,
+    budget: &mut Budget,
+) -> Result<Vec<Vec<(f64, usize)>>> {
+    let mut alternatives = Vec::with_capacity(documents.len());
+    // One source/query-term owns these comparisons. Repeated documents do not
+    // repeat DP matrices, and the cache cannot outlive this accepted corpus.
+    let mut distances: HashMap<&str, usize> = HashMap::new();
+    for (_, tokens) in documents {
+        let mut found = Vec::new();
+        if edits == 0 {
+            // Conservative lookup work: no more than one key comparison per
+            // entry, each bounded by query length. No edit matrix is needed.
+            budget.charge(0, ((query_term.len() + 1) * (tokens.len() + 1)) as u64)?;
+            if let Some(count) = tokens.get(query_term) {
+                found.push((*count as f64, 0));
+            }
+        } else {
+            for (term, count) in tokens {
+                budget.charge(0, term.len() as u64 + 1)?;
+                let edit = if let Some(edit) = distances.get(term.as_str()) {
+                    *edit
+                } else {
+                    let edit = distance(query_term, term, budget).await?;
+                    distances.insert(term.as_str(), edit);
+                    edit
+                };
+                if edit <= edits {
+                    found.push((*count as f64, edit));
+                }
+            }
+        }
+        alternatives.push(found);
+        // Cached/exact paths must cooperate too, even when no DP cell runs.
+        tokio::task::yield_now().await;
+    }
+    Ok(alternatives)
+}
+
+pub(super) async fn rank(
+    wide: &mut RecordBatch,
+    rank: &RankIR,
+    params: &ParamMap,
+    snapshot: &Snapshot,
+    budget: &mut Budget,
+) -> Result<()> {
+    // All sources see the same incoming binding rows. Adding metric columns
+    // does not select a population; only the explicit output does that.
+    for source in &rank.sources {
+        lexical(wide, source, params, snapshot, budget).await?;
+        budget.relation(wide)?;
+    }
+    let membership = wide
+        .column_by_name(&rank.output.column(MetricKind::Rank))
+        .ok_or_else(|| OmniError::manifest_internal("rank output metric absent"))?;
+    let kept = UInt32Array::from_iter_values(
+        (0..wide.num_rows())
+            .filter(|i| membership.is_valid(*i))
+            .map(|i| i as u32),
+    );
+    *wide = take_batch(wide, &kept)?;
+    budget.relation(wide)?;
+    Ok(())
+}
+
+async fn lexical(
+    wide: &mut RecordBatch,
+    source: &LexicalIR,
+    params: &ParamMap,
+    snapshot: &Snapshot,
+    budget: &mut Budget,
+) -> Result<()> {
+    let k = integer(&source.candidates, params, 1, 10_000, "candidates")?;
+    let edits = integer(&source.max_edits, params, 0, 2, "max_edits")?;
+    let query_terms = budget
+        .query_terms
+        .get(&source.source)
+        .cloned()
+        .ok_or_else(|| OmniError::manifest_internal("lexical source was not admitted"))?;
+    let ds = snapshot
+        .open_lance_dataset(&format!("node:{}", source.type_name))
+        .await?;
+    let mut documents = Vec::new();
+    let mut stream = crate::table_store::TableStore::scan_stream_bounded(
+        &ds,
+        Some(&["id", &source.property]),
+        None,
+        None,
+        false,
+        256,
+        65536,
+    )
+    .await?;
+    let scan_memory = MemoryConsumer::new("staged lexical scan buffers")
+        .register(&budget.session.runtime_env().memory_pool);
+    while let Some(batch) = stream.try_next().await.map_err(OmniError::lance_stream)? {
+        // Adjacent batches may share a much larger backing allocation. Charge
+        // the consumed batch as live memory, not cumulative processed bytes.
+        // Native prefetch/decode before this point is still outside admission.
+        scan_memory
+            .try_resize(batch.get_array_memory_size())
+            .map_err(OmniError::datafusion)?;
+        budget.charge(0, batch.num_rows() as u64)?;
+        let ids = batch
+            .column_by_name("id")
+            .and_then(|c| c.as_any().downcast_ref::<StringArray>())
+            .ok_or_else(|| OmniError::manifest_internal("lexical identity column missing"))?;
+        let values = batch
+            .column_by_name(&source.property)
+            .and_then(|c| c.as_any().downcast_ref::<StringArray>())
+            .ok_or_else(|| OmniError::manifest_internal("lexical String field missing"))?;
+        for row in 0..batch.num_rows() {
+            if values.is_null(row) {
+                continue;
+            }
+            let analyzed = terms(values.value(row), budget)?;
+            if !analyzed.is_empty() {
+                budget.charge(ids.value(row).len() as u64, 0)?;
+                documents.push((ids.value(row).to_string(), analyzed));
+            }
+        }
+        tokio::task::yield_now().await;
+    }
+    drop(stream);
+    scan_memory.free();
+    let n = documents.len() as f64;
+    let length: Vec<u64> = documents
+        .iter()
+        .map(|(_, terms)| terms.values().sum())
+        .collect();
+    let average = length.iter().sum::<u64>() as f64 / n.max(1.0);
+    let mut scores = vec![0.0_f64; documents.len()];
+    let mut matches = vec![0_usize; documents.len()];
+    for query_term in query_terms.keys() {
+        let alternatives = term_alternatives(query_term, &documents, edits, budget).await?;
+        let df = alternatives.iter().filter(|a| !a.is_empty()).count() as f64;
+        let idf = libm::log1p((n - df + 0.5) / (df + 0.5));
+        for (i, found) in alternatives.iter().enumerate() {
+            if found.is_empty() {
+                continue;
+            }
+            matches[i] += 1;
+            let norm = 1.2 * (0.25 + 0.75 * length[i] as f64 / average);
+            let best = found
+                .iter()
+                .map(|(tf, edit)| [1.0, 0.5, 0.25][*edit] * 2.2 * tf / (tf + norm))
+                .fold(0.0_f64, f64::max);
+            scores[i] += idf * best;
+        }
+        tokio::task::yield_now().await;
+    }
+    let id_name = format!("{}.id", source.target);
+    let ids = wide
+        .column_by_name(&id_name)
+        .and_then(|c| c.as_any().downcast_ref::<StringArray>())
+        .ok_or_else(|| OmniError::manifest_internal("rank target identity absent"))?;
+    let eligible: HashSet<_> = ids.iter().flatten().collect();
+    let mut winners: Vec<_> = documents
+        .iter()
+        .enumerate()
+        .filter(|(i, (id, _))| {
+            eligible.contains(id.as_str())
+                && matches[*i] > 0
+                && (source.mode == TermMode::Any || matches[*i] == query_terms.len())
+        })
+        .map(|(i, (id, _))| (id, scores[i]))
+        .collect();
+    winners.sort_by(|(a, sa), (b, sb)| sb.total_cmp(sa).then_with(|| a.cmp(b)));
+    winners.truncate(k);
+    let ranks: HashMap<_, _> = winners
+        .iter()
+        .enumerate()
+        .map(|(i, (id, score))| (id.as_str(), (i as u64 + 1, *score)))
+        .collect();
+    let rank_array = UInt64Array::from(
+        (0..wide.num_rows())
+            .map(|i| ranks.get(ids.value(i)).map(|(rank, _)| *rank))
+            .collect::<Vec<_>>(),
+    );
+    let score_array = Float64Array::from(
+        (0..wide.num_rows())
+            .map(|i| ranks.get(ids.value(i)).map(|(_, score)| *score))
+            .collect::<Vec<_>>(),
+    );
+    let mut fields = wide.schema().fields().to_vec();
+    fields.push(Arc::new(Field::new(
+        source.source.column(MetricKind::Rank),
+        DataType::UInt64,
+        true,
+    )));
+    fields.push(Arc::new(Field::new(
+        source.source.column(MetricKind::Score),
+        DataType::Float64,
+        true,
+    )));
+    let mut columns = wide.columns().to_vec();
+    columns.extend([
+        Arc::new(rank_array) as ArrayRef,
+        Arc::new(score_array) as ArrayRef,
+    ]);
+    *wide = RecordBatch::try_new(Arc::new(Schema::new(fields)), columns)
+        .map_err(OmniError::arrow_internal)?;
+    Ok(())
+}
+
+fn column(wide: &RecordBatch, expr: &IRExpr) -> Result<ArrayRef> {
+    let name = match expr {
+        IRExpr::PropAccess { variable, property } => format!("{variable}.{property}"),
+        IRExpr::Metric { source, kind } => source.column(*kind),
+        _ => {
+            return Err(OmniError::manifest_internal(
+                "unsupported selection expression",
+            ));
+        }
+    };
+    wide.column_by_name(&name)
+        .cloned()
+        .ok_or_else(|| OmniError::manifest_internal(format!("selection column {name} absent")))
+}
+
+pub(super) async fn take(
+    wide: &mut RecordBatch,
+    take: &TakeIR,
+    params: &ParamMap,
+    budget: &mut Budget,
+) -> Result<()> {
+    let quota = integer(&take.limit, params, 0, i64::MAX as u64, "take limit")?;
+    budget.relation(wide)?;
+    let ids = column(
+        wide,
+        &IRExpr::PropAccess {
+            variable: take.target.clone(),
+            property: "id".into(),
+        },
+    )?;
+    // Keep graph payloads out of the window pipeline. The row ordinal refers
+    // only to this incoming batch; it is never a graph/native row identity.
+    let mut columns: Vec<ArrayRef> = vec![
+        ids,
+        Arc::new(UInt32Array::from_iter_values(0..wide.num_rows() as u32)),
+    ];
+    let mut names = vec!["target".to_string(), "binding".to_string()];
+    let mut keys = Vec::new();
+    for (i, key) in take.keys.iter().enumerate() {
+        let name = format!("key_{i}");
+        columns.push(column(wide, key)?);
+        keys.push(col(&name));
+        names.push(name);
+    }
+    let mut order = Vec::new();
+    for (i, ordering) in take.order.iter().enumerate() {
+        let name = format!("order_{i}");
+        columns.push(column(wide, &ordering.expr)?);
+        order.push(col(&name).sort(!ordering.descending, !ordering.descending));
+        names.push(name);
+    }
+    order.push(col("target").sort(true, false));
+    let fields = names
+        .iter()
+        .zip(&columns)
+        .map(|(name, values)| Field::new(name, values.data_type().clone(), true))
+        .collect::<Vec<_>>();
+    let narrow = RecordBatch::try_new(Arc::new(Schema::new(fields)), columns)
+        .map_err(OmniError::arrow_internal)?;
+    let frame = budget
+        .session
+        .read_batch(narrow)
+        .map_err(OmniError::datafusion)?
+        .window(vec![
+            dense_rank()
+                .partition_by(keys)
+                .order_by(order)
+                .build()
+                .map_err(OmniError::datafusion)?
+                .alias("pair_rank"),
+        ])
+        .map_err(OmniError::datafusion)?
+        .filter(col("pair_rank").lt_eq(lit(quota as u64)))
+        .map_err(OmniError::datafusion)?
+        .select(vec![col("binding")])
+        .map_err(OmniError::datafusion)?;
+    // Typechecking proves every comparator value is constant on a target/key
+    // pair. With target identity as final tie key, dense_rank counts distinct
+    // targets, while preserving every duplicate binding without a rejoin.
+    let mut stream = frame
+        .execute_stream()
+        .await
+        .map_err(OmniError::datafusion)?;
+    let mut kept = vec![false; wide.num_rows()];
+    while let Some(batch) = stream.try_next().await.map_err(OmniError::datafusion)? {
+        let rows = batch
+            .column(0)
+            .as_any()
+            .downcast_ref::<UInt32Array>()
+            .ok_or_else(|| {
+                OmniError::manifest_internal("take produced an invalid binding ordinal")
+            })?;
+        for row in rows.iter() {
+            let row = row.ok_or_else(|| {
+                OmniError::manifest_internal("take produced a null binding ordinal")
+            })? as usize;
+            let slot = kept.get_mut(row).ok_or_else(|| {
+                OmniError::manifest_internal("take produced an out-of-range binding ordinal")
+            })?;
+            if *slot {
+                return Err(OmniError::manifest_internal(
+                    "take repeated a binding ordinal",
+                ));
+            }
+            *slot = true;
+        }
+    }
+    drop(stream);
+    // Selection preserves incoming order. Do not let a window's physical
+    // partition/order replace the preceding ranking stage's active order.
+    let keep = UInt32Array::from(
+        kept.iter()
+            .enumerate()
+            .filter_map(|(i, keep)| keep.then_some(i as u32))
+            .collect::<Vec<_>>(),
+    );
+    *wide = take_batch(wide, &keep)?;
+    budget
+        .resident
+        .try_resize(wide.get_array_memory_size())
+        .map_err(OmniError::datafusion)?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use arrow_array::Int64Array;
+    use omnigraph_compiler::ir::IROrdering;
+
+    #[test]
+    fn repeated_views_do_not_accumulate_retained_buffer_bytes() {
+        let text = "x".repeat(4096);
+        let batch = RecordBatch::try_from_iter([(
+            "text",
+            Arc::new(StringArray::from_iter_values(std::iter::repeat_n(
+                &text, 256,
+            ))) as ArrayRef,
+        )])
+        .unwrap();
+        let mut budget = Budget::with_memory(2 * 1024 * 1024, 1).unwrap();
+        let pool = Arc::clone(&budget.session.runtime_env().memory_pool);
+        let retained = batch.get_array_memory_size();
+        assert!(retained < 2 * 1024 * 1024);
+        for row in 0..batch.num_rows() {
+            let view = batch.slice(row, 1);
+            assert_eq!(view.get_array_memory_size(), retained);
+            budget
+                .relation(&view)
+                .expect("rechecking shared storage must not accumulate it");
+            assert_eq!(pool.reserved(), retained);
+        }
+        assert_eq!(
+            budget.input_bytes, 0,
+            "retained views are not new lexical input"
+        );
+        terms("abcd", &mut budget).unwrap();
+        assert_eq!(
+            budget.input_bytes, 4,
+            "input units are consumed UTF-8 bytes"
+        );
+        drop(budget);
+        assert_eq!(
+            pool.reserved(),
+            0,
+            "the query releases its relation reservation"
+        );
+    }
+
