+            ("follow", FOLLOW, true),
+            ("revise", REVISE, false),
+            ("prune", PRUNE, false),
+        ])
+    };
+    let tokens = || {
+        vec![
+            ("act-invoke".into(), "t-invoke".into()),
+            ("act-full".into(), "t-full".into()),
+        ]
+    };
+    let state = AppState::open_single_with_queries(
+        graph.to_string_lossy().to_string(),
+        tokens(),
+        Some(&policy_path),
+        registry(),
+    )
+    .await
+    .unwrap();
+    let app = omnigraph_server::build_app(state);
+    let search_params = json!({"q":"ALPHA", "window":1});
+    let (status, discovered) = json_response(
+        &app,
+        invoke_request("discover", "t-invoke", json!({"params":search_params})),
+    )
+    .await;
+    assert_eq!(status, StatusCode::OK, "{discovered}");
+    assert_eq!(
+        discovered["row_count"], 2,
+        "one selected pair retains both paths"
+    );
+    assert_eq!(discovered["rows"][0]["path"], "direct");
+    assert_eq!(discovered["rows"][1]["path"], "duplicate");
+    for row in discovered["rows"].as_array().unwrap() {
+        assert_eq!(row["source_rank"], 1);
+        assert!(row["source_score"].as_f64().unwrap() > 0.0);
+    }
+    let old_head = discovered["graph_commit_id"]
+        .as_str()
+        .expect("replay identity from the same read")
+        .to_owned();
+    // RFC 0040's meta-field lookup is not in this integration prototype.
+    // Exercise the existing key lookup; retain returned node identities to
+    // prove the follow-up still identifies the same graph entities.
+    let page_id = discovered["rows"][0]["page"]["id"].as_str().unwrap();
+    let section_id = discovered["rows"][0]["section"]["id"].as_str().unwrap();
+    assert!(!page_id.is_empty() && !section_id.is_empty());
+    let follow_params = json!({"page":discovered["rows"][0]["page"]["slug"], "section":discovered["rows"][0]["section"]["slug"]});
+    for stored in [false, true] {
+        let (status, equivalent) = json_response(
+            &app,
+            read_request(
+                stored,
+                "discover",
+                DISCOVER,
+                json!({"params":search_params}),
+                "t-invoke",
+            ),
+        )
+        .await;
+        assert_eq!(status, StatusCode::OK, "{equivalent}");
+        assert_eq!(
+            equivalent, discovered,
+            "both carriers must expose the same result and head"
+        );
+    }
+
+    // Change both source tables, then separately delete a path: the language
+    // intentionally separates constructive and destructive mutations. The
+    // live answer must differ before an old-snapshot assertion proves replay.
+    let (status, revised) =
+        json_response(&app, invoke_request("revise", "t-full", json!({}))).await;
+    assert_eq!(status, StatusCode::OK, "{revised}");
+    let revised_head = revised["commit"]["graph_commit_id"].as_str().unwrap();
+    assert_ne!(revised_head, old_head);
+    let (status, pruned) = json_response(&app, invoke_request("prune", "t-full", json!({}))).await;
+    assert_eq!(status, StatusCode::OK, "{pruned}");
+    let new_head = pruned["commit"]["graph_commit_id"]
+        .as_str()
+        .unwrap()
+        .to_owned();
+    assert_ne!(new_head, old_head);
+    assert_ne!(new_head, revised_head);
+    drop(app);
+    let state = AppState::open_single_with_queries(
+        graph.to_string_lossy().to_string(),
+        tokens(),
+        Some(&policy_path),
+        registry(),
+    )
+    .await
+    .unwrap();
+    let app = omnigraph_server::build_app(state);
+    for stored in [false, true] {
+        for pinned in [false, true] {
+            let snapshot = pinned.then_some(old_head.as_str());
+            let expected_head = if pinned { &old_head } else { &new_head };
+            let (status, found) = json_response(
+                &app,
+                read_request(
+                    stored,
+                    "discover",
+                    DISCOVER,
+                    json!({"params":search_params,"snapshot":snapshot}),
+                    "t-invoke",
+                ),
+            )
+            .await;
+            assert_eq!(status, StatusCode::OK, "{found}");
+            assert_eq!(found["graph_commit_id"], expected_head.as_str());
+            assert_eq!(found["target"]["snapshot"], json!(snapshot));
+            assert_eq!(
+                found["rows"],
+                if pinned {
+                    discovered["rows"].clone()
+                } else {
+                    json!([])
+                }
+            );
+            let (status, source) = json_response(
+                &app,
+                read_request(
+                    stored,
+                    "follow",
+                    FOLLOW,
+                    json!({"params":follow_params,"snapshot":snapshot}),
+                    "t-invoke",
+                ),
+            )
+            .await;
+            assert_eq!(status, StatusCode::OK, "{source}");
+            assert_eq!(source["graph_commit_id"], expected_head.as_str());
+            let expected_rows = if pinned {
+                json!([
+                    {"page":{"id":page_id,"slug":"guide","title":"alpha alpha"},"section":{"id":section_id,"slug":"first","text":"original source"},"path":"direct"},
+                    {"page":{"id":page_id,"slug":"guide","title":"alpha alpha"},"section":{"id":section_id,"slug":"first","text":"original source"},"path":"duplicate"}
+                ])
+            } else {
+                json!([{"page":{"id":page_id,"slug":"guide","title":"beta"},"section":{"id":section_id,"slug":"first","text":"revised source"},"path":"direct"}])
+            };
+            assert_eq!(source["rows"], expected_rows);
+        }
+        for (extra, expected_status) in [
+            (
+                json!({"params":search_params,"snapshot":"missing-snapshot"}),
+                StatusCode::NOT_FOUND,
+            ),
+            (
+                json!({"params":search_params,"snapshot":old_head,"branch":"main"}),
+                StatusCode::BAD_REQUEST,
+            ),
+            (
+                json!({"params":{"q":"alpha","window":0}}),
+                StatusCode::BAD_REQUEST,
+            ),
+            (
+                json!({"params":{"q":"x".repeat(4097),"window":1}}),
+                StatusCode::PAYLOAD_TOO_LARGE,
+            ),
+        ] {
+            let (status, error) = json_response(
+                &app,
+                read_request(stored, "discover", DISCOVER, extra, "t-invoke"),
+            )
+            .await;
+            assert_eq!(status, expected_status, "{error}");
+            assert!(
+                error.get("rows").is_none(),
+                "a refusal cannot return successful partial rows: {error}"
+            );
+            if status == StatusCode::PAYLOAD_TOO_LARGE {
+                assert_eq!(error["resource_limit"]["limit"], 4096);
+                assert_eq!(error["resource_limit"]["actual"], 4097);
+            }
+        }
+    }
+
+    // Revoke the actor's read permission while retaining invoke_query. A
+    // previously issued snapshot identifies data; it does not grant access.
+    drop(app);
+    std::fs::write(
+        &policy_path,
+        r#"
+version: 1
+groups:
+  invokers: [act-invoke]
+protected_branches: [main]
+rules:
+  - id: invoke-only
+    allow:
+      actors: {group: invokers}
+      actions: [invoke_query]
+"#,
+    )
+    .unwrap();
+    let state = AppState::open_single_with_queries(
+        graph.to_string_lossy().to_string(),
+        tokens(),
+        Some(&policy_path),
+        registry(),
+    )
+    .await
+    .unwrap();
+    let app = omnigraph_server::build_app(state);
+    for stored in [false, true] {
+        let (status, error) = json_response(
+            &app,
+            read_request(
+                stored,
+                "follow",
+                FOLLOW,
+                json!({"params":follow_params,"snapshot":old_head}),
+                "t-invoke",
+            ),
+        )
+        .await;
+        assert_eq!(status, StatusCode::FORBIDDEN, "{error}");
+        assert_eq!(error["code"], "forbidden");
+        assert!(error.get("rows").is_none());
+    }
+}
