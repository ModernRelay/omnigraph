+    #[tokio::test]
+    async fn edit_distance_yields_before_completion_and_across_comparisons() {
+        use std::task::Poll;
+
+        let mut budget = Budget::new().unwrap();
+        let a = "a".repeat(1024);
+        let b = format!("{}b", "a".repeat(1023));
+        let mut comparison = Box::pin(distance(&a, &b, &mut budget));
