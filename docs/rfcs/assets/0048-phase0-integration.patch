+            r#"{"act-parity":"parity-tok"}"#,
+        )],
+    );
+    let query = r#"
+query staged($q: String, $window: I64) {
+    match { $p: Person $p.age > 29 }
+    rank $p { lexical($p.name, terms($q, max_edits: 1), candidates: $window) as names yield names }
+    match { $p worksAt $c }
+    take $c { per { $p.name } order { $c.name } limit 1 }
+    return { $p.name as person, $c.name as company, metric(names, rank) as source_rank,
+             metric(names, score) as source_score }
+    order { metric(names, rank), $c.name }
+    limit 1
+}
