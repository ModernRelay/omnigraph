+--- params
+{"q":"ALPHA"}
+
+--- expect ordered
+{"org":"a","incident":"i1","path":"a1","source_rank":1}
+{"org":"a","incident":"i1","path":"a1again","source_rank":1}
+{"org":"a","incident":"i2","path":"a2","source_rank":1}
+{"org":"b","incident":"i1","path":"b1","source_rank":2}
+
+--- expect shape
+org: String
+incident: String
+path: String
+source_rank: U64?
+
+--- query
+query empty_terms($q: String) {
+    match { $o: Organization }
+    rank $o { lexical($o.name, terms($q), candidates: 1) as names yield names }
+    return { $o.slug as org }
+}
+
+--- params
+{"q":"!!! ..."}
+
+--- expect error: terms query contains no searchable terms
+
+--- query
+query empty_terms_without_bindings($q: String) {
+    match { $o: Organization { slug: "missing" } }
+    rank $o { lexical($o.name, terms($q), candidates: 1) as names yield names }
+    return { $o.slug as org }
+}
+
+--- params
+{"q":""}
+
+--- expect error: terms query contains no searchable terms
+
+--- query
+query nonempty_terms_without_bindings($q: String) {
+    match { $o: Organization { slug: "missing" } }
+    rank $o { lexical($o.name, terms($q), candidates: 1) as names yield names }
+    return { $o.slug as org }
+    order { $o.slug }
+}
+
+--- params
+{"q":"zebra"}
+
+--- expect ordered
+
+--- expect shape
+org: String
+
+--- query
+query traversal_target($q: String) {
+    match { $o: Organization { eligible: true } $o $e:hasIncident $i }
+    rank $i { lexical($i.title, terms($q), candidates: 2) as incidents yield incidents }
+    take $i { per { $o.slug } order { $i.severity } limit 1 }
+    return { $o.slug as org, $i.slug as incident, $e.slug as path, metric(incidents, rank) as source_rank }
+    order { $o.slug, $e.slug }
+}
+
+--- params
+{"q":"alpha"}
+
+--- expect ordered
+{"org":"a","incident":"i2","path":"a2","source_rank":2}
+{"org":"b","incident":"i1","path":"b1","source_rank":1}
+
+--- expect shape
+org: String
+incident: String
+path: String
+source_rank: U64?
+
+--- query
+query explicit_output() {
+    match { $o: Organization { eligible: true } }
+    rank $o {
+        lexical($o.name, terms("alpha"), candidates: 2) as alpha
+        lexical($o.name, terms("beta"), candidates: 1) as beta
+        lexical($o.name, terms("nomatch"), candidates: 1) as unused
+        yield alpha
+    }
+    return { $o.slug as org, metric(alpha, rank) as alpha_rank,
+             metric(beta, rank) as beta_rank, metric(unused, score) as unused_score }
+}
+
+--- expect ordered
+{"org":"a","alpha_rank":1}
+{"org":"b","alpha_rank":2,"beta_rank":1}
+
+--- expect shape
+org: String
+alpha_rank: U64?
+beta_rank: U64?
+unused_score: F64?
+
+--- query
+query reordered_output() {
+    match { $o: Organization { eligible: true } }
+    rank $o {
+        lexical($o.name, terms("nomatch"), candidates: 1) as unused
+        lexical($o.name, terms("beta"), candidates: 1) as beta
+        lexical($o.name, terms("alpha"), candidates: 2) as alpha
+        yield alpha
+    }
+    return { $o.slug as org, metric(alpha, rank) as alpha_rank,
+             metric(beta, rank) as beta_rank, metric(unused, score) as unused_score }
+}
+
+--- expect ordered
+{"org":"a","alpha_rank":1}
+{"org":"b","alpha_rank":2,"beta_rank":1}
+
+--- expect shape
+org: String
+alpha_rank: U64?
+beta_rank: U64?
+unused_score: F64?
+
+--- query
+query different_output() {
+    match { $o: Organization { eligible: true } }
+    rank $o {
+        lexical($o.name, terms("alpha"), candidates: 1) as alpha
+        lexical($o.name, terms("beta"), candidates: 2) as beta
+        yield beta
+    }
+    return { $o.slug as org, metric(alpha, rank) as alpha_rank,
+             metric(beta, rank) as beta_rank }
+}
+
+--- expect ordered
+{"org":"b","beta_rank":1}
+{"org":"c","beta_rank":2}
+
+--- expect shape
+org: String
+alpha_rank: U64?
+beta_rank: U64?
