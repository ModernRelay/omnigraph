+#[test]
+fn staged_rank_retains_later_filters_and_metric_scope() {
+    let catalog = build_catalog(
+        &parse_schema(
+            r#"
+        node Doc { slug: String @key title: String @analyzed active: Bool }
+        node Tag { name: String @key }
+        edge Tagged: Doc -> Tag
+    "#,
+        )
+        .unwrap(),
+    )
+    .unwrap();
+    let source = r#"
+        query q($q: String) {
+            match { $d: Doc }
+            rank $d { lexical($d.title, terms($q), candidates: 2) as hits yield hits }
+            match { $d.active = true }
+            return { $d.slug, metric(hits, rank) as rank }
+            order { rank }
+        }
+    "#;
+    let query = parse_query(source).unwrap();
+    let ctx = typecheck_query(&catalog, query.single_decl()).unwrap();
+    let ir = lower_query(&catalog, query.single_decl(), &ctx).unwrap();
+    assert!(
+        matches!(&ir.pipeline[..], [IROp::NodeScan { filters, .. }, IROp::Rank(_), IROp::Filter(_)] if filters.is_empty())
+    );
+    let multi = source.replace(
+        "as hits yield hits",
+        "as hits lexical($d.title, terms(\"unused\"), candidates: 1) as unused yield hits",
+    );
+    let query = parse_query(&multi).unwrap();
+    let ctx = typecheck_query(&catalog, query.single_decl()).unwrap();
+    let ir = lower_query(&catalog, query.single_decl(), &ctx).unwrap();
+    let IROp::Rank(rank) = &ir.pipeline[1] else {
+        panic!("rank barrier was lost")
+    };
+    assert_eq!(rank.target, "d");
+    assert_eq!(rank.output, SourceId("hits".into()));
+    assert_eq!(
+        rank.sources
+            .iter()
+            .map(|source| source.source.0.as_str())
+            .collect::<Vec<_>>(),
+        ["hits", "unused"]
+    );
+    for predicate in [
+        "metric(hits, score) > metric(unused, score)",
+        "metric(hits, score) > metric(hits, rank)",
+    ] {
+        let invalid = multi.replace("$d.active = true", predicate);
+        let query = parse_query(&invalid).unwrap();
+        assert!(
+            typecheck_query(&catalog, query.single_decl())
+                .unwrap_err()
+                .to_string()
+                .contains("one source and metric domain")
+        );
+    }
+    let same_domain = multi.replace(
+        "$d.active = true",
+        "metric(hits, score) >= metric(hits, score)",
+    );
+    let query = parse_query(&same_domain).unwrap();
+    typecheck_query(&catalog, query.single_decl()).unwrap();
+    assert!(parse_query(&source.replace("yield hits", "")).is_err());
+    for replacement in ["yield missing", "yield hits yield hits", "yieldhits"] {
+        let invalid = source.replace("yield hits", replacement);
+        assert!(
+            parse_query(&invalid)
+                .and_then(|query| typecheck_query(&catalog, query.single_decl()))
+                .is_err()
+        );
+    }
+    let wrong_block = source.replace(
+        "match { $d.active = true }",
+        "rank $d { lexical($d.title, terms($q), candidates: 1) as later yield hits }",
+    );
+    let query = parse_query(&wrong_block).unwrap();
+    assert!(
+        typecheck_query(&catalog, query.single_decl())
+            .unwrap_err()
+            .to_string()
+            .contains("current block")
+    );
+    let expanded = parse_query(&source.replace(
+        "match { $d.active = true }",
+        "match { $d tagged $t $d.active = true }",
+    ))
+    .unwrap();
+    let descriptor =
+        crate::query::descriptor::describe_query_operation(&catalog, expanded.single_decl())
+            .unwrap();
+    assert_eq!(
+        descriptor
+            .reads
+            .iter()
+            .map(|r| r.type_name.as_str())
+            .collect::<Vec<_>>(),
+        ["Doc", "Tag", "Tagged"]
+    );
+    let unknown = source.replace("metric(hits, rank)", "metric(future, rank)");
+    let query = parse_query(&unknown).unwrap();
+    assert!(
+        typecheck_query(&catalog, query.single_decl())
+            .unwrap_err()
+            .to_string()
+            .contains("not in scope")
+    );
+    let query = parse_query(&source.replace("candidates: 2", "candidates: 0")).unwrap();
+    assert!(
+        typecheck_query(&catalog, query.single_decl())
+            .unwrap_err()
+            .to_string()
+            .contains("candidates")
+    );
+}
