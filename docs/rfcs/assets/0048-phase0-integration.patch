@@ -0,0 +1,118 @@
+//! Typed parsing for the executable RFC 0048 vertical slice.
+use super::*;
+use pest::iterators::Pair;
+use std::collections::BTreeMap;
+
+fn options<'a>(pairs: impl Iterator<Item = Pair<'a, Rule>>) -> Result<BTreeMap<String, Expr>> {
+    let mut result = BTreeMap::new();
+    for pair in pairs {
+        let mut parts = pair.into_inner();
+        let name = parts.next().unwrap().as_str().to_string();
+        if result
+            .insert(name.clone(), parse_expr(parts.next().unwrap())?)
+            .is_some()
+        {
+            return Err(CompilerError::Parse(format!("duplicate option `{name}`")));
+        }
+    }
+    Ok(result)
+}
+
+fn no_unknown(options: BTreeMap<String, Expr>) -> Result<()> {
+    if let Some(name) = options.keys().next() {
+        return Err(CompilerError::Parse(format!("unsupported option `{name}`")));
+    }
+    Ok(())
+}
+
+pub(super) fn rank(pair: Pair<Rule>) -> Result<ReadStage> {
+    let mut parts = pair.into_inner();
+    let target = parts.next().unwrap().as_str()[1..].to_string();
+    let output = parts
+        .next_back()
+        .unwrap()
+        .into_inner()
+        .nth(1)
+        .unwrap()
+        .as_str()
+        .to_string();
+    let sources = parts
+        .map(|part| lexical(target.clone(), part))
+        .collect::<Result<Vec<_>>>()?;
+    if sources.len() > 16 {
+        return Err(CompilerError::Plan(
+            "staged integration admits at most 16 lexical sources per block".into(),
+        ));
+    }
+    Ok(ReadStage::Rank(RankStage {
+        target,
+        sources,
+        output,
+    }))
+}
+
+fn lexical(target: String, pair: Pair<Rule>) -> Result<LexicalStage> {
+    let mut args: Vec<_> = pair.into_inner().collect();
+    let source = args.pop().unwrap().as_str().to_string();
+    let mut args = args.into_iter();
+    let field = parse_expr(args.next().unwrap())?;
+    let mut terms_args = args.next().unwrap().into_inner();
+    let text = parse_expr(terms_args.next().unwrap())?;
+    let mut terms_options = options(terms_args)?;
+    let max_edits = terms_options
+        .remove("max_edits")
+        .unwrap_or(Expr::Literal(Literal::Integer(0)));
+    let mode = match terms_options.remove("mode") {
+        None => TermMode::All,
+        Some(Expr::Literal(Literal::String(value))) if value == "all" => TermMode::All,
+        Some(Expr::Literal(Literal::String(value))) if value == "any" => TermMode::Any,
+        _ => {
+            return Err(CompilerError::Parse(
+                "terms mode must be \"all\" or \"any\"".into(),
+            ));
+        }
+    };
+    no_unknown(terms_options)?;
+    let mut source_options = options(args)?;
+    let candidates = source_options
+        .remove("candidates")
+        .ok_or_else(|| CompilerError::Parse("lexical requires explicit candidates".into()))?;
+    no_unknown(source_options)?;
+    Ok(LexicalStage {
+        target,
+        field,
+        terms: Terms {
+            text,
+            max_edits,
+            mode,
+        },
+        candidates,
+        source,
+    })
+}
+
+pub(super) fn take(pair: Pair<Rule>) -> Result<ReadStage> {
+    let mut parts = pair.into_inner();
+    let target = parts.next().unwrap().as_str()[1..].to_string();
+    let keys = parts
+        .next()
+        .unwrap()
+        .into_inner()
+        .map(parse_expr)
+        .collect::<Result<_>>()?;
+    let mut order = Vec::new();
+    let mut next = parts.next().unwrap();
+    if next.as_rule() == Rule::order_clause {
+        order = next
+            .into_inner()
+            .map(parse_ordering)
+            .collect::<Result<_>>()?;
+        next = parts.next().unwrap();
+    }
+    Ok(ReadStage::Take(TakeStage {
+        target,
+        keys,
+        order,
+        limit: parse_expr(next)?,
+    }))
+}
