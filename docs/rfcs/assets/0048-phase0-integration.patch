+# issue: none
+# notes: RFC 0048 integration experiment. The excluded organization would outrank the
+# notes: eligible ones. Two edge rows reach the same incident; they consume one quota
+# notes: slot but both survive selection. A later output limit counts those rows.
+# notes: Empty analyzed queries are invalid even when no graph binding is eligible.
+# notes: Rank sources receive the same eligible binding relation with independent
+# notes: windows; only yield selects rows. Missing source metrics stay null, and
+# notes: adding or reordering unused sources cannot change the selected output.
+# notes: The existing JSON writer omits null cells. Shape checks still require
+# notes: every projected metric column, including the all-null F64 unused score.
+
+--- schema
+node Organization {
+    slug: String @key
+    eligible: Bool
+    name: String @analyzed
+}
+node Incident {
+    slug: String @key
+    severity: I64
+    title: String @analyzed
+}
+edge HasIncident: Organization -> Incident {
+    slug: String
+    @key(src, dst, slug)
+}
+
+--- seed
+{"type":"Organization","data":{"slug":"a","eligible":true,"name":"alpha alpha"}}
+{"type":"Organization","data":{"slug":"b","eligible":true,"name":"alpha beta"}}
+{"type":"Organization","data":{"slug":"c","eligible":true,"name":"alpha beta gamma delta"}}
+{"type":"Organization","data":{"slug":"excluded","eligible":false,"name":"alpha alpha alpha"}}
+{"type":"Incident","data":{"slug":"i1","severity":9,"title":"alpha alpha alpha"}}
+{"type":"Incident","data":{"slug":"i2","severity":8,"title":"alpha alpha"}}
+{"type":"Incident","data":{"slug":"i3","severity":7,"title":"alpha"}}
+{"type":"Incident","data":{"slug":"i4","severity":8,"title":"alpha beta"}}
+{"edge":"HasIncident","from":"a","to":"i1","data":{"slug":"a1"}}
+{"edge":"HasIncident","from":"a","to":"i1","data":{"slug":"a1again"}}
+{"edge":"HasIncident","from":"a","to":"i2","data":{"slug":"a2"}}
+{"edge":"HasIncident","from":"a","to":"i3","data":{"slug":"a3"}}
+{"edge":"HasIncident","from":"b","to":"i1","data":{"slug":"b1"}}
+{"edge":"HasIncident","from":"b","to":"i4","data":{"slug":"b4"}}
+{"edge":"HasIncident","from":"c","to":"i3","data":{"slug":"c3"}}
+{"edge":"HasIncident","from":"excluded","to":"i1","data":{"slug":"x1"}}
+
+--- query
+query staged($q: String) {
+    match { $o: Organization { eligible: true } }
