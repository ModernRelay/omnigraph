# issue: none
# notes: List five branches, then check every branch table before and after reopening. One operation on a fresh handle is timed; checks and restart are outside the timer.

--- runner
timeout_ms: 60000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- query
branch list

--- expect unordered
{"name":"main"}
{"name":"sibling1"}
{"name":"sibling2"}
{"name":"sibling3"}
{"name":"source"}
--- expect shape
name: String

--- query
branch list

--- expect unordered
{"name":"main"}
{"name":"sibling1"}
{"name":"sibling2"}
{"name":"sibling3"}
{"name":"source"}
--- expect shape
name: String

--- query branch: main
query chunk_rows() { match { $c: Chunk } return { $c.slug as slug, $c.embedding as embedding } }

