# issue: none
# notes: One checked warmup precedes one measured query per fresh process; a restart and exact result check follow. This repetition boundary differs from the former repeated Rust timing loop.

--- runner
timeout_ms: 60000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- query
query lookup() { match { $p: Person { name: "p000500" } } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"p000500","p.age":0}
--- expect shape
p.name: String
p.age: I64

--- query
query lookup() { match { $p: Person { name: "p000500" } } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"p000500","p.age":0}
--- expect shape
p.name: String
p.age: I64

--- restart

--- query
query lookup() { match { $p: Person { name: "p000500" } } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"p000500","p.age":0}
--- expect shape
p.name: String
p.age: I64
