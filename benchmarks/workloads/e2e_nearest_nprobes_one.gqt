# issue: none
# notes: Full nearest query with public ann_nprobes=1; one-partition setting coverage, not a historical ANN recall/timing comparison. One operation on a fresh handle is timed; checks and restart are outside the timer.

--- runner
timeout_ms: 60000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- query
set ann_nprobes = 1;
query nearest_matching_rows($q: Vector(4)) {
    match { $d: Doc $d.n > 3 }
    return { $d.slug }
    order { nearest($d.embedding, $q) }
    limit 3
}
--- params
{"q":[2.3,0.0,0.0,0.0]}

--- expect ordered
{"d.slug":"d004"}
{"d.slug":"d005"}
{"d.slug":"d006"}
--- expect shape
d.slug: String

--- restart

--- query
set ann_nprobes = 1;
query nearest_matching_rows($q: Vector(4)) {
    match { $d: Doc $d.n > 3 }
    return { $d.slug }
    order { nearest($d.embedding, $q) }
    limit 3
}
--- params
{"q":[2.3,0.0,0.0,0.0]}

--- expect ordered
{"d.slug":"d004"}
{"d.slug":"d005"}
{"d.slug":"d006"}
--- expect shape
d.slug: String

