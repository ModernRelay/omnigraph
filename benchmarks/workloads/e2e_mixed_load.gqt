# issue: none
# notes: One public loader call updates 16 existing keys and inserts 16 new keys; exact 80-row result. One operation on a fresh handle is timed; checks and restart are outside the timer.

--- runner
timeout_ms: 60000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- load generate: v1 seed: 0 mode: merge branch: main
tables:
  - kind: node
    name: Chunk
    rows: 32
    commits: 1
    batch_rows: 32
    start: 48
    columns:
      slug: {kind: key, prefix: base, width: 3}
      embedding: {kind: literal, value: [300.0,0.0,0.0,0.0]}
--- expect ok

--- query
branch list

--- expect unordered
{"name":"main"}
--- expect shape
name: String

--- query branch: main
query chunk_rows() { match { $c: Chunk } return { $c.slug as slug, $c.embedding as embedding } }

