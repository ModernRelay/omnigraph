# issue: none
# notes: Shared benchmark dataset/query contract.

--- runner
timeout_ms: 600000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- mutate
branch merge "bench-source" into "bench-target"
--- expect outcome: merged

--- query branch: main
query node_0_main() {
    match { $n: BenchN000 }
    return { $n.cohort as cohort, count($n.name) as n, count($n.payload) as payloads, min($n.val) as lo, max($n.val) as hi }
}
--- expect unordered
{"cohort":"keep","n":100000,"payloads":100000,"lo":0,"hi":99999}
--- expect shape
cohort: String?
n: I64
payloads: I64
lo: I32?
hi: I32?

--- query branch: main
query edge_0_main() {
    match { $a: BenchN000
        $a $e:benche000 $b }
    return { $e.cohort as cohort, count($e.val) as n, count($e.payload) as payloads, min($e.val) as lo, max($e.val) as hi }
}
--- expect unordered
{"cohort":"d50_src_upd","n":5,"payloads":5,"lo":0,"hi":4}
{"cohort":"d50_src_del","n":5,"payloads":5,"lo":5,"hi":9}
{"cohort":"d50_tgt_upd","n":5,"payloads":5,"lo":10,"hi":14}
{"cohort":"d50_tgt_del","n":5,"payloads":5,"lo":15,"hi":19}
{"cohort":"keep","n":99980,"payloads":99980,"lo":20,"hi":99999}
--- expect shape
cohort: String?
n: I64
payloads: I64
lo: I32?
hi: I32?

