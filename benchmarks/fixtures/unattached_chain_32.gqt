# issue: none
# notes: The 32 paired updates of very_long_history_32 as one retained unattached chain (a root and
# notes: 31 children, each on the previous snapshot); main stays at the seed. The chain is unrolled
# notes: because a commit binding may not sit in a loop.

--- runner
timeout_ms: 60000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node HistoryRow { key: String @key value: I64 payload: String }

--- seed
{"type":"HistoryRow","data":{"key":"hot","value":0,"payload":"fixed"}}

--- mutate
query set_one() as unattached branch { update HistoryRow set { value: 1 } where key = "hot" }
--- expect affected: nodes=1 edges=0
--- bind commit $c00

--- mutate
query restore_zero() as unattached branch on "${c00}" { update HistoryRow set { value: 0 } where key = "hot" }
--- expect affected: nodes=1 edges=0
--- bind commit $c01

