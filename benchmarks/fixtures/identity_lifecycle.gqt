# issue: none
# notes: Sequential branch-name reuse with a live child retaining the old lifetime; no table-schema lifecycle or held-snapshot claim.

--- runner
timeout_ms: 60000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item { key: String @key value: I64 }

--- seed
{"type":"Item","data":{"key":"alice","value":0}}

--- mutate
branch create "feature" from main
--- expect ok

--- mutate branch: feature
query old_write() { insert Item { key: "old_only", value: 10 } }
--- expect affected: nodes=1 edges=0

--- mutate
branch create "old_child" from "feature"
--- expect ok

--- mutate
branch delete "feature"
--- expect ok

--- mutate
query main_write() { insert Item { key: "new_main", value: 20 } }
--- expect affected: nodes=1 edges=0

--- mutate
branch create "feature" from main
--- expect ok

--- query branch: main
query current_rows() { match { $r: Item } return { $r.key as key, $r.value as value } }
--- expect unordered
{"key":"alice","value":0}
{"key":"new_main","value":20}
--- expect shape
key: String
value: I64

--- query branch: feature
query current_rows() { match { $r: Item } return { $r.key as key, $r.value as value } }
--- expect unordered
{"key":"alice","value":0}
{"key":"new_main","value":20}
--- expect shape
key: String
value: I64

--- query branch: old_child
query current_rows() { match { $r: Item } return { $r.key as key, $r.value as value } }
--- expect unordered
{"key":"alice","value":0}
{"key":"old_only","value":10}
--- expect shape
key: String
value: I64

--- query
branch list
--- expect unordered
{"name":"main"}
{"name":"feature"}
{"name":"old_child"}
--- expect shape
name: String
