# issue: none
# notes: Deterministic keyed edge divergence with one publication per explicit load batch.

--- runner
timeout_ms: 600000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node BenchN000 { name: String @key cohort: String? val: I32? payload: String? }
node BenchN001 { name: String @key cohort: String? val: I32? payload: String? }
node BenchN002 { name: String @key cohort: String? val: I32? payload: String? }
node BenchN003 { name: String @key cohort: String? val: I32? payload: String? }
edge BenchE000: BenchN000 -> BenchN001 { cohort: String? val: I32? payload: String? }
edge BenchE001: BenchN001 -> BenchN002 { cohort: String? val: I32? payload: String? }
edge BenchE002: BenchN002 -> BenchN003 { cohort: String? val: I32? payload: String? }
edge BenchE003: BenchN003 -> BenchN000 { cohort: String? val: I32? payload: String? }

--- seed generate: v1 seed: 0
tables:
  - kind: "node"
    name: "BenchN000"
    rows: 100000
    commits: 25
    batch_rows: 4096
    columns:
      name: {"kind": "key", "prefix": "n000_r", "width": 7}
      cohort: {"kind": "literal", "value": "keep"}
      val: {"kind": "ordinal", "start": 0, "step": 1}
      payload: {"kind": "repeat", "text": "x", "count": 64}
  - kind: "node"
    name: "BenchN001"
    rows: 100000
    commits: 25
    batch_rows: 4096
    columns:
      name: {"kind": "key", "prefix": "n001_r", "width": 7}
      cohort: {"kind": "literal", "value": "keep"}
      val: {"kind": "ordinal", "start": 0, "step": 1}
      payload: {"kind": "repeat", "text": "x", "count": 64}
  - kind: "node"
    name: "BenchN002"
    rows: 100000
    commits: 25
    batch_rows: 4096
    columns:
      name: {"kind": "key", "prefix": "n002_r", "width": 7}
      cohort: {"kind": "literal", "value": "keep"}
      val: {"kind": "ordinal", "start": 0, "step": 1}
      payload: {"kind": "repeat", "text": "x", "count": 64}
  - kind: "node"
    name: "BenchN003"
    rows: 100000
    commits: 25
    batch_rows: 4096
    columns:
      name: {"kind": "key", "prefix": "n003_r", "width": 7}
      cohort: {"kind": "literal", "value": "keep"}
      val: {"kind": "ordinal", "start": 0, "step": 1}
      payload: {"kind": "repeat", "text": "x", "count": 64}
  - kind: "edge"
    name: "BenchE000"
    rows: 100000
    commits: 25
    batch_rows: 4096
    start: 0
    id: {"kind": "key", "prefix": "e000_r", "width": 7}
    from: {"kind": "endpoint", "prefix": "n000_r", "width": 7, "population": 100000, "distribution": {"kind": "ordinal"}}
    to: {"kind": "endpoint", "prefix": "n001_r", "width": 7, "population": 100000, "distribution": {"kind": "ordinal"}}
    columns:
      cohort: {"kind": "ranges", "ranges": [{"end": 5, "value": "d50_src_upd"}, {"end": 10, "value": "d50_src_del"}, {"end": 15, "value": "d50_tgt_upd"}, {"end": 20, "value": "d50_tgt_del"}], "fallback": "keep"}
      val: {"kind": "ordinal", "start": 0, "step": 1}
      payload: {"kind": "repeat", "text": "x", "count": 64}
  - kind: "edge"
    name: "BenchE001"
    rows: 100000
    commits: 25
    batch_rows: 4096
    start: 0
    id: {"kind": "key", "prefix": "e001_r", "width": 7}
    from: {"kind": "endpoint", "prefix": "n001_r", "width": 7, "population": 100000, "distribution": {"kind": "ordinal"}}
    to: {"kind": "endpoint", "prefix": "n002_r", "width": 7, "population": 100000, "distribution": {"kind": "ordinal"}}
    columns:
      cohort: {"kind": "ranges", "ranges": [{"end": 4, "value": "d50_src_upd"}, {"end": 8, "value": "d50_src_del"}, {"end": 12, "value": "d50_tgt_upd"}, {"end": 16, "value": "d50_tgt_del"}], "fallback": "keep"}
      val: {"kind": "ordinal", "start": 0, "step": 1}
      payload: {"kind": "repeat", "text": "x", "count": 64}
  - kind: "edge"
    name: "BenchE002"
    rows: 100000
    commits: 25
    batch_rows: 4096
    start: 0
    id: {"kind": "key", "prefix": "e002_r", "width": 7}
    from: {"kind": "endpoint", "prefix": "n002_r", "width": 7, "population": 100000, "distribution": {"kind": "ordinal"}}
    to: {"kind": "endpoint", "prefix": "n003_r", "width": 7, "population": 100000, "distribution": {"kind": "ordinal"}}
    columns:
      cohort: {"kind": "ranges", "ranges": [{"end": 4, "value": "d50_src_upd"}, {"end": 8, "value": "d50_src_del"}, {"end": 12, "value": "d50_tgt_upd"}, {"end": 16, "value": "d50_tgt_del"}], "fallback": "keep"}
      val: {"kind": "ordinal", "start": 0, "step": 1}
      payload: {"kind": "repeat", "text": "x", "count": 64}
  - kind: "edge"
    name: "BenchE003"
    rows: 100000
    commits: 25
    batch_rows: 4096
    start: 0
    id: {"kind": "key", "prefix": "e003_r", "width": 7}
    from: {"kind": "endpoint", "prefix": "n003_r", "width": 7, "population": 100000, "distribution": {"kind": "ordinal"}}
    to: {"kind": "endpoint", "prefix": "n000_r", "width": 7, "population": 100000, "distribution": {"kind": "ordinal"}}
    columns:
