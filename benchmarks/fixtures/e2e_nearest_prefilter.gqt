--- query
query filtered_nearest($q: Vector(4)) {
    match { $d: Doc { status: "hit" } }
    return { $d.slug }
    order { nearest($d.embedding, $q) }
    limit 3
}
--- params
{"q":[1.0,0.0,0.0,0.0]}

--- expect ordered
{"d.slug":"hit001"}
{"d.slug":"hit002"}
{"d.slug":"hit003"}
--- expect shape
d.slug: String

