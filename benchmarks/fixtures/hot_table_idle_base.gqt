# issue: none
# notes: Hot row stays fixed while idle table, branch and unrelated-history axes are isolated: base.

--- runner
timeout_ms: 60000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Hot { key: String @key value: I64 }

--- seed
{"type":"Hot","data":{"key":"hot","value":0}}

--- query branch: main
query current_rows() { match { $r: Hot } return { $r.key as key, $r.value as value } }
--- expect unordered
{"key":"hot","value":0}
--- expect shape
key: String
value: I64

--- query
branch list
--- expect unordered
{"name":"main"}
--- expect shape
name: String
