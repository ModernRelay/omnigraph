# issue: none
# notes: Bounded query-shape representative: 100 people and 50 disjoint directed edges. Names start at p000500; generated vectors use the existing GQT seed recipe. Scale, vectors and publication batches differ from the former Rust workload; this has a new timing identity.

--- runner
timeout_ms: 60000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    age: I64
    team: String
    bio: String
    embedding: Vector(32)
}
edge Knows: Person -> Person

--- seed generate: v1 seed: 42
tables:
  - kind: node
    name: Person
    rows: 100
    commits: 1
    batch_rows: 100
    start: 500
    columns:
      name: {kind: key, prefix: p, width: 6}
      age: {kind: modulo, modulus: 100}
      team: {kind: key, prefix: g, width: 0, modulo: 10}
      bio: {kind: repeat, text: "synthetic person biography ", count: 40}
      embedding: {kind: vector, dimensions: 32}
  - kind: edge
    name: Knows
    rows: 50
    commits: 1
    batch_rows: 50
    id: {kind: key, prefix: e, width: 3}
    from:
      kind: ranges
      ranges:
        - {end: 1, value: "p000500"}
        - {end: 2, value: "p000502"}
        - {end: 3, value: "p000504"}
        - {end: 4, value: "p000506"}
        - {end: 5, value: "p000508"}
        - {end: 6, value: "p000510"}
        - {end: 7, value: "p000512"}
        - {end: 8, value: "p000514"}
        - {end: 9, value: "p000516"}
        - {end: 10, value: "p000518"}
        - {end: 11, value: "p000520"}
