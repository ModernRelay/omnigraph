--- query
set ann_nprobes = 1;
query nearest_matching_rows($q: Vector(4)) {
    match { $d: Doc $d.n > 3 }
    return { $d.slug }
    order { nearest($d.embedding, $q) }
    limit 3
}
--- params
{"q":[2.3,0.0,0.0,0.0]}

--- expect ordered
{"d.slug":"d004"}
{"d.slug":"d005"}
{"d.slug":"d006"}
--- expect shape
d.slug: String

