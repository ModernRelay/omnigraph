# issue: none
--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
--- schema
node Person {
    name: String @key
    age: I32
}
--- seed generate: v1 seed: 7
tables:
  - kind: node
    name: Person
    rows: 10000001
    commits: 10000001
    columns:
      name: {kind: key, prefix: person-, width: 8}
      age: {kind: literal, value: 1}
--- query
query all() { match { $p: Person } return { $p.name } }
