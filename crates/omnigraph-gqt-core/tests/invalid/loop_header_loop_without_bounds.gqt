# issue: none
--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
--- schema
node Person {
    name: String @key
    age: I32
}
--- seed
{"type":"Person","data":{"name":"alice","age":1}}
--- loop $i
--- mutate
query bump($n: I32) { match { $x: Person } where $x.name = "alice"  update $x set { age: $n } }
--- params
{"n": ${i}}
--- expect affected: nodes=1 edges=0
--- endloop
