# issue: none
--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
--- schema
node Person {
    name: String @key
}
--- seed
{"type":"Person","data":{"name":"alice"}}
--- mutate
query propose() as commit {
    insert Person { name: "bob" }
}
--- expect ok
--- bind commit $c
--- mutate
commit publish "${c}" extra
--- expect ok
