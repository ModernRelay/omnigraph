# issue: none
--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
--- schema
node Person {
    name: String @key
    age: I32
}
--- seed
{"type":"Person","data":{"name":"alice","age":1}}
--- branches generate: v1 seed: 0 count: 2 prefix: ${branch}
tables:
  - kind: node
    name: Person
    rows: 1
    commits: 1
    columns:
      name: {kind: key, prefix: "${branch}-", width: 3}
      age: {kind: literal, value: 1}
--- query
query all() { match { $p: Person } return { $p.name } }
--- expect unordered
--- expect shape
p.name: String
