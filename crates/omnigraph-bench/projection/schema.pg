node Catalog {
    catalog_id: String @key
    path: String
    digest: String
    scenario_count: U32
}

node Suite {
    name: String @key
    catalog_id: String
}

node Scenario {
    name: String @key
    measured_step_ordinal: U32?
    measured_step: String?
    repetitions: U32?
    deadline_seconds: U64?
    protocol_json: String?
    fixture_kind: String?
}

node Fixture {
    fixture_id: String @key
    kind: String
    path: String?
    definition_json: String
}

node Workload {
    workload_id: String @key
    path: String
    sha256: String
}

node Revision {
    sha: String @key
}

node Machine {
    machine_fingerprint: String @key
    label: String?
    os_name: String?
    os_version: String?
    kernel_version: String?
    architecture: String?
    cpu_model: String?
    logical_cores: U32?
    physical_cores: U32?
    total_memory_bytes: U64?
}

node Campaign {
    dispatch_id: String @key
    trust: String
    reason: String?
    suite: String?
    started_unix_ms: U64?
    finished_unix_ms: U64?
    exit_code: I64?
    failed_stage: String?
}

node BenchmarkPoint {
    point_id: String @key
    point_name: String
    point_identity_version: U32
    scenario: String
    run_spec_json: String
}

node BenchmarkRun {
    invocation_id: String @key
    record_sha256: String @unique
    archive_object: String @unique
    archive_pointer: String @unique
    session_id: String
    invoked_at_unix_ms: U64
    case_id: String
    case_digest: String
    sut_evidence: String
    package_version: String
    source_commit: String
    source_tree_dirty: Bool
    build_profile: String
    build_opt_level: String
    debug_assertions: Bool
    target_triple: String?
    rustc_version: String?
    build_declared_release_lto: String?
    build_declared_release_codegen_units: U32?
    build_declared_release_strip: Bool?
    build_cargo_encoded_rustflags_present: Bool?
    build_release_profile_environment_overrides_supported: Bool?
    build_effective_codegen_options_proved: Bool
    worker_executable_sha256: String?
    sut_fingerprint: String
    sut_json: String
    client_build_json: String?
    client_machine_json: String?
    machine_fingerprint: String?
    machine_format_version: U32?
    machine_os_name: String?
    machine_os_version: String?
    machine_kernel_version: String?
    machine_architecture: String?
    machine_cpu_model: String?
    machine_logical_cores: U32?
    machine_physical_cores: U32?
    machine_total_memory_bytes: U64?
    machine_resource_control_json: String?
    machine_scheduling_json: String?
    machine_resource_limits_json: String?
    machine_label: String?
    backend_evidence: String
    backend_fingerprint: String
    backend_json: String
    fixture_manifest_sha256: String?
    fixture_logical_sha256: String
    fixture_physical_sha256: String?
    acquisition_status: String
    claim_eligible: Bool
    terminal_failed_repetition: U32?
    terminal_stage: String?
    terminal_code: String?
    requested_repetitions: U32
    observed_repetitions: U32
    min_us: U64
    p50_us: U64
    max_us: U64
    p95_us: U64?
    p95_supported: Bool
    wall_evidence: String
    floor_multiplier_millis: U32
    lance_data_plane_logical_calls_min: U64?
    lance_data_plane_logical_calls_p50: U64?
    lance_data_plane_logical_calls_max: U64?
    control_plane_logical_calls_min: U64?
    control_plane_logical_calls_p50: U64?
    control_plane_logical_calls_max: U64?
    logical_counts_presence_json: String
    physical_counts_presence_json: String
}

edge Measures: BenchmarkRun -> BenchmarkPoint @card(1..1) {
    @unique(@src, @dst)
}

edge Declares: Catalog -> Scenario {
    @key(@src, @dst)
}

edge Groups: Suite -> Scenario {
    @key(@src, @dst)
}

edge Uses: Scenario -> Fixture @card(0..1) {
    @unique(@src, @dst)
}

edge Executes: Scenario -> Workload @card(0..1) {
    @unique(@src, @dst)
}

edge Defines: Scenario -> BenchmarkPoint {
    @key(@src, @dst)
}

edge Ran: BenchmarkRun -> Scenario @card(0..1) {
    @key(@src, @dst)
}

edge Built: BenchmarkRun -> Revision {
    @unique(@src, @dst)
}

edge MeasuredBy: BenchmarkRun -> Revision {
    @unique(@src, @dst)
}

edge Hosted: Machine -> BenchmarkRun {
    @unique(@src, @dst)
}

edge Produced: Campaign -> BenchmarkRun {
    @unique(@src, @dst)
}

node Level {
    factor: String
    value: String
    @key(factor, value)
}

edge Has: BenchmarkPoint -> Level {
    @key(@src, @dst)
}
