query series_for_scenario($scenario: String) {
    match {
        $s: Scenario,
        $r ran $s,
        $r measures $p,
        $r built $c,
    }
    where $s.name = $scenario
    return {
        $s.name as scenario,
        $p.point_name as point,
        $c.sha as commit,
        $r.invoked_at_unix_ms as invoked_at_unix_ms,
        $r.min_us as min_us,
        $r.p50_us as p50_us,
        $r.max_us as max_us,
        $r.observed_repetitions as repetitions,
        $r.claim_eligible as claim_eligible
    }
    order { invoked_at_unix_ms }
}
