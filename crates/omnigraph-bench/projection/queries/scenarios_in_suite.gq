query scenarios_in_suite($suite: String) {
    match {
        $u: Suite,
        $u groups $s,
        $s executes $w,
        $s uses $f,
    }
    where $u.name = $suite
    return {
        $s.name as scenario,
        $s.measured_step as measured_step,
        $w.path as workload,
        $f.kind as fixture_kind
    }
    order { scenario }
}
