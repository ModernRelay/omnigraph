// RFC 0048 compiler experiment. Loaded only into the unit-test parser.
// Reuse current tokens, graph patterns and scalar expressions; query_file
// remains the production root and cannot reach any of these rules.
probe_file = { SOI ~ probe_decl ~ EOI }
probe_decl = { "query" ~ ident ~ "(" ~ param_list? ~ ")" ~ query_annotation* ~ "{" ~ probe_match ~ (probe_rank | probe_match | probe_take)* ~ probe_return ~ probe_order? ~ probe_limit? ~ "}" }
probe_limit = { "limit" ~ probe_value }
probe_match = { "match" ~ "{" ~ probe_match_item+ ~ "}" }
probe_match_item = { probe_negation | binding | traversal | probe_match_terms | probe_filter }
probe_negation = { probe_kw_not ~ "{" ~ probe_match_item+ ~ "}" }
probe_filter = { probe_value }
probe_match_terms = { "match_terms" ~ "(" ~ probe_value ~ "," ~ probe_terms ~ ")" }
probe_rank = { "rank" ~ variable ~ "{" ~ probe_source+ ~ probe_output ~ "}" }
probe_output = { probe_kw_yield ~ ident }
probe_kw_yield = @{ "yield" ~ !(ASCII_ALPHANUMERIC | "_") }
probe_source = { (probe_lexical | probe_vector | probe_fusion) ~ "as" ~ ident }
probe_lexical = { "lexical" ~ "(" ~ probe_value ~ "," ~ probe_terms ~ ("," ~ probe_option)* ~ ")" }
probe_terms = { "terms" ~ "(" ~ probe_value ~ ("," ~ probe_option)* ~ ")" }
probe_vector = { probe_vector_kind ~ "(" ~ probe_value ~ "," ~ probe_value ~ ("," ~ probe_option)* ~ ")" }
probe_vector_kind = { "knn" | "ann" }
probe_fusion = { "rrf" ~ "(" ~ probe_arm ~ ("," ~ probe_arm)+ ~ ("," ~ probe_option)* ~ ")" }
probe_arm = { "arm" ~ "(" ~ ident ~ ("," ~ probe_option)* ~ ")" }
probe_option = { ident ~ ":" ~ probe_value }
probe_take = { "take" ~ variable ~ "{" ~ probe_per ~ probe_order? ~ "limit" ~ probe_value ~ "}" }
probe_per = { "per" ~ "{" ~ probe_value ~ ("," ~ probe_value)* ~ "}" }
probe_return = { "return" ~ "{" ~ probe_projection+ ~ "}" }
probe_projection = { probe_value ~ ("as" ~ ident)? ~ ","? }
probe_order = { "order" ~ "{" ~ probe_ordering ~ ("," ~ probe_ordering)* ~ "}" }
probe_ordering = { probe_value ~ order_dir? ~ probe_nulls? }
probe_nulls = { "nulls" ~ probe_null_placement }
probe_null_placement = { "first" | "last" }
probe_value = { probe_or }
probe_or = { probe_and ~ (probe_kw_or ~ probe_and)* }
probe_and = { probe_not ~ (probe_kw_and ~ probe_not)* }
// Parentheses distinguish scalar negation from a projected alias named `not`.
probe_not = { (probe_kw_not ~ &"(")* ~ probe_comparison }
probe_comparison = { probe_sum ~ (probe_comparison_op ~ probe_sum)? }
probe_sum = { probe_product ~ (probe_add_op ~ probe_product)* }
probe_product = { probe_primary ~ (probe_mul_op ~ probe_primary)* }
probe_primary = { probe_metric | probe_identity | probe_aggregate | probe_is_null | "(" ~ probe_value ~ ")" | probe_alias | expr }
probe_alias = @{ !(("true" | "false") ~ !(ASCII_ALPHANUMERIC | "_")) ~ ident_chars ~ !((WHITESPACE | COMMENT)* ~ "(") }
probe_is_null = { "is_null" ~ "(" ~ probe_value ~ ")" }
probe_comparison_op = @{ "starts_with" ~ !(ASCII_ALPHANUMERIC | "_") | "contains" ~ !(ASCII_ALPHANUMERIC | "_") | ">=" | "<=" | "!=" | ">" | "<" | "=" }
probe_add_op = { "+" | "-" }
probe_mul_op = { "*" | "/" }
probe_kw_not = @{ "not" ~ !(ASCII_ALPHANUMERIC | "_") }
probe_kw_and = @{ "and" ~ !(ASCII_ALPHANUMERIC | "_") }
probe_kw_or = @{ "or" ~ !(ASCII_ALPHANUMERIC | "_") }
probe_metric = { "metric" ~ "(" ~ ident ~ "," ~ ident ~ ")" }
probe_identity = { variable ~ ".@id" }
probe_aggregate = { agg_func ~ "(" ~ probe_value ~ ")" }
