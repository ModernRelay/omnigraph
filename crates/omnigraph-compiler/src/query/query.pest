// NanoGraph Query Grammar (.gq files)

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT = _{ LINE_COMMENT | BLOCK_COMMENT }
LINE_COMMENT = _{ "//" ~ (!"\n" ~ ANY)* }
BLOCK_COMMENT = _{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

query_file = { SOI ~ setting_stmt* ~ (show_stmt ~ statement_trailer? | branch_stmt ~ ";"? ~ statement_trailer? | commit_stmt ~ ";"? ~ statement_trailer? | load_stmt ~ ";"? ~ statement_trailer? | explain_stmt ~ statement_trailer? | query_decl* ~ missing_param_list?) ~ EOI }
// A declaration whose name is not followed by `(`, matched after the well
// formed declarations so the parser refuses it at the name's end with the
// one fix (`query name()`) instead of reporting the file's first position;
// pest tracks attempts per rule, never per token, so the missing `(` is
// otherwise not an attempt it can name.
missing_param_list = { missing_query_keyword ~ ident ~ !"(" ~ ANY* }
missing_query_keyword = @{ "query" ~ !(ASCII_ALPHANUMERIC | "_") }

// Settings statements stand at the head of a file, before its one statement
// or its declarations; `show` is itself the one statement. Names are looked
// up against the settings definition after the keyword, so `set`, `reset`,
// `show`, `all` and every setting name stay identifiers inside a body.
setting_stmt  = { set_stmt | reset_stmt }
set_stmt      = { kw_set ~ setting_name ~ "=" ~ setting_value ~ ";" }
reset_stmt    = { kw_reset ~ (kw_all | setting_name) ~ ";" }
show_stmt     = { kw_show ~ (kw_all | setting_name) ~ ";" }
setting_name  = @{ ident ~ ("." ~ ident)* }
setting_value = { integer | ident | string_lit }

// Statements: one per file, never beside a query declaration. Each keyword
// is atomic and closed by a word boundary: an identifier character may not
// follow it (`branch createb0` is a parse error), a quoted name may.
branch_stmt   = { kw_branch ~ (branch_create | branch_delete | branch_merge_base | branch_merge | branch_list | branch_diff) }
// The two control writes on an unpublished commit, named by its full id.
commit_stmt   = { kw_commit ~ (commit_publish | commit_drop) }
// `explain` wraps the one read declaration or load statement whose plan is answered as rows.
explain_stmt  = { kw_explain ~ (query_decl | load_stmt) }
// Anything the file holds after its one statement, matched so the parser
// refuses it by name instead of leaving `EOI` to report the expected tokens.
statement_trailer = { (setting_stmt | show_stmt | branch_stmt | commit_stmt | load_stmt | explain_stmt | query_decl)+ }
// `load csv "<uri>" into node:Person mode overwrite [delimiter "|"] [header]
// [columns (a, b)]`: one CSV object, named by URI, into one declared type.
// Every option is a keyword so a `.pg` property may carry any of these names.
load_stmt      = { kw_load ~ kw_csv ~ string_lit ~ kw_into ~ load_target ~ load_option* }
load_target    = { load_kind ~ ":" ~ type_name }
load_kind      = @{ ("node" | "edge") ~ !(ASCII_ALPHANUMERIC | "_") }
load_option    = { load_mode | load_delimiter | load_header | load_columns }
load_mode      = { kw_mode ~ load_mode_name }
load_mode_name = @{ ("overwrite" | "append" | "merge") ~ !(ASCII_ALPHANUMERIC | "_") }
load_delimiter = { kw_delimiter ~ string_lit }
load_header    = { kw_header }
load_columns   = { kw_columns ~ "(" ~ ident ~ ("," ~ ident)* ~ ")" }
kw_load      = @{ "load" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_csv       = @{ "csv" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_mode      = @{ "mode" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_delimiter = @{ "delimiter" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_header    = @{ "header" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_columns   = @{ "columns" ~ !(ASCII_ALPHANUMERIC | "_") }
branch_create = { kw_create ~ branch_name ~ (kw_from ~ (create_from_commit | branch_name))? }
// `from commit "<id>"`: the new branch starts at that graph commit. A bare
// `commit` with no quoted id after it names a branch called `commit`.
create_from_commit = { kw_commit ~ string_lit }
branch_delete = { kw_delete ~ branch_name }
branch_merge  = { kw_merge ~ branch_name ~ (kw_into ~ branch_name)? ~ (as_commit_clause | dry_run_clause)? }
branch_list   = { kw_list }
// Control reads (RFC 0030 §8): the merge base of a merge, a branch's net
// change since that base (`into`), or the net change between two points,
// each a branch or a quoted commit id (`to`). `merge-base` is tried before
// `merge`, which would otherwise take `merge` and fail on `-base`.
branch_merge_base = { kw_merge_base ~ branch_name ~ (kw_into ~ branch_name)? }
branch_diff   = { kw_diff ~ branch_name ~ ((kw_into | kw_to) ~ branch_name)? ~ diff_after_page? ~ diff_limit? }
diff_after_page = { kw_after ~ kw_page ~ string_lit }
diff_limit    = { kw_limit ~ integer }
// `dry run`: the merge is decided and nothing is written.
dry_run_clause = { kw_dry ~ kw_run }
// A bare `as` followed by `commit`, or `dry` followed by `run`, is the
// clause, never a branch named `as` or `dry`; quote the name for that.
branch_name   = { !(kw_as ~ kw_commit) ~ !(kw_dry ~ kw_run) ~ (ident | string_lit) }
commit_publish = { kw_publish ~ string_lit }
commit_drop    = { kw_drop ~ string_lit }
// `as commit`: the write's result is an unpublished commit.
as_commit_clause = { kw_as ~ kw_commit }
// `as unattached branch [on <base>]`: the write's result is an unattached
// snapshot, a root of the request branch's head or a child of the named
// unattached snapshot (a quoted id or a `String` parameter).
as_unattached_clause = { kw_as ~ kw_unattached ~ kw_branch ~ (kw_on ~ (string_lit | variable))? }

kw_branch = @{ "branch" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_explain = @{ "explain" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_create = @{ "create" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_delete = @{ "delete" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_merge  = @{ "merge" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_merge_base = @{ "merge-base" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_diff   = @{ "diff" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_to     = @{ "to" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_after  = @{ "after" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_page   = @{ "page" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_limit  = @{ "limit" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_dry    = @{ "dry" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_run    = @{ "run" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_list   = @{ "list" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_from   = @{ "from" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_into   = @{ "into" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_set    = @{ "set" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_reset  = @{ "reset" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_show   = @{ "show" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_all    = @{ "all" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_as     = @{ "as" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_commit = @{ "commit" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_unattached = @{ "unattached" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_on     = @{ "on" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_publish = @{ "publish" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_drop   = @{ "drop" ~ !(ASCII_ALPHANUMERIC | "_") }

query_decl = {
    "query" ~ ident ~ "(" ~ param_list? ~ ")" ~ query_annotation* ~ (as_commit_clause | as_unattached_clause)? ~ "{"
        ~ query_body
    ~ "}"
}
query_annotation = { description_annotation | instruction_annotation }
description_annotation = { "@description" ~ "(" ~ string_lit ~ ")" }
instruction_annotation = { "@instruction" ~ "(" ~ string_lit ~ ")" }

query_body = { read_query_body | mutation_body }
mutation_body = { mutation_stmt+ }
read_query_body = {
    match_clause
    ~ return_clause
    ~ order_clause?
    ~ limit_clause?
}

mutation_stmt = { insert_stmt | update_stmt | delete_stmt }
insert_stmt = { "insert" ~ type_name ~ "{" ~ mutation_assignment+ ~ "}" }
update_stmt = { "update" ~ type_name ~ "set" ~ "{" ~ mutation_assignment+ ~ "}" ~ "where" ~ mutation_predicate }
delete_stmt = { "delete" ~ type_name ~ "where" ~ mutation_predicate }
mutation_assignment = { ident ~ ":" ~ expr ~ ","? }
mutation_predicate = { expr }

param_list = { param ~ ("," ~ param)* }
param = { variable ~ ":" ~ type_ref }

type_ref = { (list_type | base_type | vector_type) ~ "?"? }
list_type = { "[" ~ base_type ~ "]" }
vector_type = { "Vector" ~ "(" ~ integer ~ ")" }
base_type = { "String" | "Blob" | "Bool" | "I32" | "I64" | "U32" | "U64" | "F32" | "F64" | "DateTime" | "Date" }

match_clause = { "match" ~ "{" ~ clause+ ~ "}" }

clause = { negation | subquery_predicate | exists_block | binding | traversal | filter }
// Deprecated and unreferenced, kept for one release (compatibility surfaces RFC, deprecate before remove).
text_search_clause = { search_call | fuzzy_call | match_text_call }

// Binding: $p: Person { name: "Alice" }
binding = { variable ~ ":" ~ type_name ~ ("{" ~ prop_match_list ~ "}")? }

prop_match_list = { prop_match ~ ("," ~ prop_match)* ~ ","? }
prop_match = { ident ~ ":" ~ expr }
// Deprecated and unreferenced, kept for one release (compatibility surfaces RFC, deprecate before remove).
match_value = { literal | variable | now_call }

// Traversal: $p knows $f (directional) or $p <knows> $f (undirected —
// matches the edge in either direction; same-endpoint-type edges only).
// Edge selection also admits (knows | likes) and *, with finite hop bounds.
// An optional edge binding names the matched edge row: $p $w:knows $f.
// A node binding also starts `variable ~ ":"`; the case of the next token
// (lowercase edge_ident vs uppercase type_name) keeps the choice unambiguous.
// The edge is named bare, or as a string, the one spelling for an edge a
// reserved word names: `$i "in" $b` follows the edge `In`, as a quoted
// `branch_name` does for a branch.
traversal = { variable ~ edge_binding? ~ (undirected_edge | edge_alternation | edge_wildcard | edge_ident | string_lit) ~ traversal_bounds? ~ variable }
edge_binding = { variable ~ ":" }
undirected_edge = { "<" ~ (edge_wildcard | edge_alternatives | edge_ident | string_lit) ~ ">" }
edge_alternation = { "(" ~ edge_alternatives ~ ")" }
edge_alternatives = { (edge_ident | string_lit) ~ ("|" ~ (edge_ident | string_lit))+ }
edge_wildcard = { "*" }
traversal_bounds = { "{" ~ integer ~ "," ~ integer? ~ "}" }

// Filter: a Boolean expression, `$f.age > 25 and not $f.retired`
filter = { expr }

// Negation: not { ... }
negation = { "not" ~ "{" ~ clause+ ~ "}" }

// Correlated subquery predicates: the aggregate over the block's matches
// per outer row, compared with a scalar. `count { ... } > 2`,
// `sum($m.size) { ... } > 100`, and `exists { ... }` (`count { ... } > 0`).
subquery_predicate = { agg_func ~ ("(" ~ expr ~ ")")? ~ subquery_block ~ comp_op ~ expr }
exists_block = { "exists" ~ subquery_block }
subquery_block = { "{" ~ clause+ ~ "}" }

// Return clause — projections separated by commas or newlines; `distinct`
// keeps one row per distinct projected tuple.
return_clause = { "return" ~ kw_distinct? ~ "{" ~ projection+ ~ "}" }
kw_distinct = @{ "distinct" ~ !(ASCII_ALPHANUMERIC | "_") }
projection = { expr ~ ("as" ~ (reserved_alias | expr_ident))? ~ ","? }

// Order clause
order_clause = { "order" ~ "{" ~ ordering ~ ("," ~ ordering)* ~ "}" }
ordering = { nearest_ordering | (expr ~ order_dir?) }
nearest_ordering = { "nearest" ~ "(" ~ prop_access ~ "," ~ expr ~ ")" }
order_dir = { "asc" | "desc" }

// Limit clause
limit_clause = { "limit" ~ integer }

// Expressions: a precedence ladder, lowest binding first. A comparison is
// non-associative, so `$a < $b < $c` fails in the enclosing rule. Every
// keyword is word-bounded like `kw_set`, so `nothing` and `android` stay
// identifiers; the six keywords are reserved in operand position and as a
// return alias (`reserved_property`, `reserved_alias` name the collision).
expr              = { or_expr }
or_expr           = { and_expr ~ (kw_or ~ and_expr)* }
and_expr          = { not_expr ~ (kw_and ~ not_expr)* }
not_expr          = { (kw_not ~ not_expr) | comparison }
comparison        = { operand ~ ((filter_op ~ operand) | (kw_in ~ operand) | null_test)? }
null_test         = { kw_is ~ kw_not? ~ kw_null }
operand           = { "(" ~ expr ~ ")" | now_call | nearest_ordering | search_call
                    | fuzzy_call | match_text_call | bm25_call | rrf_call | agg_call
                    | prop_access | meta_field | variable | literal
                    | reserved_property | expr_ident }
kw_and            = @{ "and" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_or             = @{ "or" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_not            = @{ "not" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_is             = @{ "is" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_null           = @{ "null" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_in             = @{ "in" ~ !(ASCII_ALPHANUMERIC | "_") }
reserved          = { kw_and | kw_or | kw_not | kw_is | kw_null | kw_in }
reserved_property = { reserved }
reserved_alias    = { reserved }
expr_ident        = @{ !reserved ~ ident }

now_call = { "now" ~ "(" ~ ")" }
search_call = { "search" ~ "(" ~ expr ~ "," ~ expr ~ ")" }
fuzzy_call = { "fuzzy" ~ "(" ~ expr ~ "," ~ expr ~ ("," ~ expr)? ~ ")" }
match_text_call = { "match_text" ~ "(" ~ expr ~ "," ~ expr ~ ")" }
bm25_call = { "bm25" ~ "(" ~ expr ~ "," ~ expr ~ ")" }
rank_expr = { nearest_ordering | bm25_call }
rrf_call = { "rrf" ~ "(" ~ rank_expr ~ "," ~ rank_expr ~ ("," ~ expr)? ~ ")" }

prop_access = { variable ~ "." ~ (meta_field | ident) }
// Metadata includes `$p.@id`, `$e.@src`, `$e.@dst`, and read-only `$e.@type`.
// Mutation predicates admit stored metadata. User properties use bare names.
meta_field = @{ "@" ~ ident }

// `count(distinct $x)`; the bare alternative keeps an alias named `distinct`
// parseable as an argument.
agg_call = { agg_func ~ "(" ~ ((kw_distinct ~ expr) | expr) ~ ")" }
agg_func = { "count" | "sum" | "avg" | "min" | "max" }

comp_op = { ">=" | "<=" | "!=" | ">" | "<" | "=" }
filter_op = { "starts_with" | "contains" | comp_op }

// Terminals
variable = @{ "$" ~ (ident_chars | "_") }
ident_chars = @{ (ASCII_ALPHA_LOWER | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// Edge identifier — lowercase start, same as ident but used in traversal
// context. Never a reserved word, so `$a and $b` over Boolean parameters
// falls through `traversal` to `filter` instead of naming an edge `and`.
edge_ident = @{ !reserved ~ (ASCII_ALPHA_LOWER | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// A leading `@` names an engine catalogue type (`@Operator`), read-only and
// engine-owned like the `@` meta-fields; a user schema cannot declare one.
type_name = @{ "@"? ~ ASCII_ALPHA_UPPER ~ (ASCII_ALPHANUMERIC | "_")* }
ident = @{ (ASCII_ALPHA_LOWER | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

literal = { list_lit | datetime_lit | date_lit | string_lit | float_lit | integer | bool_lit }
date_lit = { "date" ~ "(" ~ string_lit ~ ")" }
datetime_lit = { "datetime" ~ "(" ~ string_lit ~ ")" }
list_lit = { "[" ~ (literal ~ ("," ~ literal)*)? ~ "]" }
string_lit = @{ "\"" ~ string_char* ~ "\"" }
string_char = @{ !("\"" | "\\") ~ ANY | "\\" ~ ANY }
float_lit = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }
integer = @{ ASCII_DIGIT+ }
bool_lit = @{ ("true" | "false") ~ !(ASCII_ALPHANUMERIC | "_") }

// ===========================================================================
// GQ edition 3 (docs/rfcs/2026-11-07-gq-3.md, section 7).
//
// Selected by the edition line `gq 3;`; a file without it parses with
// `query_file` above, unchanged. The rule names are section 7's, suffixed
// `3` where an edition-2 rule of another body has the name. Rules whose name
// ends in `_rec` are recognizers: they exist only so the builder can refuse
// the text at the construct, with a byte-range suggestion (section 5). Every
// recognizer accepts only text that section 7's rules refuse, so the set of
// accepted texts is section 7's. The rule names are pinned by
// `parser3_tests::the_edition3_rule_set_is_pinned` (section 11, rule 1).
// ===========================================================================

gq3_file = { SOI ~ edition_line ~ setting_stmt* ~ (show_stmt ~ statement_trailer3? | branch_stmt ~ ";"? ~ statement_trailer3? | commit_stmt ~ ";"? ~ statement_trailer3? | load_stmt ~ ";"? ~ statement_trailer3? | explain_stmt3 ~ statement_trailer3? | declaration3* ~ missing_param_list3?) ~ EOI }
edition_line = { kw_gq ~ integer ~ ";" }
explain_stmt3 = { kw_explain ~ (query_decl3 | load_stmt) }
statement_trailer3 = { (setting_stmt | show_stmt | branch_stmt | commit_stmt | load_stmt | explain_stmt3 | declaration3)+ }
missing_param_list3 = { (kw_query | kw_mutation | kw_view) ~ ident ~ !"(" ~ ANY* }

// `mutation` and `view` are recognised at declaration start only to print
// `query` as the fix.
declaration3 = { query_decl3 | mutation_decl | view_decl }
mutation_decl = { kw_mutation ~ ident ~ param_list3 ~ annotation3* ~ (as_commit_clause | as_unattached_clause)? ~ "{" ~ (read_body3 ~ &"}" | mutation_body3 ~ &"}" | swapped_read_rec) ~ "}" }
view_decl     = { kw_view ~ ident ~ param_list3 ~ annotation3* ~ "{" ~ (read_body3 ~ &"}" | mutation_body3 ~ &"}" | swapped_read_rec) ~ "}" }

query_decl3 = { kw_query ~ ident ~ param_list3 ~ annotation3* ~ (as_commit_clause | as_unattached_clause)? ~ "{" ~ (read_body3 ~ &"}" | mutation_body3 ~ &"}" | swapped_read_rec) ~ "}" }
param_list3 = { "(" ~ (param_item3 ~ ("," ~ param_item3)*)? ~ ")" }
param_item3 = _{ param3 | param_untyped_rec }
// Section 7 writes `type_ref_or_kind` and `literal`, which it does not
// define; the parameter kinds are a later change, so the type is today's
// `type_ref` and the default an edition-3 literal.
param3 = { variable ~ ":" ~ type_ref ~ ("=" ~ param_default)? }
param_default = { neg_sign? ~ literal3 }
neg_sign = { "-" }
param_untyped_rec = { variable ~ &("," | ")") }
annotation3 = { annotation_name ~ ("(" ~ (annotation_arg3 ~ ("," ~ annotation_arg3)*)? ~ ")")? }
annotation_name = @{ "@" ~ ident }
annotation_arg3 = { annotation_kwarg | annotation_colon_rec | annotation_value }
annotation_kwarg = { ident ~ "=" ~ annotation_value }
annotation_colon_rec = { ident ~ ":" ~ annotation_value }
annotation_value = { literal3 | variable | meta_field | ident }

// Read body: section 7's `match ~ return ~ order? ~ limit?`, written as a
// sequence the builder checks, so a missing `return`, an `order` after
// `limit`, `order by`, `offset`, `group by`, `having` and `retrieve` are
// refused at the construct with a fix. The accepted texts are section 7's.
read_body3 = { (match_clause3 | match_nobrace_rec) ~ retrieve_rec? ~ (return_clause3 | return_nobrace_rec)? ~ read_tail3* }
read_tail3 = _{ order_clause3 | order_by_rec | limit_clause3 | limit_neg_rec | offset_rec | group_by_rec | having_rec }
limit_neg_rec = { kw_limit ~ "-" ~ integer3 }
// `return { … }` written before `match { … }`.
swapped_read_rec = { return_clause3 ~ match_clause3 ~ read_tail3* }
match_clause3 = { kw_match ~ "{" ~ read_clause3+ ~ "}" }
// Inside braces there is no statement, so `$a delete $b` can only be a
// triple over an edge named `delete`, refused with the quoted fix.
read_clause3 = _{ stmt_edge_rec | clause3 }
stmt_edge_rec = { variable ~ stmt_word ~ variable }
stmt_word = @{ ("insert" | "update" | "delete") ~ !(ASCII_ALPHANUMERIC | "_") }
match_nobrace_rec = { kw_match ~ !"{" ~ (!(kw_return | stmt_keyword) ~ clause3)+ }
retrieve_rec = { fw_retrieve ~ "{" ~ brace_body ~ "}" }
return_clause3 = { kw_return ~ kw_distinct? ~ "{" ~ projection3+ ~ "}" }
return_nobrace_rec = { kw_return ~ kw_distinct? ~ !"{" ~ projection3+ }
projection3 = { (sql_alias_rec | distinct_item_rec | star_item_rec | expr3 ~ alias3?) ~ ","? }
alias3 = { kw_as ~ (reserved_alias | expr_ident | alias_string_rec) }
alias_string_rec = { string_lit }
sql_alias_rec = { !bool_lit ~ expr_ident ~ (!"==" ~ "=" | ":") ~ expr3 }
distinct_item_rec = { kw_distinct ~ !"(" ~ expr3 }
star_item_rec = { "*" }
order_clause3 = { kw_order ~ "{" ~ ordering3 ~ ("," ~ ordering3)* ~ "}" }
// A bare name in `order` is a return alias, and only a whole key may be one;
// the builder refuses a bare name anywhere else.
ordering3 = { dir_first_rec | expr3 ~ order_dir3? }
dir_first_rec = { order_dir3 ~ !(expr_ident ~ ("," | "}" | order_dir3)) ~ expr3 }
order_dir3 = @{ ("asc" | "desc") ~ !(ASCII_ALPHANUMERIC | "_") }
order_by_rec = { kw_order ~ fw_by ~ ordering3 ~ ("," ~ ordering3)* }
limit_clause3 = { kw_limit ~ (integer3 | variable) }
offset_rec = { fw_offset ~ (integer3 | variable) }
group_by_rec = { fw_group ~ fw_by ~ expr3 ~ ("," ~ expr3)* }
having_rec = { fw_having ~ ("{" ~ brace_body ~ "}" | expr3) }

// Clauses.
clause3 = { arrow_traversal | cypher_pattern | list_to_rows | prefix_rec | with_rec | call_block_rec | match_prefix_rec | let_clause | from_clause | from_paren_rec | negation3 | optional_block | optional_rec | blockless_rec | binding_brace_filter | binding_paren_rec | binding3 | binding_lower_rec | traversal3 | filter3 | stray_braces_rec }
let_clause     = { kw_let ~ variable ~ "=" ~ (inline_read | expr3) }
// `from` is the clause when the next token is `{`, `$` or an identifier
// touching `(`; a name with whitespace before its `(` is recognised to print
// the touching form.
from_clause    = { kw_from ~ &("{" | "$" | call_head | spaced_call_head) ~ relation_expr }
relation_expr  = { inline_read | call | spaced_call_rec | variable }
from_paren_rec = { kw_from ~ "(" ~ relation_expr ~ ")" }
inline_read    = { "{" ~ (read_body3 ~ &"}" | matchless_read_rec) ~ "}" }
matchless_read_rec = { (!kw_return ~ clause3)+ ~ return_clause3 ~ read_tail3* }
optional_block = { kw_optional ~ "{" ~ read_clause3+ ~ "}" }
negation3      = { kw_not ~ "{" ~ read_clause3+ ~ "}" }
subquery_block3 = { "{" ~ read_clause3+ ~ "}" }
binding3 = { variable ~ ":" ~ type_name ~ ("{" ~ prop_match_list3 ~ "}")? }       // a node or an edge type
prop_match_list3 = { prop_match3 ~ ("," ~ prop_match3)* ~ ","? }
prop_match3 = { ident ~ ":" ~ expr3 }
traversal3 = { !(variable ~ edge_wildcard ~ variable ~ continuation) ~ variable ~ edge_binding? ~ (undirected_edge3 | edge_sel3) ~ traversal_bounds? ~ variable }
continuation = { "." | concat_bars | sum_op3 | product_op | comp_op | infix_string_op | kw_in | kw_is | kw_and | kw_or }
undirected_edge3 = { "<" ~ (edge_alternatives3 | edge_sel3) ~ ">" }
edge_sel3 = { edge_alternation3 | edge_wildcard | catalogue_edge | edge_ident3 | string_lit }
// `let`, `from`, `true`, `false`, `insert`, `update` and `delete` are never
// bare edge names (nor are the reserved words, which `edge_ident` excludes):
// in a write body `$ok  delete $p` would otherwise parse silently as a triple
// over an edge named `delete`. They are written quoted, as `"in"` is.
edge_ident3 = @{ !(("let" | "from" | "true" | "false" | "insert" | "update" | "delete") ~ !(ASCII_ALPHANUMERIC | "_")) ~ edge_ident }
edge_alternation3 = { "(" ~ edge_alternatives3 ~ ")" }
edge_alternatives3 = { edge_name3 ~ ("|" ~ edge_name3)+ }
edge_name3 = _{ catalogue_edge | edge_ident3 | string_lit }
catalogue_edge = @{ "@" ~ ident }
filter3 = { expr3 }
// Braces where a clause starts: property matches written after a filter.
stray_braces_rec = { "{" ~ brace_body ~ "}" }

// Recognizers in clause position.
// `-e->`, `<-e-`, `-e-`, and Cypher's bracketed `-[:E]->`.
arrow_traversal = { variable ~ arrow_open ~ ("[" ~ cypher_rel_body ~ "]" | edge_binding? ~ edge_sel3 ~ traversal_bounds?) ~ arrow_close ~ variable }
arrow_open  = { "<-" | "-" }
arrow_close = { "->" | "-" }
// Cypher's `(a:Person)-[:KNOWS]->(b)`.
cypher_pattern = { cypher_node ~ (cypher_rel ~ cypher_node)+ | cypher_typed_node }
cypher_typed_node = { "(" ~ ident? ~ ":" ~ cypher_name ~ ("{" ~ cypher_prop ~ ("," ~ cypher_prop)* ~ "}")? ~ ")" }
cypher_node = { "(" ~ ident? ~ (":" ~ cypher_name)? ~ ("{" ~ cypher_prop ~ ("," ~ cypher_prop)* ~ "}")? ~ ")" }
cypher_prop = { ident ~ ":" ~ expr3 }
cypher_rel = { arrow_open ~ ("[" ~ cypher_rel_body ~ "]")? ~ arrow_close }
cypher_rel_body = { ident? ~ (":" ~ cypher_name)? ~ cypher_hops? }
cypher_hops = { "*" ~ integer? ~ (".." ~ integer?)? }
cypher_name = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
// `for $x in …`, `unwind … as $x`, `let $x in rel`, `let ($a, $b) in rel`.
list_to_rows = { (kw_for ~ variable ~ kw_in ~ (inline_read | expr3)) | (kw_unwind ~ expr3 ~ kw_as ~ variable) | (kw_let ~ ("(" ~ variable ~ ("," ~ variable)* ~ ")" | variable) ~ kw_in ~ (inline_read | expr3)) }
// Words from other languages at clause start (section 5's table).
prefix_rec = { fw_where ~ clause3 }
with_rec = { fw_with ~ with_item ~ ("," ~ with_item)* }
with_item = { expr3 ~ (kw_as ~ expr_ident)? }
call_block_rec = { fw_call ~ &"{" ~ (inline_read | "{" ~ clause3+ ~ "}") }
match_prefix_rec = { fw_match ~ !"{" ~ clause3 }
optional_rec = { fw_optional ~ fw_match? ~ ("{" ~ clause3+ ~ "}" | !"{" ~ clause3) }
blockless_rec = { (kw_not | kw_exists) ~ !("{" | "(") ~ (arrow_traversal | cypher_pattern | traversal3 | binding3) }
detach_rec = { fw_detach ~ &stmt_keyword }
// `$d: Doc { year >= 2025 }`: braces holding a comparison.
binding_brace_filter = { variable ~ ":" ~ type_name ~ "{" ~ !(prop_match_list3 ~ "}") ~ (brace_items_rec | brace_body) ~ "}" }
brace_items_rec = { brace_item ~ ("," ~ brace_item)* ~ ","? ~ &"}" }
brace_item = { brace_colon_compare | brace_compare | prop_match3 }
brace_colon_compare = { ident ~ ":" ~ comp_op ~ sum3 }
brace_compare = { ident ~ comp_op ~ sum3 }
brace_body = @{ (("{" ~ brace_body ~ "}") | (!("{" | "}") ~ ANY))* }
// `$p: Person(handle: $h)` and the withdrawn view binding `$x: View($h)`.
binding_paren_rec = { variable ~ ":" ~ binding_paren_head ~ (prop_match_list3 | call_args)? ~ ")" }
binding_paren_head = ${ type_name ~ "(" }
binding_lower_rec = { variable ~ ":" ~ ident }

// Write body: groups, each a read's clauses (bare) then its statements.
mutation_body3 = { write_group+ ~ trailing_clauses_rec? }
write_group    = { (!stmt_keyword ~ write_clause3)* ~ mutation_stmt3+ }
write_clause3  = _{ match_block_rec | detach_rec | clause3 }
// Section 7's `stmt_keyword` is the three statement words; `create`, `merge`
// and `set` are recognised here too, so Cypher's and SQL's write words at a
// write body's clause start are refused as statements with `insert` or
// `update` as the fix. No clause can begin with those words, so the accepted
// texts are section 7's.
stmt_keyword   = @{ ("insert" | "update" | "delete" | "create" | "merge" | "set") ~ !(ASCII_ALPHANUMERIC | "_") }
mutation_stmt3 = { where_stmt | create_rec | set_rec | delete_multi_rec | delete_type_rec | insert_paren_rec | update_noset_rec | stmt_var_rec | insert_stmt3 | update_stmt3 | delete_stmt3 }
// `insert $b`, `update $b` with no `set`: after a lone variable, the shape of
// a triple over an edge named `insert` or `update`.
stmt_var_rec = { (kw_insert | kw_update) ~ variable ~ !(kw_set | "{") }
insert_stmt3   = { kw_insert ~ type_name ~ "{" ~ assignment3+ ~ "}" }
update_stmt3   = { kw_update ~ variable ~ kw_set ~ "{" ~ assignment3+ ~ "}" }
delete_stmt3   = { kw_delete ~ variable }
assignment3    = { (ident ~ ":" ~ (null_value | expr3) | eq_assign_rec | qualified_assign_rec | meta_assign_rec) ~ ","? }
null_value     = { kw_null ~ &("," | "}" | ident ~ ":") }
// The predicate admits bare names (section 7: "where_expr admits bare
// names"), which the fix qualifies; `operand3` carries them as a recognizer.
where_stmt     = { (kw_update ~ (variable | type_name) ~ kw_set ~ "{" ~ assignment3+ ~ "}" | kw_delete ~ (variable | type_name)) ~ kw_where ~ expr3 }
match_block_rec = { kw_match ~ "{" ~ clause3+ ~ "}" }
trailing_clauses_rec = { (!"}" ~ write_clause3)+ }
eq_assign_rec = { ident ~ !"==" ~ "=" ~ (null_value | expr3) }
qualified_assign_rec = { prop_access3 ~ (":" | "=") ~ (null_value | expr3) }
meta_assign_rec = { meta_field ~ ":" ~ expr3 }
create_rec = { fw_create ~ (cypher_node | type_name ~ "{" ~ assignment3+ ~ "}") }
set_rec = { kw_set ~ set_item ~ ("," ~ set_item)* }
set_item = { prop_access3 ~ "=" ~ (null_value | expr3) }
delete_multi_rec = { kw_delete ~ variable ~ ("," ~ variable)+ }
delete_type_rec = { kw_delete ~ type_name }
insert_paren_rec = { kw_insert ~ type_name ~ "(" ~ "{" ~ assignment3+ ~ "}" ~ ")" }
update_noset_rec = { kw_update ~ variable ~ "{" ~ assignment3+ ~ "}" }

// Expressions: edition 2's logic ladder with the arithmetic ladder between
// comparison and operand.
expr3       = { or_expr3 }
or_expr3    = { and_expr3 ~ (kw_or ~ and_expr3)* }
and_expr3   = { not_expr3 ~ (kw_and ~ not_expr3)* }
not_expr3   = { (kw_not ~ not_expr3) | comparison3 }
comparison3 = { sum3 ~ (null_compare_rec | regex_rec | comp_op ~ sum3 ~ chained_rec? | not_in_rec | kw_in ~ (in_paren_rec | sum3) | between_rec | like_rec | starts_with_words_rec | infix_string_op ~ sum3 | null_test)? }
null_compare_rec = { ("!=" | "=") ~ kw_null }
regex_rec = { "=~" ~ sum3 }
chained_rec = { (comp_op ~ sum3)+ }
not_in_rec = { kw_not ~ kw_in ~ sum3 }
in_paren_rec = { "(" ~ expr3 ~ ("," ~ expr3)+ ~ ")" }
between_rec = { fw_between ~ sum3 ~ kw_and ~ sum3 }
like_rec = { fw_like ~ sum3 }
starts_with_words_rec = { (fw_starts | fw_ends) ~ fw_with ~ sum3 }
// Infix `contains` / `starts_with`, word-bounded and not touching `(`.
infix_string_op = @{ ("contains" | "starts_with") ~ !(ASCII_ALPHANUMERIC | "_" | "(") }
// A binary minus has whitespace on both sides or neither; the builder
// refuses `$n -1` and `$n- 1` with `$n - 1` as the fix.
sum3        = { product3 ~ (sum_op3 ~ product3)* }
sum_op3     = { "+" | "-" | concat_bars }
concat_bars = { "||" }
product3    = { unary3 ~ (product_op ~ unary3)* }
product_op  = { "*" | "/" | "%" }
unary3      = { unary_minus ~ unary3 | operand3 }
unary_minus = { "-" }
// Section 7's `operand3` has no bare name. Here a bare name is the last
// alternative, the recognizer `bare_name_rec`, so the parse reaches the word
// and the builder refuses it there with the foreign-word table's fix; it is
// admitted only as a whole `order` key and inside the `where_stmt` predicate,
// so the accepted texts are section 7's.
operand3    = { "(" ~ expr3 ~ ")" | block_value | agg_distinct | count_star_rec | case_rec | literal3 | type_prop_rec | call | keyword_call_rec | spaced_call_rec | prop_method_rec | prop_chain_rec | prop_star_rec | prop_access3 | meta_field | variable | reserved_property | bare_name_rec }
block_value = { (agg_name ~ ("(" ~ expr3 ~ ")")? | kw_exists) ~ subquery_block3 }
agg_name    = @{ ("count" | "sum" | "avg" | "min" | "max") ~ !(ASCII_ALPHANUMERIC | "_") }
agg_distinct = { agg_name ~ "(" ~ kw_distinct ~ expr3 ~ ")" }
count_star_rec = { agg_name ~ "(" ~ "*" ~ ")" }
// The call's name touches its `(`, and is never a clause keyword (section 5:
// a registry row is never named `let`, `from`, `optional` or `exists`).
call        = { call_head ~ call_args? ~ ")" }
call_head   = ${ call_name ~ "(" }
call_name   = @{ !(reserved | kw_let | kw_from | kw_optional | kw_exists) ~ ident }
call_args   = { positional ~ ("," ~ positional)* ~ ("," ~ call_option)* ~ !("," ~ positional) | call_option ~ ("," ~ call_option)* ~ !("," ~ positional) | mixed_args_rec }
// An option written before a positional argument.
mixed_args_rec = { (call_option | positional) ~ ("," ~ (call_option | positional))+ }
positional  = { !(ident ~ ":") ~ (inline_read | expr3) }
call_option = { ident ~ ":" ~ expr3 }
keyword_call_rec = { keyword_call_head ~ call_args? ~ ")" }
keyword_call_head = ${ (kw_let | kw_from | kw_optional | kw_exists) ~ "(" }
spaced_call_rec = { spaced_call_head ~ call_args? ~ ")" }
spaced_call_head = ${ call_name ~ (" " | "\t" | "\r" | "\n")+ ~ "(" }
case_rec = { fw_case ~ (fw_when ~ expr3 ~ fw_then ~ expr3)+ ~ (fw_else ~ expr3)? ~ fw_end }
type_prop_rec = { type_name ~ "." ~ ident }
prop_method_rec = { prop_method_head ~ call_args? ~ ")" }
prop_method_head = ${ variable ~ "." ~ ident ~ "(" }
prop_chain_rec = { variable ~ "." ~ ident ~ ("." ~ (ident | "*"))+ }
prop_star_rec = { variable ~ "." ~ "*" }
prop_access3 = { variable ~ "." ~ (meta_field | ident) }
bare_name_rec = { expr_ident }

literal3   = { list_lit3 | datetime_lit3 | date_lit3 | string_lit | exp_float_rec | float_lit3 | integer3 | bool_lit }
// `date("…")` is the literal, and like a call its name touches its `(`.
date_lit3     = { date_head3 ~ string_lit ~ ")" }
date_head3    = @{ "date(" }
datetime_lit3 = { datetime_head3 ~ string_lit ~ ")" }
datetime_head3 = @{ "datetime(" }
list_lit3  = { "[" ~ (literal3 ~ ("," ~ literal3)*)? ~ "]" }
float_lit3 = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+)? ~ !(ASCII_ALPHANUMERIC | "_") }
integer3   = @{ ASCII_DIGIT+ ~ !(ASCII_ALPHANUMERIC | "_" | ".") }
// `1e3`: an exponent needs a fraction.
exp_float_rec = @{ ASCII_DIGIT+ ~ ("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT+ ~ !(ASCII_ALPHANUMERIC | "_") }

kw_gq       = @{ "gq" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_query    = @{ "query" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_mutation = @{ "mutation" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_view     = @{ "view" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_match    = @{ "match" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_return   = @{ "return" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_order    = @{ "order" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_let      = @{ "let" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_optional = @{ "optional" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_exists   = @{ "exists" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_insert   = @{ "insert" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_update   = @{ "update" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_where    = @{ "where" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_for      = @{ "for" ~ !(ASCII_ALPHANUMERIC | "_") }
kw_unwind   = @{ "unwind" ~ !(ASCII_ALPHANUMERIC | "_") }
// Foreign words: case-insensitive, word-bounded; `where(…)` and the like stay
// calls.
fw_where    = @{ (^"where" | ^"filter") ~ !(ASCII_ALPHANUMERIC | "_" | "(") }
fw_with     = @{ ^"with" ~ !(ASCII_ALPHANUMERIC | "_" | "(") }
fw_call     = @{ ^"call" ~ !(ASCII_ALPHANUMERIC | "_" | "(") }
fw_match    = @{ ^"match" ~ !(ASCII_ALPHANUMERIC | "_" | "(") }
fw_optional = @{ ^"optional" ~ !(ASCII_ALPHANUMERIC | "_" | "(") }
fw_detach   = @{ ^"detach" ~ !(ASCII_ALPHANUMERIC | "_" | "(") }
fw_create   = @{ (^"create" | ^"merge") ~ !(ASCII_ALPHANUMERIC | "_" | "(") }
fw_by       = @{ ^"by" ~ !(ASCII_ALPHANUMERIC | "_") }
fw_offset   = @{ (^"offset" | ^"skip") ~ !(ASCII_ALPHANUMERIC | "_") }
fw_group    = @{ ^"group" ~ !(ASCII_ALPHANUMERIC | "_") }
fw_having   = @{ ^"having" ~ !(ASCII_ALPHANUMERIC | "_") }
fw_retrieve = @{ ^"retrieve" ~ !(ASCII_ALPHANUMERIC | "_") }
fw_between  = @{ ^"between" ~ !(ASCII_ALPHANUMERIC | "_") }
fw_like     = @{ ^"like" ~ !(ASCII_ALPHANUMERIC | "_") }
fw_starts   = @{ ^"starts" ~ !(ASCII_ALPHANUMERIC | "_") }
fw_ends     = @{ ^"ends" ~ !(ASCII_ALPHANUMERIC | "_") }
fw_case     = @{ ^"case" ~ !(ASCII_ALPHANUMERIC | "_") }
fw_when     = @{ ^"when" ~ !(ASCII_ALPHANUMERIC | "_") }
fw_then     = @{ ^"then" ~ !(ASCII_ALPHANUMERIC | "_") }
fw_else     = @{ ^"else" ~ !(ASCII_ALPHANUMERIC | "_") }
fw_end      = @{ ^"end" ~ !(ASCII_ALPHANUMERIC | "_") }
