// task: every recent document within a distance, by l2
// kind: ranking-and-search
// expect: accept
// rfc: asset §5
// amended: the ranked column is a property access and `l2` is `distance` (RFC §3, 2026-11-08)
query q($q: Vector(3), $r: F32) {
  match { from distance({ match { $d: Doc  $d.year >= 2025 } return { $d } }, $d.embedding, $q)  $distance <= $r }
  return { $d.title, $distance }
  order { $distance, $d.id }
  limit 10
}
