// task: nearest with k written positionally
// kind: ranking-and-search
// expect: accept
// rfc: §3 refused respellings: positional k
// later: positional option refused with the option as the fix
// amended: the ranked column is a property access and `l2` is `distance` (RFC §3, 2026-11-08)
query q($q: Vector(3)) {
  match { from nearest({ match { $d: Doc } return { $d } }, $d.embedding, $q, 20) }
  return { $d.title }
}
