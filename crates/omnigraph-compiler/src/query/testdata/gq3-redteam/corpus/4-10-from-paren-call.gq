// task: a from whose relation is a parenthesised call
// kind: shapes-of-a-result
// expect: refuse-with-fix:from union({ match { $p: Person } return { $p } }, { match { $p: Person } return { $p } })
// rfc: §7 relation_expr
query q() {
  match { from (union({ match { $p: Person } return { $p } }, { match { $p: Person } return { $p } })) }
  return { $p.name }
}
