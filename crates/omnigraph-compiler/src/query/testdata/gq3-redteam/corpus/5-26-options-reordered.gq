// task: nearest with recall before k
// kind: ranking-and-search
// expect: accept
// rfc: §3
// amended: the ranked column is a property access and `l2` is `distance` (RFC §3, 2026-11-08)
query q($q: Vector(3)) {
  match { from nearest({ match { $d: Doc } return { $d } }, $d.embedding, $q, recall: 0.9, k: 20) }
  return { $d.title }
}
