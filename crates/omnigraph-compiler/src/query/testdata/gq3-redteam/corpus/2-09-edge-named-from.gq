// task: a traversal over an edge named `from`
// kind: traversal
// expect: refuse-with-fix:$a "from" $b
// rfc: §7: let and from are legal as edge names
// note: makes this a quoted-only edge
// amended: `from` is never a bare edge name; the quoted edge is the fix (RFC §7, 2026-11-08)
query q() {
  match { $a: Person  $a from $b }
  return { $b.name }
}
