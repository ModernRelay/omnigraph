// task: nearest over a node binding instead of a relation (the unresolved shorthand)
// kind: ranking-and-search
// expect: accept
// rfc: unresolved question 1
// later: T69
// amended: the ranked column is a property access and `l2` is `distance` (RFC §3, 2026-11-08)
query q($q: Vector(3)) {
  match { $d: Doc  $d.year > 2020  from nearest($d, $d.embedding, $q, k: 5) }
  return { $d.title }
}
