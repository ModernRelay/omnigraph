// task: BM25 over an all-terms one-edit lexical query
// kind: ranking-and-search
// expect: accept
// rfc: §4 the lexical query
// amended: the ranked column is a property access and `l2` is `distance` (RFC §3, 2026-11-08)
query q($q: String) {
  match { from bm25({ match { $d: Doc } return { $d } }, $d.body, terms($q, mode: all, max_edits: 1)) }
  return { $d.title, $score }
}
