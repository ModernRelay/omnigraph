// task: unbounded reachability as an open hop range `knows{1,}`
// kind: traversal
// expect: accept
// rfc: §2 Expand: an open upper bound is a later change
// later: T15 (RFC §5, 2026-11-08: the type-level door with a pinned test)
// note: additive later; must be refused now with a message that does not pretend it exists
// amended: an open bound is a later form whose door is the type checker's T15 (RFC §5, 2026-11-08)
query q() {
  match { $a: Person  $a knows{1,} $b }
  return { $b.name }
}
