// task: a write whose targets come from a ranked read
// kind: ranking-and-search
// expect: accept
// rfc: asset §6
// amended: the ranked column is a property access and `l2` is `distance` (RFC §3, 2026-11-08)
query tag_near($q: Vector(3)) {
  from nearest({ match { $d: Doc } return { $d } }, $d.embedding, $q, k: 20)
  update $d set { tags: ["near"] }
}
