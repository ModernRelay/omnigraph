// task: a from over a declared read with a space before the parenthesis
// kind: shapes-of-a-result
// expect: refuse-with-fix:from colleagues($h)
// rfc: §7: from is the clause when the next token is an identifier followed by `(`
// amended: a space before a call's `(` is refused with the touching form (RFC §3, 2026-11-08)
query colleagues($of: String) {
  match { $p: Person { handle: $of }  $p worksAt $c  $q worksAt $c }
  return { $q }
}

query q($h: String) {
  match { from colleagues ($h) }
  return { $q.name }
}
