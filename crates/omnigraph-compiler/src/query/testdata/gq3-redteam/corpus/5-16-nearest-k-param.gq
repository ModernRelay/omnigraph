// task: a nearest window sized by a parameter
// kind: ranking-and-search
// expect: accept
// rfc: §3
// amended: the ranked column is a property access and `l2` is `distance` (RFC §3, 2026-11-08)
query q($q: Vector(3), $k: I64 = 10) {
  match { from nearest({ match { $d: Doc } return { $d } }, $d.embedding, $q, k: $k) }
  return { $d.title }
}
