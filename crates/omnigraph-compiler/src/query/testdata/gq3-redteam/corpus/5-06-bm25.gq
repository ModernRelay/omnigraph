// task: documents ranked by BM25
// kind: ranking-and-search
// expect: accept
// rfc: asset §5
// amended: the ranked column is a property access and `l2` is `distance` (RFC §3, 2026-11-08)
query q($q: String) {
  match { from bm25({ match { $d: Doc } return { $d } }, $d.body, $q) }
  return { $d.title, $score as s }
  order { $score desc }
  limit 10
}
