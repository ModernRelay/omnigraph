// task: hybrid fused ranking with a named population
// kind: ranking-and-search
// expect: accept
// rfc: asset §5
// amended: the ranked column is a property access and `l2` is `distance` (RFC §3, 2026-11-08)
query hybrid($q: String, $v: Vector(3)) {
  match {
    let $docs = { match { $d: Doc } return { $d } }
    from rrf(nearest($docs, $d.embedding, $v, k: 50), bm25($docs, $d.body, $q), k: 60)
  }
  return { $d.title, $score }
  order { $score desc }
  limit 10
}
