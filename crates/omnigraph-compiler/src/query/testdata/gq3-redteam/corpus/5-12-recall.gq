// task: a declared recall on nearest
// kind: ranking-and-search
// expect: accept
// rfc: §3 relation expressions
// amended: the ranked column is a property access and `l2` is `distance` (RFC §3, 2026-11-08)
query q($q: Vector(3)) {
  match { from nearest({ match { $d: Doc } return { $d } }, $d.embedding, $q, k: 20, recall: 0.9) }
  return { $d.title, $distance }
}
