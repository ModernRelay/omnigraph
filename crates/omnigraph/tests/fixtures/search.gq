query text_search($q: String) {
    match { $d: Doc }
    where match_terms($d.title, terms($q, mode: any))
    return { $d.slug, $d.title }
}

query fuzzy_search($q: String) {
    match { $d: Doc }
    where match_terms($d.title, terms($q, mode: any, max_edits: 2))
    return { $d.slug, $d.title }
}

query phrase_search($q: String) {
    match { $d: Doc }
    where match_terms($d.body, terms($q, mode: any))
    return { $d.slug, $d.title }
}

query vector_search($q: Vector(4)) {
    match { let $pop = { match { $d: Doc } return { $d } }, from nearest($pop, $d.embedding, $q, k: 3) as $distance }
    return { $d.slug, $d.title }
    order { $distance }
    limit 3
}

query bm25_search($q: String) {
    match { let $pop = { match { $d: Doc } return { $d } }, from bm25($pop, $d.title, $q) as $score }
    return { $d.slug, $d.title }
    order { $score desc }
    limit 3
}

query rrf_two_vectors($q1: Vector(4), $q2: Vector(4)) {
    match { let $all = { match { $d: Doc } return { $d } }, from rrf(nearest($all, $d.embedding, $q1, k: 3), nearest($all, $d.embedding, $q2, k: 3), k: 60) as $score, $d: Doc }
    return { $d.slug, $d.title }
    order { $score desc }
    limit 3
}
