query text_search($q: String) {
    match { $d: Doc }
    where search($d.title, $q)
    return { $d.slug, $d.title }
}

query fuzzy_search($q: String) {
    match { $d: Doc }
    where fuzzy($d.title, $q, max_edits: 2)
    return { $d.slug, $d.title }
}

query phrase_search($q: String) {
    match { $d: Doc }
    where match_text($d.body, $q)
    return { $d.slug, $d.title }
}

query vector_search($q: Vector(4)) {
    match { from nearest({ match { $d: Doc } return { $d } }, $d.embedding, $q, k: 3) }
    return { $d.slug, $d.title }
    order { $distance }
    limit 3
}

query bm25_search($q: String) {
    match { from bm25({ match { $d: Doc } return { $d } }, $d.title, $q) }
    return { $d.slug, $d.title }
    order { $score desc }
    limit 3
}

query hybrid_search($vq: Vector(4), $tq: String) {
    match { let $all = { match { $d: Doc } return { $d } }, from rrf(nearest($all, $d.embedding, $vq, k: 3), bm25($all, $d.title, $tq), k: 60), $d: Doc }
    return { $d.slug, $d.title }
    order { $score desc }
    limit 3
}

query rrf_two_fts($q: String) {
    match { let $all = { match { $d: Doc } return { $d } }, from rrf(bm25($all, $d.title, $q), bm25($all, $d.body, $q), k: 60), $d: Doc }
    return { $d.slug, $d.title }
    order { $score desc }
    limit 3
}

query rrf_two_vectors($q1: Vector(4), $q2: Vector(4)) {
    match { let $all = { match { $d: Doc } return { $d } }, from rrf(nearest($all, $d.embedding, $q1, k: 3), nearest($all, $d.embedding, $q2, k: 3), k: 60), $d: Doc }
    return { $d.slug, $d.title }
    order { $score desc }
    limit 3
}
