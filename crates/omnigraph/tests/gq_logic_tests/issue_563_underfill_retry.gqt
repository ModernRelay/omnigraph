{"edge":"ChunkOfArtifact","from":"chunk-11","to":"art-0","data":{"id":"e-11","label":"of"}}

--- query
query recall($q: String) {
    match {
        $c: Chunk
        $c chunkOfArtifact $a
        search($c.text, $q)
    }
    return { $c.slug, $a.slug }
    order { bm25($c.text, $q) }
    limit 2
}

--- params
{"q": "needle"}

--- expect ordered
{"c.slug": "chunk-08", "a.slug": "art-0"}
{"c.slug": "chunk-09", "a.slug": "art-0"}
