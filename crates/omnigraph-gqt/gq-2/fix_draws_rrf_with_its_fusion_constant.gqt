# issue: none
# notes: GQ 2 `rrf` with its fusion constant written as a third argument, and `rrf` over a binding only a triple
# notes: introduces: `lint --fix` draws each with `from rrf(…, k: <constant>)` over the ranked type, the binding's type
# notes: read from the edge's end, and the rewrite answers as GQ 2 did. The hand rewrite is
# notes: crates/omnigraph-gqt/cases/fix_draws_rrf_with_its_fusion_constant.gqt.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    body: String @index
    emb: Vector(2)
}
node Topic {
    name: String @key
}
edge About: Doc -> Topic

--- seed
{"type":"Doc","data":{"slug":"d1","body":"graph engine","emb":[1.0,0.0]}}
{"type":"Doc","data":{"slug":"d2","body":"graph","emb":[0.0,1.0]}}
{"type":"Topic","data":{"name":"t"}}
{"edge":"About","from":"d1","to":"t"}
{"edge":"About","from":"d2","to":"t"}

--- query
query constant($q: Vector(2)) {
  match {
    $d: Doc
  }
  return { $d.slug }
  order { rrf(nearest($d.emb, $q), bm25($d.body, "graph"), 60) }
  limit 2
}

--- params
{"q": [1.0, 0.0]}

--- expect unordered
{"d.slug":"d1"}
{"d.slug":"d2"}

--- expect shape
d.slug: String

--- query
query through_a_triple($q: Vector(2)) {
  match {
    $t: Topic
    $d about $t
  }
  return { $d.slug }
  order { rrf(nearest($d.emb, $q), bm25($d.body, "graph")) }
  limit 2
}

--- params
{"q": [1.0, 0.0]}

--- expect unordered
{"d.slug":"d1"}
{"d.slug":"d2"}

--- expect shape
d.slug: String
