# issue: none
# notes: GQ 2 text whose blocks hold only filters, or only re-mention the outer binding: each block tests the
# notes: row it is written on. `lint --fix` writes the scalar the block folds to (`exists` to `coalesce(φ, false)`,
# notes: `count` to `if(…, 1, 0)`, `sum` to the value as `F64`), and its rewrite answers as GQ 2 did. The hand
# notes: rewrite is crates/omnigraph-gqt/cases/fix_folds_a_block_holding_only_filters.gqt.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Tag {
    name: String @key
    count: I32?
}

--- seed
{"type":"Tag","data":{"name":"a","count":5}}
{"type":"Tag","data":{"name":"b","count":1}}
{"type":"Tag","data":{"name":"c"}}

--- query
query counted() {
  match {
    $t: Tag
    count { $t.count > 2 } != 0
  }
  return { $t.name }
}

--- expect unordered
{"t.name":"a"}

--- expect shape
t.name: String

--- query
query existing() {
  match {
    $t: Tag
    exists { $t.count > 2 }
  }
  return { $t.name }
}

--- expect unordered
{"t.name":"a"}

--- expect shape
t.name: String

--- query
query summed() {
  match {
    $t: Tag
    sum($t.count) { $t.count > 0 } > 1
  }
  return { $t.name }
}

--- expect unordered
{"t.name":"a"}

--- expect shape
t.name: String

--- query
query rementioned() {
  match {
    $t: Tag
    count { $t: Tag { name: "b" } } > 0
  }
  return { $t.name }
}

--- expect unordered
{"t.name":"b"}

--- expect shape
t.name: String
