# issue: 788
# red_on: 2026-10-09, upstream main: a search-led aggregate planned no Sort at all, so the groups came back in the Aggregate's own order whatever keys followed bm25() or rrf().
# notes: The leading search function selects the population an aggregate reads and does not order the groups; the keys after it order the groups, then every group key ascending (RFC 0047 §One total order), so the order is total and `expect ordered` holds.
# notes: x has 1 doc, y has 2; the n desc / n asc pair is red whatever order the Aggregate emits groups in.
# notes: The fused steps' second arm repeats the term, since identical arms are a type error; both arms select every Doc.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    kind: String
    text: String @index
}

--- seed
{"type":"Doc","data":{"slug":"a","kind":"x","text":"needle"}}
{"type":"Doc","data":{"slug":"b","kind":"y","text":"needle"}}
{"type":"Doc","data":{"slug":"c","kind":"y","text":"needle"}}

--- query
set engine = v2;
query largest_group($t: String) {
    match { let $pop = { match { $d: Doc } return { $d } }, from bm25($pop, $d.text, $t) as $score }
    return { $d.kind, count($d) as n }
    order { n desc }
    limit 1
}

--- params
{"t": "needle"}

--- expect ordered
{"d.kind":"y","n":2}

--- expect shape
d.kind: String
n: I64

--- query
set engine = v2;
query smallest_group($t: String) {
    match { let $pop = { match { $d: Doc } return { $d } }, from bm25($pop, $d.text, $t) as $score }
    return { $d.kind, count($d) as n }
    order { n asc }
    limit 1
}

--- params
{"t": "needle"}

--- expect ordered
{"d.kind":"x","n":1}

--- expect shape
d.kind: String
n: I64

--- query
set engine = v2;
query every_group_ordered($t: String) {
    match { let $pop = { match { $d: Doc } return { $d } }, from bm25($pop, $d.text, $t) as $score }
    return { $d.kind, count($d) as n }
    order { n desc }
    limit 10
}

--- params
{"t": "needle"}

--- expect ordered
{"d.kind":"y","n":2}
{"d.kind":"x","n":1}

--- expect shape
d.kind: String
n: I64

--- query
set engine = v2;
query fused_largest_group($t: String) {
    match { let $all = { match { $d: Doc } return { $d } }, from rrf(bm25($all, $d.text, $t), bm25($all, $d.text, "needle needle"), k: 60) as $score, $d: Doc }
    return { $d.kind, count($d) as n }
    order { n desc }
    limit 1
}

--- params
{"t": "needle"}

--- expect ordered
{"d.kind":"y","n":2}

--- expect shape
d.kind: String
n: I64

--- query
set engine = v2;
query fused_smallest_group($t: String) {
    match { let $all = { match { $d: Doc } return { $d } }, from rrf(bm25($all, $d.text, $t), bm25($all, $d.text, "needle needle"), k: 60) as $score, $d: Doc }
    return { $d.kind, count($d) as n }
    order { n asc }
    limit 1
}

--- params
{"t": "needle"}

--- expect ordered
{"d.kind":"x","n":1}

--- expect shape
d.kind: String
n: I64
