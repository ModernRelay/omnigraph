# issue: none
# notes: Keyed twin of unkeyed_edge_dup_three_way_merge.gqt: repeated pairs upsert.
# notes: Both branches add the same self-loop; merge, source deletion and restart keep one per pair.
# notes: main's independent Person insert must also survive.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    name: String @key
}
edge Knows: Person -> Person {
    @key(@src, @dst)
}

--- seed
{"type": "Person", "data": {"name": "Alice"}}
{"type": "Person", "data": {"name": "Bob"}}
{"type": "Person", "data": {"name": "Charlie"}}
{"type": "Person", "data": {"name": "Diana"}}
{"edge": "Knows", "from": "Alice", "to": "Bob"}
{"edge": "Knows", "from": "Alice", "to": "Charlie"}
{"edge": "Knows", "from": "Bob", "to": "Diana"}

--- mutate
branch create b0

--- expect ok

--- mutate branch: main
query add_loop_on_main() { insert Knows { from: "Diana", to: "Diana" } }

--- expect affected: nodes=0 edges=1

--- mutate branch: b0
query add_loop_on_branch() { insert Knows { from: "Diana", to: "Diana" } }

--- expect affected: nodes=0 edges=1

--- mutate branch: b0
query upsert_branch_loop() { insert Knows { from: "Diana", to: "Diana" } }

--- expect affected: nodes=0 edges=1

--- mutate branch: b0
query upsert_inherited_edge() { insert Knows { from: "Alice", to: "Bob" } }

--- expect affected: nodes=0 edges=1

--- mutate branch: main
query add_person_on_main() { insert Person { name: "Eve" } }

--- expect affected: nodes=1 edges=0

--- query branch: b0
query edges() {
    match {
        $p: Person
        $p $e:knows $q
    }
    return { $p.name, $q.name }
}

--- expect unordered
{"p.name": "Alice", "q.name": "Bob"}
{"p.name": "Alice", "q.name": "Charlie"}
{"p.name": "Bob", "q.name": "Diana"}
{"p.name": "Diana", "q.name": "Diana"}

--- expect shape
p.name: String
q.name: String

--- mutate
branch merge b0

--- expect ok

--- query branch: main
query edges() {
    match {
        $p: Person
        $p $e:knows $q
    }
    return { $p.name, $q.name }
}

--- expect unordered
{"p.name": "Alice", "q.name": "Bob"}
{"p.name": "Alice", "q.name": "Charlie"}
{"p.name": "Bob", "q.name": "Diana"}
{"p.name": "Diana", "q.name": "Diana"}

--- expect shape
p.name: String
q.name: String

--- query branch: main
query people() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "Alice"}
{"p.name": "Bob"}
{"p.name": "Charlie"}
{"p.name": "Diana"}
{"p.name": "Eve"}

--- expect shape
p.name: String

--- mutate
branch delete b0

--- expect ok

--- restart

--- query branch: main
query edge_count() {
    match {
        $p: Person
        $p $e:knows $q
    }
    return { count($q.name) as n }
}

--- expect unordered
{"n": 4}

--- expect shape
n: I64
