# issue: none
# notes: An insert and an update of the same key in one mutation are two staged batches until the last-write-wins fold; the update carries the pending row's Blob, so the payload counts twice as input.
# notes: The 2,115-byte payload reaches 4,230 at write_max_bytes = 4093 and is refused as `materialized blob payload bytes` before any write; the table stays empty.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Doc {
    slug: String @key
    content: Blob?
    note: String
}

--- seed

--- mutate
set write_max_bytes = 4093;
query insert_then_update($payload: Blob) {
    insert Doc { slug: "twice", content: $payload, note: "n" }
    update Doc set { note: "u" } where slug = "twice"
}

--- params
{"payload": "base64:"}

--- expect error: materialized blob payload bytes

--- query
query docs() {
    match { $d: Doc }
    return { $d.slug, $d.note }
}

--- expect unordered

--- expect shape
d.slug: String
d.note: String
