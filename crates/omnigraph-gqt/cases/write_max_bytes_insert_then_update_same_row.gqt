# issue: none
# notes: Two updates of one row in one group are two staged versions until the last-write-wins fold; the first assigns the Blob and the second carries the pending row's Blob, so the payload counts twice.
# notes: The 2,115-byte payload reaches 4,230 at write_max_bytes = 4093 and is refused as `materialized blob payload bytes` before any write; the row keeps its note and no Blob.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Doc {
    slug: String @key
    content: Blob?
    note: String
}

--- seed
{"type":"Doc","data":{"slug":"twice","note":"n"}}

--- mutate
set write_max_bytes = 4093;
query assign_then_retitle($payload: Blob) {
    match { $x: Doc } where $x.slug = "twice"
    update $x set { content: $payload }
    update $x set { note: "u" }
}

--- params
{"payload": "base64:"}

--- expect error: materialized blob payload bytes

--- query
query docs() {
    match { $d: Doc }
    return { $d.slug, $d.note }
}

--- expect unordered
{"d.slug":"twice","d.note":"n"}

--- expect shape
d.slug: String
d.note: String
