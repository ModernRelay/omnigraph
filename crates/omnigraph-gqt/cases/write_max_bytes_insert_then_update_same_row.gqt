# issue: none
# notes: An update of a row inserted earlier in the same mutation holds two copies of its Blob while its scan runs: the pending row, and the matched copy the update rewrites. Both count as `materialized blob payload bytes`.
# notes: The 2,115-byte payload reaches 4,230 at write_max_bytes = 4093 and is refused before any write; the table stays empty.
# notes: That is the scan's working set, not the retained image: the rewrite replaces the pending row (issue #925), so at 4230 a second update of the same row again holds two copies, not three, and is admitted.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Doc {
    slug: String @key
    content: Blob?
    note: String
}

--- seed

--- mutate
set write_max_bytes = 4093;
query insert_then_update($payload: Blob) {
    insert Doc { slug: "twice", content: $payload, note: "n" }
    update Doc set { note: "u" } where slug = "twice"
}

--- params
{"payload": "base64:"}

--- expect error: materialized blob payload bytes

--- query
query docs() {
    match { $d: Doc }
    return { $d.slug, $d.note }
}

--- expect unordered

--- expect shape
d.slug: String
d.note: String

--- mutate
set write_max_bytes = 4230;
query insert_then_update_twice($payload: Blob) {
    insert Doc { slug: "twice", content: $payload, note: "n" }
    update Doc set { note: "u" } where slug = "twice"
    update Doc set { note: "v" } where slug = "twice"
}

--- params
{"payload": "base64:"}

--- expect affected: nodes=3 edges=0

--- query
query docs_after_admission() {
    match { $d: Doc }
    return { $d.slug, $d.note }
}

--- expect unordered
{"d.slug": "twice", "d.note": "v"}

--- expect shape
d.slug: String
d.note: String
