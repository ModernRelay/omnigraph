# issue: none
# notes: An update of a row whose Blob an earlier statement of the same write assigned holds two copies of it while its scan runs: the pending row, and the matched copy the update rewrites. Both count as `materialized blob payload bytes`.
# notes: The 2,115-byte payload reaches 4,230 at write_max_bytes = 4093 and is refused before any write; the row keeps its note and no Blob.
# notes: That is the scan's working set, not the retained image: each rewrite replaces the pending version, so at 4230 a third statement again holds two copies, not three, and is admitted.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Doc {
    slug: String @key
    content: Blob?
    note: String
}

--- seed
{"type":"Doc","data":{"slug":"twice","note":"n"}}

--- mutate
set write_max_bytes = 4093;
query assign_then_retitle($payload: Blob) {
    match { $x: Doc } where $x.slug = "twice"
    update $x set { content: $payload }
    update $x set { note: "u" }
}

--- params
{"payload": "base64:"}

--- expect error: materialized blob payload bytes

--- query
query docs() {
    match { $d: Doc }
    return { $d.slug, $d.note }
}

--- expect unordered
{"d.slug":"twice","d.note":"n"}

--- expect shape
d.slug: String
d.note: String

--- mutate
set write_max_bytes = 4230;
query assign_then_retitle_twice($payload: Blob) {
    match { $x: Doc } where $x.slug = "twice"
    update $x set { content: $payload }
    update $x set { note: "u" }
    update $x set { note: "v" }
}

--- params
{"payload": "base64:"}

--- expect affected: nodes=3 edges=0

--- query
query docs_after_admission() {
    match { $d: Doc }
    return { $d.slug, $d.note }
}

--- expect unordered
{"d.slug": "twice", "d.note": "v"}

--- expect shape
d.slug: String
d.note: String
