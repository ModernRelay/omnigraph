# issue: none
# notes: A child write that matches nothing answers its counts and no commit, so it binds nothing and creates
# notes: no snapshot; the next child on the same root still extends it, and the recorded target is unchanged.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}

--- mutate
query root_bob() as unattached branch {
    insert Person { name: "bob", age: 41 }
}

--- expect affected: nodes=1 edges=0

--- bind commit $r

--- mutate
query noop_child() as unattached branch on "${r}" {
    update Person set { age: 99 } where name = "nobody"
}

--- expect affected: nodes=0 edges=0

--- mutate
query child_carol() as unattached branch on "${r}" {
    insert Person { name: "carol", age: 52 }
}

--- expect affected: nodes=1 edges=0

--- bind commit $c

--- query snapshot: $c
query names_at_child() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "bob"}
{"p.name": "carol"}

--- expect shape
p.name: String

--- query
query names_on_main() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}

--- expect shape
p.name: String
