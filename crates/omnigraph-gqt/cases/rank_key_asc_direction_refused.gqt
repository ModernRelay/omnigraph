# issue: none
# red_on: 2026-10-09, upstream main: both engines accepted `asc` on a leading bm25()/rrf() key and returned most relevant first; only nearest refused a modifier.
# notes: `asc` written on a leading `bm25`/`rrf` order key contradicts the fixed descending-relevance rank, so the type checker
# notes: refuses it (T54; the parser refuses any modifier on `nearest`, which no case can pin since the harness parses every step
# notes: up front). The bare key is the control (a outranks b: equal length, tf 2 vs 1); `desc` is redundant and stays accepted.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    text: String @index
    embedding: Vector(2)
}

--- seed
{"type":"Doc","data":{"slug":"a","text":"needle needle","embedding":[0.0,0.0]}}
{"type":"Doc","data":{"slug":"b","text":"needle hay","embedding":[1.0,0.0]}}

--- query
query bm25_bare() {
    match { from bm25({ match { $d: Doc } return { $d } }, $d.text, "needle") }
    return { $d.slug }
    order { $score desc }
    limit 2
}

--- expect ordered
{"d.slug": "a"}
{"d.slug": "b"}

--- expect shape
d.slug: String

--- query
query bm25_asc() {
    match { $d: Doc }
    return { $d.slug }
    order { bm25($d.text, "needle") asc }
    limit 2
}

--- expect error: T65: `bm25` is a relation function; a ranking is drawn with `from`, and its score is a column

--- query
query rrf_asc($v: Vector(2)) {
    match { $d: Doc }
    return { $d.slug }
    order { rrf(nearest($d.embedding, $v), bm25($d.text, "needle")) asc }
    limit 2
}

--- params
{"v": [0.0, 0.0]}

--- expect error: T65: `rrf` is a relation function; a ranking is drawn with `from`, and its score is a column

--- query
query rrf_desc($v: Vector(2)) {
    match { let $all = { match { $d: Doc } return { $d } }  from rrf(nearest($all, $d.embedding, $v, k: 2), bm25($all, $d.text, "needle"), k: 60) $d: Doc }
    return { $d.slug }
    order { $score desc }
    limit 2
}

--- params
{"v": [0.0, 0.0]}

--- expect ordered
{"d.slug": "a"}
{"d.slug": "b"}

--- expect shape
d.slug: String
