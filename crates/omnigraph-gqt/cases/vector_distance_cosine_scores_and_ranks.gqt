--- mutate
query add($s: String, $e: Vector(4)) { insert Doc { slug: $s, embedding: $e } }

--- params
{"s": "g", "e": [0.0, 0.0, 4.0, 0.0]}

--- expect affected: nodes=1 edges=0

--- mutate
