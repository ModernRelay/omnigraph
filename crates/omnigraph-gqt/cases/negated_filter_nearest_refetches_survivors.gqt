# issue: none
# notes: `not { $d.name starts_with "doc-00" }` over 20 docs, limit 4: a `not`
# notes: block is an anti-join above the scan, never a pushed filter, and it
# notes: drops rows 0..9. The first pass (0..3) loses every row, short; the x4
# notes: rerun asks for 16 of the 20 live rows (16 < 20, a wider rung) and holds
# notes: survivors 10..15 (6 > 4): d010, d011, d012, d013.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    n: I64 @index
    name: String @index
    embedding: Vector(4) @index
}

edge Knows: Doc -> Doc {
}

--- seed
{"type":"Doc","data":{"slug":"d000","n":0,"name":"doc-000","embedding":[0.0,0.0,0.0,0.0]}}
