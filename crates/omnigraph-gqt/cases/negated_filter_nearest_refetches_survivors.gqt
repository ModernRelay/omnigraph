--- query
query scenario($q: Vector(4)) {
    match {
        $d: Doc
        not { $d.name starts_with "doc-00" }
    }
    return { $d.slug }
    order { nearest($d.embedding, $q) }
    limit 4
}

--- params
{"q": [-0.3, 0.0, 0.0, 0.0]}

--- expect ordered
{"d.slug":"d010"}
{"d.slug":"d011"}
{"d.slug":"d012"}
{"d.slug":"d013"}

--- expect shape
d.slug: String
