--- expect same as reference


--- query
query sixteen_arms() {
    match {
      let $all = { match { $d: Doc } return { $d } },
      from rrf(nearest($all, $d.embedding, [0.0, 0.0], k: 2), nearest($all, $d.embedding, [1.0, 0.0], k: 2), nearest($all, $d.embedding, [2.0, 0.0], k: 2), nearest($all, $d.embedding, [3.0, 0.0], k: 2), nearest($all, $d.embedding, [4.0, 0.0], k: 2), nearest($all, $d.embedding, [5.0, 0.0], k: 2), nearest($all, $d.embedding, [6.0, 0.0], k: 2), nearest($all, $d.embedding, [7.0, 0.0], k: 2), nearest($all, $d.embedding, [8.0, 0.0], k: 2), nearest($all, $d.embedding, [9.0, 0.0], k: 2), nearest($all, $d.embedding, [10.0, 0.0], k: 2), nearest($all, $d.embedding, [11.0, 0.0], k: 2), nearest($all, $d.embedding, [12.0, 0.0], k: 2), nearest($all, $d.embedding, [13.0, 0.0], k: 2), nearest($all, $d.embedding, [14.0, 0.0], k: 2), nearest($all, $d.embedding, [15.0, 0.0], k: 2)) as $s,
    }
    return { $d.slug }
    order { $s desc, $d.slug }
}

--- expect ordered
{"d.slug":"d1"}
{"d.slug":"d2"}
{"d.slug":"d0"}

--- expect shape
d.slug: String

--- expect same as reference


--- query
query seventeen_arms() {
    match {
      let $all = { match { $d: Doc } return { $d } },
      from rrf(nearest($all, $d.embedding, [0.0, 0.0], k: 2), nearest($all, $d.embedding, [1.0, 0.0], k: 2), nearest($all, $d.embedding, [2.0, 0.0], k: 2), nearest($all, $d.embedding, [3.0, 0.0], k: 2), nearest($all, $d.embedding, [4.0, 0.0], k: 2), nearest($all, $d.embedding, [5.0, 0.0], k: 2), nearest($all, $d.embedding, [6.0, 0.0], k: 2), nearest($all, $d.embedding, [7.0, 0.0], k: 2), nearest($all, $d.embedding, [8.0, 0.0], k: 2), nearest($all, $d.embedding, [9.0, 0.0], k: 2), nearest($all, $d.embedding, [10.0, 0.0], k: 2), nearest($all, $d.embedding, [11.0, 0.0], k: 2), nearest($all, $d.embedding, [12.0, 0.0], k: 2), nearest($all, $d.embedding, [13.0, 0.0], k: 2), nearest($all, $d.embedding, [14.0, 0.0], k: 2), nearest($all, $d.embedding, [15.0, 0.0], k: 2), nearest($all, $d.embedding, [16.0, 0.0], k: 2)) as $s,
    }
    return { $d.slug }
    order { $s desc, $d.slug }
}

--- expect error: type error: T75: `rrf` takes 2 to 16 arms, got 17
