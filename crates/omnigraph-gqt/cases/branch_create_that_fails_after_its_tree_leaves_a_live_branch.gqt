# issue: none
# notes: A branch exists from the moment its entry in main's catalog is durable. A create that
# notes: fails after it has also written the tree only loses its acknowledgement: the branch is
# notes: listed, written and read like any other, before and after a reopen.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}

--- seam
at: branch_create.post_tree
occurrence: 1
action: fail
scope: next_step

--- mutate
branch create b

--- expect error: injected failpoint triggered: branch_create.post_tree

--- query
branch list

--- expect unordered
{"name": "b"}
{"name": "main"}

--- expect shape
name: String

--- mutate branch: b
query write_on_b() {
    insert Person { name: "bob", age: 41 }
}

--- expect affected: nodes=1 edges=0

--- restart

--- query branch: b
query names_on_b() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "bob"}

--- expect shape
p.name: String

--- query
query names_on_main() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}

--- expect shape
p.name: String
