# issue: none
# notes: Only d003, d006 and d009 have edges; both RRF arms rank them in that order.
# notes: Keep 10 docs: 3/10 eligible sources exceeds the 10% gate threshold; the unfiltered top two have no edge.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    n: I64 @index
    name: String @index
    text: String @index
    embedding: Vector(4) @index
}

edge Knows: Doc -> Doc {
}

