--- query
query nearest_and_text_with_edges($q: Vector(4), $text: String) {
    match {
        $d: Doc
        $d knows $t
    }
    return { $d.slug }
    order { rrf(nearest($d.embedding, $q), bm25($d.text, $text)) }
    limit 2
}

--- params
{"q": [-0.3, 0.0, 0.0, 0.0], "text": "needle"}

--- expect unordered
{"d.slug":"d003"}
{"d.slug":"d006"}

--- expect shape
d.slug: String
