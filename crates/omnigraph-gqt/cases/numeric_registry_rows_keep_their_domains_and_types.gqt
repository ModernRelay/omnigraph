--- query
query exact_values() {
    match { $x: N } where $x.k = "pos"
    return { sqrt(16) as s, exp(0) as e, ln(1) as l, log10(1000) as t, power(2, 10) as p, power(4, -1) as q, power(-8, 3) as c }
}

--- expect unordered
