--- query
query abs_of_the_smallest_i32() {
    match { $x: N } where $x.k = "min"
    return { abs($x.i) as a }
}

--- expect error: E1

--- query
query abs_of_the_smallest_i64() {
    match { $x: N } where $x.k = "min"
    return { abs($x.l) as a }
}

--- expect error: E1

--- query
query abs_of_a_float_never_overflows() {
    match { $x: N } where $x.k = "min"
    return { abs($x.f) as a, abs($x.g) as b }
}

--- expect unordered
{"a":1500000000000000,"b":10000000000}

--- expect shape
a: F64
b: F32

--- query
query integer_round_leaves_its_type() {
    match { $x: N } where $x.k = "big"
    return { round($x.i, digits: -1) as r }
}

--- expect error: E1

--- query
query float_round_overflows() {
    match { $x: N } where $x.k = "huge"
    return { round($x.f, digits: 1) as r }
}

--- expect error: E3

--- query
query round_digits_outside_i32() {
    match { $x: N } where $x.k = "pos"
    return { round($x.f, digits: 3000000000) as r }
}

--- expect error: E5

--- query
query sqrt_of_a_negative() {
    match { $x: N } return { sqrt($x.f) as r }
}

--- expect error: E5

--- query
query ln_of_zero() {
    match { $x: N } where $x.k = "negzero"
    return { ln($x.l) as r }
}

--- expect error: E5

--- query
query ln_of_negative_zero() {
    match { $x: N } where $x.k = "negzero"
    return { ln($x.f) as r }
}

--- expect error: E5

--- query
query log10_of_a_negative() {
    match { $x: N } where $x.k = "neg"
    return { log10($x.i) as r }
}

--- expect error: E5

--- query
query exp_overflows() {
    match { $x: N } where $x.k = "pos"
    return { exp($x.l) as r }
}

--- expect error: E3

--- query
query power_overflows() {
    match { $x: N } where $x.k = "huge"
    return { power($x.f, 2) as r }
}

--- expect error: E3

--- query
query negative_base_to_a_fractional_power() {
    match { $x: N } where $x.k = "neg"
    return { power($x.f, 0.5) as r }
}

--- expect error: E5

--- query
query unguarded_root_in_where() {
    match { $x: N } where sqrt($x.f) > 1.0
    return { $x.k }
}

--- expect error: E5

--- query
query guarded_root_in_where() {
    match { $x: N } where $x.f > 0 and sqrt($x.f) > 1.0
    return { $x.k }
}

--- expect unordered
{"x.k":"big"}
{"x.k":"frac"}
{"x.k":"huge"}
{"x.k":"pos"}

--- expect shape
x.k: String

--- query
query guarded_root_inside_if() {
    match { $x: N } where $x.k != "huge"
    return { $x.k, if($x.f >= 0, sqrt($x.f), 0.0) as r }
}

--- expect unordered
{"r":0,"x.k":"min"}
{"r":0,"x.k":"neg"}
{"r":0,"x.k":"negzero"}
{"r":0,"x.k":"nulls"}
{"r":0.707106781187,"x.k":"half"}
{"r":1.581138830084,"x.k":"pos"}
{"r":1.63554272338,"x.k":"frac"}
{"r":38729833.462074168026,"x.k":"big"}

