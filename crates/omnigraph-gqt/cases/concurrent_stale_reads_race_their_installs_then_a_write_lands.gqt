# issue: none
# notes: r1 and r2 park at their manifest listing holding the pre-publish coordinator; w1 publishes and installs; r2 then r1 refresh clones and install in turn. The later update and the final rows pin that no late install left an older state bound.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}

--- concurrent
w1: query add_bob() { insert Person { name: "bob", age: 31 } }
r1: query all() { match { $p: Person } return { $p.name } }
r2: query all() { match { $p: Person } return { $p.name } }
order: w1 park put __manifest/_versions/, r1 start, r1 park head __manifest/, r2 start, r2 park head __manifest/, w1 put __manifest/_versions/, w1, r2 head __manifest/, r2, r1 head __manifest/, r1
--- expect
w1: ok
r1: ok
r2: ok

--- mutate
query age_alice() { update Person set { age: 99 } where name = "alice" }
--- expect ok

--- query
query people() { match { $p: Person } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"alice","p.age":99}
{"p.name":"bob","p.age":31}
--- expect shape
p.name: String
p.age: I32
