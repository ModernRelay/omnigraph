# issue: none
# notes: Ordered expectations use a total user key, or explicit identities for every binding
# notes: when the documented identity tie-break determines a page boundary.
# notes: Rank groups the rows; name orders ties explicitly.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    rank: I64
}

--- seed
{"type":"Person","data":{"name":"alice","rank":2}}
{"type":"Person","data":{"name":"bob","rank":1}}
{"type":"Person","data":{"name":"carol","rank":2}}
{"type":"Person","data":{"name":"dave","rank":1}}

--- query
query ranked() {
    match { $p: Person }
    return { $p.name, $p.rank }
    order { $p.rank asc, $p.name asc }
}

--- expect ordered
{"p.name": "bob", "p.rank": 1}
{"p.name": "dave", "p.rank": 1}
{"p.name": "alice", "p.rank": 2}
{"p.name": "carol", "p.rank": 2}

--- expect shape
p.name: String
p.rank: I64
