# issue: none
# notes: Misdirect the second storage.put under __recovery/*: the confirm put, after the arm put.
# notes: Reopen serves both committed rows after a foreign-named confirm put.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0]

--- schema
node Person {
    name: String @key
}

--- seed
{"type":"Person","data":{"name":"alice"}}

--- seam
at: storage.put
subject: "__recovery/*"
occurrence: 2
action: misdirect
scope: next_step

--- mutate
query add_row() {
    insert Person { name: "bob" }
}

--- expect affected: nodes=1 edges=0

--- restart

--- query
query all() { match { $p: Person } return { $p.name } }

--- expect unordered
{"p.name":"alice"}
{"p.name":"bob"}

--- expect shape
p.name: String
