--- mutate
query add($s: String, $e: Vector(4)) { replace Doc { slug: $s, embedding: $e } }

--- params
{"s": "g", "e": [0.0, 0.0, 3.0, 0.0]}

--- expect affected: nodes=1 edges=0

--- mutate
query add($s: String, $e: Vector(4)) { replace Doc { slug: $s, embedding: $e } }

--- params
{"s": "h", "e": [-2.0, 0.0, 0.0, 0.0]}

