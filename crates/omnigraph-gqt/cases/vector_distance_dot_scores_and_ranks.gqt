# issue: none
# notes: A `dot` field (`Vector(n, distance = "dot")`) scores and ranks by
# notes: `1 - dot(x, q)`, ascending, which can be negative, under `distance` and
# notes: `nearest` alike, and a returned distance is always that exact value:
# notes: `Doc` is indexed (an IVF_FLAT built for dot), `Raw` carries no index, and
# notes: the two rows inserted after the index was built leave `Doc` partially
# notes: indexed. Every state answers the same rows. A zero vector is in the
# notes: domain of `dot` and scores 1.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    embedding: Vector(4, distance = "dot")? @index
}
node Raw {
    slug: String @key
    embedding: Vector(4, distance = "dot")?
}

--- seed
{"type":"Doc","data":{"slug":"a","embedding":[1.0,1.0,1.0,1.0]}}
{"type":"Doc","data":{"slug":"b","embedding":[1.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"c","embedding":[0.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d","embedding":[-1.0,-1.0,-1.0,-1.0]}}
{"type":"Doc","data":{"slug":"e","embedding":[2.0,2.0,2.0,2.0]}}
{"type":"Doc","data":{"slug":"f"}}
{"type":"Raw","data":{"slug":"a","embedding":[1.0,1.0,1.0,1.0]}}
{"type":"Raw","data":{"slug":"b","embedding":[1.0,0.0,0.0,0.0]}}
{"type":"Raw","data":{"slug":"c","embedding":[0.0,0.0,0.0,0.0]}}
{"type":"Raw","data":{"slug":"d","embedding":[-1.0,-1.0,-1.0,-1.0]}}
{"type":"Raw","data":{"slug":"e","embedding":[2.0,2.0,2.0,2.0]}}
{"type":"Raw","data":{"slug":"f"}}

--- query
query scored_indexed($q: Vector(4)) {
    match {
        let $pop = { match { $x: Doc } return { $x } },
        from distance($pop, $x.embedding, $q) as $distance,
    }
    return { $x.slug, $distance }
    order { $distance }
}

--- params
{"q": [1.0, 1.0, 1.0, 1.0]}

--- expect ordered
{"distance":-7.0,"x.slug":"e"}
{"distance":-3.0,"x.slug":"a"}
{"distance":0.0,"x.slug":"b"}
{"distance":1.0,"x.slug":"c"}
{"distance":5.0,"x.slug":"d"}

--- expect shape
x.slug: String
distance: F32

--- query
query nearest_indexed($q: Vector(4)) {
    match {
        let $pop = { match { $x: Doc } return { $x } },
        from nearest($pop, $x.embedding, $q, k: 5) as $distance,
    }
    return { $x.slug, $distance }
    order { $distance }
}

--- params
{"q": [1.0, 1.0, 1.0, 1.0]}

--- expect ordered
{"distance":-7.0,"x.slug":"e"}
{"distance":-3.0,"x.slug":"a"}
{"distance":0.0,"x.slug":"b"}
{"distance":1.0,"x.slug":"c"}
{"distance":5.0,"x.slug":"d"}

--- expect shape
x.slug: String
distance: F32

--- query
query nearest_indexed_window($q: Vector(4)) {
    match {
        let $pop = { match { $x: Doc } return { $x } },
        from nearest($pop, $x.embedding, $q, k: 2) as $distance,
    }
    return { $x.slug, $distance }
    order { $distance }
}

--- params
{"q": [1.0, 1.0, 1.0, 1.0]}

--- expect ordered
{"distance":-7.0,"x.slug":"e"}
{"distance":-3.0,"x.slug":"a"}

--- expect shape
