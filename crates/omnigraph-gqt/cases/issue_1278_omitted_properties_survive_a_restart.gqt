# issue: 1278
# red_on: c2e13c80a55c3d29a731ea62b61a168c27741a57: the keyed insert nulls `n` and `tags`, so the read after the restart returns only slug and title.
# notes: The values a keyed insert keeps for the properties it omits are durable: a restart reads them back. The other
# notes: halves are in issue_1278_keyed_insert_keeps_omitted_properties.gqt.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0]

--- schema
node Doc {
    slug: String @key
    title: String
    n: I64?
    tags: [String]?
}

--- seed
{"type":"Doc","data":{"slug":"d1","title":"one","n":7,"tags":["a"]}}

--- mutate
query retitle() {
    insert Doc { slug: "d1", title: "new" }
}

--- expect affected: nodes=1 edges=0

--- restart

--- query
query d1() {
    match { $d: Doc }
    return { $d.slug, $d.title, $d.n, $d.tags }
}

--- expect unordered
{"d.slug": "d1", "d.title": "new", "d.n": 7, "d.tags": ["a"]}

--- expect shape
d.slug: String
d.title: String
d.n: I64?
d.tags: [String]?
