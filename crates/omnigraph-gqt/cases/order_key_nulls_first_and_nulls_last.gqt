p.age: I32?

--- query
query age_nulls_last_tie_rule() {
    match { $p: Person }
    return { $p.age }
    order { $p.age nulls last }
}

--- expect ordered
{"p.age":25}
{"p.age":30}
{"p.age":30}
{"p.age":41}
{}
{}

--- expect shape
p.age: I32?

--- query
query score_desc_nulls_first_limit() {
    match { $p: Person }
    return { $p.name, $p.score }
    order { $p.score desc nulls first, $p.name }
    limit 3
}

--- expect ordered
{"p.name":"cyd"}
{"p.name":"fay"}
{"p.name":"eve","p.score":3.25}

--- expect shape
p.name: String
p.score: F64?

--- query
query score_nulls_last_limit() {
    match { $p: Person }
    return { $p.name, $p.score }
    order { $p.score nulls last, $p.name }
    limit 2
}

--- expect ordered
{"p.name":"bob","p.score":-2}
{"p.name":"dan","p.score":0}

--- expect shape
p.name: String
p.score: F64?

--- query
query score_desc_limit_past_the_values() {
    match { $p: Person }
    return { $p.name, $p.score }
    order { $p.score desc, $p.name desc }
    limit 5
}

--- expect ordered
{"p.name":"eve","p.score":3.25}
{"p.name":"ann","p.score":1.5}
{"p.name":"dan","p.score":0}
{"p.name":"bob","p.score":-2}
{"p.name":"fay"}

--- expect shape
p.name: String
p.score: F64?

--- query
query city_nulls_last() {
    match { $p: Person }
    return { $p.name, $p.city }
    order { $p.city nulls last, $p.name desc }
}

--- expect ordered
{"p.city":"Oslo","p.name":"dan"}
{"p.city":"Oslo","p.name":"ann"}
{"p.city":"Rome","p.name":"cyd"}
{"p.name":"fay"}
{"p.name":"eve"}
{"p.name":"bob"}

--- expect shape
p.name: String
p.city: String?

--- query
query city_desc_nulls_first_limit() {
    match { $p: Person }
    return { $p.name, $p.city }
    order { $p.city desc nulls first, $p.name }
    limit 4
}

--- expect ordered
{"p.name":"bob"}
{"p.name":"eve"}
{"p.name":"fay"}
{"p.city":"Rome","p.name":"cyd"}

--- expect shape
p.name: String
p.city: String?

--- query
query groups_nulls_last_limit() {
    match { $p: Person }
    return { $p.city, count($p) as n }
    order { $p.city nulls last }
    limit 2
}

--- expect unordered
{"n":1,"p.city":"Rome"}
{"n":2,"p.city":"Oslo"}

--- expect shape
p.city: String?
n: I64

--- query
query groups_desc_nulls_first_limit() {
    match { $p: Person }
    return { $p.city, count($p) as n }
    order { $p.city desc nulls first }
    limit 2
}

--- expect unordered
{"n":1,"p.city":"Rome"}
{"n":3}

--- expect shape
p.city: String?
n: I64

--- query
query alias_key_nulls_last() {
    match { $p: Person }
    return { $p.name, $p.age as age }
    order { age desc nulls last, $p.name }
    limit 4
}

--- expect ordered
{"age":41,"p.name":"fay"}
{"age":30,"p.name":"ann"}
{"age":30,"p.name":"cyd"}
{"age":25,"p.name":"dan"}

--- expect shape
p.name: String
age: I32?

--- query
query correlated_youngest_friend_nulls_last() {
    match {
        $p: Person,
        from { match { $f: Person, $p knows $f } return { $f, $f.age as age } order { $f.age nulls last } limit 1 },
    }
    return { $p.name, $f.name as friend, $age }
}

--- expect unordered
{"age":25,"friend":"dan","p.name":"ann"}
{"age":30,"friend":"cyd","p.name":"cyd"}
{"age":41,"friend":"fay","p.name":"dan"}

--- expect shape
p.name: String
friend: String
age: I32?

--- query
query correlated_oldest_friend_nulls_first() {
    match {
        $p: Person,
        from { match { $f: Person, $p knows $f } return { $f, $f.age as age } order { $f.age desc nulls first } limit 1 },
    }
    return { $p.name, $f.name as friend, $age }
}

--- expect unordered
{"age":41,"friend":"fay","p.name":"dan"}
{"friend":"bob","p.name":"ann"}
{"friend":"eve","p.name":"cyd"}

--- expect shape
p.name: String
friend: String
age: I32?
