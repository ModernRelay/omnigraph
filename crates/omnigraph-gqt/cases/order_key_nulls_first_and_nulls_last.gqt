# issue: none
# notes: An order key places its nulls as written: `nulls first` before every non-null value of the
# notes: key, `nulls last` after, whatever the direction; with neither, the fixed value order's
# notes: placement holds, nulls first ascending and last descending. Only that key's nulls move:
# notes: rows whose key is null tie on it and fall to the later keys, then the tie rule. Covered:
# notes: an I32, an F64 and a String key, each direction with each placement, a `limit` cutting
# notes: the placed order, groups cut by a nullable key (group rows take `expect unordered`, so
# notes: the `limit` shows which groups the placement keeps), and a correlated `from` whose own
# notes: `order` and `limit` pick one row per outer row.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    age: I32?
    score: F64?
    city: String? @index
}

edge Knows: Person -> Person

--- seed
{"type":"Person","data":{"name":"ann","age":30,"score":1.5,"city":"Oslo"}}
{"type":"Person","data":{"name":"bob","score":-2.0}}
{"type":"Person","data":{"name":"cyd","age":30,"city":"Rome"}}
{"type":"Person","data":{"name":"dan","age":25,"score":0.0,"city":"Oslo"}}
{"type":"Person","data":{"name":"eve","score":3.25}}
{"type":"Person","data":{"name":"fay","age":41}}
{"edge":"Knows","from":"ann","to":"bob"}
{"edge":"Knows","from":"ann","to":"dan"}
{"edge":"Knows","from":"ann","to":"fay"}
{"edge":"Knows","from":"cyd","to":"eve"}
{"edge":"Knows","from":"cyd","to":"cyd"}
{"edge":"Knows","from":"dan","to":"fay"}

--- query
query age_default() {
    match { $p: Person }
    return { $p.name, $p.age }
    order { $p.age, $p.name }
}

--- expect ordered
{"p.name":"bob"}
{"p.name":"eve"}
{"p.age":25,"p.name":"dan"}
{"p.age":30,"p.name":"ann"}
{"p.age":30,"p.name":"cyd"}
{"p.age":41,"p.name":"fay"}

--- expect shape
p.name: String
p.age: I32?

--- query
query age_nulls_first() {
    match { $p: Person }
    return { $p.name, $p.age }
    order { $p.age nulls first, $p.name }
}

--- expect ordered
{"p.name":"bob"}
{"p.name":"eve"}
{"p.age":25,"p.name":"dan"}
{"p.age":30,"p.name":"ann"}
{"p.age":30,"p.name":"cyd"}
{"p.age":41,"p.name":"fay"}

--- expect shape
p.name: String
p.age: I32?

--- query
query age_nulls_last() {
    match { $p: Person }
    return { $p.name, $p.age }
    order { $p.age nulls last, $p.name }
}

--- expect ordered
{"p.age":25,"p.name":"dan"}
{"p.age":30,"p.name":"ann"}
{"p.age":30,"p.name":"cyd"}
{"p.age":41,"p.name":"fay"}
{"p.name":"bob"}
{"p.name":"eve"}

--- expect shape
p.name: String
p.age: I32?

--- query
query age_desc_default() {
    match { $p: Person }
    return { $p.name, $p.age }
    order { $p.age desc, $p.name }
}

--- expect ordered
{"p.age":41,"p.name":"fay"}
{"p.age":30,"p.name":"ann"}
{"p.age":30,"p.name":"cyd"}
{"p.age":25,"p.name":"dan"}
{"p.name":"bob"}
{"p.name":"eve"}

--- expect shape
p.name: String
p.age: I32?

--- query
query age_desc_nulls_first_names_desc() {
    match { $p: Person }
    return { $p.name, $p.age }
    order { $p.age desc nulls first, $p.name desc }
}

--- expect ordered
{"p.name":"eve"}
{"p.name":"bob"}
{"p.age":41,"p.name":"fay"}
{"p.age":30,"p.name":"cyd"}
{"p.age":30,"p.name":"ann"}
{"p.age":25,"p.name":"dan"}

--- expect shape
p.name: String
p.age: I32?

--- query
query age_desc_nulls_last() {
    match { $p: Person }
    return { $p.name, $p.age }
    order { $p.age desc nulls last, $p.name }
}

--- expect ordered
{"p.age":41,"p.name":"fay"}
{"p.age":30,"p.name":"ann"}
{"p.age":30,"p.name":"cyd"}
{"p.age":25,"p.name":"dan"}
{"p.name":"bob"}
{"p.name":"eve"}

