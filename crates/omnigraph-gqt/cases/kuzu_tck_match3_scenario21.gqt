--- query
query stmt_4() {
    match {
        $a: A { name: "a" }
        $b: A { name: "b" }
        $c: A { name: "c" }
        $x: A
        $a knows $x
        $b knows $x
        $c knows $x
    }
    return { $x.pk, $x.name }
}

--- expect unordered
{"x.pk": 3, "x.name": "d"}
{"x.pk": 4, "x.name": "e"}
