# issue: none
# notes: rrf(nearest, bm25) over 8 docs whose BM25 tf gradient ranks rows in the
# notes: same order as nearest from -0.3: both arms agree, so the fused top-3 is
# notes: rows 0..2 (unordered set: rrf refuses ordered expects).

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    n: I64 @index
    name: String @index
    text: String @index
    embedding: Vector(4) @index
}

edge Knows: Doc -> Doc {
}

--- seed
{"type":"Doc","data":{"slug":"d000","n":0,"name":"doc-000","embedding":[0.0,0.0,0.0,0.0],"text":"needle needle needle needle needle needle needle needle filler"}}
{"type":"Doc","data":{"slug":"d001","n":1,"name":"doc-001","embedding":[1.0,0.0,0.0,0.0],"text":"needle needle needle needle needle needle needle filler"}}
{"type":"Doc","data":{"slug":"d002","n":2,"name":"doc-002","embedding":[2.0,0.0,0.0,0.0],"text":"needle needle needle needle needle needle filler"}}
{"type":"Doc","data":{"slug":"d003","n":3,"name":"doc-003","embedding":[3.0,0.0,0.0,0.0],"text":"needle needle needle needle needle filler"}}
{"type":"Doc","data":{"slug":"d004","n":4,"name":"doc-004","embedding":[4.0,0.0,0.0,0.0],"text":"needle needle needle needle filler"}}
{"type":"Doc","data":{"slug":"d005","n":5,"name":"doc-005","embedding":[5.0,0.0,0.0,0.0],"text":"needle needle needle filler"}}
{"type":"Doc","data":{"slug":"d006","n":6,"name":"doc-006","embedding":[6.0,0.0,0.0,0.0],"text":"needle needle filler"}}
{"type":"Doc","data":{"slug":"d007","n":7,"name":"doc-007","embedding":[7.0,0.0,0.0,0.0],"text":"needle filler"}}

--- query
query fused($q: Vector(4), $t: String) {
    match {
        $d: Doc
    }
    return { $d.slug }
    order { rrf(nearest($d.embedding, $q), bm25($d.text, $t)) }
    limit 3
}

--- params
{"q": [-0.3, 0.0, 0.0, 0.0], "t": "needle"}

--- expect unordered
{"d.slug":"d000"}
{"d.slug":"d001"}
{"d.slug":"d002"}

--- expect shape
d.slug: String
