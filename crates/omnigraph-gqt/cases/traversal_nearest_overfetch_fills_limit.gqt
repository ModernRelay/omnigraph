# issue: none
# notes: Keep 20 docs: 4/20 edge sources exceeds the 10% gate threshold.
# notes: At limit 3, the first scan finds only d002; k = 12 finds all four sources without an exact pass.
# notes: Rust probe: issue_567_nearest_gate_falls_back_above_the_ratio.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    n: I64 @index
    name: String @index
    embedding: Vector(4) @index
}

edge Knows: Doc -> Doc {
}

