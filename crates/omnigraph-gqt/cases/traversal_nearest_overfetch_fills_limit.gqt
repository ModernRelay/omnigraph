# issue: none
# notes: `$d knows $t` over 20 docs with edges leaving 2, 5, 8, 11: 4 of 20 (20%,
# notes: still 15% with one fewer) fails the gate's 10% fence, so the scan is
# notes: unfiltered and the traversal drops rows above it. Limit 3: the first
# notes: pass (rows 0..2) keeps one source, short; the x4 rerun asks for 12 of
# notes: the 20 live rows (12 < 20, so a wider rung, not the exact pass) and
# notes: holds four sources (4 > 3): the loop stops there with d002, d005, d008.
# notes: Rust twin (probes: one overfetch, no exact pass):
# notes: issue_567_nearest_gate_falls_back_above_the_ratio.

--- schema
node Doc {
    slug: String @key
    n: I64 @index
    name: String @index
    embedding: Vector(4) @index
}

edge Knows: Doc -> Doc {
}

