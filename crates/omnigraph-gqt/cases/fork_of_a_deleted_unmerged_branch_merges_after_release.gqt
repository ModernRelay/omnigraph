# issue: none
# notes: t forks the unmerged s; four bumps under set history_release_bytes = 2048; release s's fork
# notes: point, branch delete s settles its head into __history, and after a restart t merges into b.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0]

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":0}}
{"type":"Person","data":{"name":"bob","age":0}}
{"type":"Person","data":{"name":"carol","age":0}}

--- mutate
set history_release_bytes = 2048;

--- expect ok

--- mutate
branch create b

--- expect ok

--- mutate
branch create s from b

--- expect ok

--- mutate branch: s
query set_bob_on_s() {
    update Person set { age: 3 } where name = "bob"
}

--- expect affected: nodes=1 edges=0

--- mutate
branch create t from s

--- expect ok

--- mutate branch: t
query set_carol_on_t() {
    update Person set { age: 5 } where name = "carol"
}

--- expect affected: nodes=1 edges=0

--- loop $i 1 5
--- mutate branch: b
query bump_alice($n: I32) {
    update Person set { age: $n } where name = "alice"
}
--- params
{"n": ${i}}
--- expect affected: nodes=1 edges=0
--- endloop

--- mutate
branch delete s

--- expect ok

--- restart

--- mutate
branch merge t into b

--- expect outcome: merged

--- query branch: b
query people_after_t() { match { $p: Person } return { $p.name, $p.age } }

--- expect unordered
{"p.name":"alice","p.age":4}
{"p.name":"bob","p.age":3}
{"p.name":"carol","p.age":5}

--- expect shape
p.name: String
p.age: I32
