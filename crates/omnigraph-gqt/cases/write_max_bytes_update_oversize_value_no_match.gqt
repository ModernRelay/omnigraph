# issue: none
# notes: An update refuses an assigned base64: value over write_max_bytes before it scans, so the refusal does not depend on a matched row.
# notes: The 4,095-byte value exceeds write_max_bytes = 4093 and is refused although no Doc has slug "missing".

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Doc {
    slug: String @key
    content: Blob?
    note: String
}

--- seed

--- mutate
query seed_doc() {
    insert Doc { slug: "present", note: "n" }
}

--- expect affected: nodes=1 edges=0

--- mutate
set write_max_bytes = 4093;
query assign_missing($payload: Blob) {
    update Doc set { content: $payload } where slug = "missing"
}

--- params
{"payload": "base64:"}

--- expect error: decoded blob input bytes per operation
