# issue: none
# notes: A notes line may spell a marker: this one spells `${who}`, the loop variable the params substitute, and the case is read and runs.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    name: String @key
}

--- seed
{"type":"Person","data":{"name":"alice"}}

--- foreach $who bob carol

--- mutate
query insert_person($name: String) {
    insert Person { name: $name }
}

--- params
{"name": "${who}"}

--- expect affected: nodes=1 edges=0

--- endloop

--- query
query all_names() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "bob"}
{"p.name": "carol"}

--- expect shape
p.name: String
