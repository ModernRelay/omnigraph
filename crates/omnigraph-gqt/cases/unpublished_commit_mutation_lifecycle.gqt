# issue: none
# notes: A mutation `as commit` leaves its branch unchanged and is readable at its id; `commit publish`
# notes: installs that result, a repeat publish answers the published commit, and a published commit is never dropped.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed

--- mutate
query add_alice() {
    insert Person { name: "alice", age: 30 }
}

--- expect affected: nodes=1 edges=0

--- mutate
query propose_bob() as commit {
    insert Person { name: "bob", age: 41 }
}

--- expect affected: nodes=1 edges=0

--- bind commit $bob

--- query
query names_on_main() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}

--- expect shape
p.name: String

--- query snapshot: $bob
query names_at_proposal() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "bob"}

--- expect shape
p.name: String

--- mutate
commit publish "${bob}"

--- expect ok

--- query
query names_after_publish() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "bob"}

--- expect shape
p.name: String

--- mutate
commit publish "${bob}"

--- expect ok

--- mutate
commit drop "${bob}"

--- expect error: is published

--- query snapshot: $bob
query names_at_published() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "bob"}

--- expect shape
p.name: String
