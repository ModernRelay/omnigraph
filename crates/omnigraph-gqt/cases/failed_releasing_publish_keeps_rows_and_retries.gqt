# issue: none
# notes: The insert after the loop is the releasing publish (loop end as read_beside_the_history_release);
# notes: publish.pre_merge fails it after the block put, no row shows, and the retry accepts the equal copy.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0]

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":0}}
{"type":"Person","data":{"name":"bob","age":0}}

--- mutate
set history_release_bytes = 2048;

--- expect ok

--- mutate
branch create b

--- expect ok

--- loop $i 1 4
--- mutate branch: b
query bump_alice($n: I32) {
    update Person set { age: $n } where name = "alice"
}
--- params
{"n": ${i}}
--- expect affected: nodes=1 edges=0
--- endloop

--- seam
at: publish.pre_merge
occurrence: 1
action: fail
scope: next_step

--- mutate branch: b
query rejected_releasing_publish() { insert Person { name: "carol", age: 1 } }

--- expect error: injected failpoint triggered: publish.pre_merge

--- query branch: b
query rows_after_rejection() { match { $p: Person } return { $p.name, $p.age } }

--- expect unordered
{"p.name":"alice","p.age":3}
{"p.name":"bob","p.age":0}

--- expect shape
p.name: String
p.age: I32

--- mutate branch: b
query retried_releasing_publish() { insert Person { name: "carol", age: 1 } }

--- expect affected: nodes=1 edges=0

--- query branch: b
query rows_after_retry() { match { $p: Person } return { $p.name, $p.age } }

--- expect unordered
{"p.name":"alice","p.age":3}
{"p.name":"bob","p.age":0}
{"p.name":"carol","p.age":1}

--- expect shape
p.name: String
p.age: I32
