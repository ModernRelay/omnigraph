# issue: none
# notes: plain nearest over 3 docs, limit 10: the corpus is smaller than the
# notes: limit (3 < 10), so the answer is every row, ascending from -0.3, and
# notes: no error. One case for both spellings of this regime (a 1-doc corpus
# notes: under limit 3 and a 50-doc corpus under limit 100 sat on this path).

--- schema
node Doc {
    slug: String @key
    n: I64 @index
    name: String @index
    embedding: Vector(4) @index
}

edge Knows: Doc -> Doc {
}

--- seed
{"type":"Doc","data":{"slug":"d000","n":0,"name":"doc-000","embedding":[0.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d001","n":1,"name":"doc-001","embedding":[1.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d002","n":2,"name":"doc-002","embedding":[2.0,0.0,0.0,0.0]}}

--- query
query scenario($q: Vector(4)) {
    match {
        $d: Doc
    }
    return { $d.slug }
    order { nearest($d.embedding, $q) }
    limit 10
}

--- params
{"q": [-0.3, 0.0, 0.0, 0.0]}

--- expect ordered
{"d.slug":"d000"}
{"d.slug":"d001"}
{"d.slug":"d002"}

--- expect shape
d.slug: String
