# issue: none
# notes: A merge whose acknowledgement and readback both fail reports in doubt; the merge is durable exactly once.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Person {
    name: String @key
    age: I64
}
edge Knows: Person -> Person { @key(@src, @dst) }

--- seed
{"type":"Person","data":{"name":"alice","age":30}}
{"type":"Person","data":{"name":"bob","age":40}}
{"edge":"Knows","from":"alice","to":"bob"}
{"edge":"Knows","from":"bob","to":"alice"}

--- mutate
branch create source
--- expect ok

--- mutate branch: source
query source_changes() {
    insert Person { name: "carol", age: 50 }
    update Person set { age: 31 } where name = "alice"
}
--- expect affected: nodes=2 edges=0

--- mutate branch: source
query delete_bob() { delete Person where name = "bob" }
--- expect affected: nodes=1 edges=2

--- seam
at: publish.post_merge_pre_ack
occurrence: 1
action: fail
scope: next_step

--- seam
at: publish.read_back
occurrence: 1
action: fail
scope: next_step

--- mutate
branch merge source into main
--- expect error: outcome is in doubt

--- query branch: main
query people() { match { $p: Person } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"alice","p.age":31}
{"p.name":"carol","p.age":50}
--- expect shape
p.name: String
p.age: I64

--- restart

--- query branch: main
query people() { match { $p: Person } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"alice","p.age":31}
{"p.name":"carol","p.age":50}
--- expect shape
p.name: String
p.age: I64

--- mutate
query add_dave() { insert Person { name: "dave", age: 60 } }
--- expect affected: nodes=1 edges=0

--- query branch: main
query people() { match { $p: Person } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"alice","p.age":31}
{"p.name":"carol","p.age":50}
{"p.name":"dave","p.age":60}
--- expect shape
p.name: String
p.age: I64
