--- query
query order_by_int16_test() {
    match {
        $a: Person
        $b: Organisation
        $a $e:studyAt $b
    }
    return { $e.length }
    order { $e.length asc }
}

--- expect ordered
{"e.length": 5}
{"e.length": 22}
{"e.length": 55}

