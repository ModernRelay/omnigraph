--- query
query order_by_three_hop_test() {
    match {
        $a: Person
        $b: Person
        $c: Person
        $d: Person
        $a knows $b
        $b knows $c
        $c knows $d
    }
    return { $a.fName }
    order { $d.age desc, $c.age asc, $b.age asc, $a.age desc }
    limit 10
}

--- expect ordered
{"a.fName": "Carol"}
{"a.fName": "Alice"}
{"a.fName": "Dan"}
{"a.fName": "Carol"}
{"a.fName": "Bob"}
{"a.fName": "Dan"}
{"a.fName": "Alice"}
{"a.fName": "Bob"}
{"a.fName": "Dan"}
{"a.fName": "Carol"}

