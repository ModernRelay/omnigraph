--- query
query order_by_aggregate_test1() {
    match {
        $a: Person
        $b: Person
        $a knows $b
    }
    return { $a.age, count($b) as c }
    order { $a.age asc }
}

--- expect unordered
{"a.age": 20, "c": 5}
{"a.age": 30, "c": 3}
{"a.age": 35, "c": 3}
{"a.age": 45, "c": 3}

--- query
query order_by_flat_unflat() {
    match {
        $p: Person
        $p1: Person
        $p knows $p1
    }
    return { $p.pk, $p1.pk }
    order { $p.pk asc, $p1.pk asc }
    limit 13
}

