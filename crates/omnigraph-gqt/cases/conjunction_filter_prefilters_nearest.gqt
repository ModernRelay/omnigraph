# issue: none
# notes: two pushed predicates, numeric and string, joined by AND in one scan filter:
# notes: `$d.n >= 7` admits rows 7..11, `$d.name contains "-00"` admits rows
# notes: 0..9, the conjunction admits 7, 8, 9: exactly limit 3, so the scan
# notes: returns k matching rows and the unfiltered top-3 (0, 1, 2) is not it.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    n: I64 @index
    name: String @index
    embedding: Vector(4) @index
}

edge Knows: Doc -> Doc {
}

--- seed
{"type":"Doc","data":{"slug":"d000","n":0,"name":"doc-000","embedding":[0.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d001","n":1,"name":"doc-001","embedding":[1.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d002","n":2,"name":"doc-002","embedding":[2.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d003","n":3,"name":"doc-003","embedding":[3.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d004","n":4,"name":"doc-004","embedding":[4.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d005","n":5,"name":"doc-005","embedding":[5.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d006","n":6,"name":"doc-006","embedding":[6.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d007","n":7,"name":"doc-007","embedding":[7.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d008","n":8,"name":"doc-008","embedding":[8.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d009","n":9,"name":"doc-009","embedding":[9.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d010","n":10,"name":"doc-010","embedding":[10.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d011","n":11,"name":"doc-011","embedding":[11.0,0.0,0.0,0.0]}}

--- query
query scenario($q: Vector(4)) {
    match {
        $d: Doc
        $d.n >= 7
        $d.name contains "-00"
    }
    return { $d.slug }
    order { nearest($d.embedding, $q) }
    limit 3
}

--- params
{"q": [-0.3, 0.0, 0.0, 0.0]}

--- expect ordered
{"d.slug":"d007"}
{"d.slug":"d008"}
{"d.slug":"d009"}

--- expect shape
d.slug: String
