# issue: none
# red_on: 2026-10-16, main @ 9c2b3679: step 1 (mutate): expected an error containing "@range violation on Counter.count: value 9007199254740993 > max 9007199254740992", but the mutation succeeded
# notes: @range compares an integer value with its bound exactly. Above 2^53 an F64 comparison rounds 9007199254740993 and
# notes: 9007199254740992 to the same double, and above i64::MAX a U64 value and an I64 bound round to the same 2^63.
# notes: A Float bound on an integer column, and an Integer bound on a float column, compare against the bound's exact value.
# notes: A list property's @range bounds each element; the loader used to skip list columns without checking them.
# notes: U64 values above i64::MAX reach @range through a load; mutation parameters stop at i64::MAX.
# notes: The seed loads each boundary value; the final read shows that every refused write stored nothing.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Counter {
    name: String @key
    count: I64?
    unsigned: U64?
    small: I32?
    reading: F64?
    counts: [I64]?
    @range(count, 0..9007199254740992)
    @range(unsigned, 0..9223372036854775807)
    @range(small, -2.5..2.5)
    @range(reading, 9007199254740993..)
    @range(counts, 0..9007199254740992)
}

--- seed
{"type":"Counter","data":{"name":"count_at","count":9007199254740992}}
{"type":"Counter","data":{"name":"unsigned_at","unsigned":9223372036854775807}}
{"type":"Counter","data":{"name":"small_inside","small":-2}}
{"type":"Counter","data":{"name":"reading_above","reading":9007199254740994.0}}
{"type":"Counter","data":{"name":"counts_inside","counts":[0,9007199254740992]}}

--- mutate
query count_above_max() { insert Counter { name: "count_above", count: 9007199254740993 } }
--- expect error: @range violation on Counter.count: value 9007199254740993 > max 9007199254740992

--- load generate: v1 seed: 0 mode: append
tables:
  - kind: node
    name: Counter
    rows: 1
    commits: 1
    columns:
      name: {kind: literal, value: loaded_above}
      count: {kind: literal, value: 9007199254740993}
--- expect error: @range violation on Counter.count: value 9007199254740993 > max 9007199254740992

--- load generate: v1 seed: 0 mode: append
tables:
  - kind: node
    name: Counter
    rows: 1
    commits: 1
    columns:
      name: {kind: literal, value: unsigned_above}
      unsigned: {kind: literal, value: 9223372036854775808}
--- expect error: @range violation on Counter.unsigned: value 9223372036854775808 > max 9223372036854775807

--- mutate
query small_below_float_min($small: I32) { insert Counter { name: "small_below", small: $small } }
--- params
{"small": -3}
--- expect error: @range violation on Counter.small: value -3 < min -2.5

--- mutate
query small_above_float_max($small: I32) { insert Counter { name: "small_above", small: $small } }
--- params
{"small": 3}
--- expect error: @range violation on Counter.small: value 3 > max 2.5

--- mutate
query reading_below_integer_min() { insert Counter { name: "reading_below", reading: 9007199254740992.0 } }
--- expect error: @range violation on Counter.reading: value 9007199254740992 < min 9007199254740993

--- mutate
query counts_element_above_max() { insert Counter { name: "counts_above", counts: [0, 9007199254740993] } }
--- expect error: @range violation on Counter.counts: value 9007199254740993 > max 9007199254740992

--- query
query counters() {
    match { $c: Counter }
    return { $c.name, $c.count, $c.unsigned, $c.small, $c.reading, $c.counts }
}
--- expect unordered
{"c.name": "count_at", "c.count": 9007199254740992}
{"c.name": "unsigned_at", "c.unsigned": 9223372036854775807}
{"c.name": "small_inside", "c.small": -2}
{"c.name": "reading_above", "c.reading": 9007199254740994.0}
{"c.name": "counts_inside", "c.counts": [0, 9007199254740992]}
--- expect shape
c.name: String
c.count: I64?
c.unsigned: U64?
c.small: I32?
c.reading: F64?
c.counts: [I64]?
