--- query
query sweep($q: Vector(4)) {
    match {
        $d: Doc
        $d.n > 15
        $d knows $t
    }
    return { $d.slug }
    order { nearest($d.embedding, $q) }
    limit 2
}

--- params
{"q": [-0.3, 0.0, 0.0, 0.0]}

--- expect ordered
{"d.slug":"d020"}
{"d.slug":"d030"}

--- expect shape
d.slug: String

--- query
query sweep($q: Vector(4)) {
    match {
        $d: Doc
        $d knows $t
        $t.n > 25
    }
    return { $d.slug }
    order { nearest($d.embedding, $q) }
    limit 2
}

