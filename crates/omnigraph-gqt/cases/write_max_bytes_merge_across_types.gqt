# issue: none
# notes: A merge that writes rows counts Blob payloads across types together: Doc and Image each carry 4,500 bytes, 9,000 in all.
# notes: Main diverges on both tables, so neither is adopted by pointer; write_max_bytes = 8190 refuses the merge and leaves main unchanged, and the default merge succeeds.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Doc {
    slug: String @key
    content: Blob?
    note: String
}

node Image {
    slug: String @key
    content: Blob?
}

--- seed

--- mutate
branch create source;

--- expect ok

--- mutate branch: source
query insert_source($payload: Blob) {
    insert Doc { slug: "d", content: $payload, note: "source" }
    insert Image { slug: "i", content: $payload }
}

--- params
{"payload": "base64:"}

--- expect affected: nodes=2 edges=0

--- mutate
query diverge_main() {
    insert Doc { slug: "target", note: "target" }
    insert Image { slug: "target-image" }
}

--- expect affected: nodes=2 edges=0

--- mutate
set write_max_bytes = 8190;
branch merge source into main;

--- expect error: materialized blob payload bytes

--- query
query images_after_refusal() {
    match { $i: Image }
    return { $i.slug }
}

--- expect unordered
{"i.slug":"target-image"}

--- expect shape
i.slug: String

--- mutate
branch merge source into main;

--- expect outcome: merged

--- query
query images_after_merge() {
    match { $i: Image }
    return { $i.slug }
}

--- expect unordered
{"i.slug":"i"}
{"i.slug":"target-image"}

--- expect shape
i.slug: String
