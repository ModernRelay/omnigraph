# issue: none
# notes: Under set history_release_bytes = 2048; the third bump closes b's block (its head takes slot 0) and nothing is under
# notes: __history yet; after a restart and reset history_release_bytes; the next insert still puts the block: the release
# notes: decision travels in the head's commit id, not in the session budget. The merge of s then bases on the released block.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0]

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":0}}
{"type":"Person","data":{"name":"bob","age":0}}

--- mutate
set history_release_bytes = 2048;

--- expect ok

--- mutate
branch create b

--- expect ok

--- mutate
branch create s from b

--- expect ok

--- mutate branch: s
query set_bob_on_s() {
    update Person set { age: 7 } where name = "bob"
}

--- expect affected: nodes=1 edges=0

--- loop $i 1 4
--- mutate branch: b
query bump_alice($n: I32) {
    update Person set { age: $n } where name = "alice"
}
--- params
{"n": ${i}}
--- expect affected: nodes=1 edges=0
--- endloop

--- restart

--- mutate
reset history_release_bytes;

--- expect ok

--- concurrent
w1 on b: query releasing_publish_at_production_budget() { insert Person { name: "carol", age: 1 } }
r1 on b: query all() { match { $p: Person } return { $p.name } }
order: w1 park put __history/blocks/, r1 start, r1, w1 put __history/blocks/, w1
--- expect
w1: ok
r1: ok

--- query branch: b
query rows_after_release() { match { $p: Person } return { $p.name, $p.age } }

--- expect unordered
{"p.name":"alice","p.age":3}
{"p.name":"bob","p.age":0}
{"p.name":"carol","p.age":1}

--- expect shape
p.name: String
p.age: I32

--- mutate
branch merge s into b

--- expect outcome: merged

--- query branch: b
query rows_after_merge() { match { $p: Person } return { $p.name, $p.age } }

--- expect unordered
{"p.name":"alice","p.age":3}
{"p.name":"bob","p.age":7}
{"p.name":"carol","p.age":1}

--- expect shape
p.name: String
p.age: I32

--- restart

--- query branch: b
query rows_after_second_reopen() { match { $p: Person } return { $p.name, $p.age } }

--- expect unordered
{"p.name":"alice","p.age":3}
{"p.name":"bob","p.age":7}
{"p.name":"carol","p.age":1}

--- expect shape
p.name: String
p.age: I32
