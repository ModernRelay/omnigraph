# issue: 659
# red_on: 7f1233bb
# notes: Endpoint declarations belong to their lexical block; checked nested directions and anonymous endpoints survive lowering.
# notes: A block in `where` correlates on every element's names (section 3), so a block whose variable must stay its own names a variable no element binds.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person { name: String @key value: I64? }
node Company { name: String @key value: String? }
edge WorksAt: Person -> Company
edge Employs: Company -> Person
edge Knows: Person -> Person
edge Likes: Person -> Person

--- seed
{"type":"Person","data":{"name":"p"}}
{"type":"Person","data":{"name":"x"}}
{"type":"Company","data":{"name":"acme"}}
{"type":"Company","data":{"name":"idle"}}
{"edge":"WorksAt","id":"works","from":"p","to":"acme","data":{}}
{"edge":"Employs","id":"employs","from":"acme","to":"p","data":{}}
{"edge":"Knows","id":"knows","from":"p","to":"x","data":{}}
{"edge":"Likes","id":"likes","from":"p","to":"x","data":{}}

--- query
query later_endpoint_declaration() {
    match { $c $e:(worksAt | employs) $p, $c: Company } where $c.name = "acme"
    return { $p.name as person, $e.@type as kind }
}
--- expect unordered
{"person":"p","kind":"WorksAt"}
{"person":"p","kind":"Employs"}

--- expect shape
person: String
kind: String

--- query
query permuted_members() {
    match { $c $e:(employs | worksAt) $p, $c: Company } where $c.name = "acme"
    return { $p.name as person, $e.@type as kind }
}
--- expect unordered
{"person":"p","kind":"WorksAt"}
{"person":"p","kind":"Employs"}

--- expect shape
person: String
kind: String

--- query
query later_wildcard_declarations() {
    match { $c $e:* $p, $c: Company, $p: Person } where $c.name = "acme"
    return { $p.name as person, $e.@type as kind }
}
--- expect unordered
{"person":"p","kind":"WorksAt"}
{"person":"p","kind":"Employs"}

--- expect shape
person: String
kind: String

--- query
query later_inner_declaration() {
    match { $c: Company } where exists { $c * $p, $p: Person }
    return { $c.name as company }
}
--- expect unordered
{"company":"acme"}

--- expect shape
company: String

--- query
query anonymous_destination_is_independent() {
    match { $_: Company, $p: Person, $p knows $_ } where $_.name = "idle" and $p.name = "p"
    return { $p.name as person }
}
--- expect unordered
{"person":"p"}

--- expect shape
person: String

--- query
query anonymous_source_is_independent() {
    match { $_: Company, $p: Person, $_ knows $p } where $_.name = "idle" and $p.name = "x"
    return { $p.name as person }
}
--- expect unordered
{"person":"x"}

--- expect shape
person: String

--- query
query named_reverse_not() {
    match { $c: Company } where not exists { $c worksAt $p }
    return { $c.name as company }
}
--- expect unordered
{"company":"idle"}

--- expect shape
company: String

--- query
query named_reverse_exists() {
    match { $c: Company } where exists { $c worksAt $p }
    return { $c.name as company }
}
--- expect unordered
{"company":"acme"}

--- expect shape
company: String

--- query
query named_reverse_count() {
    match { $c: Company } where count { $c worksAt $p } > 0
    return { $c.name as company }
}
--- expect unordered
{"company":"acme"}

--- expect shape
company: String

--- query
query named_child_string_argument() {
    match { $p: Person } where count(contains($f.name, "x")) { $p knows $f } > 0
    return { $p.name as person }
}
--- expect unordered
{"person":"p"}

--- expect shape
person: String

--- query
query named_unanchored() {
    match { $p: Person, $x knows $y }
    return { $p.name }
}
--- expect unordered
{"p.name": "p"}
{"p.name": "x"}

--- expect shape
p.name: String

--- query
query selected_unanchored() {
    match { $p: Person, $x (knows | likes) $y }
    return { $p.name }
}
--- expect unordered
{"p.name": "p"}
{"p.name": "x"}

--- expect shape
p.name: String

--- query
query nested_unanchored() {
    match { $p: Person } where not exists { $x knows $y where $p.name = "p" }
    return { $p.name }
}
--- expect unordered
{"p.name": "x"}

--- expect shape
p.name: String

--- query
query child_declaration_does_not_escape() {
    match { $c: Company, $c * $p } where exists { $c worksAt $p, $p: Person }
    return { $c.name }
}
--- expect error: requires explicitly declared source and destination node bindings

--- query
query reverse_expand_selection() {
    match { $c: Company, $p: Person, $p $e:(worksAt | employs) $c } where $c.name = "acme"
    return { $p.name as person, $e.@type as kind }
}
--- expect unordered
{"person":"p","kind":"WorksAt"}
{"person":"p","kind":"Employs"}

--- expect shape
person: String
kind: String

--- query
query cycle_closing_selection() {
    match { $p: Person, $p (knows | likes) $f, $f (knows | likes) $p } where $p.name = "p"
    return { $f.name as person }
}
--- expect unordered

--- expect shape
person: String

--- query
query named_type_values() {
    match { $p: Person, $p $e:knows $f } where $e.@type = "Knows"
    return { $e.@type as kind, $f.name as person }
    order { $e.@type }
}
--- expect unordered
{"kind":"Knows","person":"x"}

--- expect shape
kind: String
person: String

--- query
query undirected_cross_type_wildcard() {
    match { $c: Company, $p: Person, $c <*> $p }
    return { $c.name }
}
--- expect error: T22:

--- query
query cross_type_same_variable() {
    match { $p: Person, $p (worksAt | employs) $p }
    return { $p.name }
}
--- expect error: T5:

--- query
query block_local_name_is_not_correlated() {
    match { $p: Person, $x: Company } where $p.name = "p" and exists { $p knows $k } and $x.name = "idle"
    return { $p.name as person, $x.name as company }
}
--- expect unordered
{"person":"p","company":"idle"}

--- expect shape
person: String
company: String

--- query
query block_local_name_not_block() {
    match { $p: Person, $x: Company } where not exists { $p knows $k } and $x.name = "idle"
    return { $p.name as person, $x.name as company }
}
--- expect unordered
{"person":"x","company":"idle"}

--- expect shape
person: String
company: String

--- query
query undeclared_same_variable_cross_type() {
    match { $p: Person, $x (worksAt | worksAt) $x, $p knows $x }
    return { $p.name }
}
--- expect error: cannot have both type

--- query
query undeclared_mixed_orientation_forward_member_first() {
    match { $p: Person, $x (worksAt | employs) $y, $p knows $x }
    return { $p.name }
}
--- expect error: mixed endpoint orientations requires a declared endpoint type

--- query
query undeclared_mixed_orientation_reverse_member_first() {
    match { $p: Person, $x (employs | worksAt) $y, $p knows $x }
    return { $p.name }
}
--- expect error: mixed endpoint orientations requires a declared endpoint type

--- query
query block_local_selected_edge_does_not_capture_the_outer_edge() {
    match { $p: Person, $p $e:(knows | likes) $f }
    where exists { $p $k:(knows | likes) $x where $k.@type = "Knows" }
    return { $p.name as person, $e.@type as kind, $e.@id as id }
}
--- expect unordered
{"person":"p","kind":"Knows","id":"knows"}
{"person":"p","kind":"Likes","id":"likes"}
--- expect shape
person: String
kind: String
id: String

--- query
query block_local_named_edge_does_not_capture_the_outer_edge() {
    match { $p: Person, $p $e:knows $f }
    where exists { $p $k:knows $x }
    return { $p.name as person, $e.@id as id }
}
--- expect unordered
{"person":"p","id":"knows"}
--- expect shape
person: String
id: String

--- query
query block_local_node_does_not_capture_the_outer_node() {
    match { $p: Person, $x: Company }
    where exists {
        $p: Person
        where $p.name = "p" and exists { $p knows $k }
    }
      and $x.name = "idle"
    return { $p.name as person, $x.name as company }
}
--- expect unordered
{"person":"p","company":"idle"}
--- expect shape
person: String
company: String

--- query
query nested_local_names_remain_independent() {
    match { $p: Person, $x: Company }
    where count($c.name) {
        $c: Company
        where $p.name = "p"
          and exists { $p knows $k where $k.name = "x" }
          and $c.name = "acme"
          and exists { $c worksAt $q where $q.name = "p" }
    } = 1
      and $x.name = "idle"
    return { $p.name as person, $x.name as company }
}
--- expect unordered
{"person":"p","company":"idle"}
--- expect shape
person: String
company: String

--- query
query sibling_inner_names_keep_distinct_types() {
    match { $p: Person }
    where $p.name = "p"
      and exists { $p knows $x where $x.value is null }
      and exists { $p worksAt $x where $x.value is null }
    return { $p.name as person }
}
--- expect unordered
{"person":"p"}
--- expect shape
person: String
--- expect plan
result columns [person: String]
