# issue: none
# csv_slice_bytes: 4096
# notes: Two parse partitions of 4096 bytes (the pin above; 8 MiB without it). Key KB repeats
# notes: wholly inside partition 0 (records 28 and 51); key KA repeats across the boundary
# notes: (record 7 in partition 0, record 101 in partition 1). The earlier second holder is
# notes: KB's, so the refusal names KB whichever partition's batch arrives first: the earliest
# notes: repeat is the same whatever the arrival order. Retains a row position that dropped the
# notes: partition bits and ranked KA's repeat in partition 1 before KB's.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item {
    id: String @key
    name: String
    email: String? @unique
    n: I64
}

--- seed
{"type":"Item","data":{"id":"seed","name":"s","email":"seed@x","n":0}}

