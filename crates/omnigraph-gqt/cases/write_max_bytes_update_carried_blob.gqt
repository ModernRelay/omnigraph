{"type":"Apart","data":{"slug":"big","content":"base64:","title":"old"}}
--- mutate
set write_max_bytes = 2047;
query retitle_one_byte_short() {
    update Doc set { title: "new" } where slug = "big"
    update Doc set { title: "none" } where slug = "nobody"
}

--- expect error: materialized blob payload bytes

--- query
query titles_after_refusal() {
    match { $d: Doc }
    return { $d.slug, $d.title }
}

--- expect unordered
{"d.slug": "big", "d.title": "old"}

--- expect shape
d.slug: String
d.title: String

--- mutate
set write_max_bytes = 2048;
query retitle_exact() {
    update Doc set { title: "new" } where slug = "big"
    update Doc set { title: "none" } where slug = "nobody"
}

--- expect affected: nodes=1 edges=0

--- query
query titles_after_carry() {
    match { $d: Doc }
    return { $d.slug, $d.title }
}

--- expect unordered
{"d.slug": "big", "d.title": "new"}

--- expect shape
d.slug: String
d.title: String

--- mutate
set write_max_bytes = 2047;
query retitle_alone() {
    update Doc set { title: "patched" } where slug = "big"
}

--- expect affected: nodes=1 edges=0

--- query
query titles_after_patch() {
    match { $d: Doc }
    return { $d.slug, $d.title }
}

--- expect unordered
{"d.slug": "big", "d.title": "patched"}

--- expect shape
