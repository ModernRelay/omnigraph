# issue: none
# notes: An update carries every Blob it does not assign and counts it as `materialized blob payload bytes`; assigning a Blob (here to null) carries no payload.
# notes: The seeded payload is 2,048 bytes: write_max_bytes = 2047 refuses the carry and leaves the title old, 2048 admits it exactly.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    content: Blob?
    title: String
}

--- seed
{"type":"Doc","data":{"slug":"big","content":"base64:","title":"old"}}

--- mutate
set write_max_bytes = 2047;
query retitle_one_byte_short() {
    update Doc set { title: "new" } where slug = "big"
}

--- expect error: materialized blob payload bytes

--- query
query titles_after_refusal() {
    match { $d: Doc }
    return { $d.slug, $d.title }
}

--- expect unordered
{"d.slug": "big", "d.title": "old"}

--- expect shape
d.slug: String
d.title: String

--- mutate
set write_max_bytes = 2048;
query retitle_exact() {
    update Doc set { title: "new" } where slug = "big"
}

--- expect affected: nodes=1 edges=0

--- query
query titles_after_carry() {
    match { $d: Doc }
    return { $d.slug, $d.title }
}

--- expect unordered
{"d.slug": "big", "d.title": "new"}

--- expect shape
d.slug: String
d.title: String

--- mutate
set write_max_bytes = 2047;
query clear_and_retitle($c: Blob?) {
    update Doc set { content: $c, title: "cleared" } where slug = "big"
}

--- params
{"c": null}

--- expect affected: nodes=1 edges=0

--- query
query titles_after_clear() {
    match { $d: Doc }
    return { $d.slug, $d.title }
}

--- expect unordered
{"d.slug": "big", "d.title": "cleared"}

--- expect shape
d.slug: String
d.title: String
