# issue: none
# notes: A `load csv` statement's retained source, decoded batches, validation state and
# notes: staging working set are admitted against the session's `query_memory_bytes`: an
# notes: allowance that cannot hold the source refuses with that resource before any
# notes: fragment write and the type keeps its rows; the default allowance lands the load.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0]

--- schema
node Person {
    id: String @key
    name: String
}

node Wide {
    key: I64 @key
    embedding: Vector(32768)?
}

node OmittedBlob {
    key: I64 @key
    payload: Blob?
}

--- seed
{"type":"Person","data":{"id":"p1","name":"alice"}}

