--- mutate
set query_memory_bytes = 4096;
load csv "wide.csv" into node:Person mode overwrite header

--- expect error: query_memory_bytes

--- query
query unchanged() {
    match { $p: Person }
    return { $p.id, $p.name }
}

--- expect unordered
{"p.id": "p1", "p.name": "alice"}

--- expect shape
p.id: String
p.name: String

--- mutate
load csv "wide.csv" into node:Person mode overwrite header

--- expect ok

--- query
query replaced() {
    match { $p: Person }
    return { count($p) as n }
}

--- expect unordered
{"n": 1200}

--- expect shape
n: I64

--- csv omitted.csv
key
1

--- mutate
set query_memory_bytes = 65536;
load csv "omitted.csv" into node:Wide mode overwrite header

--- expect error: query_memory_bytes

--- query
query omitted_unchanged() {
    match { $w: Wide }
    return { count($w) as n }
}

--- expect unordered
{"n": 0}

--- expect shape
n: I64

--- mutate
load csv "omitted.csv" into node:Wide mode overwrite header

--- expect ok

--- query
query omitted_loaded() {
    match { $w: Wide }
    return { $w.key }
}

--- expect unordered
{"w.key": 1}

--- expect shape
w.key: I64

--- mutate
load csv "omitted.csv" into node:OmittedBlob mode overwrite header

--- expect ok

--- query
query omitted_blob_loaded() {
    match { $b: OmittedBlob }
    return { $b.key }
}

--- expect unordered
{"b.key": 1}

--- expect shape
b.key: I64
