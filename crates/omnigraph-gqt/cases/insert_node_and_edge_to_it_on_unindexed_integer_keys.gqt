# issue: none
# notes: One mutation inserts an integer-keyed Person and an edge to it into a table with no key
# notes: index, so both endpoint checks scan and the committed keys are swept into a set; the edge's
# notes: target is found among the same write's rows before the set is consulted, and the write lands.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person { id: I64 @key }
edge Knows: Person -> Person

--- seed generate: v1 seed: 42
tables:
  - kind: node
    name: Person
    rows: 8
    commits: 4
    columns:
      id: {kind: ordinal, start: 0, step: 1}

--- mutate
query add_both() { insert Person { id: 100 } insert Knows { from: "0", to: "100" } }
--- expect affected: nodes=1 edges=1

--- query
query loaded() { match { $a: Person $a knows $b } return { count($b) as n } }
--- expect unordered
{"n": 1}
--- expect shape
n: I64
