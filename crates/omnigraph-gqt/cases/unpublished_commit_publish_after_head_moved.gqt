# issue: none
# notes: A proposal captures its target head; once an ordinary write moves the head, `commit publish`
# notes: fails the precondition and the proposal can only be dropped.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}

--- mutate
query propose_bob() as commit {
    insert Person { name: "bob", age: 41 }
}

--- expect affected: nodes=1 edges=0

--- bind commit $bob

--- mutate
query insert_carol() {
    insert Person { name: "carol", age: 52 }
}

--- expect affected: nodes=1 edges=0

--- mutate
commit publish "${bob}"

--- expect error: precondition failed on branch 'main'

--- query
query names_on_main() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "carol"}

--- expect shape
p.name: String

--- mutate
commit drop "${bob}"

--- expect ok

--- mutate
commit publish "${bob}"

--- expect error: not found
