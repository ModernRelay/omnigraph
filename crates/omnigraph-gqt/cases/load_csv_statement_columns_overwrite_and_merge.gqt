--- mutate
load csv "cross_batch_edge_duplicate.csv" into edge:Link mode overwrite header

--- expect error: @unique violation on Link.

--- query
query unchanged_after_cross_batch_edge_duplicate() {
    match { $a: Person $a $e:link $b }
    return { count($e.key) as n }
}

--- expect unordered
{"n":0}

--- expect shape
n: I64
