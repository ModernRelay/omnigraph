--- mutate
load csv "cross_batch_duplicate.csv" into node:Person mode overwrite header

--- expect error: @unique violation on Person.id: value '0'

--- query
query unchanged_after_cross_batch_duplicate() {
    match { $p: Person }
    return { $p.id, $p.name, $p.age }
}

--- expect unordered
{"p.id": 9, "p.name": "zed", "p.age": 1}

--- expect shape
p.id: I64
p.name: String
p.age: I32?

