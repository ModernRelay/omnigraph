# issue: 567
# red_on: 2026-09-04, main 650e1653: the nearest scan took the 3 nearest docs of the whole table, the traversal kept the one with an edge, and the query returned 1 row instead of 3.
# notes: Keep 10 docs: 3/10 eligible sources exceeds the 10% gate threshold.
# notes: The first three candidates contain only d00; retrying with k = 12 reaches d04 and d08.
# notes: Rust probe: issue_567_nearest_traversal_prefilters_then_overfetches (tests/search.rs).

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    embedding: Vector(4) @index
}

edge Knows: Doc -> Doc {
}

--- seed
{"type":"Doc","data":{"slug":"d00","embedding":[0.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d01","embedding":[1.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d02","embedding":[2.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d03","embedding":[3.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d04","embedding":[4.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d05","embedding":[5.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d06","embedding":[6.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d07","embedding":[7.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d08","embedding":[8.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d09","embedding":[9.0,0.0,0.0,0.0]}}
{"edge":"Knows","id":"e00","from":"d00","to":"d01","data":{}}
{"edge":"Knows","id":"e04","from":"d04","to":"d05","data":{}}
{"edge":"Knows","id":"e08","from":"d08","to":"d09","data":{}}

--- query
query nearest_with_edge($q: Vector(4)) {
    match {
        $d: Doc
        $d knows $t
    }
    return { $d.slug }
    order { nearest($d.embedding, $q) }
    limit 3
}

--- params
{"q": [0.0, 0.0, 0.0, 0.0]}

--- expect ordered
{"d.slug": "d00"}
{"d.slug": "d04"}
{"d.slug": "d08"}

--- expect shape
d.slug: String
