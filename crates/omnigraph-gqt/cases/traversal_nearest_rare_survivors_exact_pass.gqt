--- query
query nearest_with_edge($q: Vector(4)) {
    match {
        $d: Doc
        $d knows $t
    }
    return { $d.slug }
    order { nearest($d.embedding, $q) }
    limit 2
}

--- params
{"q": [-0.3, 0.0, 0.0, 0.0]}

--- expect ordered
{"d.slug": "d60"}
{"d.slug": "d61"}

--- expect shape
d.slug: String

--- query
query nearest_with_edge_wide($q: Vector(4)) {
    match {
        $d: Doc
        $d knows $t
    }
    return { $d.slug }
    order { nearest($d.embedding, $q) }
    limit 50
}

