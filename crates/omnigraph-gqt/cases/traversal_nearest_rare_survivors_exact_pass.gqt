# issue: none
# notes: PROBE: the overfetch loop's exact pass. Edges leave docs 60..99 (40 of
# notes: 100, above the gate's 10% ratio, so the scan is unfiltered). With
# notes: limit 2 the passes k = 2, 8, 32 cover docs 0..31, none with an edge;
# notes: the pass past the 16x ceiling scores the whole type flat, no cap, and
# notes: returns the two nearest edge-bearing docs. Short here = the exact pass
# notes: did not run. Step 2 (limit 50, above the 40 survivors): the first rung
# notes: would cover the whole type, so the exact pass runs at once and the
# notes: answer is exactly the survivors, in order. Rust twin:
# notes: issue_567_nearest_traversal_prefilters_then_overfetches (tests/search.rs),
# notes: forced-postfilter half.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    embedding: Vector(4) @index
}

edge Knows: Doc -> Doc {
}

