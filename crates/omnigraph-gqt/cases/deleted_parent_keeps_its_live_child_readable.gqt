# issue: none
# notes: A child branch forked from a parent keeps reading the parent's writes after the parent is
# notes: deleted, before and after a reopen, writes on, and merges into main.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}

--- mutate
branch create p

--- expect ok

--- mutate branch: p
query write_on_p() {
    insert Person { name: "bob", age: 41 }
}

--- expect affected: nodes=1 edges=0

--- mutate
branch create c from p

--- expect ok

--- mutate branch: c
query write_on_c() {
    insert Person { name: "carol", age: 52 }
}

--- expect affected: nodes=1 edges=0

--- mutate
branch delete p

--- expect ok

--- query
branch list

--- expect unordered
{"name": "c"}
{"name": "main"}

--- expect shape
name: String

--- restart

--- query branch: c
query names_on_c() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "bob"}
{"p.name": "carol"}

--- expect shape
p.name: String

--- mutate branch: c
query write_again_on_c() {
    insert Person { name: "dave", age: 63 }
}

--- expect affected: nodes=1 edges=0

--- mutate
branch merge c

--- expect outcome: fast_forward

--- query
query names_on_main() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "bob"}
{"p.name": "carol"}
{"p.name": "dave"}

--- expect shape
p.name: String
