# issue: none
# notes: Two writers of the process that holds `main` race on it: the overtaken insert prepares again and lands above
# notes: the other, and a publish whose load meets contention goes round again and lands. The owner reads every row.
# writer: held

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Person {
    name: String @key
}

--- seed
{"type":"Person","data":{"name":"alice"}}

--- concurrent
w1 on main: query add_bob() { insert Person { name: "bob" } }
w2 on main: query add_carol() { insert Person { name: "carol" } }
order: w1 park put nodes/, w2, w1 put nodes/, w1
--- expect
w1: ok
w2: ok

--- seam
at: publish.load_state
occurrence: 1
action: contention
scope: next_step

--- mutate
query add_dave() { insert Person { name: "dave" } }
--- expect affected: nodes=1 edges=0

--- query
query every_write_is_read() { match { $p: Person } return { $p.name } }
--- expect unordered
{"p.name":"alice"}
{"p.name":"bob"}
{"p.name":"carol"}
{"p.name":"dave"}
--- expect shape
p.name: String
