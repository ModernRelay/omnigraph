# issue: 1427
# red_on: 2026-11-17, main @ 8ab65713: step 4 (branch merge): … resource limit exceeded for branch-merge retained validation delta bytes: actual 37755302, limit 33554432
# notes: One statement inserts an 18 MiB row (nine 2 MiB columns) and a row whose wide columns are null, so the two
# notes: rows share a fragment. A scan of it can return the null with offsets spanning the wide row's bytes in one
# notes: decode buffer, and a measure of buffers then counts the 18 MiB of data twice, past 32 MiB. Validation
# notes: counts values and publication copies values, so the three-way merge and the validated fast forward
# notes: (`@range` keeps validation on) both merge.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    p0: String?
    p1: String?
    p2: String?
    p3: String?
    p4: String?
    p5: String?
    p6: String?
    p7: String?
    p8: String?
    n: I32?
    @range(n, 0..100)
}

--- seed

--- mutate
branch create b0
--- expect ok

--- mutate
query onmain() { insert Doc { slug: "onmain" } }
--- expect affected: nodes=1 edges=0

--- foreach $v 
--- mutate branch: b0
query insert_pair($s: String, $p: String) { insert Doc { slug: $s, p0: $p, p1: $p, p2: $p, p3: $p, p4: $p, p5: $p, p6: $p, p7: $p, p8: $p, n: 1 } insert Doc { slug: "small_a", n: 2 } }
