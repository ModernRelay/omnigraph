--- query
query int8_key_test() {
    match {
        $p: Person
        $o: Organisation
        $p $s:studyAt $o
        $s.level = 5
    }
    return { $p.pk, $o.pk }
}

--- expect unordered
{"p.pk": 0, "o.pk": 1}

