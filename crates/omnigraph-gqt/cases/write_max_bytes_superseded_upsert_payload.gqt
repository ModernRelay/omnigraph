# issue: none
# notes: A later write of a key in the same write replaces its pending version, so a superseded version is not retained and its Blob is not counted.
# notes: Two replaces of key "same" each carry 15,999 bytes: one version stays, 15,999 bytes fit write_max_bytes = 30000, and the row has the second note; carrying its Blob is refused at 15998 and admitted at 15999, by an update that shares its write with an upsert of another row, so it rewrites whole rows rather than patching the note.
# notes: Two distinct keys each carrying 15,999 bytes keep both versions: 31,998 bytes exceed 30000 and are refused as `decoded blob input bytes per operation`, and neither row is written.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Doc {
    slug: String @key
    content: Blob?
    note: String
}

--- seed

--- mutate
set write_max_bytes = 30000;
query upsert_twice($payload: Blob) {
    replace Doc { slug: "same", content: $payload, note: "first" }
    replace Doc { slug: "same", content: $payload, note: "second" }
}

--- params
{"payload": "base64:"}

--- expect affected: nodes=2 edges=0

--- query
query docs_after_upserts() {
    match { $d: Doc }
    return { $d.slug, $d.note }
}

--- expect unordered
{"d.slug": "same", "d.note": "second"}

--- expect shape
d.slug: String
d.note: String

--- mutate
set write_max_bytes = 15998;
query carry_one_byte_short() {
    match { $d: Doc } where $d.slug = "same"
    update $d set { note: "carried" }
    upsert Doc { slug: "spare", note: "none" }
}

--- expect error: materialized blob payload bytes

--- mutate
set write_max_bytes = 15999;
query carry_exact() {
    match { $d: Doc } where $d.slug = "same"
    update $d set { note: "carried" }
    upsert Doc { slug: "spare", note: "none" }
}

--- expect affected: nodes=2 edges=0

--- mutate
set write_max_bytes = 30000;
query upsert_two_keys($payload: Blob) {
    insert Doc { slug: "a", content: $payload, note: "fresh" }
    insert Doc { slug: "b", content: $payload, note: "fresh" }
}

--- params
{"payload": "base64:"}

--- expect error: decoded blob input bytes per operation

--- query
query docs_after_refusal() {
    match { $d: Doc }
    return { $d.slug, $d.note }
}

--- expect unordered
{"d.slug": "same", "d.note": "carried"}
{"d.slug": "spare", "d.note": "none"}

--- expect shape
d.slug: String
d.note: String
