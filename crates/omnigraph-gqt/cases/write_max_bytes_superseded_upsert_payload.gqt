# issue: none
# notes: Versions of one key written in the same operation count as input until the last-write-wins fold.
# notes: Two upserts of key "same" each carry 15,999 bytes: the fold keeps one, but the 31,998-byte input exceeds write_max_bytes = 30000 and is refused as `decoded blob input bytes per operation`.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Doc {
    slug: String @key
    content: Blob?
    note: String
}

--- seed

--- mutate
set write_max_bytes = 30000;
query upsert_twice($payload: Blob) {
    insert Doc { slug: "same", content: $payload, note: "first" }
    insert Doc { slug: "same", content: $payload, note: "second" }
}

--- params
{"payload": "base64:"}

--- expect error: decoded blob input bytes per operation
