--- expect error: Error while parsing value 'abc' as type 'Int64' for column 2 at line 95.

--- query
query after_mixed() {
    match { $i: Item }
    return { count($i) as c, sum($i.n) as s }
}

--- expect unordered
{"c":3,"s":60}

--- expect shape
c: I64
s: F64

