# issue: none
# csv_slice_bytes: 4096
# overwrite_chunk_rows: 10
# notes: Partition 0 carries a key repeated inside its first fragment (records 3 and 5),
# notes: partition 1 a bad integer at record 95; the refusal is the validate operator's,
# notes: ranked over every partition after the drain, not the sink's check that met the
# notes: repeat first; the committed rows stay.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item {
    id: I64 @key
    note: String
    n: I64
}

--- seed
{"type":"Item","data":{"id":1,"note":"s1","n":10}}
{"type":"Item","data":{"id":2,"note":"s2","n":20}}
{"type":"Item","data":{"id":3,"note":"s3","n":30}}

