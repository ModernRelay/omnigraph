--- query
query destination_filtered($q1: String, $q2: String) {
    match {
      let $pop = { match { $c: Chunk, $a: Artifact, $c chunkOfArtifact $a } where $a.slug = "art-0" return { $c } },
      from rrf(bm25($pop, $c.text, $q1), bm25($pop, $c.text, $q2), nearest($pop, $c.embedding, [0.0, 0.0], k: 2), k: 60) as $score,
    }
    return { $c.slug, $score }
    order { $score desc, $c.slug }
    limit 5
}

