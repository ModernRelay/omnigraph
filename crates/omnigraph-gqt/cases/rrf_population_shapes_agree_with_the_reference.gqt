--- query
query block_only($q1: String, $q2: String) {
    match {
      let $pop = { match { $c: Chunk } where not exists { $a: Artifact, $c chunkOfArtifact $a } return { $c } },
      from rrf(bm25($pop, $c.text, $q1), bm25($pop, $c.text, $q2), nearest($pop, $c.embedding, [0.0, 0.0], k: 2), k: 60) as $score,
    }
    return { $c.slug, $score }
    order { $score desc, $c.slug }
    limit 5
}

