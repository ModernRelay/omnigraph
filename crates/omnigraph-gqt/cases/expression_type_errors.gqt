# issue: none
# notes: The context rules of the shared expression model as typed errors: a non-Boolean operand of `and`/`or`/`not`, a non-Boolean filter or
# notes: mutation `where` (T41), an aggregate in a filter (T7), a Boolean item in an aggregate return (T9), a search call under `or` (T38), an unaliased comparison in return (T43), an aggregate or search call in a mutation `where` or an assignment (T44), a property leaf in an assignment or inline match (T45).

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    slug: String @key
    name: String
    age: I64
    text: String @index
    adult: Bool
}

--- seed
{"type":"Person","data":{"slug":"a","name":"alice","age":40,"text":"hello","adult":true}}

--- query
set engine = v2;
query and_over_non_boolean() {
    match { $p: Person  $p.age and $p.name }
    return { $p.slug }
}

--- expect error: T41: a filter needs a Bool, got I64

--- query
set engine = v2;
query not_over_non_boolean() {
    match { $p: Person  not $p.age }
    return { $p.slug }
}

--- expect error: T41: `not` needs a Bool, got I64

--- query
set engine = v2;
query aggregate_in_a_filter() {
    match { $p: Person  count($p) > 1 }
    return { $p.slug }
}

--- expect error: T8: `count($p)` is an aggregate over the read's own rows; it belongs in `return`

--- query
set engine = v2;
query search_under_or() {
    match { $p: Person  search($p.text, "hello") or $p.age > 30 }
    return { $p.slug }
}

--- expect error: T38: `search` is a search predicate; it must stand alone as a filter clause

--- query
set engine = v2;
query unaliased_comparison_in_return() {
    match { $p: Person }
    return { $p.slug, $p.age > 30 }
}

--- expect error: T43: a comparison in return needs an alias; write `… as <name>`

--- mutate
query count_in_a_mutation_where() {
    $x: Person  count($x.age) > 1
    update $x set { adult: true }
}

--- expect error: T8: `count(…)` is an aggregate; it belongs in `return`, or as a block `count($x.p) { … }`

--- mutate
query property_leaf_in_an_assignment() {
    $x: Person  $x.slug = "a"
    update $x set { adult: age > 30 }
}

--- expect error: Q018: `age` is a bare name, which is not a value in a read: a property is `$x.age`, a parameter `$age`, a string `"age"`; a bare name is a return alias in `order` only

--- query
set engine = v2;
query property_leaf_in_an_inline_match() {
    match { $p: Person { adult: age > 30 } }
    return { $p.slug }
}

--- expect error: Q018: `age` is a bare name, which is not a value in a read: a property is `$x.age`, a parameter `$age`, a string `"age"`; a bare name is a return alias in `order` only

--- mutate
query search_in_a_mutation_where() {
    $x: Person  search($x.text, "hello")
    delete $x
}

--- expect error: P006: `search_in_a_mutation_where`: the planner does not lower a search predicate in a write group's filters

--- mutate
query count_in_an_assignment() {
    insert Person { slug: "b", name: "b", age: 1, text: "t", adult: count(1) > 3 }
}

--- expect error: T8: `count(…)` is an aggregate; it belongs in `return`, or as a block `count($x.p) { … }`

--- query
set engine = v2;
query or_over_non_boolean() {
    match { $p: Person  $p.adult or $p.name }
    return { $p.slug }
}

--- expect error: T41: `or` needs a Bool, got String

--- query
set engine = v2;
query string_as_a_filter() {
    match { $p: Person  $p.name }
    return { $p.slug }
}

--- expect error: T41: a filter needs a Bool, got String

--- mutate
query string_as_a_mutation_where() {
    $x: Person  $x.name
    delete $x
}

--- expect error: T41: a filter needs a Bool, got String

--- query
set engine = v2;
query boolean_item_in_an_aggregate_return() {
    match { $p: Person }
    return { $p.name, count($p) as n, $p.age > 30 as adult }
}

--- expect unordered
{"p.name": "alice", "n": 1, "adult": true}

--- expect shape
p.name: String
n: I64
adult: Bool
