# issue: none
# notes: `$d knows $t` over 20 docs with one edge, leaving d015: 1 of 20 eligible
# notes: (5%, under the fence with a row to spare), so the gate pushes one id.
# notes: Limit 3 with 1 eligible (1 < 3): the prefiltered scan admits fewer rows
# notes: than k and the answer is that one row, no padding, no error.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    n: I64 @index
    name: String @index
    embedding: Vector(4) @index
}

edge Knows: Doc -> Doc {
}

