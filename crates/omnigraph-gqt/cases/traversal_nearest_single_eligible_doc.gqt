--- query
query scenario($q: Vector(4)) {
    match {
        $d: Doc
        $d knows $t
    }
    return { $d.slug }
    order { nearest($d.embedding, $q) }
    limit 3
}

--- params
{"q": [-0.3, 0.0, 0.0, 0.0]}

--- expect ordered
{"d.slug":"d015"}

--- expect shape
d.slug: String
