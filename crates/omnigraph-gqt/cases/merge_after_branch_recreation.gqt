# issue: none
# notes: A recreated branch merges with a child of its retired lifetime in On and Verify modes.
# notes: Targets, source and main retain their expected rows after reopen.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0]

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}
{"type":"Person","data":{"name":"bob","age":40}}

--- mutate
branch create feature;

--- expect ok

--- mutate branch: feature
query add_carol() {
    insert Person { name: "carol", age: 50 }
}

--- expect affected: nodes=1 edges=0

--- mutate
query add_dave() {
    insert Person { name: "dave", age: 60 }
}

--- expect affected: nodes=1 edges=0

--- mutate
set merge_lineage = verify;
branch merge feature into main;

--- expect outcome: merged

--- mutate
branch create old_child from feature;

--- expect ok

--- mutate
branch delete feature;

--- expect ok

--- mutate
branch create feature;

--- expect ok

--- mutate branch: feature
query recreated_source_deletes_bob() {
    delete Person where name = "bob"
}

--- expect affected: nodes=1 edges=0

--- mutate branch: old_child
query old_child_changes_alice() {
    update Person set { age: 31 } where name = "alice"
}

--- expect affected: nodes=1 edges=0

--- mutate
branch create on_target from old_child;

--- expect ok

--- restart

--- mutate
set merge_lineage = verify;
branch merge feature into old_child;

--- expect outcome: merged

--- mutate
set merge_lineage = on;
branch merge feature into on_target;

--- expect outcome: merged

--- restart

--- query branch: old_child
query verify_target() {
    match { $p: Person }
    return { $p.name, $p.age }
}

--- expect unordered
{"p.name":"alice","p.age":31}
{"p.name":"carol","p.age":50}
{"p.name":"dave","p.age":60}

--- expect shape
p.name: String
p.age: I32

--- query branch: on_target
query on_target_rows() {
    match { $p: Person }
    return { $p.name, $p.age }
}

--- expect unordered
{"p.name":"alice","p.age":31}
{"p.name":"carol","p.age":50}
{"p.name":"dave","p.age":60}

--- expect shape
p.name: String
p.age: I32

--- query branch: feature
query recreated_source_stays_isolated() {
    match { $p: Person }
    return { $p.name, $p.age }
}

--- expect unordered
{"p.name":"alice","p.age":30}
{"p.name":"carol","p.age":50}
{"p.name":"dave","p.age":60}

--- expect shape
p.name: String
p.age: I32

--- query
query main_stays_isolated() {
    match { $p: Person }
    return { $p.name, $p.age }
}

--- expect unordered
{"p.name":"alice","p.age":30}
{"p.name":"bob","p.age":40}
{"p.name":"carol","p.age":50}
{"p.name":"dave","p.age":60}

--- expect shape
p.name: String
p.age: I32
