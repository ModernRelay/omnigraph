# issue: none
# notes: A dense traversal (4 sources, 8 edges, 6 docs: the frontier estimate
# notes: saturates at the table) reads the destination table once as the build
# notes: side of a `HashJoin` node; the scalar filter stays inside that one read,
# notes: and the lexical predicates are a `Filter` the exact lexical scan answers.
# notes: Rows and multiplicity are the per-batch id lookup's. The last step is the
# notes: same two predicates over a root scan.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Source {
    slug: String @key
}
node Doc {
    slug: String @key
    body: String @index
    summary: String @index
    state: String
}
edge Links: Source -> Doc

--- seed
{"type":"Source","data":{"slug":"s1"}}
{"type":"Source","data":{"slug":"s2"}}
{"type":"Source","data":{"slug":"s3"}}
{"type":"Source","data":{"slug":"s4"}}
{"type":"Doc","data":{"slug":"a","body":"needle one","summary":"beacon","state":"open"}}
{"type":"Doc","data":{"slug":"b","body":"needle two","summary":"beacon","state":"closed"}}
{"type":"Doc","data":{"slug":"c","body":"other","summary":"beacon","state":"open"}}
{"type":"Doc","data":{"slug":"d","body":"needle three","summary":"other","state":"open"}}
{"type":"Doc","data":{"slug":"e","body":"needle four","summary":"beacon","state":"open"}}
{"type":"Doc","data":{"slug":"f","body":"other needle","summary":"beacon","state":"open"}}
{"edge":"Links","from":"s1","to":"a"}
{"edge":"Links","from":"s1","to":"b"}
{"edge":"Links","from":"s2","to":"a"}
{"edge":"Links","from":"s2","to":"c"}
{"edge":"Links","from":"s3","to":"d"}
{"edge":"Links","from":"s3","to":"f"}
{"edge":"Links","from":"s4","to":"d"}
{"edge":"Links","from":"s4","to":"f"}

--- query
query open_needles() {
    match { $s: Source, $s links $d, $d: Doc }
    where $d.state = "open" and match_terms($d.body, terms("needle", mode: any))
    return { $s.slug, $d.slug }
}
--- expect unordered
{"s.slug":"s1","d.slug":"a"}
{"s.slug":"s2","d.slug":"a"}
{"s.slug":"s3","d.slug":"d"}
{"s.slug":"s3","d.slug":"f"}
{"s.slug":"s4","d.slug":"d"}
{"s.slug":"s4","d.slug":"f"}
--- expect shape
s.slug: String
d.slug: String
--- expect plan
hash join $d
scan Doc as $d: filter reads [d.state]
pass access_path

--- query
query member_needles($states: [String]) {
    match { $s: Source, $s links $d }
    where $d.state in $states and match_terms($d.body, terms("needle", mode: any))
    return { $s.slug, $d.slug }
}
--- params
{"states":["open"]}
--- expect unordered
{"s.slug":"s1","d.slug":"a"}
{"s.slug":"s2","d.slug":"a"}
{"s.slug":"s3","d.slug":"d"}
{"s.slug":"s3","d.slug":"f"}
{"s.slug":"s4","d.slug":"d"}
{"s.slug":"s4","d.slug":"f"}
--- expect shape
s.slug: String
d.slug: String
--- expect plan
hash join $d
scan Doc as $d: filter reads [d.state]
pass access_path

--- query
query every_link() {
    match { $s: Source, $s links $d }
    return { $s.slug, $d.slug }
    order { $s.slug, $d.slug }
}
--- expect ordered
{"s.slug":"s1","d.slug":"a"}
{"s.slug":"s1","d.slug":"b"}
{"s.slug":"s2","d.slug":"a"}
{"s.slug":"s2","d.slug":"c"}
{"s.slug":"s3","d.slug":"d"}
{"s.slug":"s3","d.slug":"f"}
{"s.slug":"s4","d.slug":"d"}
{"s.slug":"s4","d.slug":"f"}
--- expect shape
s.slug: String
d.slug: String
--- expect plan
hash join $d
scan Doc as $d: no filter
pass access_path

--- query
query open_needle_beacons() {
    match { $s: Source, $s links $d, $d: Doc }
    where $d.state = "open"
      and match_terms($d.body, terms("needle", mode: any))
      and match_terms($d.summary, terms("beacon", mode: any))
    return { $s.slug, $d.slug }
}
--- expect unordered
{"s.slug":"s1","d.slug":"a"}
{"s.slug":"s2","d.slug":"a"}
{"s.slug":"s3","d.slug":"f"}
{"s.slug":"s4","d.slug":"f"}
--- expect shape
s.slug: String
d.slug: String
--- expect plan
hash join $d
scan Doc as $d: filter reads [d.state]
pass access_path

--- query
query root_scan_two_searches() {
    match { $d: Doc }
    where $d.state = "open"
      and match_terms($d.body, terms("needle", mode: any))
      and match_terms($d.summary, terms("beacon", mode: any))
    return { $d.slug }
}
--- expect unordered
{"d.slug":"a"}
{"d.slug":"e"}
{"d.slug":"f"}
--- expect shape
d.slug: String
--- expect plan
scan Doc as $d: filter reads [d.state]
