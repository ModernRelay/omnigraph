# issue: none
# notes: `recall: 1` searches every partition: its ranked scan carries no probe cap (`nprobes 0`)
# notes: whatever the session's `ann_nprobes`, so the search is exhaustive. A bound below 1 is
# notes: resolved by the session's effort settings: under `ann_nprobes = 1` the cap is 1.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    embedding: Vector(4) @index
}

--- seed
{"type":"Doc","data":{"slug":"d000","embedding":[0.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d001","embedding":[1.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d002","embedding":[2.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d003","embedding":[3.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d004","embedding":[4.0,0.0,0.0,0.0]}}

--- query
set ann_nprobes = 1;
query by_vector($q: Vector(4)) {
    match { let $pop = { match { $d: Doc } return { $d } }, from nearest($pop, $d.embedding, $q, k: 2, recall: 1.0) as $distance }
    return { $d.slug }
    order { $distance }
    limit 2
}
--- params
{"q": [0.0, 0.0, 0.0, 0.0]}
--- expect ordered
{"d.slug":"d000"}
{"d.slug":"d001"}
--- expect shape
d.slug: String
--- expect plan
scan Doc as $d: ranked nearest fetch 2 nprobes 0

--- query
set ann_nprobes = 1;
query by_vector($q: Vector(4)) {
    match { let $pop = { match { $d: Doc } return { $d } }, from nearest($pop, $d.embedding, $q, k: 2, recall: 0.9) as $distance }
    return { $d.slug }
    order { $distance }
    limit 2
}
--- params
{"q": [0.0, 0.0, 0.0, 0.0]}
--- expect ordered
{"d.slug":"d000"}
{"d.slug":"d001"}
--- expect shape
d.slug: String
--- expect plan
scan Doc as $d: ranked nearest fetch 2 nprobes 1
