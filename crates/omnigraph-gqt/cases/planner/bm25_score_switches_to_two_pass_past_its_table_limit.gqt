--- query
query best($q: String) {
    match {
        let $pop = { match { $d: Doc } return { $d } },
        from bm25($pop, $d.text, $q) as $score,
    }
    return { $d.slug, $score }
    order { $score desc }
    limit 6
}
--- params
{"q": "w00 w01 w02 w03 w04 w05 w06 w07 w08 w09 w10 w11 w12 w13 w14 w15 w16 w17 w18 w19 w20 w21 w22 w23 w24 w25 w26 w27 w28 w29 w30 w31 w32 w33 w34 w35 w36 w37 w38 w39 w40 w41 w42 w43 w44 w45 w46 w47 w48 w49 w50 w51 w52 w53 w54 w55 w56 w57 w58 w59"}
