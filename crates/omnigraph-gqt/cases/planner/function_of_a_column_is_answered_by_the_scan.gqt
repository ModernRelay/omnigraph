--- query
query float_negative_zero_on_the_column($z: F64) {
    match { $x: Item } where $x.f = $z
    return { $x.slug }
}

--- params
{"z": -0.0}

--- expect unordered
{"x.slug":""}
{"x.slug":"ÄLPHA"}

--- expect shape
x.slug: String

--- expect plan
scan Item as $x: access index_probe f btree

--- query
query float_range_around_zero() {
    match { $x: Item } where $x.f >= 0.0 and $x.f <= 0.0
    return { $x.slug }
}

--- expect unordered
{"x.slug":""}
{"x.slug":"ÄLPHA"}

--- expect shape
x.slug: String

--- expect plan
scan Item as $x: access index_probe f btree

