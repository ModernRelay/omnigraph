--- query
query knows_one_hop_test1() {
    match {
        $a: Person
        $b: Person
        $a knows $b
        $b.age = 20
    }
    return { $b.age }
}

--- expect unordered
{"b.age": 20}
{"b.age": 20}
{"b.age": 20}

--- query
query knows_two_hop_test1() {
    match {
        $a: Person
        $m: Person
        $b: Person
        $a knows $m
        $m knows $b
        $b.age > 40
    }
    return { $b.age }
}

