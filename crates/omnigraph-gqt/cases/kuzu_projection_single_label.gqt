--- query
query return_agg_on_const() {
    match {
        $a: Person
    }
    return { count($a) as n }
}

--- expect unordered
{"n": 8}

--- query
query return_column_with_same_expression() {
    match {
        $a: Person
        $a.fName = "Alice"
    }
    return { $a.age, $a.age as k }
}

--- expect unordered
{"a.age": 35, "k": 35}

