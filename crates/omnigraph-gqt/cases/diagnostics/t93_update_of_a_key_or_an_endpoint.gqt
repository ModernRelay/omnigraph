# issue: none
# notes: A key property and an edge's endpoints are its identity, which `update` does not change: assigning one is `T93`, whose fix moves the entity by a delete and an insert; nothing executes.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
interface Named { name: String }
node Person implements Named {
    handle: String @key
    name: String
    age: I32?
    city: String?
}
node Company implements Named {
    slug: String @key
    name: String
}
node Doc {
    id: String @key
    title: String
    body: String @index
    year: I32
    tags: [String]
    embedding: Vector(3)?
    payload: Blob?
}
node Collection {
    slug: String @key
    min_docs: I32
}
edge WorksAt: Person -> Company @card(0..1)
edge Knows: Person -> Person
edge Authored: Person -> Doc
edge Cites: Doc -> Doc
edge In: Doc -> Collection

--- seed
{"type":"Person","data":{"handle":"ada","name":"Ada","age":36}}
{"type":"Company","data":{"slug":"acme","name":"Acme"}}

--- mutate
query rename() { match { $p: Person } where $p.handle = "ada"  update $p set { handle: "lovelace" } }

--- expect error: type error: T93: `update $p` assigns `handle`, a key property of `Person`

--- mutate
query move_edge() { match { $a: Person, $a $k:knows $b }  update $k set { @dst: "ada" } }

--- expect error: type error: T93: `update $k` assigns `@dst`, an endpoint of `Knows`
