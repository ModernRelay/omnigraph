# issue: none
# notes: A read whose term this release's planner does not lower is refused at type check with `T86`, naming the construct
# notes: and saying this release does not support it yet, never the stage that adds it: an `optional`'s node returned
# notes: whole and a read that calls itself (`Fix`); nothing executes. The `optional` itself runs. An edge reference
# notes: returned whole is refused too: the result has no edge object, so an edge is read through its fields.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
interface Named { name: String }
node Person implements Named {
    handle: String @key
    name: String
    age: I32?
    city: String?
}
node Company implements Named {
    slug: String @key
    name: String
}
node Doc {
    id: String @key
    title: String
    body: String @index
    year: I32
    tags: [String]
    embedding: Vector(3)?
    payload: Blob?
}
node Collection {
    slug: String @key
    min_docs: I32
}
edge WorksAt: Person -> Company @card(0..1)
edge Knows: Person -> Person
edge Authored: Person -> Doc
edge Cites: Doc -> Doc
edge In: Doc -> Collection

--- seed
{"type":"Person","data":{"handle":"ada","name":"Ada","age":36}}
{"type":"Company","data":{"slug":"acme","name":"Acme"}}

--- query
query q($h: String) { match { $p: Person, optional { $q: Person, $p knows $q } } where $p.handle = $h return { $p.name } }

--- params
{"h": "ada"}

--- expect unordered
{"p.name":"Ada"}

--- expect shape
p.name: String

--- query
query whole($h: String) { match { $p: Person, optional { $q: Person, $p knows $q } } where $p.handle = $h return { $p.name, $q } }

--- params
{"h": "ada"}

--- expect error: type error: T86: `whole`: this release does not support a node an `optional` introduces returned whole (a nullable node object) yet

--- query
query reachable($from: String) {
    match {
        from union(
            { match { $p: Person } where $p.handle = $from return { $p as q } },
            { match { from reachable($from), $r: Person, $q knows $r } return { $r as q } }),
    }
    return distinct { $q }
}

--- params
{"from": "ada"}

--- expect error: type error: T86: `reachable`: this release does not support a read that calls itself (`Fix`) yet

--- query
query edge_whole() { match { $p: Person, $q: Person, $p $k:knows $q } return { $p.name, $k } }

--- expect error: type error: T86: `edge_whole`: this release does not support an edge reference returned whole (the result has no edge object) yet

