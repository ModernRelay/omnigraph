# issue: none
# notes: `collect` gathers scalar values; a reference argument (a node or edge binding) is refused
# notes: with `T86`, since this release has no list of references, and a property of it is the
# notes: lowered form. A Vector or a Blob argument is refused as no list element type.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    handle: String @key
    embedding: Vector(2)?
}
edge Knows: Person -> Person

--- seed
{"type":"Person","data":{"handle":"ann"}}

--- query
query friends() {
    match { $p: Person, $p knows $f }
    return { $p.handle as handle, collect($f) as friends }
}

--- expect error: T86

--- query
query friend_edges() {
    match { $p: Person, $p $k:knows $f }
    return { $p.handle as handle, collect($k) as edges }
}

--- expect error: T86

--- query
query embeddings() {
    match { $p: Person }
    return { collect($p.embedding) as embeddings }
}

--- expect error: T8
