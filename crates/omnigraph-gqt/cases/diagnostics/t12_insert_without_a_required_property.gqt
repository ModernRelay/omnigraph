# issue: none
# notes: The compiler refuses an insert omitting a required property it can never keep, a key property here, with `T12`;
# notes: nothing executes. A keyed insert omitting a required non-key property is an upsert that keeps the stored value,
# notes: refused at run time only for a new key (issue_1278_keyed_insert_keeps_omitted_properties.gqt).

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
interface Named { name: String }
node Person implements Named {
    handle: String @key
    name: String
    age: I32?
    city: String?
}
node Company implements Named {
    slug: String @key
    name: String
}
node Doc {
    id: String @key
    title: String
    body: String @index
    year: I32
    tags: [String]
    embedding: Vector(3)?
    payload: Blob?
}
node Collection {
    slug: String @key
    min_docs: I32
}
edge WorksAt: Person -> Company @card(0..1)
edge Knows: Person -> Person
edge Authored: Person -> Doc
edge Cites: Doc -> Doc
edge In: Doc -> Collection

--- seed
{"type":"Person","data":{"handle":"ada","name":"Ada","age":36}}
{"type":"Company","data":{"slug":"acme","name":"Acme"}}

--- mutate
query w() { insert Person { name: "A" } }

--- expect error: type error: T12:
