# issue: none
# notes: A name holding a character outside ASCII (a type, a variable, an edge) is refused with `Q001` at that character, as an ASCII stray character is; a string or a comment may hold one. Parse recovery once split such a character and panicked.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
interface Named { name: String }
node Person implements Named {
    handle: String @key
    name: String
    age: I32?
    city: String?
}
node Company implements Named {
    slug: String @key
    name: String
}
node Doc {
    id: String @key
    title: String
    body: String @index
    year: I32
    tags: [String]
    embedding: Vector(3)?
    payload: Blob?
}
node Collection {
    slug: String @key
    min_docs: I32
}
edge WorksAt: Person -> Company @card(0..1)
edge Knows: Person -> Person
edge Authored: Person -> Doc
edge Cites: Doc -> Doc
edge In: Doc -> Collection

--- seed
{"type":"Person","data":{"handle":"ada","name":"Zoë","age":36}}
{"type":"Company","data":{"slug":"acme","name":"Acme"}}

--- query
query q() { match { $p: Persön } return { $p.handle } }

--- expect error: parse error: Q001: expected an element (a binding `$x: Type`, a triple `$a edge $b`, `let`, `from` or `optional { }`) or `where <expression>`; found `ö`

--- query
query q() { match { $é: Person } return { $é.handle } limit 1 }

--- expect error: parse error: Q001: expected an element

--- query
query q() { match { $p: Person, $p knöws $q } return { $q.handle } }

--- expect error: parse error: Q001:

--- query
query q() { match { $p: Person } where $p.name = "Zoë return { $p.handle } }

--- expect error: parse error: Q001: expected an expression; found `"`

--- mutate
query w() { insert Persön { handle: "a", name: "b" } }

--- expect error: parse error: Q001:

--- query
query q() { match { $p: Person } where $p.name = "Zoë" /* naïve */ return { $p.handle } }

--- expect unordered
{"p.handle":"ada"}

--- expect shape
p.handle: String
