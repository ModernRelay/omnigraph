# issue: none
# notes: Arguments bind by position, so a defaulted parameter is followed only by defaulted ones: a declaration with a
# notes: required parameter after a defaulted one is refused with `T88` at the declaration, whose printed fix moves the
# notes: defaulted parameters after the others; nothing executes.


--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
interface Named { name: String }
node Person implements Named {
    handle: String @key
    name: String
    age: I32?
    city: String?
}
node Company implements Named {
    slug: String @key
    name: String
}
node Doc {
    id: String @key
    title: String
    body: String @index
    year: I32
    tags: [String]
    embedding: Vector(3)?
    payload: Blob?
}
node Collection {
    slug: String @key
    min_docs: I32
}
edge WorksAt: Person -> Company @card(0..1)
edge Knows: Person -> Person
edge Authored: Person -> Doc
edge Cites: Doc -> Doc
edge In: Doc -> Collection

--- seed
{"type":"Person","data":{"handle":"ada","name":"Ada","age":36}}
{"type":"Company","data":{"slug":"acme","name":"Acme"}}

--- query
query q($min: I32 = 30, $city: String) { match { $p: Person } where $p.age >= $min and $p.city = $city return { $p.name } }

--- params
{"city": "Berlin"}

--- expect error: type error: T88: `q`'s parameter `$min` has a default and `$city` after it has none
