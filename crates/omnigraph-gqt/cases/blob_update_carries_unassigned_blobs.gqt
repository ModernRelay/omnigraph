# issue: none
# notes: An update on a type with two Blob properties assigns one and carries the other.
# notes: The scalars on both sides of each Blob keep their values on a committed row and on a row inserted in the same mutation.
# notes: A null on a non-nullable scalar is refused when the predicate matches no row.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    first: Blob?
    title: String
    second: Blob?
    rank: I64
}

--- seed
{"type":"Doc","data":{"slug":"a","first":"base64:AQID","title":"alpha","second":"base64:BAUG","rank":1}}
{"type":"Doc","data":{"slug":"b","title":"beta","second":"base64:BwgJ","rank":2}}

--- mutate
query assign_first_carry_second($slug: String, $first: Blob?) {
    match { $x: Doc } where $x.slug = $slug
    update $x set { first: $first }
}

--- params
{"slug": "a", "first": "base64:CgsM"}

--- expect affected: nodes=1 edges=0

--- mutate
query clear_first_carry_second($slug: String, $first: Blob?) {
    match { $x: Doc } where $x.slug = $slug
    update $x set { first: $first }
}

--- params
{"slug": "a", "first": null}

--- expect affected: nodes=1 edges=0

--- mutate
query assign_scalar_carry_both($slug: String) {
    match { $x: Doc } where $x.slug = $slug
    update $x set { title: "renamed" }
}

--- params
{"slug": "b"}

--- expect affected: nodes=1 edges=0

--- mutate
query assign_both($slug: String, $first: Blob?, $second: Blob?) {
    match { $x: Doc } where $x.slug = $slug
    update $x set { first: $first, second: $second }
}

--- params
{"slug": "b", "first": "base64:DQ4P", "second": null}

--- expect affected: nodes=1 edges=0

--- mutate
query insert_then_assign_second($first: Blob?, $second: Blob?) {
    insert Doc { slug: "c", first: $first, title: "gamma", rank: 3 }
    match { $x: Doc } where $x.slug = "c"
    update $x set { second: $second }
}

--- params
{"first": "base64:EBES", "second": "base64:ExQV"}

--- expect affected: nodes=2 edges=0

--- mutate
query assign_scalar_over_null_and_stored_blobs() {
    match { $x: Doc } where $x.rank > 1
    update $x set { rank: 9 }
}

--- expect affected: nodes=2 edges=0

--- query
query scalars_after_blob_updates() {
    match { $d: Doc }
    return { $d.slug, $d.title, $d.rank }
}

--- expect unordered
{"d.slug": "a", "d.title": "alpha", "d.rank": 1}
{"d.slug": "b", "d.title": "renamed", "d.rank": 9}
{"d.slug": "c", "d.title": "gamma", "d.rank": 9}

--- expect shape
d.slug: String
d.title: String
d.rank: I64

--- mutate
query null_on_non_nullable_scalar_matching_no_row($slug: String, $rank: I64?) {
    match { $x: Doc } where $x.slug = $slug
    update $x set { rank: $rank }
}

--- params
{"slug": "nobody", "rank": null}

--- expect error: cannot assign null to non-nullable property 'rank' of Doc
