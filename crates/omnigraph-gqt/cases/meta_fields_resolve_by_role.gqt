# issue: none
# notes: Use @id, @src and @dst for system fields. Plain id, src and dst
# notes: refer to declared user properties; otherwise they are errors.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    age: I32?
}
node Doc {
    id: String @key
}
edge Knows: Person -> Person {
    since: I32?
    id: String?
    src: String?
    dst: String?
}

edge Bare: Person -> Person {}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}
{"type":"Person","data":{"name":"bob","age":25}}
{"type":"Doc","data":{"id":"d1"}}
{"edge":"Knows","id":"knows-alice-bob","from":"alice","to":"bob","data":{"since":2020,"id":"edge-data","src":"source-data","dst":"target-data"}}

--- query
query identities() {
    match { $p: Person }
    return { $p.@id, $p.name }
}

--- expect unordered
{"p.@id": "alice", "p.name": "alice"}
{"p.@id": "bob", "p.name": "bob"}

--- expect shape
p.@id: String
p.name: String

--- query
query endpoints() {
    match { $p: Person, $p $e:knows $f }
    return { $e.@src as from, $e.@dst as to, $e.since }
}

--- expect unordered
{"from": "alice", "to": "bob", "e.since": 2020}

--- expect shape
from: String
to: String
e.since: I32?

--- query
query edge_properties_beside_endpoints() {
    match { $p: Person, $p $e:knows $f }
    return { $e.id, $e.src, $e.dst, $e.@src, $e.@dst }
}

--- expect unordered
{"e.id":"edge-data","e.src":"source-data","e.dst":"target-data","e.@src":"alice","e.@dst":"bob"}

--- expect shape
e.id: String?
e.src: String?
e.dst: String?
e.@src: String
e.@dst: String

--- query
query count_identities() {
    match { $p: Person }
    return { count($p.@id) }
}

--- expect unordered
{"p.@id":2}

--- expect shape
p.@id: I64

--- query
query minimum_identity() {
    match { $p: Person }
    return { min($p.@id) }
}

--- expect unordered
{"p.@id":"alice"}

--- expect shape
p.@id: String?

--- query
query minimum_endpoint() {
    match { $p: Person, $p $e:knows $f }
    return { min($e.@src), max($e.@dst) }
}

--- expect unordered
{"e.@src":"alice","e.@dst":"bob"}

--- expect shape
e.@src: String?
e.@dst: String?

--- query
query grouped_identity_order() {
    match { $p: Person }
    return { $p.@id, count($p.name) as n }
    order { $p.@id desc }
}

--- expect unordered
{"p.@id":"bob","n":1}
{"p.@id":"alice","n":1}

--- expect shape
p.@id: String
n: I64

--- query
query grouped_endpoint_order() {
    match { $p: Person, $p $e:knows $f }
    return { $e.@src, count($e.@id) as n }
    order { $e.@src }
}

--- expect unordered
{"e.@src":"alice","n":1}

--- expect shape
e.@src: String
n: I64

--- query
query aggregate_identity_order() {
    match { $p: Person }
    return { count($p.@id) }
    order { $p.@id }
}

--- expect error: T42

--- query
query user_id_beside_identity() {
    match { $d: Doc }
    return { $d.id, $d.@id }
}

--- expect unordered
{"d.id": "d1", "d.@id": "d1"}

--- expect shape
d.id: String
d.@id: String

--- query
query by_identity($who: String) {
    match { $p: Person }
    where $p.@id = $who
    return { $p.name }
}

--- params
{"who": "bob"}

--- expect unordered
{"p.name": "bob"}

--- expect shape
p.name: String

--- query
query last_identity() {
    match { $p: Person }
    return { $p.@id }
    order { $p.@id desc }
    limit 1
}

--- expect unordered
{"p.@id": "bob"}

--- expect shape
p.@id: String

--- query
query filter_endpoint() {
    match { $p: Person, $p $e:knows $f }
    where $e.@dst = "bob"
    return { $e.@id, $f.@id }
}

--- expect unordered
{"e.@id":"knows-alice-bob","f.@id":"bob"}

--- expect shape
e.@id: String
f.@id: String

--- mutate
query birthday() { match { $x: Person } where $x.@id = "bob"  update $x set { age: 26 } }

--- expect affected: nodes=1 edges=0

--- query
query updated() { match { $p: Person } where $p.@id = "bob" return { $p.age } }

--- expect unordered
{"p.age":26}

--- expect shape
p.age: I32?

--- mutate
query absent_edge_identity() { match { $x: Knows } where $x.@id = "absent"  delete $x }

--- expect affected: nodes=0 edges=0

--- mutate
query absent_edge_endpoint() { match { $x: Knows } where $x.@dst = "absent"  delete $x }

--- expect affected: nodes=0 edges=0

--- query
query node_has_no_source() { match { $p: Person } return { $p.@src } }

--- expect error: T6: binding `$p` has no meta-field `@src`; its meta-fields are `@id`

--- query
query node_has_no_owner() { match { $p: Person } return { $p.@owner } }

--- expect error: T6: binding `$p` has no meta-field `@owner`; its meta-fields are `@id`

--- query
query bare_node_id_filter() { match { $p: Person } where $p.id = "alice" return { $p.name } }

--- expect error: T6: type `Person` has no property `id`; the system identity is `$p.@id`

--- query
query bare_edge_id() { match { $p: Person, $p $e:bare $f } return { $e.id } }

--- expect error: T6: edge `Bare` has no property `id`; the system identity is `$e.@id`

--- query
query bare_edge_source() { match { $p: Person, $p $e:bare $f } return { $e.src } }

--- expect error: T6: edge `Bare` has no property `src`; the system endpoint is `$e.@src`

--- query
query bare_edge_destination() { match { $p: Person, $p $e:bare $f } return { $e.dst } }

--- expect error: T6: edge `Bare` has no property `dst`; the system endpoint is `$e.@dst`

--- query
query unknown_node_property() { match { $p: Person } return { $p.salary } }

--- expect error: T6: type `Person` has no property `salary`

--- mutate
query insert_node_id_property() { insert Person { name: "x", id: "x" } }

--- expect error: T11: type `Person` has no property `id`; the engine assigns system identity; it cannot be set through a property assignment

--- mutate
query update_node_id_property() { match { $x: Person } where $x.@id = "alice"  update $x set { id: "x" } }

--- expect error: T11: type `Person` has no property `id`; the engine assigns system identity; it cannot be set through a property assignment

--- mutate
query insert_edge_id_property() { insert Bare { from: "alice", to: "bob", id: "x" } }

--- expect error: T11: type `Bare` has no property `id`; the engine assigns system identity; it cannot be set through a property assignment

--- mutate
query delete_by_bare_source() { match { $x: Bare } where $x.src = "alice"  delete $x }

--- expect error: T6: edge `Bare` has no property `src`; the system endpoint is `$x.@src`

--- mutate
query delete_by_bare_destination() { match { $x: Bare } where $x.dst = "bob"  delete $x }

--- expect error: T6: edge `Bare` has no property `dst`; the system endpoint is `$x.@dst`

--- mutate
query delete_node_by_source() { match { $x: Person } where $x.@src = "alice"  delete $x }

--- expect error: T6: binding `$x` has no meta-field `@src`; its meta-fields are `@id`

--- mutate
query delete_edge_by_owner() { match { $x: Knows } where $x.@owner = "alice"  delete $x }

--- expect error: T6: binding `$x` has no meta-field `@owner`; its meta-fields are `@id`, `@src`, `@dst` and `@type`

--- mutate
query wrong_identity_type($n: I32) { match { $x: Person } where $x.@id = $n  delete $x }

--- params
{"n":1}

--- expect error: T7: cannot compare String with I32

--- query
query bare_id_is_not_the_identity() {
    match { $p: Person }
    return { $p.id }
}

--- expect error: T6: type `Person` has no property `id`; the system identity is `$p.@id`

--- mutate
query unlink($who: String) {
    match { $x: Knows } where $x.@src = $who
    delete $x
}

--- params
{"who": "alice"}

--- expect affected: nodes=0 edges=1

--- mutate
query forget($who: String) {
    match { $x: Person } where $x.@id = $who
    delete $x
}

--- params
{"who": "bob"}

--- expect affected: nodes=1 edges=0

--- mutate
query forget_by_bare_id($who: String) {
    match { $x: Person } where $x.id = $who
    delete $x
}

--- params
{"who": "alice"}

--- expect error: T6: type `Person` has no property `id`; the system identity is `$x.@id`

--- query
query remaining() {
    match { $p: Person }
    return { $p.@id }
}

--- expect unordered
{"p.@id": "alice"}

--- expect shape
p.@id: String
