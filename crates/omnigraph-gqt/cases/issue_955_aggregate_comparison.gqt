--- query
query ordinary_hidden_property_still_orders() {
    match { $p: Person }
    return { $p.slug }
    order { $p.name }
    limit 1
}
--- expect ordered
{"p.slug":"ann"}
--- expect shape
p.slug: String

--- query
query aggregate_metadata_name_still_orders() {
    match { $p: Person }
    return { count($p.@id), count($p) > 0 as present }
    order { $p.@id }
}
--- expect unordered
{"p.@id":3,"present":true}
--- expect shape
p.@id: I64
present: Bool?

--- query
query constant_edge_type_still_orders_groups() {
    match { $f: Forum $f $e:hasMember $p }
    return { $f.title as title, count($p) > 0 as present }
    order { $e.@type }
}
--- expect unordered
{"title":"graph club","present":true}
{"title":"chess","present":true}
--- expect shape
title: String
present: Bool?
