# issue: none
# notes: A literal-only constant folds at compile time, so `{ adult: true or false }` matches
# notes: as `adult = true`.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    slug: String @key
    adult: Bool
}

--- seed
{"type":"Person","data":{"slug":"a","adult":false}}
{"type":"Person","data":{"slug":"b","adult":true}}

--- query
query folded_inline_match() {
    match { $p: Person } where $p.adult = (true or false)
    return { $p.slug }
}

--- expect unordered
{"p.slug": "b"}

--- expect shape
p.slug: String
