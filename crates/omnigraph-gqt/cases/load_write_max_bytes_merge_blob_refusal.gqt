# issue: none
# notes: A merge-mode load uses the session's write_max_bytes: a 4,097-byte base64: value is refused at 4096 and leaves the row unchanged, a 4,096-byte value loads.
# notes: Blob bytes cannot be projected, so the observable is the title written in the same upsert.
# notes: No omnigraph-server environment: served runs refuse settings steps and the HTTP load routes take no setting.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Doc {
    slug: String @key
    title: String
    content: Blob?
}

--- seed
{"type":"Doc","data":{"slug":"a","title":"old","content":"base64:QUFB"}}

--- mutate
set write_max_bytes = 4096;

--- expect ok

--- load generate: v1 seed: 1 mode: merge
tables:
  - kind: node
    name: Doc
    rows: 1
    commits: 1
    columns:
      slug: {kind: literal, value: a}
      title: {kind: literal, value: new}
      content:
        kind: literal
        value: "base64:"
--- expect error: decoded blob input bytes

--- query
query after_refusal() { match { $d: Doc } return { $d.slug, $d.title } }
--- expect unordered
{"d.slug": "a", "d.title": "old"}
--- expect shape
d.slug: String
d.title: String

--- load generate: v1 seed: 1 mode: merge
tables:
  - kind: node
    name: Doc
    rows: 1
    commits: 1
    columns:
      slug: {kind: literal, value: a}
      title: {kind: literal, value: new}
      content:
        kind: literal
        value: "base64:"
--- expect ok

--- query
query after_exact() { match { $d: Doc } return { $d.slug, $d.title } }
--- expect unordered
{"d.slug": "a", "d.title": "new"}
--- expect shape
d.slug: String
d.title: String
