# issue: none
# notes: Passed on PR 662 at f57268dc before this refactor; guards unchanged serial-default semantics.
# notes: Behavioral coverage for bounded merge preparation: four four-row tables.
# notes: Both branches change every table. Alpha and Beta have disjoint edits;
# notes: Gamma and Delta conflict, so refusal must not publish Alpha or Beta.
# notes: Reopen and check every row on both branches. Then restore only the
# notes: conflicting target cells to their base values, retain target-only edits,
# notes: retry, and check the complete combined target and unchanged source.
# notes: This feature case uses production width one. merge_cost.rs retains
# notes: the Rust assertions for widths 1/2/4, conflict ordering, heads, lineage,
# notes: sidecars, bounded resources, and cancellation. No pre-refactor red run
# notes: is claimed for this unchanged logical contract.

--- schema
node Alpha {
    name: String @key
    value: I32
}
node Beta {
    name: String @key
    value: I32
}
node Gamma {
    name: String @key
    value: I32
}
node Delta {
    name: String @key
    value: I32
}

--- seed
{"type":"Alpha","data":{"name":"row-0","value":0}}
{"type":"Alpha","data":{"name":"row-1","value":0}}
{"type":"Alpha","data":{"name":"row-2","value":0}}
{"type":"Alpha","data":{"name":"row-3","value":0}}
{"type":"Beta","data":{"name":"row-0","value":0}}
{"type":"Beta","data":{"name":"row-1","value":0}}
{"type":"Beta","data":{"name":"row-2","value":0}}
{"type":"Beta","data":{"name":"row-3","value":0}}
{"type":"Gamma","data":{"name":"row-0","value":0}}
{"type":"Gamma","data":{"name":"row-1","value":0}}
{"type":"Gamma","data":{"name":"row-2","value":0}}
{"type":"Gamma","data":{"name":"row-3","value":0}}
{"type":"Delta","data":{"name":"row-0","value":0}}
{"type":"Delta","data":{"name":"row-1","value":0}}
{"type":"Delta","data":{"name":"row-2","value":0}}
{"type":"Delta","data":{"name":"row-3","value":0}}

--- mutate
branch create source

--- expect ok

--- mutate branch: source
query source_edits() {
    update Alpha set { value: 10 } where name = "row-0"
    update Beta set { value: 110 } where name = "row-0"
    update Gamma set { value: 210 } where name = "row-0"
    update Delta set { value: 310 } where name = "row-0"
}

--- expect affected: nodes=4 edges=0

--- mutate
query target_edits() {
    update Alpha set { value: 20 } where name = "row-1"
    update Beta set { value: 120 } where name = "row-1"
    update Gamma set { value: 220 } where name = "row-1"
    update Delta set { value: 320 } where name = "row-1"
    update Gamma set { value: 220 } where name = "row-0"
    update Delta set { value: 320 } where name = "row-0"
}

--- expect affected: nodes=6 edges=0

--- mutate
branch merge source into main

--- expect error: merge conflicts

--- restart

--- query branch: main
query refused_main_alpha() {
    match { $n: Alpha }
    return { $n.name, $n.value }
}

