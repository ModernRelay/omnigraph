load csv "counters.csv" into node:Counter mode overwrite header

--- expect error: staged_write_input_bytes

--- mutate
set write_max_bytes = 256;
load csv "counters.csv" into node:Counter mode append header

--- expect error: retained keyed batch bytes per operation

--- mutate
set write_max_bytes = 256;
load csv "counters.csv" into node:Counter mode merge header

--- expect error: retained keyed batch bytes per operation

--- query
query projection_refusals_keep_rows() {
    match { $c: Counter }
    return { $c.id }
}

--- expect unordered
{"c.id": 1}

--- expect shape
c.id: I64

