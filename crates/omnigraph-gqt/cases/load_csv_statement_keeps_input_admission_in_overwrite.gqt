# issue: none
# notes: `write_max_bytes` bounds each staged-write input of a CSV load: an overwrite batch
# notes: over the cap refuses as `staged_write_input_bytes`, a keyed mode's retained batches
# notes: refuse under the keyed adapter's ceiling, and the type keeps its rows either way.
# notes: The bound is per staged write, so an overwrite whose input spans several reader
# notes: batches lands when each batch fits, although the whole input does not.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    id: I64 @key
    name: String
}

node Counter {
    id: I64 @key
}

node Unkeyed { id: I64 }
node Text { id: String }

--- seed
{"type":"Person","data":{"id":1,"name":"alice"}}
{"type":"Counter","data":{"id":1}}
{"type":"Unkeyed","data":{"id":1}}

--- csv people.csv
id,name
2,bob
3,carol
4,dave
5,erin
6,frank
7,grace
8,heidi
9,ivan

--- mutate
set write_max_bytes = 64;
load csv "people.csv" into node:Person mode overwrite header

--- expect error: staged_write_input_bytes

--- query
query unchanged() {
    match { $p: Person }
    return { $p.id, $p.name }
}

--- expect unordered
{"p.id": 1, "p.name": "alice"}

--- expect shape
p.id: I64
p.name: String

--- mutate
load csv "people.csv" into node:Person mode overwrite header

--- expect ok

--- query
query replaced() {
    match { $p: Person }
    return { $p.id }
}

--- expect unordered
{"p.id": 2}
{"p.id": 3}
{"p.id": 4}
{"p.id": 5}
{"p.id": 6}
{"p.id": 7}
{"p.id": 8}
{"p.id": 9}

--- expect shape
p.id: I64

