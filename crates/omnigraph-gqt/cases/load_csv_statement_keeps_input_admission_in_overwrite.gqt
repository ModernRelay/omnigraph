--- mutate
set write_max_bytes = 262144;
load csv "wide_counters.csv" into node:Counter mode overwrite header

--- expect ok

--- expect plan
load route: plan
load write: overwrite fragments
load executed: partitions 1 rows 20000

--- query
query per_batch_bound_admits_the_whole_input() { match { $n: Counter } return { count($n) as n } }
