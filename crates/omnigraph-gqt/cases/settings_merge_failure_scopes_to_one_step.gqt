# issue: none
# notes: A conflicting merge must neither leak its setting override nor
# notes: change either branch, including after restart.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}
{"type":"Person","data":{"name":"bob","age":40}}

--- mutate
set merge_lineage = off;

--- expect ok

--- mutate
branch create source;

--- expect ok

--- mutate branch: source
query bump_on_source() {
    update Person set { age: 31 } where name = "alice"
}

--- expect affected: nodes=1 edges=0

--- mutate
query bump_on_main() {
    update Person set { age: 32 } where name = "alice"
}

--- expect affected: nodes=1 edges=0

--- mutate
set merge_lineage = verify;
branch merge source into main;

--- expect error: merge conflicts

--- query
show merge_lineage;

--- expect unordered
{"name":"merge_lineage","value":"off","default":"on","source":"file","scope":"request"}

--- mutate
reset merge_lineage;
branch merge source into main;

--- expect error: merge conflicts

--- query
show merge_lineage;

--- expect unordered
{"name":"merge_lineage","value":"off","default":"on","source":"file","scope":"request"}

--- restart

--- query branch: source
query source_after_restart() {
    match { $p: Person }
    return { $p.name, $p.age }
}

--- expect unordered
{"p.name":"alice","p.age":31}
{"p.name":"bob","p.age":40}

--- expect shape
p.name: String
p.age: I32

--- query
query main_after_restart() {
    match { $p: Person }
    return { $p.name, $p.age }
}

--- expect unordered
{"p.name":"alice","p.age":32}
{"p.name":"bob","p.age":40}

--- expect shape
p.name: String
p.age: I32
