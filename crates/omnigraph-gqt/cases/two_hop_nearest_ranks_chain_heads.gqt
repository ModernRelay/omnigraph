# issue: none
# notes: `$d knows $t  $t knows $u` over 20 docs with chains 0->1->2, 10->11->12,
# notes: 15->16->17: six docs have an out-edge (30%, Threshold fallback), only the
# notes: three heads have a two-hop path. Limit 2: the first pass (0, 1) keeps
# notes: head 0 and drops middle 1 at the second hop, short; the x4 rerun (0..7)
# notes: adds nothing; the next rung (32) would cover the 20 live rows, so the
# notes: exact pass runs and the answer is the two nearest heads, d000, d010.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    n: I64 @index
    name: String @index
    embedding: Vector(4) @index
}

edge Knows: Doc -> Doc {
}

