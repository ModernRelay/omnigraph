--- query
query scenario($q: Vector(4)) {
    match {
        $d: Doc
        $d knows $t
        $t knows $u
    }
    return { $d.slug }
    order { nearest($d.embedding, $q) }
    limit 2
}

--- params
{"q": [-0.3, 0.0, 0.0, 0.0]}

--- expect ordered
{"d.slug":"d000"}
{"d.slug":"d010"}

--- expect shape
d.slug: String
