--- query
query square_test() {
    match {
        $a: Person
        $b: Person
        $c: Person
        $d: Person
        $a knows $b
        $b knows $c
        $c knows $d
        $a knows $d
    }
    return { count($a) as n }
}

--- expect unordered
{"n": 84}

