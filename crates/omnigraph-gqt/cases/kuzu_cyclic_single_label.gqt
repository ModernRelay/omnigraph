query triangle_filter_test2() {
    match {
        $a: Person
        $b: Person
        $c: Organisation
        $a knows $b
        $b studyAt $c
        $a studyAt $c
        $a.fName = "Alice"
    }
    return { count($a) as n }
}

--- expect unordered
{"n": 1}

--- query
query triangle_filter_with_projection_test() {
    match {
        $a: Person
        $b: Person
        $c: Person
        $a knows $b
        $b knows $c
        $a knows $c
        $a.pk < $b.pk
        $b.pk < $c.pk
    }
    return { $a.fName, $b.fName, $c.fName }
}

