--- query
query triangle_test() {
    match {
        $a: Person
        $b: Person
        $c: Person
        $a knows $b
        $b knows $c
        $a knows $c
    }
    return { count($a) as n }
}

--- expect unordered
{"n": 24}

--- query
query triangle_test_with_edge_filter() {
    match {
        $a: Person
        $b: Person
        $c: Person
        $a $e1:knows $b
        $b $e2:knows $c
        $a $e3:knows $c
        $e1.date = date("1950-05-14")
    }
    return { $a.fName, $e1.date, $b.fName, $e2.date, $c.fName, $e3.date }
}

