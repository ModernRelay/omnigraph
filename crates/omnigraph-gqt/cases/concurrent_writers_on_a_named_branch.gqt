# issue: none
# red_on: none; guard case
# notes: Two writes on a named branch, one overtaking the other between capture and commit: the overtaken insert lands, the overtaken update is refused with graph_head:feature, main is untouched, and feature survives a reopen. End results only; the probe-first revalidation itself is guarded by failpoints.rs.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Person {
    name: String @key
    age: I32
}
node Company { name: String @key }

--- seed
{"type":"Person","data":{"name":"alice","age":30}}

--- mutate
branch create feature
--- expect ok

--- mutate branch: feature
query first_write_on_feature() { insert Person { name: "bob", age: 31 } }
--- expect affected: nodes=1 edges=0

--- concurrent
w1 on feature: query add_carol() { insert Person { name: "carol", age: 32 } }
w2 on feature: query add_acme() { insert Company { name: "acme" } }
order: w1 park put nodes/, w2, w1 put nodes/, w1
--- expect
w1: ok
w2: ok

--- concurrent
u1 on feature: query age_alice() { update Person set { age: 99 } where name = "alice" }
i1 on feature: query add_globex() { insert Company { name: "globex" } }
order: u1 park put nodes/, i1, u1 put nodes/, u1
--- expect
u1: error: graph_head:feature
i1: ok

--- query branch: feature
query people_on_feature() {
    match { $p: Person }
    return { $p.name, $p.age }
}
--- expect unordered
{"p.name":"alice","p.age":30}
{"p.name":"bob","p.age":31}
{"p.name":"carol","p.age":32}
--- expect shape
p.name: String
p.age: I32

--- query branch: feature
query companies_on_feature() {
    match { $c: Company }
    return { $c.name }
}
--- expect unordered
{"c.name":"acme"}
{"c.name":"globex"}
--- expect shape
c.name: String

--- query
query people_on_main() {
    match { $p: Person }
    return { $p.name, $p.age }
}
--- expect unordered
{"p.name":"alice","p.age":30}
--- expect shape
p.name: String
p.age: I32

--- restart

--- query branch: feature
query people_on_feature_after_reopen() {
    match { $p: Person }
    return { $p.name, $p.age }
}
--- expect unordered
{"p.name":"alice","p.age":30}
{"p.name":"bob","p.age":31}
{"p.name":"carol","p.age":32}
--- expect shape
p.name: String
p.age: I32
