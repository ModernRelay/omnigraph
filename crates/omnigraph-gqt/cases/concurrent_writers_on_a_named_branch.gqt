# issue: none
# red_on: none; guard case
# notes: An overtaken insert succeeds; overtaken updates and deletes are refused. Branch results stay isolated and survive reopen.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Person {
    name: String @key
    age: I32
}
node Company { name: String @key }

--- seed
{"type":"Person","data":{"name":"alice","age":30}}
{"type":"Person","data":{"name":"bob","age":31}}

--- mutate
branch create feature
--- expect ok

--- concurrent
w1 on feature: query add_carol() { insert Person { name: "carol", age: 32 } }
w2 on feature: query add_acme() { insert Company { name: "acme" } }
order: w1 park put nodes/, w2, w1 put nodes/, w1
--- expect
w1: ok
w2: ok

--- concurrent
u1 on feature: query age_alice() { update Person set { age: 99 } where name = "alice" }
i1 on feature: query add_globex() { insert Company { name: "globex" } }
order: u1 park put nodes/, i1, u1 put nodes/, u1
--- expect
u1: error: graph_head:feature
i1: ok

--- concurrent
d1 on feature: query delete_alice() { delete Person where name = "alice" }
i2 on feature: query add_initech() { insert Company { name: "initech" } }
order: d1 park put _deletions/, i2, d1 put _deletions/, d1
--- expect
d1: error: graph_head:feature
i2: ok

--- query branch: feature
query people_on_feature() { match { $p: Person } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"alice","p.age":30}
{"p.name":"bob","p.age":31}
{"p.name":"carol","p.age":32}
--- expect shape
p.name: String
p.age: I32

--- query
query people_on_main() { match { $p: Person } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"alice","p.age":30}
{"p.name":"bob","p.age":31}
--- expect shape
p.name: String
p.age: I32

--- query
query no_companies_on_main() { match { $c: Company } return { $c.name } }
--- expect unordered
--- expect shape
c.name: String

--- restart

--- query branch: feature
query people_on_feature_after_reopen() { match { $p: Person } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"alice","p.age":30}
{"p.name":"bob","p.age":31}
{"p.name":"carol","p.age":32}
--- expect shape
p.name: String
p.age: I32

--- query branch: feature
query companies_on_feature_after_reopen() { match { $c: Company } return { $c.name } }
--- expect unordered
{"c.name":"acme"}
{"c.name":"globex"}
{"c.name":"initech"}
--- expect shape
c.name: String
