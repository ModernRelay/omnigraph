--- query
query recall_count($q: String) {
    match {
        $c: Chunk
        search($c.text, $q)
    }
    return { count($c) as total }
    order { bm25($c.text, $q) }
    limit 2
}

--- params
{"q": "needle"}

--- expect unordered
{"total": 20}

--- expect shape
total: I64
