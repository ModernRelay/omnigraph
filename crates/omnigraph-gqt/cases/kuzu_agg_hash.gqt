--- query
query hash_agg_count_int8() {
    match {
        $p: Person
        $o: Organisation
        $p $s:studyAt $o
    }
    return { $s.year, count($s.level) as n }
}

--- expect unordered
{"s.year": 2020, "n": 2}
{"s.year": 2021, "n": 1}

