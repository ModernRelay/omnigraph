# issue: 920
# red_on: main @ 1beab855; before the fix the query reports `value Float(inf) exceeds F64 range` at execution instead of a stable type diagnostic.
# notes: An overflowing decimal float must be refused during type checking before execution.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node N {
    f: F64
    embedding: Vector(2) @index
}

--- seed
{"type":"N","data":{"f":0.0,"embedding":[1.0,0.0]}}

--- query
set engine = v2;
query out_of_range_float_literal() {
    match {
        $x: N
        $x.f < .0
    }
    return { $x.f }
}

--- expect error: T3: float literal is outside the F64 range

--- query
query out_of_range_nearest_vector_literal() {
    match {
        $x: N
    }
    return { $x.f }
    order { nearest($x.embedding, [.0, 0.0]) }
    limit 1
}

--- expect error: T3: float literal is outside the F64 range
