# issue: none
# notes: Already passes on PR 630 at 47cb4c02; guards the empty-delta behavior through the refactor.
# notes: Main and parent have equal rows after a merge. Merging main back must
# notes: preserve the parent's owned history, still borrowed by child. After
# notes: parent changes and restarts, child's first write starts from its pin.
# notes: Reduced from branching.rs::branch_merge_preserves_state_when_native_versions_differ;
# notes: that Rust owner also checks exact registration and no physical empty-delta commit.

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}

--- mutate
branch create parent

--- expect ok

--- mutate branch: parent
query parent_first_write() {
    update Person set { age: 31 } where name = "alice"
}

--- expect affected: nodes=1 edges=0

--- mutate
branch create child from parent

--- expect ok

--- mutate
branch merge parent into main

--- expect outcome: fast_forward

--- mutate
branch merge main into parent

--- expect outcome: fast_forward

--- mutate branch: parent
query owner_next_write() {
    update Person set { age: 32 } where name = "alice"
}

--- expect affected: nodes=1 edges=0

--- restart

--- query branch: child
query child_kept_borrowed_rows() {
    match { $p: Person }
    return { $p.name, $p.age }
}

--- expect unordered
{"p.name":"alice","p.age":31}

--- expect shape
p.name: String
p.age: I32

--- mutate branch: child
query child_first_write() {
    insert Person { name: "bob", age: 40 }
}

--- expect affected: nodes=1 edges=0

--- restart

--- query branch: child
query child_forked_its_old_pin() {
    match { $p: Person }
    return { $p.name, $p.age }
}

--- expect unordered
{"p.name":"alice","p.age":31}
{"p.name":"bob","p.age":40}

--- expect shape
p.name: String
p.age: I32

--- query branch: parent
query child_write_left_parent_unchanged() {
    match { $p: Person }
    return { $p.name, $p.age }
}

--- expect unordered
{"p.name":"alice","p.age":32}

--- expect shape
p.name: String
p.age: I32

--- query
query main_kept_merged_rows() {
    match { $p: Person }
    return { $p.name, $p.age }
}

--- expect unordered
{"p.name":"alice","p.age":31}

--- expect shape
p.name: String
p.age: I32
