# issue: none
# notes: No name starts with "doc-9". Nearest must return no rows.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    n: I64 @index
    name: String @index
    embedding: Vector(4) @index
}

--- seed
{"type":"Doc","data":{"slug":"d000","n":0,"name":"doc-000","embedding":[0.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d001","n":1,"name":"doc-001","embedding":[1.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d002","n":2,"name":"doc-002","embedding":[2.0,0.0,0.0,0.0]}}

--- query
query nearest_without_matches($q: Vector(4)) {
    match {
        $d: Doc
        $d.name starts_with "doc-9"
    }
    return { $d.slug }
    order { nearest($d.embedding, $q) }
    limit 2
}

--- params
{"q": [-0.3, 0.0, 0.0, 0.0]}

--- expect ordered

--- expect shape
d.slug: String
