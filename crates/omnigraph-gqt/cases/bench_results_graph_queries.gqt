--- query
query point_levels($point: String) {
    match {
        $p: BenchmarkPoint { point_id: $point }
        $p has $l
    }
    return {
        $l.factor as factor
        $l.value as value
    }
    order { factor asc }
}
--- params
{"point": "pt-2"}
--- expect ordered
{"factor": "protocol.deadline_seconds", "value": "90"}
{"factor": "protocol.reset", "value": "clone"}
{"factor": "queries_sha256", "value": "q-2"}
--- expect shape
factor: String
value: String

--- query
query points_at($scenario: String, $factor: String, $value: String) {
    match {
        $s: Scenario { name: $scenario }
        $s defines $p
        $l: Level { factor: $factor, value: $value }
        $p has $l
    }
    return {
        $p.point_id as point
        $p.point_name as point_name
    }
    order { point asc }
}
--- params
{"scenario": "branch-merge-d50", "factor": "protocol.deadline_seconds", "value": "90"}
--- expect ordered
{"point": "pt-2", "point_name": "gqt-cold-pt2"}
--- expect shape
point: String
point_name: String
