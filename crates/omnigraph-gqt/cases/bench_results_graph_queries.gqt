--- query
query suite_members() {
    match {
        $u: Suite
        $u groups $s
    }
    return {
        $u.name as suite
        $s.name as scenario
    }
    order { suite asc, scenario asc }
}
--- expect ordered
{"suite": "regression", "scenario": "branch-merge-d50"}
--- expect shape
suite: String
scenario: String

--- query
query scenario_facts() {
    match {
        $s: Scenario
        $s executes $w
        $s uses $f
    }
    return {
        $s.name as scenario
        $s.measured_step as measured_step
        $s.repetitions as repetitions
        $w.path as workload
        $w.sha256 as workload_sha256
        $f.kind as fixture_kind
        $f.path as fixture
    }
    order { scenario asc }
}
--- expect ordered
{"scenario": "branch-merge-d50", "measured_step": "branch merge w0 into main", "repetitions": 5, "workload": "workloads/merge_one.gqt", "workload_sha256": "wl-1", "fixture_kind": "file", "fixture": "fixtures/branches_16.gqt"}
--- expect shape
scenario: String
measured_step: String?
repetitions: U32?
workload: String
workload_sha256: String
fixture_kind: String
fixture: String?

--- query
query run_hosts() {
    match {
        $r: BenchmarkRun
        $r measuredBy $h
        $m hosted $r
    }
    return {
        $r.invocation_id as invocation_id
        $h.sha as harness
        $m.label as machine
        $m.cpu_model as cpu_model
        $m.architecture as architecture
        $m.logical_cores as logical_cores
    }
    order { invocation_id asc }
}
