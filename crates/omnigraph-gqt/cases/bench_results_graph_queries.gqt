--- query
query series_for_scenario($scenario: String) {
    match {
        $s: Scenario { name: $scenario }
        $r ran $s
        $r measures $p
        $r built $c
    }
    return {
        $s.name as scenario
        $p.point_name as point
        $c.sha as commit
        $r.invoked_at_unix_ms as invoked_at_unix_ms
        $r.min_us as min_us
        $r.p50_us as p50_us
        $r.max_us as max_us
        $r.observed_repetitions as repetitions
        $r.claim_eligible as claim_eligible
    }
    order { invoked_at_unix_ms asc }
}
--- params
{"scenario": "branch-merge-d50"}
--- expect ordered
{"scenario": "branch-merge-d50", "point": "gqt-cold-pt1", "commit": "aaaa0001", "invoked_at_unix_ms": 1000, "min_us": 95, "p50_us": 100, "max_us": 110, "repetitions": 5, "claim_eligible": true}
{"scenario": "branch-merge-d50", "point": "gqt-cold-pt1", "commit": "bbbb0002", "invoked_at_unix_ms": 2000, "min_us": 85, "p50_us": 90, "max_us": 99, "repetitions": 5, "claim_eligible": true}
--- expect shape
scenario: String
point: String
commit: String
invoked_at_unix_ms: U64
min_us: U64
p50_us: U64
max_us: U64
repetitions: U32
claim_eligible: Bool

--- query
query suite_series($suite: String) {
    match {
        $u: Suite { name: $suite }
        $u groups $s
        $r ran $s
        $r built $c
    }
    return {
        $s.name as scenario
        $c.sha as commit
        $r.invoked_at_unix_ms as invoked_at_unix_ms
        $r.p50_us as p50_us
        $r.claim_eligible as claim_eligible
    }
    order { scenario asc, invoked_at_unix_ms asc }
}
--- params
{"suite": "regression"}
