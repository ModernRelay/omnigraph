{"scenario": "branch-merge-d50", "commit": "bbbb0002", "invoked_at_unix_ms": 2000, "p50_us": 90, "claim_eligible": true}
--- expect shape
scenario: String
commit: String
invoked_at_unix_ms: U64
p50_us: U64
claim_eligible: Bool

--- query
query runs_for_commit($sha: String) {
    match {
        $c: Revision { sha: $sha }
        $r built $c
        $r measures $p
        $r ran $s
    }
    return {
        $s.name as scenario
        $p.point_name as point
        $r.invocation_id as invocation_id
        $r.invoked_at_unix_ms as invoked_at_unix_ms
        $r.p50_us as p50_us
        $r.acquisition_status as acquisition_status
        $r.claim_eligible as claim_eligible
    }
    order { scenario asc, invoked_at_unix_ms asc }
}
