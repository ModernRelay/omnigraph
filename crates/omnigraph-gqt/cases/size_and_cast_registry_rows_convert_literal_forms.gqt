--- expect error: E6

--- query
query integer_out_of_range() {
    match { $x: C } where $x.k = "d"
    return { cast($x.l, I32) as n }
}

--- expect error: E6

--- query
query negative_to_unsigned() {
    match { $x: C } where $x.k = "a"
    return { cast($x.l, U32) as n }
}

--- expect error: E6

--- query
query float_out_of_integer_range() {
    match { $x: C } where $x.k = "b"
    return { cast($x.f, I32) as n }
}

--- expect error: E6

--- query
query float_out_of_f32_range() {
    match { $x: C } where $x.k = "a"
    return { cast(1.0e300, F32) as n }
}

--- expect error: E6

--- query
query guarded_cast() {
    match { $x: C } where $x.k != "d" and cast($x.s, I64) > 0
    return { $x.k }
}

--- expect unordered
{"x.k":"a"}
{"x.k":"c"}

--- expect shape
x.k: String

--- query
query cast_from_a_vector() {
    match { $x: C } return { cast($x.v, String) as v }
}

--- expect error: T7: `cast` does not convert Vector(2) to String

--- query
query cast_to_a_vector() {
    match { $x: C } return { cast($x.l, Vector(2)) as v }
}

--- expect error: T7: `cast` converts to a scalar type, not `Vector(2)`

--- query
query cast_to_a_node_type() {
    match { $x: C } return { cast($x.l, C) as v }
}

--- expect error: T7: `cast` converts to a scalar type, not `C`

--- query
query cast_a_date_to_a_number() {
    match { $x: C } return { cast($x.d, I64) as v }
}

--- expect error: T7: `cast` does not convert Date to I64

--- query
query cast_a_bool_to_a_float() {
    match { $x: C } return { cast($x.b, F64) as v }
}

--- expect error: T7: `cast` does not convert Bool to F64

--- query
query cast_a_list() {
    match { $x: C } return { cast($x.tags, String) as v }
}

--- expect error: T7: `cast` converts a scalar, got [String]?

--- query
query size_of_a_string() {
    match { $x: C } return { size($x.s) as v }
}

--- expect error: T7: `size` counts a list's elements, got String?
