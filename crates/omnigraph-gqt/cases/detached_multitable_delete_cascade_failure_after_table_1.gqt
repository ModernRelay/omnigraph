# issue: none
# notes: A node delete that cascades into two edge tables fails at the first of its three detached commits while the
# notes: others run: the node and both edges are there before and after a restart, the retry removes them once. Under a delete cascade.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Person {
    name: String @key
}
node Company {
    name: String @key
}
edge Knows: Person -> Person {
    @key(@src, @dst)
}
edge WorksAt: Person -> Company {
    @key(@src, @dst)
}

--- seed
{"type":"Person","data":{"name":"alice"}}
{"type":"Person","data":{"name":"eve"}}
{"type":"Company","data":{"name":"acme"}}
{"edge":"Knows","from":"alice","to":"alice"}
{"edge":"Knows","from":"eve","to":"alice"}
{"edge":"WorksAt","from":"alice","to":"acme"}
{"edge":"WorksAt","from":"eve","to":"acme"}

--- seam
at: mutation.post_table_commit
occurrence: 1
action: fail
scope: next_step

--- mutate branch: main
query w() {
    delete Person where name = "eve"
}
--- expect error: injected failpoint triggered: mutation.post_table_commit

--- query
query before_restart_person() { match { $p: Person } return { $p.name } }
--- expect unordered
{"p.name":"alice"}
{"p.name":"eve"}
--- expect shape
p.name: String

--- query
query before_restart_knows() { match { $p: Person $p knows $q } return { $p.name, $q.name } }
--- expect unordered
{"p.name":"alice","q.name":"alice"}
{"p.name":"eve","q.name":"alice"}
--- expect shape
p.name: String
q.name: String

--- query
query before_restart_worksat() { match { $p: Person $p worksAt $c } return { $p.name, $c.name } }
--- expect unordered
{"c.name":"acme","p.name":"alice"}
{"c.name":"acme","p.name":"eve"}
--- expect shape
p.name: String
c.name: String

--- restart

--- query
query after_restart_person() { match { $p: Person } return { $p.name } }
--- expect unordered
{"p.name":"alice"}
{"p.name":"eve"}
--- expect shape
p.name: String

--- query
query after_restart_knows() { match { $p: Person $p knows $q } return { $p.name, $q.name } }
--- expect unordered
{"p.name":"alice","q.name":"alice"}
{"p.name":"eve","q.name":"alice"}
--- expect shape
p.name: String
q.name: String

--- query
query after_restart_worksat() { match { $p: Person $p worksAt $c } return { $p.name, $c.name } }
--- expect unordered
{"c.name":"acme","p.name":"alice"}
{"c.name":"acme","p.name":"eve"}
--- expect shape
p.name: String
c.name: String

--- mutate branch: main
query w() {
    delete Person where name = "eve"
}
--- expect affected: nodes=1 edges=2

--- restart

--- query
query landed_person() { match { $p: Person } return { $p.name } }
--- expect unordered
{"p.name":"alice"}
--- expect shape
p.name: String

--- query
query landed_knows() { match { $p: Person $p knows $q } return { $p.name, $q.name } }
--- expect unordered
{"p.name":"alice","q.name":"alice"}
--- expect shape
p.name: String
q.name: String

--- query
query landed_worksat() { match { $p: Person $p worksAt $c } return { $p.name, $c.name } }
--- expect unordered
{"c.name":"acme","p.name":"alice"}
--- expect shape
p.name: String
c.name: String
