# issue: 665
# red_on: 2026-09-04, main c253f111: returned 0 rows instead of d001.
# notes: The nearest doc, d000, has no outgoing edge. Retrying with the same limit stays empty;
# notes: a wider retry must find d001.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    embedding: Vector(4) @index
}

edge Knows: Doc -> Doc {
}

--- seed
{"type":"Doc","data":{"slug":"d000","embedding":[0.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d001","embedding":[1.0,0.0,0.0,0.0]}}
{"edge":"Knows","id":"e001","from":"d001","to":"d000","data":{}}

--- query
query nearest_with_edge($q: Vector(4)) {
    match {
        $d: Doc
        $d knows $t
    }
    return { $d.slug }
    order { nearest($d.embedding, $q) }
    limit 1
}

--- params
{"q": [0.0, 0.0, 0.0, 0.0]}

--- expect ordered
{"d.slug": "d001"}

--- expect shape
d.slug: String
