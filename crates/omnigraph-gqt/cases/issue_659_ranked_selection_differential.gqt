--- query
query nearest_named($q: Vector(4)) {
    match { $d: Doc $t: Doc $d knows $t  }
    return { $d.slug as slug }
    order { nearest($d.embedding, $q) }
    limit 3
}
--- params
{"q":[25.3,0.0,0.0,0.0]}
--- expect ordered
{"slug":"d030"}
{"slug":"d020"}
{"slug":"d040"}
--- expect shape
slug: String
--- expect plan
expand $d $t: selection named [Knows out]
expand $d $t: mode indexed_scan ran indexed_scan

--- query
query nearest_alternative($q: Vector(4)) {
    match { $d: Doc $t: Doc $d (knows | knows) $t  }
    return { $d.slug as slug }
    order { nearest($d.embedding, $q) }
    limit 3
}
--- params
{"q":[25.3,0.0,0.0,0.0]}
--- expect ordered
{"slug":"d030"}
{"slug":"d020"}
{"slug":"d040"}
--- expect shape
slug: String
--- expect plan
expand $d $t: selection alternation [Knows out]
expand $d $t: mode indexed_scan ran indexed_scan

--- query
query nearest_wildcard($q: Vector(4)) {
    match { $d: Doc $t: Doc $d * $t  }
    return { $d.slug as slug }
    order { nearest($d.embedding, $q) }
    limit 3
}
--- params
{"q":[25.3,0.0,0.0,0.0]}
--- expect ordered
{"slug":"d030"}
{"slug":"d020"}
{"slug":"d040"}
--- expect shape
slug: String
--- expect plan
expand $d $t: selection wildcard [Knows out]
expand $d $t: mode indexed_scan ran indexed_scan

--- query
query nearest_named_chain($q: Vector(4)) {
    match { $d: Doc $t: Doc $d knows $t $t tagged $m }
    return { $d.slug as slug }
    order { nearest($d.embedding, $q) }
    limit 3
}
--- params
{"q":[25.3,0.0,0.0,0.0]}
--- expect ordered
{"slug":"d030"}
{"slug":"d020"}
{"slug":"d040"}
--- expect shape
slug: String
--- expect plan
expand $d $t: selection named [Knows out]
expand $d $t: mode indexed_scan ran indexed_scan
expand $t $m: selection named [Tagged out]
expand $t $m: mode indexed_scan ran indexed_scan

--- query
query nearest_selected_chain($q: Vector(4)) {
    match { $d: Doc $t: Doc $d knows $t $t (tagged | tagged) $m }
    return { $d.slug as slug }
    order { nearest($d.embedding, $q) }
    limit 3
}
--- params
{"q":[25.3,0.0,0.0,0.0]}
--- expect ordered
{"slug":"d030"}
{"slug":"d020"}
{"slug":"d040"}
--- expect shape
slug: String
--- expect plan
expand $d $t: selection named [Knows out]
expand $d $t: mode indexed_scan ran indexed_scan
expand $t $m: selection alternation [Tagged out]
expand $t $m: mode indexed_scan ran indexed_scan

--- query
query fused_sparse_named($q: Vector(4), $other: Vector(4)) {
    match { $d: Doc $t: Doc $d knows $t }
    return { $d.slug as slug }
    order { rrf(nearest($d.embedding, $q), nearest($d.embedding, $other)) }
    limit 3
}
--- params
{"q":[20.3,0.0,0.0,0.0],"other":[40.3,0.0,0.0,0.0]}
--- expect unordered
{"slug":"d020"}
{"slug":"d040"}
--- expect shape
slug: String
--- expect plan
expand $d $t: selection named [Knows out]
rank fuse row tiebreak [$t.@id]

--- query
query fused_sparse_wildcard($q: Vector(4), $other: Vector(4)) {
    match { $d: Doc $t: Doc $d * $t }
    return { $d.slug as slug }
    order { rrf(nearest($d.embedding, $q), nearest($d.embedding, $other)) }
    limit 3
}
