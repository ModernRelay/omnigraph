# issue: 659
# red_on: 7f1233bb
# traversal: indexed
# notes: Named and selected traversals refill ranked windows after sparse eligibility; every named hop in a selected statement keeps its rows.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc { slug: String @key embedding: Vector(4) @index }
node Marker { slug: String @key }
edge Knows: Doc -> Doc
edge Tagged: Doc -> Marker

