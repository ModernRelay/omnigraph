# issue: none
# notes: 8 docs indexed, then the three nearest to -0.3 (0, 1, 2) deleted: the
# notes: whole first window of limit 3 is gone (3 deleted >= 3), so an engine
# notes: masking deletions after the top-k answers nothing. Deleted rows never
# notes: return and the limit fills from the 5 survivors (5 > 3): d003, d004, d005.

--- schema
node Doc {
    slug: String @key
    n: I64 @index
    name: String @index
    embedding: Vector(4) @index
}

edge Knows: Doc -> Doc {
}

--- seed
{"type":"Doc","data":{"slug":"d000","n":0,"name":"doc-000","embedding":[0.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d001","n":1,"name":"doc-001","embedding":[1.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d002","n":2,"name":"doc-002","embedding":[2.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d003","n":3,"name":"doc-003","embedding":[3.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d004","n":4,"name":"doc-004","embedding":[4.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d005","n":5,"name":"doc-005","embedding":[5.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d006","n":6,"name":"doc-006","embedding":[6.0,0.0,0.0,0.0]}}
{"type":"Doc","data":{"slug":"d007","n":7,"name":"doc-007","embedding":[7.0,0.0,0.0,0.0]}}

--- mutate
query del($s: String) {
    delete Doc where slug = $s
}

--- params
{"s": "d000"}

--- expect affected: nodes=1 edges=0

--- mutate
query del($s: String) {
    delete Doc where slug = $s
}

--- params
{"s": "d001"}

--- expect affected: nodes=1 edges=0

--- mutate
query del($s: String) {
    delete Doc where slug = $s
}

--- params
{"s": "d002"}

--- expect affected: nodes=1 edges=0

--- query
query sweep($q: Vector(4)) {
    match {
        $d: Doc
    }
    return { $d.slug }
    order { nearest($d.embedding, $q) }
    limit 3
}

--- params
{"q": [-0.3, 0.0, 0.0, 0.0]}

--- expect ordered
{"d.slug":"d003"}
{"d.slug":"d004"}
{"d.slug":"d005"}

--- expect shape
d.slug: String
