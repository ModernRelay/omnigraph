# issue: none
# notes: Overlapping delete predicates remove the union of their matches and count
# notes: each node and each cascaded edge once. Every group of a write selects on
# notes: its one snapshot, so three delete groups on one type are refused (`T91`)
# notes: and the union is one group's disjunction.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    age: I32
    team: String
}
edge Knows: Person -> Person

--- seed
{"type":"Person","data":{"name":"Alice","age":30,"team":"red"}}
{"type":"Person","data":{"name":"Bob","age":40,"team":"red"}}
{"type":"Person","data":{"name":"Carol","age":50,"team":"blue"}}
{"type":"Person","data":{"name":"Dave","age":20,"team":"blue"}}
{"edge": "Knows", "from": "Alice", "to": "Bob"}
{"edge": "Knows", "from": "Bob", "to": "Carol"}
{"edge": "Knows", "from": "Carol", "to": "Dave"}
{"edge": "Knows", "from": "Dave", "to": "Alice"}

--- mutate
query delete_three_overlapping($threshold: I32) {
    match { $x: Person } where $x.team = "red"
    delete $x
    match { $x: Person } where $x.age > $threshold
    delete $x
    match { $x: Person } where $x.name = "Alice"
    delete $x
}

--- params
{"threshold": 35}

--- expect error: T91: `delete_three_overlapping`: group 2 selects on type `Person`, which an earlier group of the write changes

--- mutate
query delete_overlapping($threshold: I32) {
    match { $x: Person } where $x.team = "red" or $x.age > $threshold or $x.name = "Alice"
    delete $x
}

--- params
{"threshold": 35}

--- expect affected: nodes=3 edges=4

--- query
query survivors() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "Dave"}

--- expect shape
p.name: String

--- query
query remaining_edges() {
    match { $a: Person, $a knows $b }
    return { $a.name, $b.name }
}

--- expect unordered

--- expect shape
a.name: String
b.name: String
