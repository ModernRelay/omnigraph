--- query
query fused($t: String) {
    match {
        $d: Doc
        $p: Probe
        $d.n = $p.n
    }
    return { $d.slug }
    order { rrf(bm25($d.text, $t), bm25($d.text, $t)) }
    limit 1
}

--- params
{"t":"needle"}

--- expect unordered
{"d.slug":"best"}

--- expect shape
d.slug: String
