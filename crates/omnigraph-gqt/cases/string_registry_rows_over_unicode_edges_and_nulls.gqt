--- query
query lengths_and_windows() {
    match { $x: S }
    return {
        $x.k,
        length($x.s) as len,
        left($x.s, 2) as l2,
        right($x.s, 2) as r2,
        left($x.s, 0) as l0,
        left($x.s, 100) as l100,
        right($x.s, 100) as r100,
        substring($x.s, 2, 3) as s23,
        substring($x.s, 0, 3) as s03,
        substring($x.s, -2, 5) as sm25,
        substring($x.s, 5, 100) as s5,
        substring($x.s, 100, 2) as s100,
        substring($x.s, 3, 0) as s30
    }
}

--- expect unordered
