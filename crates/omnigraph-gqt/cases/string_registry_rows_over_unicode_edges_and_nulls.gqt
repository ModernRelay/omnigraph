# issue: none
# notes: The registry's String rows (the GQ 3 RFC, section 2). `lower` and `upper` are
# notes: Unicode case mappings: `ß` uppercases to `SS`, `İ` lowercases to `i` and a
# notes: combining dot, a word-final capital sigma lowercases to `ς`. `trim`, `ltrim` and
# notes: `rtrim` strip Unicode whitespace (a no-break space, an em space, a tab), never a
# notes: zero-width space, which is not whitespace. `length` counts Unicode scalar values,
# notes: not bytes. `left`, `right` and `substring` count characters too; `substring`'s
# notes: 1-based window is clipped to the string, so a start at or below zero shortens it
# notes: and a start past the end is empty. A row is null where any argument is null. A
# notes: negative count or length is `E5`, and a guard written before the row keeps the
# notes: rows it refuses out; a type error names the row it cannot take.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node S {
    k: String @key
    s: String?
    n: I64?
    tags: [String]?
}

--- seed
{"type":"S","data":{"k":"ascii","s":"Garden Party","n":3}}
{"type":"S","data":{"k":"empty","s":"","n":0}}
{"type":"S","data":{"k":"blank","s":"   ","n":2}}
{"type":"S","data":{"k":"uniws","s":"  \tmid dle\t  ","n":-1}}
{"type":"S","data":{"k":"zwsp","s":"​x y​","n":1}}
{"type":"S","data":{"k":"sharp","s":"Straße","n":5}}
{"type":"S","data":{"k":"dotted","s":"İstanbul","n":1}}
{"type":"S","data":{"k":"sigma","s":"ΣΑΣ ΟΔΟΣ","n":4}}
{"type":"S","data":{"k":"wide","s":"日本語😀ab","n":2,"tags":["x"]}}
{"type":"S","data":{"k":"nulls"}}
{"type":"S","data":{"k":"nulln","s":"abc"}}

--- query
query case_mapping() {
    match { $x: S }
    return { $x.k, lower($x.s) as lo, upper($x.s) as up, length(lower($x.s)) as lo_len, length(upper($x.s)) as up_len }
}

--- expect unordered
{"lo":"   ","lo_len":3,"up":"   ","up_len":3,"x.k":"blank"}
{"lo":"","lo_len":0,"up":"","up_len":0,"x.k":"empty"}
{"lo":"abc","lo_len":3,"up":"ABC","up_len":3,"x.k":"nulln"}
{"lo":"garden party","lo_len":12,"up":"GARDEN PARTY","up_len":12,"x.k":"ascii"}
{"lo":"i̇stanbul","lo_len":9,"up":"İSTANBUL","up_len":8,"x.k":"dotted"}
{"lo":"straße","lo_len":6,"up":"STRASSE","up_len":7,"x.k":"sharp"}
{"lo":"  \tmid dle\t  ","lo_len":13,"up":"  \tMID DLE\t  ","up_len":13,"x.k":"uniws"}
{"lo":"σας οδος","lo_len":8,"up":"ΣΑΣ ΟΔΟΣ","up_len":8,"x.k":"sigma"}
{"lo":"​x y​","lo_len":5,"up":"​X Y​","up_len":5,"x.k":"zwsp"}
{"lo":"日本語😀ab","lo_len":6,"up":"日本語😀AB","up_len":6,"x.k":"wide"}
{"x.k":"nulls"}

--- expect shape
