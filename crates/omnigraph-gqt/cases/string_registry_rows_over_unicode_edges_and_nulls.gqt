--- query
query null_in_every_position() {
    match { $x: S } where $x.k in ["nulls", "nulln", "ascii"]
    return {
        $x.k,
        left($x.s, $x.n) as l,
        right($x.s, $x.n) as r,
        substring($x.s, $x.n, 2) as s_start,
        substring($x.s, 1, $x.n) as s_len,
        substring("abcdef", $x.n, $x.n) as s_both,
        lower($x.s) as lo,
        trim($x.s) as t,
        length($x.s) as len
    }
}

