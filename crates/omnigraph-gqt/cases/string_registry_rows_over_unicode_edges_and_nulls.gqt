--- query
query left_negative_count() {
    match { $x: S } return { $x.k, left($x.s, $x.n) as l }
}

--- expect error: E5

--- query
query right_negative_count() {
    match { $x: S } return { $x.k, right($x.s, $x.n) as r }
}

--- expect error: E5

--- query
query substring_negative_length() {
    match { $x: S } return { $x.k, substring($x.s, 1, $x.n) as s }
}

--- expect error: E5

--- query
query negative_count_in_where() {
    match { $x: S } where left($x.s, $x.n) = "Ga"
    return { $x.k }
}

--- expect error: E5

--- query
query guard_before_the_row() {
    match { $x: S } where $x.n >= 0 and left($x.s, $x.n) = "Gar"
    return { $x.k }
}

--- expect unordered
{"x.k":"ascii"}

--- expect shape
x.k: String

--- query
query guard_inside_if() {
    match { $x: S }
    return { $x.k, if($x.n >= 0, right($x.s, $x.n), "") as r }
}

--- expect unordered
