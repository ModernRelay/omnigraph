# issue: none
# notes: A writer on main parked inside its freshness probe, taken beside its staging puts, while a same-branch writer
# notes: publishes: the probe answered current but the handle's head moved, so the writer probes again under its gates; an insert reprepares and lands, an update is refused with the typed conflict.

--- runner
timeout_ms: 6000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Person {
    name: String @key
    age: I32?
}

--- seed
{"type":"Person","data":{"name":"alice","age":1}}
{"type":"Person","data":{"name":"bob","age":2}}

--- concurrent
w1: query add_dave() { insert Person { name: "dave", age: 4 } }
w2: query add_carol() { insert Person { name: "carol", age: 3 } }
order: w1 head __manifest/_versions/, w1 head __manifest/_versions/, w1 park head __manifest/_versions/, w2 start, w2, w1 head __manifest/_versions/, w1
--- expect
w1: ok
w2: ok

--- query
query both_inserts_landed_once() { match { $p: Person } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"alice","p.age":1}
{"p.name":"bob","p.age":2}
{"p.name":"carol","p.age":3}
{"p.name":"dave","p.age":4}
--- expect shape
p.name: String
p.age: I32?

--- concurrent
w1: query age_alice() { update Person set { age: 9 } where name = "alice" }
w2: query add_erin() { insert Person { name: "erin", age: 5 } }
order: w1 head __manifest/_versions/, w1 head __manifest/_versions/, w1 park head __manifest/_versions/, w2 start, w2, w1 head __manifest/_versions/, w1
--- expect
w1: error: write authority 'graph_head:main' changed during preparation
w2: ok

--- query
query update_refused_insert_landed() { match { $p: Person } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"alice","p.age":1}
{"p.name":"bob","p.age":2}
{"p.name":"carol","p.age":3}
{"p.name":"dave","p.age":4}
{"p.name":"erin","p.age":5}
--- expect shape
p.name: String
p.age: I32?

--- mutate
query add_frank() { insert Person { name: "frank", age: 6 } }
--- expect affected: nodes=1 edges=0

--- restart

--- query
query cold() { match { $p: Person } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"alice","p.age":1}
{"p.name":"bob","p.age":2}
{"p.name":"carol","p.age":3}
{"p.name":"dave","p.age":4}
{"p.name":"erin","p.age":5}
{"p.name":"frank","p.age":6}
--- expect shape
p.name: String
p.age: I32?
