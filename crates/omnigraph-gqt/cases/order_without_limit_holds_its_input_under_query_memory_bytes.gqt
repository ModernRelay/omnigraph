# issue: none
# notes: An outer `order` without `limit` holds its whole input under the query pool and sorts
# notes: once (no spill), so a budget under the held input's cost refuses the query naming
# notes: `query_memory_bytes` and a budget above it returns every row; with a `limit` the sort is a
# notes: streaming top-k holding one batch and `limit` rows, so the same rows fit at a budget the
# notes: held sort refuses. 64 rows with a 1 KiB key: refused at 262144 bytes, every row
# notes: at 4194304, the top five at 262144.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item {
    id: String @key
    v: I64
}

--- seed
{"type":"Item","data":{"id":"a","v":-100}}

--- load generate: v1 seed: 3 mode: append
tables:
  - kind: node
    name: Item
    rows: 64
    commits: 4
    batch_rows: 16
    columns:
      id: {kind: key, prefix: , width: 6}
      v: {kind: ordinal, start: 0, step: 1}
--- expect ok

--- query
set query_memory_bytes = 262144;
query held_sort_refused() {
    match { $i: Item }
    return { $i.v }
    order { $i.id desc }
}

--- expect error: resource limit exceeded for query_memory_bytes

--- query
set query_memory_bytes = 4194304;
query held_sort_fits() {
    match { $i: Item }
    return { $i.v }
    order { $i.id desc }
}

