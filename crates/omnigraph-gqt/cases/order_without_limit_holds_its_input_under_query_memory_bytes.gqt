--- query
set query_memory_bytes = 262144;
query top_k_fits_where_the_held_sort_refused() {
    match { $i: Item }
    return { $i.v }
    order { $i.id desc }
    limit 5
}

--- expect ordered
{"i.v": 63}
{"i.v": 62}
{"i.v": 61}
{"i.v": 60}
{"i.v": 59}

--- expect shape
i.v: I64
