# issue: none
# notes: r1 loads the pre-publish coordinator, parks at its manifest listing, and resumes after w1 installs; the stale-Arc refresh must finish ok and leave the new version installed. A lock-holding engine starves here because the parked read holds the coordinator.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Person {
    name: String @key
}

--- seed
{"type":"Person","data":{"name":"alice"}}

--- concurrent
w1: query add_bob() { insert Person { name: "bob" } }
r1: query all() { match { $p: Person } return { $p.name } }
order: w1 park put __manifest/_versions/, r1 start, r1 park head __manifest/, w1 put __manifest/_versions/, w1, r1 head __manifest/, r1
--- expect
w1: ok
r1: ok

--- query
query all() { match { $p: Person } return { $p.name } }
--- expect unordered
{"p.name":"alice"}
{"p.name":"bob"}
--- expect shape
p.name: String
