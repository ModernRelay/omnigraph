--- query
query q() {
    match { $p: Person, $q: Person, $p knows $q, $q knows $p }
    return { $p.handle, $q.handle }
}

--- expect unordered
{"p.handle":"ada","q.handle":"ada"}

--- expect shape
p.handle: String
q.handle: String

--- expect same as reference

--- query
query q() {
    match { $p knows $q }
    return { $p.handle, $q.handle }
}

--- expect unordered
{"p.handle":"ada","q.handle":"ada"}
{"p.handle":"ada","q.handle":"bob"}
{"p.handle":"bob","q.handle":"cy"}
{"p.handle":"cy","q.handle":"ada"}
{"p.handle":"di","q.handle":"bob"}

--- expect shape
p.handle: String
q.handle: String

--- expect same as reference

--- query
query q() {
    match { $p: Person }
    where exists { $c: Company, $p worksAt $c } and not exists { $q: Person, $q knows $p }
    return { $p.handle }
}

--- expect unordered
{"p.handle":"di"}

--- expect shape
p.handle: String

--- expect same as reference

--- query
query q() {
    match { $p: Person }
    return { $p.city, count($p) as n, sum($p.quota) as total, avg($p.age) as mean, min($p.age) as youngest, max($p.handle) as last, count(distinct $p.age) as ages }
}

--- expect unordered
{"ages":0,"last":"cy","n":1,"p.city":"Paris","total":3}
{"ages":2,"last":"di","mean":27.5,"n":2,"p.city":"London","total":1,"youngest":19}
{"ages":2,"last":"ed","mean":30.5,"n":2,"total":1,"youngest":25}

--- expect shape
p.city: String?
n: I64
total: F64
mean: F64?
youngest: I32?
last: String
ages: I64

--- expect same as reference

--- query
query q() {
    match { $p: Person } where $p.age > 99
    return { count($p) as n, sum($p.quota) as total, min($p.age) as youngest }
}

--- expect unordered
{"n":0}

--- expect shape
n: I64
total: F64?
youngest: I32?

--- expect same as reference

--- query
query q() {
    match { $c: Company }
    where sum($w.since) { $p: Person, $p $w:worksAt $c } > 2015
    return { $c.slug }
}

--- expect unordered
{"c.slug":"acme"}
{"c.slug":"bolt"}

--- expect shape
c.slug: String

--- expect same as reference

--- query
query q() {
    match { $p: Person, $c: Company, $p worksAt $c }
    return distinct { $c.slug, $p.city }
}

--- expect unordered
{"c.slug":"acme","p.city":"London"}
{"c.slug":"acme"}
{"c.slug":"bolt","p.city":"London"}
{"c.slug":"bolt","p.city":"Paris"}

--- expect shape
c.slug: String
p.city: String?

--- expect same as reference

--- query
query q() {
    match { $p: Person, $c: Company, $p worksAt $c }
    return { $c.slug, count($p) as staff }
    order { staff desc, $c.slug }
    limit 2
}

--- expect unordered
{"c.slug":"acme","staff":3}
{"c.slug":"bolt","staff":2}

--- expect shape
c.slug: String
staff: I64

--- expect same as reference

--- query
query q() {
    match { $p: Person, $p $k:knows $q } where $k.weight * 2 + $p.quota > 4
    return { $p.handle, $q.handle, $k.weight - 1 as less, $k.weight % 2 as odd }
}

--- expect unordered
{"less":2,"odd":1,"p.handle":"ada","q.handle":"ada"}

--- expect shape
p.handle: String
q.handle: String
less: I64
odd: I64

--- expect same as reference

--- query
query q() {
    match { $p: Person } where $p.handle in ["ada", "cy", "zed"] or starts_with($p.handle, "e") or contains($p.city, "ari")
    return { $p.handle }
}

--- expect unordered
{"p.handle":"ada"}
{"p.handle":"cy"}
{"p.handle":"ed"}

--- expect shape
p.handle: String

--- expect same as reference
