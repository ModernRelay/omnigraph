# issue: none
# notes: Traversal forms, blocks, aggregates and scalar operators, each over rows that stress
# notes: its rule (a self-loop, a cycle, parallel edges, a null key, an empty group), compared
# notes: with the reference interpreter of the core IR.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    handle: String @key
    age: I32?
    city: String?
    quota: I64?
}
node Company {
    slug: String @key
}
edge WorksAt: Person -> Company {
    since: I64?
}
edge Knows: Person -> Person {
    weight: I64?
}

--- seed
{"type":"Person","data":{"handle":"ada","age":36,"city":"London","quota":1}}
{"type":"Person","data":{"handle":"bob","age":25,"quota":0}}
{"type":"Person","data":{"handle":"cy","city":"Paris","quota":3}}
{"type":"Person","data":{"handle":"di","age":19,"city":"London"}}
{"type":"Person","data":{"handle":"ed","age":36,"quota":1}}
{"type":"Company","data":{"slug":"acme"}}
{"type":"Company","data":{"slug":"bolt"}}
{"type":"Company","data":{"slug":"corp"}}
{"edge":"WorksAt","from":"ada","to":"acme","data":{"since":2010}}
{"edge":"WorksAt","from":"bob","to":"acme","data":{}}
{"edge":"WorksAt","from":"cy","to":"bolt","data":{"since":2015}}
{"edge":"WorksAt","from":"di","to":"acme","data":{"since":2018}}
{"edge":"WorksAt","from":"ada","to":"bolt","data":{"since":2020}}
{"edge":"Knows","from":"ada","to":"bob","data":{"weight":1}}
{"edge":"Knows","from":"bob","to":"cy","data":{"weight":2}}
{"edge":"Knows","from":"cy","to":"ada","data":{}}
{"edge":"Knows","from":"ada","to":"ada","data":{"weight":3}}
{"edge":"Knows","from":"di","to":"bob","data":{"weight":1}}
{"edge":"Knows","from":"di","to":"bob","data":{"weight":5}}

--- query
query q() {
    match { $p: Person, $p knows $q }
    return { $p.handle, $q.handle }
}

--- expect unordered
{"p.handle":"ada","q.handle":"ada"}
{"p.handle":"ada","q.handle":"bob"}
{"p.handle":"bob","q.handle":"cy"}
{"p.handle":"cy","q.handle":"ada"}
{"p.handle":"di","q.handle":"bob"}

--- expect shape
p.handle: String
q.handle: String

--- expect same as reference

--- query
query q() {
    match { $p: Person, $p $k:knows $q }
    return { $p.handle, $q.handle, $k.weight }
}

--- expect unordered
{"k.weight":1,"p.handle":"ada","q.handle":"bob"}
{"k.weight":1,"p.handle":"di","q.handle":"bob"}
{"k.weight":2,"p.handle":"bob","q.handle":"cy"}
{"k.weight":3,"p.handle":"ada","q.handle":"ada"}
{"k.weight":5,"p.handle":"di","q.handle":"bob"}
{"p.handle":"cy","q.handle":"ada"}

--- expect shape
p.handle: String
q.handle: String
k.weight: I64?

--- expect same as reference

--- query
query q() {
    match { $k: Knows }
    return { $k.@src, $k.@dst, $k.weight }
}

--- expect unordered
{"k.@dst":"ada","k.@src":"ada","k.weight":3}
{"k.@dst":"ada","k.@src":"cy"}
{"k.@dst":"bob","k.@src":"ada","k.weight":1}
{"k.@dst":"bob","k.@src":"di","k.weight":1}
{"k.@dst":"bob","k.@src":"di","k.weight":5}
{"k.@dst":"cy","k.@src":"bob","k.weight":2}

--- expect shape
k.@src: String
k.@dst: String
k.weight: I64?

--- expect same as reference

--- query
query q() {
    match { $p: Person, $p knows{1,3} $q }
    return { $p.handle, $q.handle }
}

--- expect unordered
