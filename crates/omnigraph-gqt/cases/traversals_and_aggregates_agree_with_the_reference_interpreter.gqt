{"p.handle":"bob","q.handle":"ada"}
{"p.handle":"bob","q.handle":"cy"}
{"p.handle":"cy","q.handle":"ada"}
{"p.handle":"cy","q.handle":"bob"}
{"p.handle":"di","q.handle":"ada"}
{"p.handle":"di","q.handle":"bob"}
{"p.handle":"di","q.handle":"cy"}

--- expect shape
