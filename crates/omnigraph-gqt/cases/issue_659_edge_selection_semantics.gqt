# issue: 659
# red_on: 7f1233bb
# notes: Bound rows preserve concrete edge identity and order equal IDs by type; unbound rows use distinct endpoints.
# notes: Recursive members share shortest distances; incoming-only paths distinguish undirected traversal.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    name: String @key
}
node Doc {
    slug: String @key
}
edge Knows: Person -> Person {
    weight: I64
    since: I32?
}
edge Likes: Person -> Person {
    weight: I64?
}
edge Owns: Person -> Doc

--- seed
{"type":"Person","data":{"name":"a"}}
{"type":"Person","data":{"name":"b"}}
{"type":"Person","data":{"name":"c"}}
{"type":"Person","data":{"name":"d"}}
{"type":"Person","data":{"name":"e"}}
{"type":"Doc","data":{"slug":"doc"}}
{"edge":"Knows","id":"shared","from":"a","to":"b","data":{"weight":1}}
{"edge":"Knows","id":"ab2","from":"a","to":"b","data":{"weight":2}}
{"edge":"Knows","id":"ac","from":"a","to":"c","data":{"weight":3}}
{"edge":"Knows","id":"loop","from":"a","to":"a","data":{"weight":4}}
{"edge":"Knows","id":"de","from":"d","to":"e","data":{"weight":5}}
{"edge":"Likes","id":"shared","from":"a","to":"b"}
{"edge":"Likes","id":"bc","from":"b","to":"c","data":{"weight":6}}
{"edge":"Likes","id":"bd","from":"b","to":"d","data":{"weight":7}}
{"edge":"Likes","id":"ca","from":"c","to":"a","data":{"weight":8}}
{"edge":"Owns","id":"document","from":"a","to":"doc"}


--- query
query same_id_edges_have_a_total_order() {
    match {
        $from: Person { name: "a" }
        $from $edge:(knows | likes) $to
        $edge.@id = "shared"
    }
    return { $edge.@type as edge_type, $edge.@id as edge_id }
    order { $from.name }
    limit 2
}

--- expect ordered
{"edge_type":"Knows","edge_id":"shared"}
{"edge_type":"Likes","edge_id":"shared"}

--- expect shape
edge_type: String
edge_id: String

--- expect plan
expand $from $to: selection alternation [Knows out, Likes out]
sort tiebreak [$edge.@type, $edge.@id, $from.@id, $to.@id]

--- query
query same_id_order_keeps_type_tiebreak() {
    match {
        $from: Person { name: "a" }
        $from $edge:(knows | likes) $to
        $edge.@id = "shared"
    }
    return { $edge.@type as edge_type, $edge.@id as edge_id }
    order { $edge.@id }
    limit 1
}

--- expect ordered
{"edge_type":"Knows","edge_id":"shared"}

--- expect shape
edge_type: String
edge_id: String

--- expect plan
sort tiebreak [$edge.@type, $from.@id, $to.@id]

--- query
query same_id_alias_order_keeps_wildcard_type_tiebreak() {
    match {
        $from: Person { name: "a" }
        $to: Person
        $from $edge:* $to
        $edge.@id = "shared"
    }
    return { $edge.@type as edge_type, $edge.@id as edge_id }
    order { edge_id }
    limit 1
}

--- expect ordered
{"edge_type":"Knows","edge_id":"shared"}

--- expect shape
edge_type: String
edge_id: String

--- expect plan
expand $from $to: selection wildcard [Knows out, Likes out]
sort tiebreak [$edge.@type, $from.@id, $to.@id]

--- query
query union_explicit_one() {
    match {
        $from: Person { name: "a" }
        $from (knows | likes){1,1} $to
    }
    return { $to.name as destination }
}

--- expect unordered
