# issue: none
# notes: A property is always `$x.p`, so a bare `false` is only ever the literal. The old
# notes: `delete … where` form, whose bare `false` was ambiguous on a type that declares a property
# notes: named `false`, is refused with its fix (Q008); `$x.flag = false` selects the false row.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Flag {
    slug: String @key
    false: Bool
}

node Switch {
    slug: String @key
    flag: Bool
}

--- seed
{"type":"Flag","data":{"slug":"keep","false":true}}
{"type":"Flag","data":{"slug":"delete","false":false}}
{"type":"Switch","data":{"slug":"on","flag":true}}
{"type":"Switch","data":{"slug":"off","flag":false}}

--- mutate
query shadowed_property() {
    delete Flag where false = false
}

--- expect error: is not a statement

--- query
query flags_untouched() {
    match { $f: Flag }
    return { $f.slug }
}

--- expect unordered
{"f.slug": "keep"}
{"f.slug": "delete"}

--- expect shape
f.slug: String

--- mutate
query literal_on_a_plain_type() {
    $x: Switch  $x.flag = false
    delete $x
}

--- expect affected: nodes=1 edges=0

--- query
query switches_after() {
    match { $s: Switch }
    return { $s.slug }
}

--- expect unordered
{"s.slug": "on"}

--- expect shape
s.slug: String
