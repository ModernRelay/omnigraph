# issue: none
# notes: Every member of an edge alternation reaches one node type at each end; members whose ends are different node types are refused. Polymorphism starts at a text this release refuses, so adding it later changes no text that compiles now. The compiler test every_form_polymorphism_adds_is_refused_at_its_construct pins the refusal's position.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
interface Named { name: String }
node Person implements Named {
    handle: String @key
    name: String
}
node Company implements Named {
    slug: String @key
    name: String
}
edge Knows: Person -> Person
edge WorksAt: Person -> Company

--- seed
{"type":"Person","data":{"handle":"ada","name":"Ada"}}
{"type":"Person","data":{"handle":"bob","name":"Bob"}}
{"type":"Company","data":{"slug":"acme","name":"Acme"}}
{"edge":"Knows","from":"ada","to":"bob"}
{"edge":"WorksAt","from":"ada","to":"acme"}

--- query
query contacts() {
    match { $p: Person, $p (knows | worksAt) $y }
    return { $y.name }
}

--- expect error: type error: T5: endpoint `$y` resolves to type `Person` but edge `WorksAt` expects `Company`
