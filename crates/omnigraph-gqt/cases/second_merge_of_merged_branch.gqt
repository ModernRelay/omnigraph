# issue: none
# notes: Merging the same branch twice returns already_up_to_date and keeps its write once.
# notes: Issue 600 concerned a DST driver misreading that valid outcome; the engine was never red.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    name: String @key
}

--- seed
{"type":"Person","data":{"name":"alice"}}

--- mutate
branch create b0

--- expect ok

--- mutate branch: b0
query insert_on_b0() {
    insert Person { name: "bob" }
}

--- expect affected: nodes=1 edges=0

--- mutate
branch merge b0

--- expect outcome: fast_forward

--- mutate
branch merge b0

--- expect outcome: already_up_to_date

--- query
query names_on_main() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "bob"}

--- expect shape
p.name: String
