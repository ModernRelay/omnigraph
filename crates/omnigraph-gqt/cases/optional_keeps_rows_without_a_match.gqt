# issue: none
# notes: `optional { p }` keeps every outer row: a row with matches once per
# notes: match, a row with none once, the names the optional introduces null
# notes: on it and nullable in the result (`Union(Correlate(R, p),
# notes: Project(Filter(R, ¬ exists p), nulls))`). A `where` after it filters the
# notes: joined rows, a filter inside it decides only the matches, and a
# notes: traversal written after it starts from a name it introduces. A write
# notes: group's selection runs it too.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Person {
    handle: String @key
    name: String
    age: I32?
}
node Company {
    slug: String @key
    name: String
}
node City {
    slug: String @key
}
edge WorksAt: Person -> Company
edge Knows: Person -> Person
edge LocatedIn: Company -> City

--- seed
{"type":"Person","data":{"handle":"ada","name":"Ada","age":36}}
{"type":"Person","data":{"handle":"bob","name":"Bob","age":25}}
{"type":"Person","data":{"handle":"cy","name":"Cy","age":41}}
{"type":"Company","data":{"slug":"acme","name":"Acme"}}
{"type":"Company","data":{"slug":"bolt","name":"Bolt"}}
{"type":"City","data":{"slug":"oslo"}}
{"edge":"WorksAt","from":"ada","to":"acme"}
{"edge":"WorksAt","from":"ada","to":"bolt"}
{"edge":"WorksAt","from":"bob","to":"acme"}
{"edge":"Knows","from":"ada","to":"bob"}
{"edge":"Knows","from":"cy","to":"ada"}
{"edge":"LocatedIn","from":"acme","to":"oslo"}

--- query
query employers() { match { $p: Person, optional { $p worksAt $c } } return { $p.handle, $c.slug } }

--- expect unordered
{"c.slug":"acme","p.handle":"ada"}
{"c.slug":"bolt","p.handle":"ada"}
{"c.slug":"acme","p.handle":"bob"}
{"p.handle":"cy"}

--- expect shape
p.handle: String
c.slug: String?

--- query
query filtered_inside() { match { $p: Person, optional { $p worksAt $c where $c.slug = "bolt" } } return { $p.handle, $c.name } }

--- expect unordered
{"c.name":"Bolt","p.handle":"ada"}
{"p.handle":"bob"}
{"p.handle":"cy"}

--- expect shape
p.handle: String
c.name: String?

--- query
query filtered_after() { match { $p: Person, optional { $p worksAt $c } } where $c is null or $c.slug = "bolt" return { $p.handle, $c.slug } }

--- expect unordered
{"c.slug":"bolt","p.handle":"ada"}
{"p.handle":"cy"}

--- expect shape
p.handle: String
c.slug: String?

--- query
query friend_employers() { match { $p: Person, optional { $p knows $f }, $f worksAt $c } return { $p.handle, $f.handle, $c.slug } }

--- expect unordered
{"c.slug":"acme","f.handle":"bob","p.handle":"ada"}
{"c.slug":"acme","f.handle":"ada","p.handle":"cy"}
{"c.slug":"bolt","f.handle":"ada","p.handle":"cy"}

--- expect shape
p.handle: String
f.handle: String?
c.slug: String

--- query
query nested() { match { $p: Person, optional { $p worksAt $c, optional { $c locatedIn $t } } } return { $p.handle, $c.slug, $t.slug } }

--- expect unordered
{"c.slug":"acme","p.handle":"ada","t.slug":"oslo"}
{"c.slug":"bolt","p.handle":"ada"}
{"c.slug":"acme","p.handle":"bob","t.slug":"oslo"}
{"p.handle":"cy"}

--- expect shape
p.handle: String
c.slug: String?
t.slug: String?

--- query
query counted() { match { $p: Person, optional { $p worksAt $c } } return { $p.handle, count($c) as employers } }

--- expect unordered
{"employers":2,"p.handle":"ada"}
{"employers":1,"p.handle":"bob"}
{"employers":0,"p.handle":"cy"}

--- expect shape
p.handle: String
employers: I64


--- mutate
query unemployed_age() {
  match { $p: Person, optional { $p worksAt $c } } where $c is null
  update $p set { age: 0 }
}

--- expect affected: nodes=1 edges=0

--- query
query ages() { match { $p: Person } return { $p.handle, $p.age } }

--- expect unordered
{"p.age":36,"p.handle":"ada"}
{"p.age":25,"p.handle":"bob"}
{"p.age":0,"p.handle":"cy"}

--- expect shape
p.handle: String
p.age: I32?
