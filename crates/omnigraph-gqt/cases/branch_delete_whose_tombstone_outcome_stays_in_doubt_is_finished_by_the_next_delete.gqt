# issue: none
# notes: A delete whose tombstone lands, loses its acknowledgement and cannot be read back answers
# notes: in doubt, and the branch refuses reads and writes as deleted. The next delete retires the
# notes: branch, and after a restart its name is created again from main.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}

--- mutate
branch create b

--- expect ok

--- mutate branch: b
query add_bob_on_b() {
    insert Person { name: "bob", age: 41 }
}

--- expect affected: nodes=1 edges=0

--- seam
at: publish.post_merge_pre_ack
occurrence: 1
action: fail
scope: next_step

--- seam
at: publish.read_back
occurrence: 1
action: fail
scope: next_step

--- mutate
branch delete b

--- expect error: branch row publication outcome is in doubt

--- query branch: b
query read_tombstoned_b() {
    match { $p: Person }
    return { $p.name }
}

--- expect error: branch 'b' was deleted

--- mutate branch: b
query write_tombstoned_b() {
    insert Person { name: "carol", age: 52 }
}

--- expect error: branch 'b' was deleted

--- mutate
branch delete b

--- expect ok

--- query
branch list

--- expect unordered
{"name": "main"}

--- expect shape
name: String

--- restart

--- mutate
branch create b

--- expect ok

--- query branch: b
query names_on_recreated_b() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}

--- expect shape
p.name: String
