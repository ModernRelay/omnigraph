# issue: none
# notes: Criss-cross merges retain two incomparable common ancestors. Both carry a=1,b=1,
# notes: so either exact-ID tie result permits the later a=7 edit. Restart reconstructs
# notes: the candidates from storage; explicit-ID catalog tests pin the tie ordering.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0]

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"a","age":0}}
{"type":"Person","data":{"name":"b","age":0}}

--- mutate
branch create left;

--- expect ok

--- mutate
branch create right;

--- expect ok

--- mutate branch: left
query left_first() {
    update Person set { age: 1 } where age = 0
}

--- expect affected: nodes=2 edges=0

--- mutate branch: right
query right_first() {
    update Person set { age: 1 } where age = 0
}

--- expect affected: nodes=2 edges=0

--- mutate
branch create left_old from left;

--- expect ok

--- mutate
branch create right_old from right;

--- expect ok

--- mutate
branch merge right_old into left;

--- expect outcome: merged

--- mutate
branch merge left_old into right;

--- expect outcome: merged

--- mutate branch: right
query right_later() {
    update Person set { age: 7 } where name = "a"
}

--- expect affected: nodes=1 edges=0

--- restart

--- mutate
branch merge left into right;

--- expect outcome: merged

--- query branch: right
query right_after_merge() {
    match { $p: Person }
    return { $p.name, $p.age }
}

--- expect unordered
{"p.name":"a","p.age":7}
{"p.name":"b","p.age":1}

--- expect shape
p.name: String
p.age: I32
