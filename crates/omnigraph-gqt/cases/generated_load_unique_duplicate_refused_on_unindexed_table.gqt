# issue: none
# notes: A generated node append that repeats an existing @unique email is refused with both holders
# notes: named when the email column has no index, so the scan path still enforces uniqueness.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    id: String @key
    email: String @unique
}
edge Knows: Person -> Person

--- seed generate: v1 seed: 42
tables:
  - kind: node
    name: Person
    rows: 8
    commits: 4
    columns:
      id: {kind: key, prefix: p, width: 6}
      email: {kind: key, prefix: e, width: 6}

--- load generate: v1 seed: 44 mode: append
tables:
  - kind: node
    name: Person
    rows: 1
    commits: 1
    start: 3
    columns:
      id: {kind: key, prefix: q, width: 6}
      email: {kind: key, prefix: e, width: 6}

--- expect error: @unique violation on Person.email: value 'e000003' held by 'p000003' and 'q000003'

