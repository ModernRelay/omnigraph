# issue: none
# notes: Edition-2 `rrf` with its fusion constant written as a third argument, and `rrf` over a binding only a triple
# notes: introduces: `lint --fix` draws each with `from rrf(…, k: <constant>)` over the ranked type, the binding's type
# notes: read from the edge's end, and the rewrite answers as edition 2 did. The hand rewrite is
# notes: crates/omnigraph-gqt/cases/fix_draws_rrf_with_its_fusion_constant.gqt.

# notes: The hand rewrite of crates/omnigraph-gqt/edition-2/fix_draws_rrf_with_its_fusion_constant.gqt, each step the text `lint --fix
# notes: --review-fixes` writes for the edition-2 step: the same rows, which the Cross-Edition Comparison
# notes: checks against edition 2, and the same typed IR, which the lint-fix edition-2 proof checks.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    body: String @index
    emb: Vector(2)
}
node Topic {
    name: String @key
}
edge About: Doc -> Topic

--- seed
{"type":"Doc","data":{"slug":"d1","body":"graph engine","emb":[1.0,0.0]}}
{"type":"Doc","data":{"slug":"d2","body":"graph","emb":[0.0,1.0]}}
{"type":"Topic","data":{"name":"t"}}
{"edge":"About","from":"d1","to":"t"}
{"edge":"About","from":"d2","to":"t"}

--- query
query constant($q: Vector(2)) {
  match { let $all = { match { $d: Doc } return { $d } }, from rrf(nearest($all, $d.emb, $q, k: 2), bm25($all, $d.body, "graph")) as $score, 
    $d: Doc
  }
  return { $d.slug }
  order { $score desc }
  limit 2
}

--- params
{"q": [1.0, 0.0]}

--- expect unordered
{"d.slug":"d1"}
{"d.slug":"d2"}

--- expect shape
d.slug: String

--- query
query through_a_triple($q: Vector(2)) {
  match { let $all = { match { $d: Doc } return { $d } }, from rrf(nearest($all, $d.emb, $q, k: 2), bm25($all, $d.body, "graph")) as $score,  $t: Topic, $d about $t }
  return { $d.slug }
  order { $score desc }
  limit 2
}

--- params
{"q": [1.0, 0.0]}

--- expect unordered
{"d.slug":"d1"}
{"d.slug":"d2"}

--- expect shape
d.slug: String
