# issue: none
# red_on: e588815a; `invalid_case: --- query section starting at line 52 does not parse: expected comp_op` at `sum($m.size) {`, so no step runs; the only aggregate in match today is the bare form, rejected with T7.
# notes: An aggregate over an inner column per outer row, then a predicate on it: sum, min, max, avg.
# notes: An outer row with no inner match has no aggregate and fails every comparison.
# notes: min and max admit what they admit in a return: numbers, String, Bool, Date, DateTime.
# notes: count over a column counts its non-null values; a null bound satisfies nothing; a U64 above the I64 range is kept.
# notes: On v1 a block binding introduced by a scan must still load the argument's column.
# notes: Shared row/error steps inherit the CI engine baseline; only plan assertions select v2.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Actor {
    slug: String @key
}
node Artifact {
    slug: String @key
    size: I64
    score: F64?
    label: String?
    created: Date
    published: Bool
    big: U64?
    weight: F32?
}
edge ArtifactOwnedByActor: Artifact -> Actor {}

--- seed
{"type":"Actor","data":{"slug":"zero"}}
{"type":"Actor","data":{"slug":"small"}}
{"type":"Actor","data":{"slug":"large"}}
{"type":"Artifact","data":{"slug":"s1","size":10,"score":-2.5,"label":"a","created":"2024-01-10","published":false,"weight":0.1}}
{"type":"Artifact","data":{"slug":"s2","size":21,"created":"2024-02-10","published":false,"weight":0.5}}
{"type":"Artifact","data":{"slug":"l1","size":50,"score":0.5,"label":"c","created":"2024-03-10","published":false,"weight":0.25}}
{"type":"Artifact","data":{"slug":"l2","size":70,"score":4.5,"label":"d","created":"2025-06-01","published":true,"big":18446744073709551615,"weight":0.75}}
{"edge":"ArtifactOwnedByActor","from":"s1","to":"small"}
{"edge":"ArtifactOwnedByActor","from":"s2","to":"small"}
{"edge":"ArtifactOwnedByActor","from":"l1","to":"large"}
{"edge":"ArtifactOwnedByActor","from":"l2","to":"large"}

--- query
query total_above_100() {
    match {
        $n: Actor
        sum($m.size) {
            $m artifactOwnedByActor $n
        } > 100
    }
    return { $n.slug }
}
--- expect unordered
{"n.slug":"large"}
--- expect shape
n.slug: String

--- query
query largest_artifact_at_most_21() {
    match {
        $n: Actor
        max($m.size) {
            $m artifactOwnedByActor $n
        } <= 21
    }
    return { $n.slug }
}
--- expect unordered
{"n.slug":"small"}
--- expect shape
n.slug: String

