# issue: 618
# red_on: 2026-09-04, main @ a09176d7: `p.score` read back as 0.9900000095367432 and `p.embedding` as the widened 64-bit digits; `p.note` printed as null instead of omitting its key.
# notes: Keep F32 and vector values at 32-bit precision. DateTime omits Z
# notes: and .000, retains nonzero milliseconds, and null properties omit their keys.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Point {
    name: String @key
    score: F32
    embedding: Vector(3)
    at: DateTime
    note: String?
}

--- seed
{"type":"Point","data":{"name":"p","score":0.99,"embedding":[0.1,0.2,0.3],"at":"2024-01-01T11:54:56.789Z"}}
{"type":"Point","data":{"name":"q","score":1,"embedding":[1,2,3],"at":"2024-01-01T00:00:00Z","note":"kept"}}

--- query
query point_values() {
    match { $p: Point }
    return { $p.name, $p.score, $p.embedding, $p.at, $p.note }
}

--- expect unordered
{"p.name": "p", "p.score": 0.99, "p.embedding": [0.1, 0.2, 0.3], "p.at": "2024-01-01T11:54:56.789"}
{"p.name": "q", "p.score": 1, "p.embedding": [1, 2, 3], "p.at": "2024-01-01T00:00:00", "p.note": "kept"}

--- expect shape
p.name: String
p.score: F32
p.embedding: Vector(3)
p.at: DateTime
p.note: String?
