# issue: none
# notes: Fail the confirm put after table writes but before graph publication.
# notes: Reopen must roll back the Armed intent and leave bob absent.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0]

--- schema
node Person {
    name: String @key
}

--- seed
{"type":"Person","data":{"name":"alice"}}

--- seam
at: mutation.sidecar_confirm_put
occurrence: 1
action: fail
scope: next_step

--- mutate
query add_row() {
    insert Person { name: "bob" }
}

--- expect error: injected failpoint triggered: mutation.sidecar_confirm_put

--- restart

--- query
query rows_after_reopen() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name":"alice"}

--- expect shape
p.name: String
