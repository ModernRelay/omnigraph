# issue: none
# notes: A materializing merge captures the selected write allowance through publication.
# notes: A refused merge leaves target rows unchanged; the exact payload fits with scalar metadata.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Doc {
    slug: String @key
    content: Blob?
    note: String
}

--- seed

--- mutate
branch create source;

--- expect ok

--- mutate branch: source
query insert_source($payload: Blob) {
    insert Doc { slug: "source", content: $payload, note: "source" }
}

--- params
{"payload": "base64:"}

--- expect affected: nodes=1 edges=0

--- mutate
query insert_target() {
    insert Doc { slug: "target", note: "target" }
}

--- expect affected: nodes=1 edges=0

--- mutate
set write_max_bytes = 4092;
branch merge source into main;

--- expect error: materialized blob payload bytes

--- query
query target_before_merge() {
    match { $d: Doc }
    return { $d.slug, $d.note }
}

--- expect unordered
{"d.slug":"target","d.note":"target"}

--- expect shape
d.slug: String
d.note: String

--- mutate
set write_max_bytes = 4093;
branch merge source into main;

--- expect outcome: merged

--- query
query target_after_merge() {
    match { $d: Doc }
    return { $d.slug, $d.note }
}

--- expect unordered
{"d.slug":"source","d.note":"source"}
{"d.slug":"target","d.note":"target"}

--- expect shape
d.slug: String
d.note: String
