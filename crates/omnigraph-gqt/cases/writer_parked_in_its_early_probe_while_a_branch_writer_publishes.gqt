# issue: none
# notes: A writer on main parked inside its freshness probe, the `__manifest/_versions/` heads taken beside its staging
# notes: puts before any gate is held, while a branch writer publishes: main's head is unmoved, so the probe serves under the gates.

--- runner
timeout_ms: 6000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Person {
    name: String @key
    age: I32?
}

--- seed
{"type":"Person","data":{"name":"alice","age":1}}
{"type":"Person","data":{"name":"bob","age":2}}

--- mutate
branch create feature
--- expect ok

--- concurrent
w1: query add_dave() { insert Person { name: "dave", age: 4 } }
w2 on feature: query add_carol() { insert Person { name: "carol", age: 3 } }
order: w1 head __manifest/_versions/, w1 head __manifest/_versions/, w1 park head __manifest/_versions/, w2 start, w2, w1 head __manifest/_versions/, w1
--- expect
w1: ok
w2: ok

--- query
query insert_landed_on_main() { match { $p: Person } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"alice","p.age":1}
{"p.name":"bob","p.age":2}
{"p.name":"dave","p.age":4}
--- expect shape
p.name: String
p.age: I32?

--- query branch: feature
query feature_has_its_own_row() { match { $p: Person } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"alice","p.age":1}
{"p.name":"bob","p.age":2}
{"p.name":"carol","p.age":3}
--- expect shape
p.name: String
p.age: I32?

--- concurrent
w1: query age_alice() { update Person set { age: 9 } where name = "alice" }
w2 on feature: query add_erin() { insert Person { name: "erin", age: 5 } }
order: w1 head __manifest/_versions/, w1 head __manifest/_versions/, w1 park head __manifest/_versions/, w2 start, w2, w1 head __manifest/_versions/, w1
--- expect
w1: ok
w2: ok

--- query
query update_landed_on_main() { match { $p: Person } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"alice","p.age":9}
{"p.name":"bob","p.age":2}
{"p.name":"dave","p.age":4}
--- expect shape
p.name: String
p.age: I32?

--- query branch: feature
query feature_keeps_the_old_value() { match { $p: Person } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"alice","p.age":1}
{"p.name":"bob","p.age":2}
{"p.name":"carol","p.age":3}
{"p.name":"erin","p.age":5}
--- expect shape
p.name: String
p.age: I32?

--- restart

--- query branch: feature
query cold_feature() { match { $p: Person } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"alice","p.age":1}
{"p.name":"bob","p.age":2}
{"p.name":"carol","p.age":3}
{"p.name":"erin","p.age":5}
--- expect shape
p.name: String
p.age: I32?

--- query
query cold_main() { match { $p: Person } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"alice","p.age":9}
{"p.name":"bob","p.age":2}
{"p.name":"dave","p.age":4}
--- expect shape
p.name: String
p.age: I32?
