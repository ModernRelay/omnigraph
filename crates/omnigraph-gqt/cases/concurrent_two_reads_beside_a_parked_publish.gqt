# issue: none
# notes: two readers on one handle both bind the installed state while w1 is parked at its __manifest/_versions/ put; neither waits for the writer nor for the other. After w1 returns every read sees carol.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Person {
    name: String @key
}

--- seed
{"type":"Person","data":{"name":"alice"}}
{"type":"Person","data":{"name":"bob"}}

--- concurrent
w1: query add_carol() { insert Person { name: "carol" } }
r1: query all_a() { match { $p: Person } return { $p.name } }
r2: query all_b() { match { $p: Person } return { $p.name } }
order: w1 park put __manifest/_versions/, r1 start, r2 start, r1, r2, w1 put __manifest/_versions/, w1
--- expect
w1: ok
r1: ok
r2: ok

--- query
query after_publish() { match { $p: Person } return { $p.name } }
--- expect unordered
{"p.name":"alice"}
{"p.name":"bob"}
{"p.name":"carol"}
--- expect shape
p.name: String
