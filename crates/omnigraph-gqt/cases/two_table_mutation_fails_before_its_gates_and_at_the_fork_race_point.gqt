# issue: none
# notes: A two-table insert fails at `mutation.post_stage_pre_effect_gate` (staging puts and the probe beside them done, no
# notes: gate held) and a second one at `fork.before_classify` (gates held, authority revalidated from that probe): nothing is committed, both tables read unchanged, cold too, and each retry lands its rows once.

--- runner
timeout_ms: 6000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Person {
    name: String @key
    age: I32?
}
node Company {
    name: String @key
}

--- seed
{"type":"Person","data":{"name":"alice","age":1}}
{"type":"Person","data":{"name":"bob","age":2}}
{"type":"Company","data":{"name":"acme"}}

--- seam
at: mutation.post_stage_pre_effect_gate
occurrence: 1
action: fail
scope: next_step

--- mutate
query add_both() {
    insert Person { name: "carol", age: 3 }
    insert Company { name: "globex" }
}
--- expect error: injected failpoint triggered: mutation.post_stage_pre_effect_gate

--- query
query people_unchanged_before_gates() { match { $p: Person } return { $p.name } }
--- expect unordered
{"p.name":"alice"}
{"p.name":"bob"}
--- expect shape
p.name: String

--- query
query companies_unchanged_before_gates() { match { $c: Company } return { $c.name } }
--- expect unordered
{"c.name":"acme"}
--- expect shape
c.name: String

--- mutate
query add_both() {
    insert Person { name: "carol", age: 3 }
    insert Company { name: "globex" }
}
--- expect affected: nodes=2 edges=0

--- query
query people_after_first_retry() { match { $p: Person } return { $p.name } }
--- expect unordered
{"p.name":"alice"}
{"p.name":"bob"}
{"p.name":"carol"}
--- expect shape
p.name: String

--- query
query companies_after_first_retry() { match { $c: Company } return { $c.name } }
--- expect unordered
{"c.name":"acme"}
{"c.name":"globex"}
--- expect shape
c.name: String

--- seam
at: fork.before_classify
occurrence: 1
action: fail
scope: next_step

--- mutate
query add_more() {
    insert Person { name: "dave", age: 4 }
    insert Company { name: "initech" }
}
--- expect error: injected failpoint triggered: fork.before_classify

--- query
query people_unchanged_at_fork() { match { $p: Person } return { $p.name } }
--- expect unordered
{"p.name":"alice"}
{"p.name":"bob"}
{"p.name":"carol"}
--- expect shape
p.name: String

--- query
query companies_unchanged_at_fork() { match { $c: Company } return { $c.name } }
--- expect unordered
{"c.name":"acme"}
{"c.name":"globex"}
--- expect shape
c.name: String

--- restart

--- query
query people_cold_after_fork_failure() { match { $p: Person } return { $p.name } }
--- expect unordered
{"p.name":"alice"}
{"p.name":"bob"}
{"p.name":"carol"}
--- expect shape
p.name: String

--- mutate
query add_more() {
    insert Person { name: "dave", age: 4 }
    insert Company { name: "initech" }
}
--- expect affected: nodes=2 edges=0

--- query
query people_after_second_retry() { match { $p: Person } return { $p.name } }
--- expect unordered
{"p.name":"alice"}
{"p.name":"bob"}
{"p.name":"carol"}
{"p.name":"dave"}
--- expect shape
p.name: String

--- query
query companies_after_second_retry() { match { $c: Company } return { $c.name } }
--- expect unordered
{"c.name":"acme"}
{"c.name":"globex"}
{"c.name":"initech"}
--- expect shape
c.name: String
