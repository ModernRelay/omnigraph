# issue: none
# notes: Under set history_release_bytes = 2048; w1 is the releasing publish: parked at its first
# notes: __history/blocks/ put while r1 reads; a loop end one off, or no release, starves the block.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0]

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":0}}
{"type":"Person","data":{"name":"bob","age":0}}

--- mutate
set history_release_bytes = 2048;

--- expect ok

--- mutate
branch create b

--- expect ok

--- loop $i 1 4
--- mutate branch: b
query bump_alice($n: I32) {
    update Person set { age: $n } where name = "alice"
}
--- params
{"n": ${i}}
--- expect affected: nodes=1 edges=0
--- endloop

--- concurrent
w1 on b: query add_carol() { insert Person { name: "carol", age: 1 } }
r1 on b: query all() { match { $p: Person } return { $p.name } }
order: w1 park put __history/blocks/, r1 start, r1, w1 put __history/blocks/, w1
--- expect
w1: ok
r1: ok

--- query branch: b
query people_after_release() { match { $p: Person } return { $p.name, $p.age } }

--- expect unordered
{"p.name":"alice","p.age":3}
{"p.name":"bob","p.age":0}
{"p.name":"carol","p.age":1}

--- expect shape
p.name: String
p.age: I32
