# issue: none
# notes: Writes of one key in one mutation keep only its latest pending version (issue #925).
# notes: Two keyed inserts of "same" leave one pending row, the second, so the update matches one row and its 15,999-byte assignment fits write_max_bytes = 30000.
# notes: The stored row has the second insert's note and the assigned Blob: carrying the Blob is refused at 15998 and admitted at 15999, so it holds exactly 15,999 bytes.
# notes: Distinct rows still add up: the same assignment matching two new rows counts 31,998 and is refused as `decoded blob input bytes per operation`, and neither row is written.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Doc {
    slug: String @key
    content: Blob?
    note: String
}

--- seed

--- mutate
set write_max_bytes = 30000;
query upsert_then_assign($payload: Blob) {
    insert Doc { slug: "same", note: "first" }
    insert Doc { slug: "same", note: "second" }
    update Doc set { content: $payload } where slug = "same"
}

--- params
{"payload": "base64:"}

--- expect affected: nodes=3 edges=0

--- query
query docs_after_assign() {
    match { $d: Doc }
    return { $d.slug, $d.note }
}

--- expect unordered
{"d.slug": "same", "d.note": "second"}

--- expect shape
d.slug: String
d.note: String

--- mutate
set write_max_bytes = 15998;
query carry_one_byte_short() {
    update Doc set { note: "carried" } where slug = "same"
    update Doc set { note: "none" } where slug = "nobody"
}

--- expect error: materialized blob payload bytes

--- mutate
set write_max_bytes = 15999;
query carry_exact() {
    update Doc set { note: "carried" } where slug = "same"
    update Doc set { note: "none" } where slug = "nobody"
}

--- expect affected: nodes=1 edges=0

--- mutate
set write_max_bytes = 30000;
query assign_two_distinct_rows($payload: Blob) {
    insert Doc { slug: "a", note: "fresh" }
    insert Doc { slug: "b", note: "fresh" }
    update Doc set { content: $payload } where note = "fresh"
}

--- params
{"payload": "base64:"}

--- expect error: decoded blob input bytes per operation

--- query
query docs_after_refusal() {
    match { $d: Doc }
    return { $d.slug, $d.note }
}

--- expect unordered
{"d.slug": "same", "d.note": "carried"}

--- expect shape
d.slug: String
d.note: String
