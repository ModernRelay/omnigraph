# issue: none
# notes: Every version of one key written in the same operation counts toward the Blob allowance, though only the latest stays pending.
# notes: The second upsert of key "same" replaces the first, and each assigns the 15,999-byte payload, which counts twice (31,998) and is refused under write_max_bytes = 30000 as `decoded blob input bytes per operation`.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Doc {
    slug: String @key
    content: Blob?
    note: String
}

--- seed

--- mutate
set write_max_bytes = 30000;
query upsert_twice($payload: Blob) {
    replace Doc { slug: "same", note: "first", content: $payload }
    replace Doc { slug: "same", note: "second", content: $payload }
}

--- params
{"payload": "base64:"}

--- expect error: decoded blob input bytes per operation
