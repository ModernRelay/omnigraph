# issue: none
# notes: Writes of one key in one write keep only its latest pending version.
# notes: Two keyed writes of "same" leave one pending row, the second, so the upsert that assigns the Blob keeps its note, and its 15,999-byte assignment fits write_max_bytes = 30000.
# notes: The stored row has the second write's note and the assigned Blob: carrying the Blob is refused at 15998 and admitted at 15999, so it holds exactly 15,999 bytes. The update there shares the write with an upsert of another row, so it rewrites whole rows and carries the Blob rather than patching the note.
# notes: Distinct rows still add up: the same assignment to two new rows counts 31,998 and is refused as `decoded blob input bytes per operation`, and neither row is written.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Doc {
    slug: String @key
    content: Blob?
    note: String
}

--- seed

--- mutate
set write_max_bytes = 30000;
query upsert_then_assign($payload: Blob) {
    replace Doc { slug: "same", note: "first" }
    replace Doc { slug: "same", note: "second" }
    upsert Doc { slug: "same", content: $payload }
}

--- params
{"payload": "base64:"}

--- expect affected: nodes=3 edges=0

--- query
query docs_after_assign() {
    match { $d: Doc }
    return { $d.slug, $d.note }
}

--- expect unordered
{"d.slug": "same", "d.note": "second"}

--- expect shape
d.slug: String
d.note: String

--- mutate
set write_max_bytes = 15998;
query carry_one_byte_short() {
    match { $d: Doc } where $d.slug = "same"
    update $d set { note: "carried" }
    upsert Doc { slug: "spare", note: "none" }
}

--- expect error: materialized blob payload bytes

--- mutate
set write_max_bytes = 15999;
query carry_exact() {
    match { $d: Doc } where $d.slug = "same"
    update $d set { note: "carried" }
    upsert Doc { slug: "spare", note: "none" }
}

--- expect affected: nodes=2 edges=0

--- mutate
set write_max_bytes = 30000;
query assign_two_distinct_rows($payload: Blob) {
    replace Doc { slug: "a", note: "fresh" }
    replace Doc { slug: "b", note: "fresh" }
    upsert Doc { slug: "a", content: $payload }
    upsert Doc { slug: "b", content: $payload }
}

--- params
{"payload": "base64:"}

--- expect error: decoded blob input bytes per operation

--- query
query docs_after_refusal() {
    match { $d: Doc }
    return { $d.slug, $d.note }
}

--- expect unordered
{"d.slug": "same", "d.note": "carried"}
{"d.slug": "spare", "d.note": "none"}

--- expect shape
d.slug: String
d.note: String
