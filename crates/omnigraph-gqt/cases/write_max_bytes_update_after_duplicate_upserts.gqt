# issue: none
# notes: Versions of one key written in the same operation count as input until the last-write-wins fold.
# notes: Two upserts of key "same" leave two pending versions; the update matches both, so its 15,999-byte assignment counts twice (31,998) and is refused under write_max_bytes = 30000 as `decoded blob input bytes per operation`.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Doc {
    slug: String @key
    content: Blob?
    note: String
}

--- seed

--- mutate
set write_max_bytes = 30000;
query upsert_then_assign($payload: Blob) {
    insert Doc { slug: "same", note: "first" }
    insert Doc { slug: "same", note: "second" }
    update Doc set { content: $payload } where slug = "same"
}

--- params
{"payload": "base64:"}

--- expect error: decoded blob input bytes per operation
