# issue: none
# notes: Four main writes put its table version above feature's. Keep these writes separate.
# notes: An untouched child inherits main, then adopts feature's lower-version table.
# notes: The child must read feature's values (the lazy-target case from PR 630).

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"a","age":1}}
{"type":"Person","data":{"name":"b","age":1}}

--- mutate
branch create feature

--- expect ok

--- mutate
query a_2_on_main() {
    match { $x: Person } where $x.name = "a"
    update $x set { age: 2 }
}

--- expect affected: nodes=1 edges=0

--- mutate
query a_3_on_main() {
    match { $x: Person } where $x.name = "a"
    update $x set { age: 3 }
}

--- expect affected: nodes=1 edges=0

--- mutate
query a_4_on_main() {
    match { $x: Person } where $x.name = "a"
    update $x set { age: 4 }
}

--- expect affected: nodes=1 edges=0

--- mutate
query a_5_on_main() {
    match { $x: Person } where $x.name = "a"
    update $x set { age: 5 }
}

--- expect affected: nodes=1 edges=0

--- mutate branch: feature
query b_9_on_feature() {
    match { $x: Person } where $x.name = "b"
    update $x set { age: 9 }
}

--- expect affected: nodes=1 edges=0

--- mutate
branch merge main into feature

--- expect outcome: merged

--- mutate branch: feature
query a_50_on_feature() {
    match { $x: Person } where $x.name = "a"
    update $x set { age: 50 }
}

--- expect affected: nodes=1 edges=0

--- mutate
branch create child

--- expect ok

--- mutate
branch merge feature into child

--- expect outcome: fast_forward

--- query branch: child
query ages_on_child() {
    match { $p: Person }
    return { $p.name, $p.age }
}

--- expect unordered
{"p.name": "a", "p.age": 50}
{"p.name": "b", "p.age": 9}

--- expect shape
p.name: String
p.age: I32
