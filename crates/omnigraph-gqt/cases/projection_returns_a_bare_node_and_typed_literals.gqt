# issue: none
# notes: Return a whole Person beside integer, float, string and boolean
# notes: literals. Preserve the missing age on bob.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    age: I32?
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}
{"type":"Person","data":{"name":"bob"}}

--- query
query tagged_people() {
    match { $p: Person }
    return { $p, 1 as one, 2.5 as ratio, "x" as tag, true as flag }
}

--- expect unordered
{"p": {"@id": "alice", "name": "alice", "age": 30}, "one": 1, "ratio": 2.5, "tag": "x", "flag": true}
{"p": {"@id": "bob", "name": "bob"}, "one": 1, "ratio": 2.5, "tag": "x", "flag": true}

--- expect shape
p: Person
one: I64
ratio: F64
tag: String
flag: Bool


--- query
query numeric_list_literals() {
    match { $p: Person { name: "alice" } }
    return {
        [1, 2.5] as integer_first,
        [2.5, 1] as float_first
    }
}

--- expect unordered
{"integer_first":[1.0,2.5],"float_first":[2.5,1.0]}

--- expect shape
integer_first: [F64]
float_first: [F64]

--- expect plan
result columns [integer_first: [F64], float_first: [F64]]

--- query
query empty_list_literal() {
    match { $p: Person { name: "alice" } }
    return { [] as empty }
}

--- expect unordered
{"empty":[]}

--- expect shape
empty: [String]

--- expect plan
result columns [empty: [String]]

--- query
query incompatible_list_literal() {
    match { $p: Person }
    return { [1, "x"] as xs }
}

--- expect error: T53: list literal elements must share a compatible scalar type

--- query
query nested_list_literal() {
    match { $p: Person }
    return { [[1], [2]] as xs }
}

--- expect error: T52: nested list literals are not supported
