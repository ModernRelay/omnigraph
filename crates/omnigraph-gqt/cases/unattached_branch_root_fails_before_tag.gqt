# issue: none
# notes: A root write that fails after its candidate `__manifest` version is written and before its tag leaves
# notes: the recorded target unchanged and no snapshot; the next root write on the same target succeeds.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}

--- seam
at: propose.post_candidate_pre_tag
occurrence: 1
action: fail
scope: next_step

--- mutate
query root_bob() as unattached branch {
    insert Person { name: "bob", age: 41 }
}

--- expect error: injected failpoint triggered: propose.post_candidate_pre_tag

--- query
query names_on_main_after_failure() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}

--- expect shape
p.name: String

--- mutate
query root_carol() as unattached branch {
    insert Person { name: "carol", age: 52 }
}

--- expect affected: nodes=1 edges=0

--- bind commit $r

--- query snapshot: $r
query names_at_root() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "carol"}

--- expect shape
p.name: String

--- query
query names_on_main() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}

--- expect shape
p.name: String
