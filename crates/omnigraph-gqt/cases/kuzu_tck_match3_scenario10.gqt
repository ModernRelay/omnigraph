--- schema
node A {
    pk: I64 @key
}
edge T: A -> A

--- seed
{"type":"A","data":{"pk":0}}
{"type":"A","data":{"pk":1}}
{"type":"A","data":{"pk":2}}
{"edge":"T","from":"0","to":"1","data":{}}
{"edge":"T","from":"1","to":"2","data":{}}

--- query
query stmt_4() {
    match {
        $a: A
        $b: A
        $a t $b
        $b t $b
    }
    return { $b.pk }
}

