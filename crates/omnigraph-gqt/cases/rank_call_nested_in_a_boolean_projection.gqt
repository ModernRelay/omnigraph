# issue: none
# notes: Projected Boolean expressions over nearest, bm25 and rrf read the retrieval score column.
# notes: Expression and alias secondary keys agree and preserve the leading retrieval order.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    text: String @index
    embedding: Vector(2)
    n: I64?
}

--- seed
{"type":"Doc","data":{"slug":"a","text":"needle","embedding":[1.0,0.0]}}
{"type":"Doc","data":{"slug":"b","text":"needle filler","embedding":[0.0,1.0],"n":10}}

--- query
set engine = v2;
query bm25_threshold($q: String) {
    match { let $pop = { match { $d: Doc } return { $d } }, from bm25($pop, $d.text, $q) as $score }
    return { $d.slug, $score > 0.0 as hit }
    order { $score desc }
    limit 2
}

--- params
{"q": "needle"}

--- expect unordered
{"d.slug": "a", "hit": true}
{"d.slug": "b", "hit": true}

--- expect shape
d.slug: String
hit: Bool

--- query
set engine = v2;
query nearest_threshold($v: Vector(2)) {
    match { let $pop = { match { $d: Doc } return { $d } }, from nearest($pop, $d.embedding, $v, k: 2) as $distance }
    return { $d.slug, $distance < 1.0 as close }
    order { $distance }
    limit 2
}

--- params
{"v": [1.0, 0.0]}

--- expect unordered
{"d.slug": "a", "close": true}
{"d.slug": "b", "close": false}

--- expect shape
d.slug: String
close: Bool

--- query
set engine = v2;
query nearest_threshold_expression($v: Vector(2)) {
    match { let $pop = { match { $d: Doc } return { $d } }, from nearest($pop, $d.embedding, $v, k: 2) as $distance }
    return { $d.slug, $distance < 1.0 as close }
    order { $distance, ($distance < 1.0) asc }
    limit 2
}

--- params
{"v":[1.0,0.0]}

--- expect ordered
{"d.slug":"a","close":true}
{"d.slug":"b","close":false}

--- expect shape
d.slug: String
close: Bool

--- query
set engine = v2;
query nearest_threshold_alias($v: Vector(2)) {
    match { let $pop = { match { $d: Doc } return { $d } }, from nearest($pop, $d.embedding, $v, k: 2) as $distance }
    return { $d.slug, $distance < 1.0 as close }
    order { $distance, close asc }
    limit 2
}

--- params
{"v":[1.0,0.0]}

--- expect ordered
{"d.slug":"a","close":true}
{"d.slug":"b","close":false}

--- expect shape
d.slug: String
close: Bool

--- query
set engine = v2;
query bm25_threshold_expression($q: String) {
    match { let $pop = { match { $d: Doc } return { $d } }, from bm25($pop, $d.text, $q) as $score }
    return { $d.slug, $score > 0.18 as hit }
    order { $score desc, ($score > 0.18) asc }
    limit 2
}

--- params
{"q":"needle"}

--- expect ordered
{"d.slug":"a","hit":true}
{"d.slug":"b","hit":false}

--- expect shape
d.slug: String
hit: Bool

--- query
set engine = v2;
query bm25_threshold_alias($q: String) {
    match { let $pop = { match { $d: Doc } return { $d } }, from bm25($pop, $d.text, $q) as $score }
    return { $d.slug, $score > 0.18 as hit }
    order { $score desc, hit asc }
    limit 2
}

--- params
{"q":"needle"}

--- expect ordered
{"d.slug":"a","hit":true}
{"d.slug":"b","hit":false}

--- expect shape
d.slug: String
hit: Bool

--- query
set engine = v2;
query rrf_threshold_expression($v: Vector(2), $q: String) {
    match { let $all = { match { $d: Doc } return { $d } }, from rrf(nearest($all, $d.embedding, $v, k: 2), bm25($all, $d.text, $q), k: 60) as $score, $d: Doc }
    return { $d.slug, $score > 0.0325 as high }
    order { $score desc, ($score > 0.0325) asc }
    limit 2
}

--- params
{"v":[1.0,0.0],"q":"needle"}

--- expect ordered
{"d.slug":"a","high":true}
{"d.slug":"b","high":false}

--- expect shape
d.slug: String
high: Bool

--- query
set engine = v2;
query rrf_threshold_alias($v: Vector(2), $q: String) {
    match { let $all = { match { $d: Doc } return { $d } }, from rrf(nearest($all, $d.embedding, $v, k: 2), bm25($all, $d.text, $q), k: 60) as $score, $d: Doc }
    return { $d.slug, $score > 0.0325 as high }
    order { $score desc, high asc }
    limit 2
}

--- params
{"v":[1.0,0.0],"q":"needle"}

--- expect ordered
{"d.slug":"a","high":true}
{"d.slug":"b","high":false}

--- expect shape
d.slug: String
high: Bool

--- query
set engine = v2;
query recursive_rank_keys($v: Vector(2)) {
    match { let $pop = { match { $d: Doc } return { $d } }, from nearest($pop, $d.embedding, $v, k: 2) as $distance }
    return {
        $d.slug,
        not ($distance < 1.0) as far,
        $distance is null as missing,
        $distance in [0.0] as exact,
        $distance < 1.0 and $d.n > 5 as eligible
    }
    order {
        $distance,
        (not ($distance < 1.0)) desc,
        ($distance is null) desc,
        ($distance in [0.0]) asc,
        ($distance < 1.0 and $d.n > 5) asc
    }
    limit 2
}

--- params
{"v":[1.0,0.0]}

--- expect ordered
{"d.slug":"a","far":false,"missing":false,"exact":true}
{"d.slug":"b","far":true,"missing":false,"exact":false,"eligible":false}

--- expect shape
d.slug: String
far: Bool
missing: Bool
exact: Bool
eligible: Bool?
