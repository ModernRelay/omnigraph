# issue: none
# notes: The step-2 access rule: a source whose row estimate exceeds one probe chunk (8,192
# notes: keys) makes the overwrite plan read committed endpoints with one projected scan
# notes: matched in memory instead of a filtered probe per chunk, and the plan says so.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    id: String @key
}
edge Knows: Person -> Person

--- seed generate: v1 seed: 11
tables:
  - kind: node
    name: Person
    rows: 2400
    commits: 1
    columns:
      id: {kind: key, prefix: p-, width: 4}

