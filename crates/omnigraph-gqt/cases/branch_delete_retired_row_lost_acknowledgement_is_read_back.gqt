# issue: none
# notes: A delete whose retirement on main's catalog lands and loses its acknowledgement reads the
# notes: entry back and answers ok: the branch leaves the listing, a read of it answers not found,
# notes: and its name is created again from main.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]
  - target: omnigraph-engine-dst
    storage: s3-compatible
    seeds: [0]
  - target: omnigraph-engine-dst
    storage: google-cloud-storage
    seeds: [0]

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}

--- mutate
branch create b

--- expect ok

--- mutate branch: b
query add_bob_on_b() {
    insert Person { name: "bob", age: 41 }
}

--- expect affected: nodes=1 edges=0

--- seam
at: publish.post_merge_pre_ack
occurrence: 2
action: fail
scope: next_step

--- mutate
branch delete b

--- expect ok

--- query
branch list

--- expect unordered
{"name": "main"}

--- expect shape
name: String

--- query branch: b
query read_retired_b() {
    match { $p: Person }
    return { $p.name }
}

--- expect error: branch 'b' not found

--- mutate
branch create b

--- expect ok

--- query branch: b
query names_on_recreated_b() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}

--- expect shape
p.name: String
