# issue: none
# csv_slice_bytes: 4096
# notes: Two parse partitions of 4096 bytes (the pin above; 8 MiB without it); record 100,
# notes: inside partition 1, has an empty field for the non-nullable `name`. A refusal of the
# notes: partitioned run reruns the same plan as one partition and that run's refusal is the
# notes: one reported, naming the source record. Retains a rerun that ran under the work scope
# notes: the first run had closed and surfaced `query work admission is closed` instead.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item {
    id: String @key
    name: String
    n: I64
}

--- seed
{"type":"Item","data":{"id":"seed","name":"s","n":0}}

