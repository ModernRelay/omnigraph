# issue: 640
# red_on: 2026-09-07, score-projection working tree based on upstream ad425c68: steps 1-4 refused with T26 (on that upstream commit: `unsupported projection expression: Nearest { … }` at execution); the refusal steps carried T26 instead of their own codes; the control step green throughout; the no-match step then stayed red at execution (`column '<var>._distance' not found`) until `execute_node_scan`'s zero-row fallback carried the score columns.
# notes: a projected `nearest`/`bm25` reads the score column the retrieval appended (`{var}._distance` /
# notes: `{var}._score`) and must repeat the leading `order` key (T33); `_distance` is the squared L2 distance.
# notes: Repeated raw rank secondary keys use the same projected score, with aliased and default names.
# notes: the bm25 values pin Lance 11's BM25 (k1 1.2, b 0.75, default tokenizer) on this corpus; a Lance bump that changes scoring reds that step by design.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    bio: String @index
    embedding: Vector(2)?
}

edge Knows: Person -> Person {
}

--- seed
{"type":"Person","data":{"name":"A","bio":"needle","embedding":[1.0,0.0]}}
{"type":"Person","data":{"name":"B","bio":"needle needle filler","embedding":[0.0,1.0]}}
{"edge":"Knows","from":"A","to":"B","data":{}}
{"edge":"Knows","from":"B","to":"A","data":{}}

--- query
query nearest_projected($v: Vector(2)) {
    match { let $pop = { match { $p: Person } return { $p } }, from nearest($pop, $p.embedding, $v, k: 2) as $distance }
    return { $p.name, $distance as score }
    order { $distance, $distance }
    limit 2
}

--- params
{"v": [1.0, 0.0]}

--- expect ordered
{"p.name": "A", "score": 0}
{"p.name": "B", "score": 2}

--- expect shape
p.name: String
score: F32

--- query
query nearest_projected_default_name($v: Vector(2)) {
    match { let $pop = { match { $p: Person } return { $p } }, from nearest($pop, $p.embedding, $v, k: 1) as $distance }
    return { $p.name, $distance as _distance }
    order { $distance, $distance }
    limit 1
}

--- params
{"v": [0.0, 1.0]}

--- expect ordered
{"p.name": "B", "_distance": 0}

--- expect shape
p.name: String
_distance: F32

--- query
query bm25_projected($q: String) {
    match { let $pop = { match { $p: Person } return { $p } }, from bm25($pop, $p.bio, $q) as $score }
    return { $p.name, $score as _score }
    order { $score desc, $score desc }
    limit 3
}

--- params
{"q": "needle"}

--- expect ordered
{"p.name": "A", "_score": 0.2292043}
{"p.name": "B", "_score": 0.21978495}

--- expect shape
p.name: String
_score: F32

--- query
query nearest_projected_no_match($v: Vector(2)) {
    match { let $pop = { match { $p: Person } where $p.name = "absent" return { $p } }, from nearest($pop, $p.embedding, $v, k: 2) as $distance }
    return { $p.name, $distance as score }
    order { $distance }
    limit 2
}

--- params
{"v": [1.0, 0.0]}

--- expect unordered

--- expect shape
p.name: String
score: F32

--- query
query bm25_projected_no_match($q: String) {
    match { let $pop = { match { $p: Person } where $p.name = "absent" return { $p } }, from bm25($pop, $p.bio, $q) as $score }
    return { $p.name, $score as score }
    order { $score desc }
    limit 3
}

--- params
{"q": "needle"}

--- expect unordered

--- expect shape
p.name: String
score: F32

--- query
query nearest_projected_without_retrieval($v: Vector(2)) {
    match { $p: Person }
    return { $p.name, nearest($p.embedding, $v) as score }
    order { $p.name }
    limit 2
}

--- params
{"v": [1.0, 0.0]}

--- expect error: T65: `nearest` is a relation function; a ranking is drawn with `from`, and its score is a column

--- query
query nearest_projected_other_query($v: Vector(2)) {
    match { $p: Person }
    return { $p.name, nearest($p.embedding, [0.0, 1.0]) as score }
    order { nearest($p.embedding, $v) }
    limit 2
}

--- params
{"v": [1.0, 0.0]}

--- expect error: T65: `nearest` is a relation function; a ranking is drawn with `from`, and its score is a column

--- query
query nearest_projected_under_aggregate($v: Vector(2)) {
    match { $p: Person }
    return { max(nearest($p.embedding, $v)) as best }
}

--- params
{"v": [1.0, 0.0]}

--- expect error: T65: `nearest` is a relation function; a ranking is drawn with `from`, and its score is a column

--- query
query rrf_projected($q: String, $v: Vector(2)) {
    match { let $all = { match { $p: Person } return { $p } }, from rrf(nearest($all, $p.embedding, $v, k: 3), bm25($all, $p.bio, $q), k: 60) as $score, $p: Person }
    return { $p.name, $score as fused }
    order { $score desc, $score }
    limit 3
}

--- params
{"q": "needle", "v": [1.0, 0.0]}

--- expect ordered
{"p.name": "A", "fused": 0.03278688524590164}
{"p.name": "B", "fused": 0.03225806451612903}

--- expect shape
p.name: String
fused: F64

--- query
query search_projected($q: String) {
    match { $p: Person }
    return { $p.name, search($p.bio, $q) as hit }
}

--- params
{"q": "needle"}

--- expect error: T38: `search` is a search predicate; it must stand alone as a conjunct of `where`

--- query
query alias_projected_again() {
    match { $p: Person }
    return { $p.name as s, s as t }
    limit 1
}

--- expect error: Q018: `s` is a bare name, which is not a value in a read: a property is `$x.s`, a parameter `$s`, a string `"s"`; a bare name is a return alias in `order` only

--- query
query nearest_projected_through_traversal($v: Vector(2)) {
    match {
      let $pop = { match { $p: Person, $f: Person, $p knows $f } return { $p, $f } },
      from nearest($pop, $p.embedding, $v, k: 3) as $distance,
    }
    return { $f.name, $distance as score }
    order { $distance, $f.name }
    limit 3
}

--- params
{"v": [1.0, 0.0]}

--- expect ordered
{"f.name": "B", "score": 0}
{"f.name": "A", "score": 2}

--- expect shape
f.name: String
score: F32

--- query
query nearest_ordered_plain_projection($v: Vector(2)) {
    match { let $pop = { match { $p: Person } return { $p } }, from nearest($pop, $p.embedding, $v, k: 2) as $distance }
    return { $p.name }
    order { $distance }
    limit 2
}

