# issue: 640
# red_on: 2026-09-07, upstream ad425c68 plus task 0150's patch: steps 1-4 refused with T26 (before 0150: `unsupported projection expression: Nearest { … }` at execution); the refusal steps carried T26 instead of their own codes; the control step green throughout; the no-match step then stayed red at execution (`column '<var>._distance' not found`) until `execute_node_scan`'s zero-row fallback carried the score columns.
# notes: a projected `nearest`/`bm25` reads the score column the retrieval appended (`{var}._distance` /
# notes: `{var}._score`) and must repeat the leading `order` key (T33); `_distance` is the squared L2 distance.
# notes: the bm25 values pin Lance 11's BM25 (k1 1.2, b 0.75, default tokenizer) on this corpus; a Lance bump that changes scoring reds that step by design.

--- schema
node Person {
    name: String @key
    bio: String @index
    embedding: Vector(2)?
}

edge Knows: Person -> Person {
}

--- seed
{"type":"Person","data":{"name":"A","bio":"needle","embedding":[1.0,0.0]}}
{"type":"Person","data":{"name":"B","bio":"needle needle filler","embedding":[0.0,1.0]}}
{"edge":"Knows","from":"A","to":"B","data":{}}
{"edge":"Knows","from":"B","to":"A","data":{}}

--- query
query nearest_projected($v: Vector(2)) {
    match { $p: Person }
    return { $p.name, nearest($p.embedding, $v) as score }
    order { nearest($p.embedding, $v) }
    limit 2
}

--- params
{"v": [1.0, 0.0]}

--- expect ordered
{"p.name": "A", "score": 0}
{"p.name": "B", "score": 2}

--- expect shape
p.name: String
score: F32

--- query
query nearest_projected_default_name($v: Vector(2)) {
    match { $p: Person }
    return { $p.name, nearest($p.embedding, $v) }
    order { nearest($p.embedding, $v) }
    limit 1
}

--- params
{"v": [0.0, 1.0]}

--- expect ordered
{"p.name": "B", "p._distance": 0}

--- expect shape
p.name: String
p._distance: F32

--- query
query bm25_projected($q: String) {
    match { $p: Person }
    return { $p.name, bm25($p.bio, $q) }
    order { bm25($p.bio, $q) desc }
    limit 3
}

--- params
{"q": "needle"}

--- expect ordered
{"p.name": "A", "p._score": 0.2292043}
{"p.name": "B", "p._score": 0.21978495}

--- expect shape
p.name: String
p._score: F32

--- query
query nearest_projected_no_match($v: Vector(2)) {
    match { $p: Person { name: "absent" } }
    return { $p.name, nearest($p.embedding, $v) as score }
    order { nearest($p.embedding, $v) }
    limit 2
}

--- params
{"v": [1.0, 0.0]}

--- expect unordered

--- expect shape
p.name: String
score: F32

