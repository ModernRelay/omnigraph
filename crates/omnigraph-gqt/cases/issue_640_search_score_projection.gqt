query bm25_projected_no_match($q: String) {
    match { $p: Person { name: "absent" } }
    return { $p.name, bm25($p.bio, $q) as score }
    order { bm25($p.bio, $q) desc }
    limit 3
}

--- params
{"q": "needle"}

--- expect unordered

--- expect shape
p.name: String
score: F32

--- query
query nearest_projected_without_retrieval($v: Vector(2)) {
    match { $p: Person }
    return { $p.name, nearest($p.embedding, $v) as score }
    order { $p.name }
    limit 2
}

--- params
{"v": [1.0, 0.0]}

--- expect error: T33: `nearest` in `return` must repeat the retrieval stated as the leading `order` key

--- query
query nearest_projected_other_query($v: Vector(2)) {
    match { $p: Person }
    return { $p.name, nearest($p.embedding, [0.0, 1.0]) as score }
    order { nearest($p.embedding, $v) }
    limit 2
}

--- params
{"v": [1.0, 0.0]}

--- expect error: T33: `nearest` in `return` must repeat the retrieval stated as the leading `order` key

--- query
query nearest_projected_under_aggregate($v: Vector(2)) {
    match { $p: Person }
    return { max(nearest($p.embedding, $v)) as best }
}

--- params
{"v": [1.0, 0.0]}

--- expect error: T32: `nearest` under `max` in `return`

--- query
query rrf_projected($q: String, $v: Vector(2)) {
    match { $p: Person }
    return { $p.name, rrf(nearest($p.embedding, $v), bm25($p.bio, $q)) as fused }
    order { rrf(nearest($p.embedding, $v), bm25($p.bio, $q)) }
    limit 3
}

--- params
{"q": "needle", "v": [1.0, 0.0]}

--- expect error: T37: `rrf` cannot be projected in `return`

--- query
query search_projected($q: String) {
    match { $p: Person }
    return { $p.name, search($p.bio, $q) as hit }
}

--- params
{"q": "needle"}

--- expect error: T35: `search` cannot be projected in `return`

--- query
query alias_projected_again() {
    match { $p: Person }
    return { $p.name as s, s as t }
    limit 1
}

--- expect error: T36: `s` cannot be projected in `return`

--- query
query nearest_projected_through_traversal($v: Vector(2)) {
    match {
        $p: Person
        $p knows $f
    }
    return { $f.name, nearest($p.embedding, $v) as score }
    order { nearest($p.embedding, $v), $f.name }
    limit 3
}

--- params
{"v": [1.0, 0.0]}

--- expect ordered
{"f.name": "B", "score": 0}
{"f.name": "A", "score": 2}

--- expect shape
f.name: String
score: F32

--- query
query nearest_ordered_plain_projection($v: Vector(2)) {
    match { $p: Person }
    return { $p.name }
    order { nearest($p.embedding, $v) }
    limit 2
}

--- params
{"v": [1.0, 0.0]}

--- expect ordered
{"p.name": "A"}
{"p.name": "B"}

--- expect shape
