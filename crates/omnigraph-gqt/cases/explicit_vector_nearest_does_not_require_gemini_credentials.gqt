# issue: none
# notes: A `nearest` given an explicit vector parameter needs no embedding provider: the case
# notes: worker runs with a cleared environment (no GEMINI_API_KEY, no OMNIGRAPH_EMBEDDINGS_MOCK)
# notes: and still ranks. The stored vectors are the old Rust fixture's mock embeddings of
# notes: "alpha", "beta" and "gamma" at 8 decimals; the query is alpha's. Replaces the Rust test
# notes: explicit_vector_nearest_does_not_require_gemini_credentials (search.rs).

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    title: String @index
    embedding: Vector(4) @index
}

--- seed
{"type":"Doc","data":{"slug":"alpha-doc","title":"alpha guide","embedding":[-0.54204881,-0.47179943,0.16090508,0.67653376]}}
{"type":"Doc","data":{"slug":"beta-doc","title":"beta guide","embedding":[0.66596329,-0.56221950,-0.41636753,0.25892115]}}
{"type":"Doc","data":{"slug":"gamma-doc","title":"gamma handbook","embedding":[0.50424933,0.25277379,0.44896162,-0.69301629]}}

--- query
query vector_search_vector($q: Vector(4)) {
    match { $d: Doc }
    return { $d.slug, $d.title }
    order { nearest($d.embedding, $q) }
    limit 3
}

--- params
{"q": [-0.54204881, -0.47179943, 0.16090508, 0.67653376]}

--- expect ordered
{"d.slug": "alpha-doc", "d.title": "alpha guide"}
{"d.slug": "beta-doc", "d.title": "beta guide"}
{"d.slug": "gamma-doc", "d.title": "gamma handbook"}

--- expect shape
d.slug: String
d.title: String
