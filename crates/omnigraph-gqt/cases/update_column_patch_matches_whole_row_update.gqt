--- expect ok

--- mutate branch: feature
query patch_on_feature() {
    update Doc set { score: 9 } where age = 5
}

--- expect affected: nodes=1 edges=0

--- mutate
query patch_on_main() {
    update Doc set { score: 8 } where age = 0
}

--- expect affected: nodes=1 edges=0

--- mutate
branch merge feature into main

--- expect outcome: merged

--- mutate
branch create feature_rows from rows

--- expect ok

--- mutate branch: feature_rows
query rewrite_on_feature() {
    update Doc set { score: 9 } where age = 5
    update Doc set { score: 0 } where slug = "nobody"
}

--- expect affected: nodes=1 edges=0

--- mutate branch: rows
query rewrite_on_rows() {
    update Doc set { score: 8 } where age = 0
    update Doc set { score: 0 } where slug = "nobody"
}

--- expect affected: nodes=1 edges=0

--- mutate
branch merge feature_rows into rows

--- expect outcome: merged

--- query
query scores_after_merge() {
    match { $d: Doc }
    return { $d.slug, $d.score, $d.emb }
    order { $d.slug asc }
}

