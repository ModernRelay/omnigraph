--- query
query nearest_first($q: Vector(4)) {
    match { $d: Doc }
    return { $d.slug }
    order { nearest($d.emb, $q) }
    limit 6
}

--- params
{"q": [0.5, 0.5, 0.5, 0.5]}

--- expect ordered
{"d.slug":"d-04"}
{"d.slug":"d-05"}
{"d.slug":"d-02"}
{"d.slug":"d-00"}
{"d.slug":"d-03"}
{"d.slug":"d-01"}

--- expect shape
d.slug: String

--- query branch: rows
query nearest_first($q: Vector(4)) {
    match { $d: Doc }
    return { $d.slug }
    order { nearest($d.emb, $q) }
