# issue: none
# notes: An update that assigns only scalars on a type with a Blob and a vector patches the assigned
# notes: columns in place (issue #1264) when it is the mutation's only write to the type; beside a
# notes: second statement on the type it rewrites whole rows. Both answer alike: the same rows,
# notes: vectors and nearest ranking, the same graph diff, and a later whole-row update, a delete and
# notes: a patch over a fragment with a deleted row read the same on both branches. Validation
# notes: refuses a patched `@range` or `@unique` violation as it refuses a whole-row one, and a
# notes: three-way branch merge of patched commits gives what one of whole-row commits gives.
# notes: The rows cannot show which path ran. The patch on `main` is pinned by the Rust test
# notes: `writes.rs::update_of_one_scalar_patches_instead_of_rewriting_blobs_and_vectors_issue_1264`
# notes: (the committed transaction is `RewriteColumns`) and by the DST storage-cost golden rows
# notes: `UpdatePatchBlob*` against `UpdateRowsBlob1M`.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Doc {
    slug: String @key
    age: I32
    score: I32?
    code: String? @unique
    content: Blob?
    emb: Vector(4)?
    @range(score, 0..100)
}

node Marker {
    name: String @key
}

--- seed generate: v1 seed: 7
tables:
  - kind: node
    name: Doc
    rows: 6
    commits: 1
    columns:
      slug: {kind: key, prefix: d-, width: 2}
      age: {kind: ordinal, start: 0, step: 1}
      code: {kind: key, prefix: c-, width: 2}
      content: {kind: blob, byte: 9, length: 64}
      emb: {kind: vector, dimensions: 4}

--- mutate
query mark() {
    insert Marker { name: "seeded" }
}

--- expect affected: nodes=1 edges=0

--- bind commit $seeded

--- mutate
branch create rows

--- expect ok

--- mutate
query patch_scores() {
    update Doc set { score: 5 } where age >= 2
}

--- expect affected: nodes=4 edges=0

--- mutate branch: rows
query rewrite_scores() {
    update Doc set { score: 5 } where age >= 2
    update Doc set { score: 0 } where slug = "nobody"
}

--- expect affected: nodes=4 edges=0

--- query
query scores() {
    match { $d: Doc }
    return { $d.slug, $d.age, $d.score }
    order { $d.slug asc }
}

--- expect ordered
{"d.age":0,"d.slug":"d-00"}
{"d.age":1,"d.slug":"d-01"}
{"d.age":2,"d.score":5,"d.slug":"d-02"}
{"d.age":3,"d.score":5,"d.slug":"d-03"}
{"d.age":4,"d.score":5,"d.slug":"d-04"}
{"d.age":5,"d.score":5,"d.slug":"d-05"}

--- expect shape
d.slug: String
d.age: I32
d.score: I32?

--- query branch: rows
query scores() {
    match { $d: Doc }
    return { $d.slug, $d.age, $d.score }
    order { $d.slug asc }
}

--- expect ordered
{"d.age":0,"d.slug":"d-00"}
{"d.age":1,"d.slug":"d-01"}
{"d.age":2,"d.score":5,"d.slug":"d-02"}
{"d.age":3,"d.score":5,"d.slug":"d-03"}
{"d.age":4,"d.score":5,"d.slug":"d-04"}
{"d.age":5,"d.score":5,"d.slug":"d-05"}

