--- mutate
query patch_out_of_range() {
    update Doc set { score: 500 } where age = 0
}

--- expect error: @range violation on Doc.score

--- mutate branch: rows
query rewrite_out_of_range() {
    update Doc set { score: 500 } where age = 0
    update Doc set { score: 0 } where slug = "nobody"
}

--- expect error: @range violation on Doc.score

--- mutate
query patch_duplicate_code() {
    update Doc set { code: "c-03" } where age = 0
}

--- expect error: @unique violation on Doc.code

--- mutate branch: rows
query rewrite_duplicate_code() {
    update Doc set { code: "c-03" } where age = 0
    update Doc set { score: 0 } where slug = "nobody"
}

--- expect error: @unique violation on Doc.code

--- mutate
query delete_one() {
    delete Doc where slug = "d-01"
}

--- expect affected: nodes=1 edges=0

--- mutate branch: rows
query delete_one() {
    delete Doc where slug = "d-01"
}

--- expect affected: nodes=1 edges=0

--- mutate
query patch_again() {
    update Doc set { score: 7 } where age < 4
}

--- expect affected: nodes=3 edges=0

--- mutate branch: rows
query rewrite_again() {
    update Doc set { score: 7 } where age < 4
    update Doc set { score: 0 } where slug = "nobody"
}

--- expect affected: nodes=3 edges=0

--- query
query scores_after_delete() {
    match { $d: Doc }
    return { $d.slug, $d.score }
    order { $d.slug asc }
}

