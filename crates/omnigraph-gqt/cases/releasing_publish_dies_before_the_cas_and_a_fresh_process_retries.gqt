# issue: none
# notes: Under set history_release_bytes = 2048; the insert after the loop releases b's block; publish.pre_merge fails it
# notes: after the __history put, a restart drops the handle, and the retried insert puts the block again, accepts the
# notes: equal copy and lands; the merge of s then finds its base in the released block, warm and after a second restart.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0]

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":0}}
{"type":"Person","data":{"name":"bob","age":0}}

--- mutate
set history_release_bytes = 2048;

--- expect ok

--- mutate
branch create b

--- expect ok

--- mutate
branch create s from b

--- expect ok

--- mutate branch: s
query set_bob_on_s() {
    update Person set { age: 7 } where name = "bob"
}

--- expect affected: nodes=1 edges=0

--- loop $i 1 4
--- mutate branch: b
query bump_alice($n: I32) {
    update Person set { age: $n } where name = "alice"
}
--- params
{"n": ${i}}
--- expect affected: nodes=1 edges=0
--- endloop

--- seam
at: publish.pre_merge
occurrence: 1
action: fail
scope: next_step

--- mutate branch: b
query interrupted_releasing_publish() { insert Person { name: "carol", age: 1 } }

--- expect error: injected failpoint triggered: publish.pre_merge

--- restart

--- concurrent
w1 on b: query retried_releasing_publish() { insert Person { name: "carol", age: 1 } }
r1 on b: query all() { match { $p: Person } return { $p.name } }
order: w1 park put __history/blocks/, r1 start, r1, w1 put __history/blocks/, w1
--- expect
w1: ok
r1: ok

--- query branch: b
query rows_after_retry() { match { $p: Person } return { $p.name, $p.age } }

--- expect unordered
{"p.name":"alice","p.age":3}
{"p.name":"bob","p.age":0}
{"p.name":"carol","p.age":1}

--- expect shape
p.name: String
p.age: I32

--- mutate
branch merge s into b

--- expect outcome: merged

--- query branch: b
query rows_after_merge() { match { $p: Person } return { $p.name, $p.age } }

--- expect unordered
{"p.name":"alice","p.age":3}
{"p.name":"bob","p.age":7}
{"p.name":"carol","p.age":1}

--- expect shape
p.name: String
p.age: I32

--- restart

--- query branch: b
query rows_after_second_reopen() { match { $p: Person } return { $p.name, $p.age } }

--- expect unordered
{"p.name":"alice","p.age":3}
{"p.name":"bob","p.age":7}
{"p.name":"carol","p.age":1}

--- expect shape
p.name: String
p.age: I32
