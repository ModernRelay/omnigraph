# issue: none
# notes: Settings keywords remain valid identifiers: set is a property,
# notes: Show/show is an edge type/hop, and all is a branch name.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    set: String
}

edge Show: Person -> Person

--- seed
{"type":"Person","data":{"name":"alice","set":"on"}}
{"type":"Person","data":{"name":"bob","set":"off"}}
{"edge":"Show","from":"alice","to":"bob"}

--- query
query keywords() {
    match {
        $a: Person
        $a show $b
    }
    return { $a.set, $b.name }
}

--- expect unordered
{"a.set": "on", "b.name": "bob"}

--- expect shape
a.set: String
b.name: String

--- mutate
branch create all;

--- expect ok

--- query
branch list;

--- expect unordered
{"name": "all"}
{"name": "main"}

--- expect shape
name: String
