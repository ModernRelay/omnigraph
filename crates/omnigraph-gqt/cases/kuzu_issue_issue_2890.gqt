--- schema
node SpotTableNode {
    model_key: String @key
    technical_name: String?
    name: String?
    row_count: I64?
}
node SpotColumnNode {
    model_key: String @key
    technical_name: String?
    name: String?
    p_unique: F64?
    p_distinct: F64?
    p_missing: F64?
    common_values: [String]?
}
edge SpotTableToCol: SpotTableNode -> SpotColumnNode

