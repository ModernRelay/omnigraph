--- mutate
branch create tgt

--- expect ok

--- mutate
branch create a

--- expect ok

--- mutate
branch create b

--- expect ok

--- mutate branch: a
query ins($n: String, $v: I64, $e: Vector(4)) {
    insert Person { name: $n, value: $v, text: "needle", embedding: $e }
}

--- params
{"n": "a1", "v": 1000, "e": [1000.0, 0.0, 0.0, 0.0]}

--- expect affected: nodes=1 edges=0

--- mutate
branch merge a into tgt

--- expect outcome: fast_forward

--- mutate branch: b
query ins($n: String, $v: I64, $e: Vector(4)) {
    insert Person { name: $n, value: $v, text: "needle", embedding: $e }
}

--- params
{"n": "b1", "v": 3000, "e": [3000.0, 0.0, 0.0, 0.0]}

--- expect affected: nodes=1 edges=0

--- mutate
branch merge b into tgt

--- expect outcome: merged

--- query branch: tgt
query scalar_read() {
    match {
        $p: Person
        $p.value = 0
    }
    return { $p.name }
}

--- expect unordered
{"p.name": "p000"}

--- expect shape
p.name: String

--- query branch: tgt
query key_read() {
    match {
        $p: Person
        $p.name = "p001"
    }
    return { $p.value }
}

--- expect unordered
{"p.value": 1}

--- expect shape
p.value: I64

--- query branch: tgt
query text_read() {
    match {
        $p: Person
        search($p.text, "needle")
    }
    return { count($p) as n }
}

--- expect unordered
{"n": 34}

--- expect shape
n: I64

--- query branch: tgt
query vector_read_indexed_row($q: Vector(4)) {
    match { $p: Person }
    return { $p.name }
    order { nearest($p.embedding, $q) }
    limit 1
}

--- params
{"q": [3.3, 0.0, 0.0, 0.0]}

--- expect ordered
{"p.name": "p003"}

--- expect shape
p.name: String

--- query branch: tgt
query vector_read_new_row($q: Vector(4)) {
    match { $p: Person }
    return { $p.name }
    order { nearest($p.embedding, $q) }
    limit 1
}

--- params
{"q": [3000.3, 0.0, 0.0, 0.0]}

--- expect ordered
{"p.name": "b1"}

--- expect shape
p.name: String
