# issue: none
# notes: Reviewing a branch (RFC 0030 §8): the merge base, the branch diff from it to the source head,
# notes: the two-point diff of the heads, and a dry run that writes nothing.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}
{"type":"Person","data":{"name":"bob","age":40}}

--- mutate
query insert_fork() {
    insert Person { name: "fork", age: 1 }
}

--- expect affected: nodes=1 edges=0

--- bind commit $fork

--- mutate
branch create feature

--- expect ok

--- mutate branch: feature
query age_alice() {
    update Person set { age: 31 } where name = "alice"
}

--- expect affected: nodes=1 edges=0

--- mutate branch: feature
query insert_carol() {
    insert Person { name: "carol", age: 22 }
}

--- expect affected: nodes=1 edges=0

--- mutate
query insert_dave() {
    insert Person { name: "dave", age: 50 }
}

--- expect affected: nodes=1 edges=0

--- merge-base source: feature

--- expect commit $fork

--- diff source: feature target: main

--- expect ordered
{"kind":"node","type":"Person","id":"alice","op":"update","before":{"properties":{"name":"alice","age":30}},"after":{"properties":{"name":"alice","age":31}}}
{"kind":"node","type":"Person","id":"carol","op":"insert","after":{"properties":{"name":"carol","age":22}}}

--- diff from: main to: feature

--- expect ordered
{"kind":"node","type":"Person","id":"alice","op":"update","before":{"properties":{"name":"alice","age":30}},"after":{"properties":{"name":"alice","age":31}}}
{"kind":"node","type":"Person","id":"carol","op":"insert","after":{"properties":{"name":"carol","age":22}}}
{"kind":"node","type":"Person","id":"dave","op":"delete","before":{"properties":{"name":"dave","age":50}}}

--- diff from: $fork to: main

--- expect ordered
{"kind":"node","type":"Person","id":"dave","op":"insert","after":{"properties":{"name":"dave","age":50}}}

--- merge-dry-run source: feature

--- expect outcome: merged

--- query
query names_on_main() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "bob"}
{"p.name": "dave"}
{"p.name": "fork"}

--- expect shape
p.name: String
