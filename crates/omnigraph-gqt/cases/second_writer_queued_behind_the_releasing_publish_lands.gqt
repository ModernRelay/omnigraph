# issue: none
# notes: Under set history_release_bytes = 2048; a second insert on b starts while the first is parked at its __history
# notes: put; it lands after the release without a second put, and a fresh process merges s on the released block.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0]

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":0}}
{"type":"Person","data":{"name":"bob","age":0}}

--- mutate
set history_release_bytes = 2048;

--- expect ok

--- mutate
branch create b

--- expect ok

--- mutate
branch create s from b

--- expect ok

--- mutate branch: s
query set_bob_on_s() {
    update Person set { age: 7 } where name = "bob"
}

--- expect affected: nodes=1 edges=0

--- loop $i 1 4
--- mutate branch: b
query bump_alice($n: I32) {
    update Person set { age: $n } where name = "alice"
}
--- params
{"n": ${i}}
--- expect affected: nodes=1 edges=0
--- endloop

--- concurrent
w1 on b: query releasing_publish() { insert Person { name: "carol", age: 1 } }
w2 on b: query queued_publish() { insert Person { name: "dave", age: 2 } }
order: w1 park put __history/blocks/, w2 start, w1 put __history/blocks/, w1, w2
--- expect
w1: ok
w2: ok

--- restart

--- mutate
branch merge s into b

--- expect outcome: merged

--- query branch: b
query rows_after_cold_merge() { match { $p: Person } return { $p.name, $p.age } }

--- expect unordered
{"p.name":"alice","p.age":3}
{"p.name":"bob","p.age":7}
{"p.name":"carol","p.age":1}
{"p.name":"dave","p.age":2}

--- expect shape
p.name: String
p.age: I32
