--- expect ok

--- expect plan
load route: plan
load validate removal node:Item: none
load write: overwrite fragments
load pipeline 0: CsvSource -> Validate -> FragmentWrite => consumer partitions 2
load executed: partitions 2 rows 100

--- query
query loaded_rows() {
    match { $i: Item }
    return { count($i) as c, sum($i.n) as s }
}

--- expect unordered
{"c":100,"s":4950}

--- expect shape
c: I64
s: F64
