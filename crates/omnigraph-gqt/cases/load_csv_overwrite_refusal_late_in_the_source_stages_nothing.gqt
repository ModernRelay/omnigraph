--- mutate
load csv "bad.csv" into node:Item mode overwrite header

--- expect error: load csv into node:Item: record 98 has an empty field for non-nullable property 'note'

--- query
query committed_rows_stay() {
    match { $i: Item }
    return { count($i) as c, sum($i.n) as s }
}

--- expect unordered
{"c":3,"s":60}

--- expect shape
c: I64
s: F64

