# issue: none
# csv_slice_bytes: 4096
# overwrite_chunk_rows: 10
# notes: A node table with no incoming edge type sweeps every check as the rows pass and
# notes: refuses after the drain: one pipeline, a fragment written every 10 rows (the pin
# notes: above; 1 Mi rows without it). A refusal past written fragments deletes them and the
# notes: committed rows stay, with the validator's text and value even where the sink's
# notes: keyed-write check met a key repeated inside one fragment first.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Item {
    id: I64 @key
    note: String
    n: I64
}

--- seed
{"type":"Item","data":{"id":1,"note":"a","n":10}}
{"type":"Item","data":{"id":2,"note":"b","n":20}}
{"type":"Item","data":{"id":3,"note":"c","n":30}}

