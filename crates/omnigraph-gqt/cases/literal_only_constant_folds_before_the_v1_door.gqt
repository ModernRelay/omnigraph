# issue: none
# notes: A literal-only constant folds at compile time, so `{ adult: true or false }` reaches
# notes: the reference engine's door as `adult = true` and returns the v2 rows.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    slug: String @key
    adult: Bool
}

--- seed
{"type":"Person","data":{"slug":"a","adult":false}}
{"type":"Person","data":{"slug":"b","adult":true}}

--- query
query folded_inline_match() {
    match { $p: Person { adult: true or false } }
    return { $p.slug }
}

--- expect unordered
{"p.slug": "b"}

--- expect shape
p.slug: String
--- expect same as v1
