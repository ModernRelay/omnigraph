# issue: none
# red_on: 2026-09-08, PR 662 @ 2850d86f: `branch merge hotfix into feature` failed with `merge target ref … already exists … refusing to claim unowned physical state`.
# notes: After feature adopts main, merging hotfix must reclaim feature's former fork.
# notes: hotfix forks from main, so this is a three-way merge with an unchanged target.
# notes: bob proves the reclaimed fork starts from main's lineage.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}

--- mutate
branch create feature

--- expect ok

--- mutate branch: feature
query feature_write() {
    update Person set { age: 31 } where name = "alice"
}

--- expect affected: nodes=1 edges=0

--- mutate
branch merge feature

--- expect outcome: fast_forward

--- mutate
query main_write() {
    update Person set { age: 32 } where name = "alice"
}

--- expect affected: nodes=1 edges=0

--- mutate
query main_adds_bob() {
    insert Person { name: "bob", age: 40 }
}

--- expect affected: nodes=1 edges=0

--- mutate
branch merge main into feature

--- expect outcome: fast_forward

--- mutate
branch create hotfix

--- expect ok

--- mutate branch: hotfix
query hotfix_write() {
    update Person set { age: 33 } where name = "alice"
}

--- expect affected: nodes=1 edges=0

--- mutate
branch merge hotfix into feature

--- expect outcome: merged

--- query branch: feature
query feature_reads_hotfix() {
    match { $p: Person }
    return { $p.name, $p.age }
}

--- expect unordered
{"p.name":"alice","p.age":33}
{"p.name":"bob","p.age":40}

--- expect shape
p.name: String
p.age: I32
