# issue: none
# notes: Integer block sums finalize once to F64; extrema retain their declared numeric type.
# notes: The plan owns aggregate arithmetic and both comparison domains, independently of parameter values.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Group { name: String @key }
node Cell { key: String @key signed: I64? unsigned: U64? }
edge InGroup: Cell -> Group

--- seed
{"type":"Group","data":{"name":"cancel"}}
{"type":"Cell","data":{"key":"cancel_0","signed":9007199254740993}}
{"edge":"InGroup","from":"cancel_0","to":"cancel"}
{"type":"Cell","data":{"key":"cancel_1","signed":-9007199254740992}}
{"edge":"InGroup","from":"cancel_1","to":"cancel"}
{"type":"Group","data":{"name":"single"}}
{"type":"Cell","data":{"key":"single_0","signed":9007199254740993}}
{"edge":"InGroup","from":"single_0","to":"single"}
{"type":"Group","data":{"name":"overflow_a"}}
{"type":"Cell","data":{"key":"overflow_a_0","signed":9223372036854775807}}
{"edge":"InGroup","from":"overflow_a_0","to":"overflow_a"}
{"type":"Cell","data":{"key":"overflow_a_1","signed":1}}
{"edge":"InGroup","from":"overflow_a_1","to":"overflow_a"}
{"type":"Cell","data":{"key":"overflow_a_2","signed":-1}}
{"edge":"InGroup","from":"overflow_a_2","to":"overflow_a"}
{"type":"Group","data":{"name":"overflow_b"}}
