{"type":"Group","data":{"name":"empty"}}

--- query
query cancellation_total_stays_one() {
    match {
        $g: Group { name: "cancel" }
        sum($c.signed) { $c inGroup $g } = 1
    }
    return { $g.name as group_name }
}
--- expect unordered
{"group_name":"cancel"}
--- expect shape
group_name: String
--- expect plan
block aggregate sum($c.signed): sum(I64?) exact_integer round_to_nearest -> F64?
type sum($c.signed): F64?
cast 1: I64 -> F64

--- query
query single_sum_rounds_before_comparison() {
    match {
        $g: Group { name: "single" }
        sum($c.signed) { $c inGroup $g } > 9007199254740992
    }
    return { $g.name as group_name }
}
--- expect unordered
--- expect shape
group_name: String
--- expect plan
block aggregate sum($c.signed): sum(I64?) exact_integer round_to_nearest -> F64?
cast 9007199254740992: I64 -> F64
no cast sum($c.signed)

