# issue: 1427
# red_on: 2026-11-17, PR #1431 @ 0a74214c: step 4 (branch merge): `branch merge` failed: branch merge reconstructed a keyed chunk outside its planned bound: 2 rows / 37754978 bytes
# notes: Shape from review 5933882191 (B1). One statement inserts an
# notes: 18 MiB row (nine 2 MiB columns) and a row whose wide columns are null, so the two rows share a fragment.
# notes: A scan can return them as two slices of one decode buffer, with the null row's offsets spanning the wide
# notes: row's bytes. Validation charges the rows it keeps, so the three-way merge reaches publication. Publication
# notes: must also keep only the rows it writes: concatenating the two slices as they are copies the 18 MiB twice,
# notes: past the planned 32 MiB chunk bound. Then a validated fast forward (`@range` keeps validation on) of a
# notes: second pair also merges at the default setting.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    p0: String?
    p1: String?
    p2: String?
    p3: String?
    p4: String?
    p5: String?
    p6: String?
    p7: String?
    p8: String?
    n: I32?
    @range(n, 0..100)
}

--- seed

--- mutate
branch create b0
--- expect ok

--- mutate
query onmain() { insert Doc { slug: "onmain" } }
--- expect affected: nodes=1 edges=0

--- foreach $v 
--- mutate branch: b0
query insert_pair($s: String, $p: String) { insert Doc { slug: $s, p0: $p, p1: $p, p2: $p, p3: $p, p4: $p, p5: $p, p6: $p, p7: $p, p8: $p, n: 1 } insert Doc { slug: "small_a", n: 2 } }
