# issue: 602
# red_on: 47abb75f (2026-09-14): step 2 reopen refuses with kind Internal, "OCC recovery sidecar '<opid>' found original commit id '<id>' but its manifest delta differs"
# notes: Skip confirm and delete: the mutation publishes but its sidecar stays Armed.
# notes: Reopen must recognize the published commit, finish recovery, and serve bob.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0]

--- schema
node Person {
    name: String @key
}

--- seed
{"type":"Person","data":{"name":"alice"}}

--- seam
at: mutation.sidecar_confirm_put
occurrence: 1
action: skip
scope: next_step

--- seam
at: mutation.sidecar_post_publish_delete
occurrence: 1
action: skip
scope: next_step

--- mutate
query add_row() {
    insert Person { name: "bob" }
}

--- expect affected: nodes=1 edges=0

--- restart

--- query
query rows_after_reopen() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name":"alice"}
{"p.name":"bob"}

--- expect shape
p.name: String
