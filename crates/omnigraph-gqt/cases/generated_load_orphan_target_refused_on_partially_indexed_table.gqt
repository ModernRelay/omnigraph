# issue: none
# traversal: auto
# notes: A generated edge append whose last target key is absent is refused on a text-keyed Person
# notes: table whose key index covers only part of the rows, so the unindexed tail is checked too.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    id: String @key
}
edge Knows: Person -> Person

--- seed generate: v1 seed: 42
tables:
  - kind: node
    name: Person
    rows: 8
    commits: 4
    columns:
      id: {kind: key, prefix: p, width: 6}

--- load generate: v1 seed: 43 mode: append
tables:
  - kind: node
    name: Person
    rows: 1
    commits: 1
    columns:
      id: {kind: key, prefix: x, width: 6}
--- expect ok

--- load generate: v1 seed: 7 mode: append
tables:
  - kind: edge
    name: Knows
    rows: 9
    commits: 1
    from: {kind: endpoint, prefix: p, width: 6, population: 8, distribution: {kind: ordinal}}
    to: {kind: endpoint, prefix: p, width: 6, population: 9, distribution: {kind: ordinal}}
    columns: {}

--- expect error: __dst 'p000008' not found in Person

