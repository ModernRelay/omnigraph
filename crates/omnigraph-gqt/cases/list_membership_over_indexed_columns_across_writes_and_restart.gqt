--- mutate
query change_covered_rows() {
    update Item set { code: 10, day: date("2024-10-10"), word: "outside" } where slug = "a"
    update Item set { code: 7, day: date("2024-07-07"), word: "theta" } where slug = "b"
}

--- expect affected: nodes=2 edges=0

