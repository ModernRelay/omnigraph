# issue: none
# notes: `write_max_bytes` has no fixed maximum on an embedded engine: a value above the
# notes: old 33554432 ceiling is accepted and the write under it succeeds. A smaller
# notes: allowance refuses a write without changing existing data. A served request cannot
# notes: raise it above the server's ceiling (`data_routes::request_budgets_stop_at_the_server_ceiling`);
# notes: `write_max_bytes.gqt` covers smaller allowances on both targets.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    id: I64 @key
    name: String
}

--- seed

--- mutate
set write_max_bytes = 67108864;
query above_old_ceiling() {
    insert Person { id: 1, name: "alice" }
}

--- expect affected: nodes=1 edges=0

--- query
query rows() {
    match { $p: Person }
    return { $p.id, $p.name }
}

--- expect unordered
{"p.id": 1, "p.name": "alice"}

--- expect shape
p.id: I64
p.name: String

--- mutate
set write_max_bytes = 1;
query refused() {
    insert Person { id: 2, name: "bob" }
}

--- expect error: resource limit exceeded

--- query
query still_one_row() {
    match { $p: Person }
    return { $p.id }
}

--- expect unordered
{"p.id": 1}

--- expect shape
p.id: I64
