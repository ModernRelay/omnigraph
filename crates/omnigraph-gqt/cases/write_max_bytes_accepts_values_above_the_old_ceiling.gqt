# issue: none
# notes: `write_max_bytes` has no fixed maximum: a value above the old 33554432 ceiling is
# notes: accepted and the write under it succeeds on embedded and served targets.
# notes: A smaller allowance refuses a write without changing existing data.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Person {
    id: I64 @key
    name: String
}

--- seed

--- mutate
set write_max_bytes = 67108864;
query above_old_ceiling() {
    insert Person { id: 1, name: "alice" }
}

--- expect affected: nodes=1 edges=0

--- query
query rows() {
    match { $p: Person }
    return { $p.id, $p.name }
}

--- expect unordered
{"p.id": 1, "p.name": "alice"}

--- expect shape
p.id: I64
p.name: String

--- mutate
set write_max_bytes = 1;
query refused() {
    insert Person { id: 2, name: "bob" }
}

--- expect error: resource limit exceeded

--- query
query still_one_row() {
    match { $p: Person }
    return { $p.id }
}

--- expect unordered
{"p.id": 1}

--- expect shape
p.id: I64
