# issue: none
# notes: an empty corpus with a traversal: nearest limit 10 returns no rows and no error.

--- schema
node Doc {
    slug: String @key
    n: I64 @index
    name: String @index
    embedding: Vector(4) @index
}

edge Knows: Doc -> Doc {
}

--- seed

--- query
query scenario($q: Vector(4)) {
    match {
        $d: Doc
        $d knows $t
    }
    return { $d.slug }
    order { nearest($d.embedding, $q) }
    limit 10
}

--- params
{"q": [-0.3, 0.0, 0.0, 0.0]}

--- expect ordered

--- expect shape
d.slug: String
