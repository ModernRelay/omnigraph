# issue: none
# traversal: auto
# notes: Partial BTREE coverage of the endpoint table (index built, then one node appended) must not
# notes: keep the probe for a large input: 200 edges against 65 nodes cost 9 per key as an indexed
# notes: probe (1,800) against a 265-row scan, so the planner scans; a probe here hands the filter
# notes: one literal per edge, the shape that resident memory grows with at SF30.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person { id: String @key }
edge Knows: Person -> Person

--- seed generate: v1 seed: 42
tables:
  - kind: node
    name: Person
    rows: 64
    commits: 1
    columns:
      id: {kind: key, prefix: p, width: 6}

--- load generate: v1 seed: 43 mode: append
tables:
  - kind: node
    name: Person
    rows: 1
    commits: 1
    columns:
      id: {kind: key, prefix: extra, width: 6}
--- expect ok

