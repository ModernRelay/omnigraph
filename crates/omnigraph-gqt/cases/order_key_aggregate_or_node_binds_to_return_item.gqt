# issue: none
# notes: An order key other than a property binds against the return list: an aggregate or a node binding equal to a return item sorts by that
# notes: item's column (`issue_566_order_key_binds_to_return_item.gqt` holds the `T42` refusal of a key no return item matches).

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    age: I64
}

--- seed
{"type":"Person","data":{"name":"bob","age":20}}
{"type":"Person","data":{"name":"alice","age":40}}

--- query
set engine = v2;
query count_ordered() {
    match { $p: Person }
    return { count($p) as total }
    order { count($p) }
}

--- expect unordered
{"total": 2}

--- expect shape
total: I64

--- query
set engine = v2;
query order_by_a_node() {
    match { $p: Person }
    return { $p }
    order { $p }
}

--- expect ordered
{"p": {"@id": "alice", "name": "alice", "age": 40}}
{"p": {"@id": "bob", "name": "bob", "age": 20}}

--- expect shape
p: Person
