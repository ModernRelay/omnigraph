# issue: none
# notes: two stacked `not` blocks over 52 docs keep rows 49 and 50 only, limit
# notes: 3: the rungs k = 3, 12, 48 cover rows 0..47 and hold no survivor (row
# notes: 48 is the spare), the next rung would pass the x16 ceiling, so the
# notes: exact pass scores all 52 rows flat and returns both survivors (2 < 3):
# notes: d049, d050. Short here = the exact pass did not run; more rows = a
# notes: `not` block was pushed or the anti-join leaked.

--- schema
node Doc {
    slug: String @key
    n: I64 @index
    name: String @index
    embedding: Vector(4) @index
}

edge Knows: Doc -> Doc {
}

