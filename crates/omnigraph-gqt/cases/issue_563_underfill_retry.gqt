# issue: 563
# red_on: 2026-08-28, retry disabled: the capped 8-row scan window held no edge-bearing chunk and the query returned 0 rows instead of 2.
# notes: Only chunks 8 through 11 have edges. They sit outside the initial
# notes: 8-row window from either end, so a capped scan must retry to return two.
# notes: Rust twin: bm25_join_fills_limit_when_capped_scan_underfills_issue_563
# notes: (crates/omnigraph/tests/search.rs).

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Chunk {
    slug: String @key
    text: String @index
}

node Artifact {
    slug: String @key
}

edge ChunkOfArtifact: Chunk -> Artifact {
    label: String
}

--- seed
{"type":"Artifact","data":{"slug":"art-0"}}
{"type":"Chunk","data":{"slug":"chunk-00","text":"needle needle needle needle needle needle needle needle needle needle needle needle needle needle needle needle needle needle needle needle filler"}}
