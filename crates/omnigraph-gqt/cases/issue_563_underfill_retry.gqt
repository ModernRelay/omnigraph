{"type":"Chunk","data":{"slug":"chunk-19","text":"needle filler"}}
{"edge":"ChunkOfArtifact","id":"e-08","from":"chunk-08","to":"art-0","data":{"label":"of"}}
{"edge":"ChunkOfArtifact","id":"e-09","from":"chunk-09","to":"art-0","data":{"label":"of"}}
{"edge":"ChunkOfArtifact","id":"e-10","from":"chunk-10","to":"art-0","data":{"label":"of"}}
{"edge":"ChunkOfArtifact","id":"e-11","from":"chunk-11","to":"art-0","data":{"label":"of"}}

--- query
query recall($q: String) {
    match {
        $c: Chunk
        $c chunkOfArtifact $a
        search($c.text, $q)
    }
    return { $c.slug, $a.slug }
    order { bm25($c.text, $q) }
    limit 2
}

--- params
{"q": "needle"}

--- expect ordered
{"c.slug": "chunk-08", "a.slug": "art-0"}
{"c.slug": "chunk-09", "a.slug": "art-0"}

--- expect shape
c.slug: String
a.slug: String
