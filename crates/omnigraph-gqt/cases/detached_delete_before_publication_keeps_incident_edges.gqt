# issue: none
# notes: Failure after detached node and edge deletes preserves the node and every incident edge across restart. A later deletion succeeds without affecting main.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Person {
    name: String @key
}
edge Knows: Person -> Person {
    @key(@src, @dst)
}

--- seed
{"type":"Person","data":{"name":"alice"}}
{"type":"Person","data":{"name":"bob"}}
{"type":"Person","data":{"name":"carol"}}
{"type":"Person","data":{"name":"dave"}}
{"edge":"Knows","from":"alice","to":"bob"}
{"edge":"Knows","from":"bob","to":"alice"}
{"edge":"Knows","from":"bob","to":"carol"}
{"edge":"Knows","from":"carol","to":"dave"}

--- mutate
branch create work

--- expect ok

--- seam
at: mutation.post_finalize_pre_publisher
occurrence: 1
action: fail
scope: next_step

--- mutate branch: work
query delete_bob() { delete Person where name = "bob" }

--- expect error: injected failpoint triggered: mutation.post_finalize_pre_publisher

--- query branch: work
query nodes_before_restart() { match { $p: Person } return { $p.name } }

--- expect unordered
{"p.name":"alice"}
{"p.name":"bob"}
{"p.name":"carol"}
{"p.name":"dave"}

--- expect shape
p.name: String

--- query branch: work
query edges_before_restart() { match { $p: Person $p $e:knows $q } return { $p.name, $q.name } }

--- expect unordered
{"p.name":"alice","q.name":"bob"}
{"p.name":"bob","q.name":"alice"}
{"p.name":"bob","q.name":"carol"}
{"p.name":"carol","q.name":"dave"}

--- expect shape
p.name: String
q.name: String

--- restart

--- query branch: work
query nodes_after_restart() { match { $p: Person } return { $p.name } }

--- expect unordered
{"p.name":"alice"}
{"p.name":"bob"}
{"p.name":"carol"}
{"p.name":"dave"}

--- expect shape
p.name: String

--- query branch: work
query edges_after_restart() { match { $p: Person $p $e:knows $q } return { $p.name, $q.name } }

--- expect unordered
{"p.name":"alice","q.name":"bob"}
{"p.name":"bob","q.name":"alice"}
{"p.name":"bob","q.name":"carol"}
{"p.name":"carol","q.name":"dave"}

--- expect shape
p.name: String
q.name: String

--- mutate branch: work
query delete_bob() { delete Person where name = "bob" }

--- expect affected: nodes=1 edges=3

--- restart

--- query branch: work
query durable_nodes() { match { $p: Person } return { $p.name } }

--- expect unordered
{"p.name":"alice"}
{"p.name":"carol"}
{"p.name":"dave"}

--- expect shape
p.name: String

--- query branch: work
query durable_edges() { match { $p: Person $p $e:knows $q } return { $p.name, $q.name } }

--- expect unordered
{"p.name":"carol","q.name":"dave"}

--- expect shape
p.name: String
q.name: String

--- query branch: main
query main_nodes_unchanged() { match { $p: Person } return { $p.name } }

--- expect unordered
{"p.name":"alice"}
{"p.name":"bob"}
{"p.name":"carol"}
{"p.name":"dave"}

--- expect shape
p.name: String

--- query branch: main
query main_edges_unchanged() { match { $p: Person $p $e:knows $q } return { $p.name, $q.name } }

--- expect unordered
{"p.name":"alice","q.name":"bob"}
{"p.name":"bob","q.name":"alice"}
{"p.name":"bob","q.name":"carol"}
{"p.name":"carol","q.name":"dave"}

--- expect shape
p.name: String
q.name: String
