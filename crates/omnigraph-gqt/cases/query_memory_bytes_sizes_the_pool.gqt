# issue: none
# notes: The per-query memory pool is the `query_memory_bytes` session setting: a tiny value
# notes: refuses a query whose tracked work exceeds it; the default (150 MiB) and an explicit
# notes: allowance below it run the same query through both the engine and the server. A
# notes: served request cannot raise it above the server's ceiling
# notes: (`data_routes::request_budgets_stop_at_the_server_ceiling`).

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Person {
    id: I64 @key
    name: String
}

--- seed
{"type":"Person","data":{"id":1,"name":"alice"}}
{"type":"Person","data":{"id":2,"name":"bob"}}
{"type":"Person","data":{"id":3,"name":"carol"}}

--- query
set query_memory_bytes = 1;
query refused() {
    match { $p: Person }
    return { $p.id, $p.name }
}

--- expect error: resource limit exceeded for query_memory_bytes

--- query
query default_runs() {
    match { $p: Person }
    return { $p.id }
}

--- expect unordered
{"p.id": 1}
{"p.id": 2}
{"p.id": 3}

--- expect shape
p.id: I64

--- query
set query_memory_bytes = 104857600;
query explicit_runs() {
    match { $p: Person }
    return { $p.id }
}

--- expect unordered
{"p.id": 1}
{"p.id": 2}
{"p.id": 3}

--- expect shape
p.id: I64
