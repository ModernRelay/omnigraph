# issue: none
# notes: 257 leaves cross the 256-row output chunk boundary; the
# notes: rows, the multiplicity of parallel edges and the self edge of an
# notes: undirected step are the executor's, on both routes.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    name: String @key
}

edge Links: Person -> Person

