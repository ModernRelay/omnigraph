--- query
query undirected_self_edge() {
    match {
        $p: Person { name: "a" }
        $p <links> $q
    }
    return { $q.name }
}

--- expect unordered
{"q.name":"a"}
{"q.name":"b"}

--- expect shape
q.name: String

--- query
query parallel_edges_once() {
    match {
        $c: Person { name: "c" }
        $c links $d
    }
    return { $d.name }
}

--- expect unordered
{"d.name":"d"}

--- expect shape
d.name: String
