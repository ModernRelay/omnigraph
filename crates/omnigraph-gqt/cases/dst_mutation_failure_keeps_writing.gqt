# issue: none
# notes: A mutation that fails after its detached table effect and before publication leaves the same Omnigraph writable: nothing is graph-visible, nothing is armed, and the branch reads and writes as before (RFC 0067).
--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Person {
    name: String @key
}
--- seed
{"type":"Person","data":{"name":"alice"}}
--- mutate
branch create work
--- expect ok
--- seam
at: mutation.post_table_commit
occurrence: 1
action: fail
scope: next_step

--- mutate branch: work
query add() { insert Person { name: "bob" } }
--- expect error: injected failpoint triggered: mutation.post_table_commit
--- query branch: work
query unchanged() { match { $p: Person } return { $p.name } }
--- expect unordered
{"p.name":"alice"}
--- expect shape
p.name: String
--- mutate branch: work
query retry() { insert Person { name: "carol" } }
--- expect affected: nodes=1 edges=0
--- query branch: work
query after_write() { match { $p: Person } return { $p.name } }
--- expect unordered
{"p.name":"alice"}
{"p.name":"carol"}
--- expect shape
p.name: String
