--- query
query sweep($q: Vector(4)) {
    match {
        $d: Doc
        $d knows $t
    }
    return { $d.slug }
    order { nearest($d.embedding, $q) }
    limit 3
}

--- params
{"q": [25.3, 0.0, 0.0, 0.0]}

--- expect ordered
{"d.slug":"d030"}
{"d.slug":"d020"}
{"d.slug":"d040"}

--- expect shape
d.slug: String
