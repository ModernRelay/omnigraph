# issue: none
# notes: RRF ranking preserves identity ordering among tied joined rows before LIMIT.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    n: I64
    text: String @index
}
node Probe {
    slug: String @key
    n: I64
}

