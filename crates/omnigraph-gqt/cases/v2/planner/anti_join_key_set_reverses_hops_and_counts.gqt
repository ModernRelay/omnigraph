# issue: none
# notes: A key-set block runs its pattern from the bound binding, so each traversal toward the
# notes: outer binding is reversed. Exact and ranged hop counts and a block written from the
# notes: bound binding keep their rows. An unbound traversal counts
# notes: distinct neighbours and a bound edge counts edge rows in either direction: d's two
# notes: parallel edges to e count once unbound and twice bound.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    name: String @key
}

edge Knows: Person -> Person

--- seed
{"type":"Person","data":{"name":"a"}}
{"type":"Person","data":{"name":"b"}}
{"type":"Person","data":{"name":"c"}}
{"type":"Person","data":{"name":"d"}}
{"type":"Person","data":{"name":"e"}}
{"edge":"Knows","from":"a","to":"b"}
{"edge":"Knows","from":"c","to":"d"}
{"edge":"Knows","from":"d","to":"e"}
{"edge":"Knows","from":"d","to":"e"}

--- query
query no_two_hops_to_e() {
    match {
        $p: Person
        not {
            $p knows{2,2} $x
            $x: Person { name: "e" }
        }
    }
    return { $p.name }
}

--- expect unordered
{"p.name": "a"}
{"p.name": "b"}
{"p.name": "d"}
{"p.name": "e"}

--- expect shape
p.name: String

--- expect plan
anti join $p: key_set

--- expect same as v1

--- query
query not_within_two_of_e() {
    match {
        $p: Person
        not {
            $p knows{1,2} $x
            $x: Person { name: "e" }
        }
    }
    return { $p.name }
}

--- expect unordered
{"p.name": "a"}
{"p.name": "b"}
{"p.name": "e"}

--- expect shape
p.name: String

--- expect plan
anti join $p: key_set

--- expect same as v1

--- query
query not_known_by_c() {
    match {
        $p: Person
        not {
            $x knows $p
            $x: Person { name: "c" }
        }
    }
    return { $p.name }
}

--- expect unordered
{"p.name": "a"}
{"p.name": "b"}
{"p.name": "c"}
{"p.name": "e"}

--- expect shape
p.name: String

--- expect plan
anti join $p: key_set

--- expect same as v1

--- query
query one_neighbour_e() {
    match {
        $p: Person
        count {
            $p knows $x
            $x: Person { name: "e" }
        } = 1
    }
    return { $p.name }
}

--- expect unordered
{"p.name": "d"}

--- expect shape
p.name: String

--- expect plan
anti join $p: key_set

--- query
query one_edge_row_to_e() {
    match {
        $p: Person
        count {
            $p $k:knows $x
            $x: Person { name: "e" }
        } = 1
    }
    return { $p.name }
}

--- expect unordered

--- expect shape
p.name: String

--- expect plan
anti join $p: key_set

--- query
query two_edge_rows_to_e() {
    match {
        $p: Person
        count {
            $p $k:knows $x
            $x: Person { name: "e" }
        } = 2
    }
    return { $p.name }
}

--- expect unordered
{"p.name": "d"}

--- expect shape
p.name: String

--- expect plan
anti join $p: key_set
