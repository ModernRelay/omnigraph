# issue: none
# traversal: auto
# notes: Lance's typed filter planner chooses the integer probe after coercion and operand normalization.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    slug: String @key
    age: I32 @index
}

--- seed
{"type":"Person","data":{"slug":"alpha","age":11}}
{"type":"Person","data":{"slug":"beta","age":22}}

--- query
set engine = v2;
query reversed() {
    match { $p: Person 11 = $p.age }
    return { $p.slug }
}
--- expect unordered
{"p.slug":"alpha"}
--- expect shape
p.slug: String
--- expect plan
scan Person as $p: access index_probe age
not pass key_to_id


--- mutate
query append_person() {
    insert Person { slug: "gamma", age: 11 }
}
--- expect affected: nodes=1 edges=0

--- query
set engine = v2;
query partial() {
    match { $p: Person $p.age = 11 }
    return { $p.slug }
}
--- expect unordered
{"p.slug":"alpha"}
{"p.slug":"gamma"}
--- expect shape
p.slug: String
--- expect plan
scan Person as $p: access index_probe age

--- query
set engine = v2;
query appended_key() {
    match { $p: Person { slug: "gamma" } }
    return { $p.slug }
}
--- expect unordered
{"p.slug":"gamma"}
--- expect shape
p.slug: String
--- expect plan
scan Person as $p: access index_probe __id
pass key_to_id
