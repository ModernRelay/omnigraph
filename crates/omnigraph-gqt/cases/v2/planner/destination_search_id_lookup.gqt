# issue: none
# notes: Destination id lookup preserves conjunctions of search membership predicates.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Source {
    slug: String @key
}
node Doc {
    slug: String @key
    body: String @index
    summary: String @index
    state: String
}
edge Links: Source -> Doc

--- seed
{"type":"Source","data":{"slug":"root"}}
{"type":"Doc","data":{"slug":"hit","body":"needle zeta","summary":"beacon","state":"open"}}
{"type":"Doc","data":{"slug":"body-only","body":"needle","summary":"other","state":"open"}}
{"type":"Doc","data":{"slug":"summary-only","body":"other zeta","summary":"beacon","state":"open"}}
{"type":"Doc","data":{"slug":"unlinked-hit","body":"needle zeta","summary":"beacon","state":"open"}}
{"type":"Doc","data":{"slug":"f05","body":"filler","summary":"filler","state":"open"}}
{"type":"Doc","data":{"slug":"f06","body":"filler","summary":"filler","state":"open"}}
{"type":"Doc","data":{"slug":"f07","body":"filler","summary":"filler","state":"open"}}
