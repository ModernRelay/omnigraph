{"edge":"Links","from":"root","to":"hit"}
{"edge":"Links","from":"root","to":"body-only"}
{"edge":"Links","from":"root","to":"summary-only"}

--- query
set engine = v2;
query one_destination_search() {
    match {
        $s: Source
        $s links $d
        search($d.body, "needle")
    }
    return { $d.slug }
}
--- expect unordered
{"d.slug":"hit"}
{"d.slug":"body-only"}
--- expect shape
d.slug: String
--- expect plan
scan Doc as $d: access id_lookup
scan Doc as $d: filter reads [d.body]

--- query
set engine = v2;
query two_destination_searches() {
    match {
        $s: Source
        $s links $d
        search($d.body, "needle")
        match_text($d.summary, "beacon")
    }
    return { $d.slug }
}
--- expect unordered
{"d.slug":"hit"}
--- expect shape
d.slug: String
--- expect plan
scan Doc as $d: access id_lookup
scan Doc as $d: filter reads [d.body, d.summary]
