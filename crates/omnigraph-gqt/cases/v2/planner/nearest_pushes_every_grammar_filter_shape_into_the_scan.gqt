--- query
query f_eq($q: Vector(4)) {
    match { $d: Doc
        $d.n = 7 }
    return { $d.slug } order { nearest($d.embedding, $q) } limit 3
}

--- params
{"q": [0.0, 0.0, 0.0, 0.0]}

--- expect ordered
{"d.slug": "n07"}

--- expect shape
d.slug: String

--- expect plan
scan Doc as $d: ranked nearest fetch 3
scan Doc as $d: filter reads [d.n]

--- query
query f_ne($q: Vector(4)) {
    match { $d: Doc
        $d.n != 0 }
    return { $d.slug } order { nearest($d.embedding, $q) } limit 3
}

