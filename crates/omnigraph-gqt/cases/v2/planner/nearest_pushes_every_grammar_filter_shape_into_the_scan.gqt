# issue: none
# notes: Every filter shape the GQ grammar can put on the ranked binding (=, !=, >, <, >=, <=,
# notes: starts_with, contains, a parameter, a flipped operand) is pushed into the ranked
# notes: `nearest` scan, so the top-k of the MATCHING rows comes back from one scan. The query
# notes: vector is the origin and doc n sits at distance n, so rank order is n order. Replaces
# notes: the Rust test nearest_pushes_every_grammar_filter_shape_into_the_scan (search.rs), whose
# notes: `pushed_filter_exprs == 1` probe is the `filter reads` plan line here.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    n: I64 @index
    name: String @index
    embedding: Vector(4) @index
}

