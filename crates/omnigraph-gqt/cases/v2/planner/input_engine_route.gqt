# issue: none
# notes: inventory sweep, input class `engine`: the same query on the v2 plan runner
# notes: and on the reference engine returns the same rows.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    age: I64
}
edge Knows: Person -> Person

--- seed
{"type":"Person","data":{"name":"alice","age":30}}
{"type":"Person","data":{"name":"bob","age":40}}
{"type":"Person","data":{"name":"carol","age":50}}
{"edge":"Knows","from":"alice","to":"bob"}
{"edge":"Knows","from":"bob","to":"carol"}

--- query
set engine = v2;
query older_friends($min: I64) {
    match {
        $p: Person
        $p knows $q
        $q.age > $min
    }
    return { $p.name, $q.name }
    order { $p.name }
}
--- params
{"min": 35}
--- expect ordered
{"p.name":"alice","q.name":"bob"}
{"p.name":"bob","q.name":"carol"}
--- expect shape
p.name: String
q.name: String
--- expect plan
expand $p Knows $q: mode indexed_scan ran indexed_scan
--- expect same as v1
