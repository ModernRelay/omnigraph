# issue: none
# notes: Residual filters over a cross join (#1336) run each later condition, and
# notes: the right side of `and`/`or`, only on the pairs the earlier conditions
# notes: left undecided. Rows are complete when no pair survives the first
# notes: condition, when a few do, and when nulls reach `or` and `and`. The frozen
# notes: reference engine refuses compound predicates, so the rows are written out.
# notes: The mechanism is pinned by and_skips_the_rows_its_left_operand_removed_issue_1336.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    slug: String @key
    age: I64
    score: I64
    level: I64?
}

--- seed
{"type":"Person","data":{"slug":"a","age":10,"score":60,"level":1}}
{"type":"Person","data":{"slug":"b","age":20,"score":50}}
{"type":"Person","data":{"slug":"c","age":30,"score":40,"level":3}}
{"type":"Person","data":{"slug":"d","age":40,"score":30,"level":2}}
{"type":"Person","data":{"slug":"e","age":50,"score":20}}
{"type":"Person","data":{"slug":"f","age":60,"score":10,"level":5}}

--- query
set engine = v2;
query none_survive() {
    match {
        $p: Person
        $q: Person
        $p.age > $q.age and $p.score > $q.score
    }
    return { $p.slug, $q.slug }
}

--- expect unordered

--- expect shape
p.slug: String
q.slug: String

--- query
set engine = v2;
query few_survive() {
    match {
        $p: Person
        $q: Person
        $p.age > $q.age
        $p.level > $q.level
        $p.score < $q.score or $p.level = $q.level
    }
    return { $p.slug, $q.slug }
}

--- expect unordered
{"p.slug": "c", "q.slug": "a"}
{"p.slug": "d", "q.slug": "a"}
{"p.slug": "f", "q.slug": "a"}
{"p.slug": "f", "q.slug": "c"}
{"p.slug": "f", "q.slug": "d"}
--- expect shape
p.slug: String
q.slug: String

--- query
set engine = v2;
query nulls_reach_or() {
    match {
        $p: Person
        $q: Person
        $p.score = $q.score or ($p.level < $q.level and $p.age > $q.age)
    }
    return { $p.slug, $q.slug }
}

--- expect unordered
{"p.slug": "a", "q.slug": "a"}
{"p.slug": "b", "q.slug": "b"}
{"p.slug": "c", "q.slug": "c"}
{"p.slug": "d", "q.slug": "c"}
{"p.slug": "d", "q.slug": "d"}
{"p.slug": "e", "q.slug": "e"}
{"p.slug": "f", "q.slug": "f"}
--- expect shape
p.slug: String
q.slug: String
