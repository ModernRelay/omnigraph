# issue: none
# notes: The planner records the traversal mode on the physical Expand from
# notes: the row-count estimate (3 sources over 2 edges: the indexed path
# notes: costs 2, a CSR build 3) and the explain document names the pass.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    name: String @key
}

edge Links: Person -> Person

--- seed
{"type":"Person","data":{"name":"alice"}}
{"type":"Person","data":{"name":"bob"}}
{"type":"Person","data":{"name":"carol"}}
{"edge":"Links","from":"alice","to":"bob"}
{"edge":"Links","from":"bob","to":"carol"}

--- query
set engine = v2;
query linked() {
    match {
        $s: Person
        $s links $d
    }
    return { $s.name, $d.name }
}

--- expect unordered
{"s.name":"alice","d.name":"bob"}
{"s.name":"bob","d.name":"carol"}

--- expect shape
s.name: String
d.name: String

--- expect plan
expand $s Links $d: mode indexed_scan
pass expand_mode
