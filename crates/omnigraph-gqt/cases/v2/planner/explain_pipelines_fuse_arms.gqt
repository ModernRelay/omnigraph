# issue: none
# notes: Fuse is a breaker with one input per arm, each arm the plan its ranking takes standing alone: the exact
# notes: `bm25` arm scores its scan and sorts by the score into the fusion (an arm after the first is a collected
# notes: side, so its pipelines come first), the `nearest` arm's window sorts its candidates and cuts its targets
# notes: into the fusion, the fused rows drain into the Sort above it, and the sorted page reaches the consumer.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    text: String @index(fulltext, analyzer = "standard_v1")
    embedding: Vector(4) @index
}

--- seed
{"type":"Doc","data":{"slug":"d000","embedding":[0.0,0.0,0.0,0.0],"text":"needle needle needle needle filler"}}
{"type":"Doc","data":{"slug":"d001","embedding":[1.0,0.0,0.0,0.0],"text":"needle needle needle filler"}}
{"type":"Doc","data":{"slug":"d002","embedding":[2.0,0.0,0.0,0.0],"text":"needle needle filler"}}
{"type":"Doc","data":{"slug":"d003","embedding":[3.0,0.0,0.0,0.0],"text":"needle filler"}}
{"type":"Doc","data":{"slug":"d004","embedding":[4.0,0.0,0.0,0.0],"text":"filler"}}

--- query
set engine = v2;
query fused($q: Vector(4), $t: String) {
    match { let $all = { match { $d: Doc } return { $d } }, from rrf(nearest($all, $d.embedding, $q, k: 3), bm25($all, $d.text, $t), k: 60) as $score, $d: Doc }
    return { $d.slug }
    order { $score desc }
    limit 3
}
--- params
{"q": [0.0, 0.0, 0.0, 0.0], "t": "needle"}
--- expect ordered
{"d.slug":"d000"}
{"d.slug":"d001"}
{"d.slug":"d002"}
--- expect shape
d.slug: String
--- expect plan
pipeline 0: Scan -> Score => Sort
pipeline 1: Sort => Fuse(arm) after 0
pipeline 2: Scan => Sort
pipeline 3: Sort -> TargetCut => Fuse after 2
pipeline 4: Fuse -> Projection => Sort after 1, 3
pipeline 5: Sort -> Page => consumer after 4
fuse $d: arms [nearest, bm25]
