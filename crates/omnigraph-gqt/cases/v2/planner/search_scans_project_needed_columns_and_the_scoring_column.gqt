--- query
query nearest_slug($q: Vector(4)) {
    match { $d: Doc }
    return { $d.slug }
    order { nearest($d.embedding, $q) }
    limit 10
}

--- params
{"q": [0.0, 0.0, 0.0, 0.0]}

--- expect ordered
{"d.slug": "n00000"}
{"d.slug": "n00001"}
{"d.slug": "n00002"}
{"d.slug": "n00003"}
{"d.slug": "n00004"}
{"d.slug": "n00005"}
{"d.slug": "n00006"}
{"d.slug": "n00007"}
{"d.slug": "n00008"}
{"d.slug": "n00009"}

--- expect shape
d.slug: String

--- expect plan
scan Doc as $d: ranked nearest fetch 10
scan Doc as $d: columns [__id, slug]

--- query
query bm25_slug($q: String) {
    match { $d: Doc }
    return { $d.slug }
    order { bm25($d.title, $q) }
    limit 10
}

--- params
{"q": "alpha"}

--- expect ordered
{"d.slug": "n00000"}
{"d.slug": "n00002"}
{"d.slug": "n00004"}
{"d.slug": "n00006"}
{"d.slug": "n00008"}
{"d.slug": "n00010"}
{"d.slug": "n00012"}
{"d.slug": "n00014"}
{"d.slug": "n00016"}
{"d.slug": "n00018"}

--- expect shape
d.slug: String

--- expect plan
scan Doc as $d: ranked bm25
scan Doc as $d: columns [__id, slug]

--- query
query nearest_whole($q: Vector(4)) {
    match { $d: Doc }
    return { $d }
    order { nearest($d.embedding, $q) }
    limit 10
}

--- params
{"q": [0.0, 0.0, 0.0, 0.0]}

