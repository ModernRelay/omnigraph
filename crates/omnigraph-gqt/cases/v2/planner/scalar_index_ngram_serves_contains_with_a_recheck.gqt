# issue: none
# traversal: auto
# notes: `@index` on a String builds an NGRAM beside its BTREE and full-text index (docs/rfcs/2026-11-07-gq-3.md
# notes: section 4, "Scalar indexes"). `contains` probes it for candidates (lowercased, ASCII-folded trigrams)
# notes: and Lance rechecks each with the case-sensitive substring test, so a case-mismatched or accent-folded
# notes: needle returns the scan's rows. A needle shorter than three characters, a needle with no alphanumeric
# notes: trigram (which Lance 13 would answer with no row, so the engine pushes it in a form no index answers)
# notes: and a negated `contains` take the scan. Rows equal the reference interpreter's and an unindexed twin's;
# notes: a null text never matches. The appended rows lie outside the index (partial coverage). A delete
# notes: through a trigram-less needle removes its row.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Note {
    slug: String @key
    text: String? @index
}
node PlainNote {
    slug: String @key
    text: String?
}

--- seed
{"type": "Note", "data": {"slug": "n1", "text": "Hello World"}}
{"type": "Note", "data": {"slug": "n2", "text": "hello there"}}
{"type": "Note", "data": {"slug": "n3"}}
{"type": "Note", "data": {"slug": "n4", "text": "a-b c"}}
{"type": "Note", "data": {"slug": "n5", "text": "café crème"}}
{"type": "Note", "data": {"slug": "n6", "text": "WORLDWIDE web"}}
{"type": "PlainNote", "data": {"slug": "n1", "text": "Hello World"}}
{"type": "PlainNote", "data": {"slug": "n2", "text": "hello there"}}
{"type": "PlainNote", "data": {"slug": "n3"}}
{"type": "PlainNote", "data": {"slug": "n4", "text": "a-b c"}}
{"type": "PlainNote", "data": {"slug": "n5", "text": "café crème"}}
{"type": "PlainNote", "data": {"slug": "n6", "text": "WORLDWIDE web"}}

--- query
query contains_exact_case_indexed() {
    match { $n: Note }
    where contains($n.text, "World")
    return { $n.slug }
}

--- expect unordered
{"n.slug": "n1"}

--- expect shape
n.slug: String

--- expect plan
scan Note as $n: access index_probe text ngram

--- expect same as reference

--- query
query contains_exact_case_unindexed() {
    match { $n: PlainNote }
    where contains($n.text, "World")
    return { $n.slug }
}

--- expect unordered
{"n.slug": "n1"}

--- expect shape
n.slug: String

--- expect plan
scan PlainNote as $n: access sequential

--- expect same as reference

