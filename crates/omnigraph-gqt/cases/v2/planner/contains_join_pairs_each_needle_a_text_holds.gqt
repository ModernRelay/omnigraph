--- query
set engine = v2;
query found_numbers_under_a_second_filter() {
    match {
        $m: Matter
        $p: Passage
        $p.text contains $m.number
        $m.number != $p.text and ($m.mid != "m-16" or $p.pid != "p-overlap")
    }
    return { $m.mid, $p.pid }
}

