{"edge":"TouchpointByIdentity","from":"t10","to":"x5"}
{"edge":"TouchpointByIdentity","from":"t11","to":"x5"}

--- query
query lookalikes($channel: String, $exclude: String) {
    match {
        $c: Channel { slug: $channel }
        $s: Source
        $c channelWatchesSource $s
        $t: Touchpoint { action: "star" }
        $t touchpointOnSource $s
        $x: ExternalID
        $t touchpointByIdentity $x
        not {
            $s0: Source { slug: $exclude }
            $t0: Touchpoint
            $t0 touchpointOnSource $s0
            $t0 touchpointByIdentity $x
        }
    }
    return { $x.slug, count($t) as repos }
}

--- params
{"channel": "c1", "exclude": "excluded"}

--- expect unordered
{"x.slug": "x2", "repos": 2}
{"x.slug": "x4", "repos": 1}

--- expect shape
x.slug: String
repos: I64

--- expect plan
anti join $x: key_set
pass anti_join_strategy

--- expect same as v1

--- query
query twice_on_excluded($channel: String, $exclude: String) {
    match {
        $c: Channel { slug: $channel }
        $s: Source
        $c channelWatchesSource $s
        $t: Touchpoint { action: "star" }
        $t touchpointOnSource $s
        $x: ExternalID
        $t touchpointByIdentity $x
        count {
            $s0: Source { slug: $exclude }
            $t0: Touchpoint
            $t0 touchpointOnSource $s0
            $t0 touchpointByIdentity $x
        } >= 2
    }
    return { $x.slug, count($t) as repos }
}

--- params
{"channel": "c1", "exclude": "excluded"}

--- expect unordered
{"x.slug": "x3", "repos": 1}

--- expect shape
x.slug: String
repos: I64

--- expect plan
anti join $x: key_set

--- query
query heavy_on_excluded($channel: String, $exclude: String) {
    match {
        $c: Channel { slug: $channel }
        $s: Source
        $c channelWatchesSource $s
        $t: Touchpoint { action: "star" }
        $t touchpointOnSource $s
        $x: ExternalID
        $t touchpointByIdentity $x
        sum($t0.weight) {
            $s0: Source { slug: $exclude }
            $t0: Touchpoint
            $t0 touchpointOnSource $s0
            $t0 touchpointByIdentity $x
        } > 3
    }
    return { $x.slug, count($t) as repos }
}

--- params
{"channel": "c1", "exclude": "excluded"}

--- expect unordered
{"x.slug": "x3", "repos": 1}
{"x.slug": "x5", "repos": 1}

--- expect shape
x.slug: String
repos: I64

--- expect plan
anti join $x: key_set

--- query
query not_through_the_web($channel: String, $exclude: String) {
    match {
        $c: Channel { slug: $channel }
        $s: Source
        $c channelWatchesSource $s
        $t: Touchpoint { action: "star" }
        $t touchpointOnSource $s
        $x: ExternalID
        $t touchpointByIdentity $x
        not {
            $s0: Source { slug: $exclude }
            $t0: Touchpoint
            $t0 $e:touchpointOnSource $s0
            $e.via = "web"
            $t0 touchpointByIdentity $x
        }
    }
    return { $x.slug, count($t) as repos }
}

