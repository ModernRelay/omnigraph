{"channel": "c1", "exclude": "excluded"}

--- expect unordered
{"x.slug": "x2", "repos": 2}
{"x.slug": "x4", "repos": 1}
{"x.slug": "x5", "repos": 1}

--- expect shape
x.slug: String
repos: I64

--- expect plan
anti join $x: key_set

--- expect same as v1

--- query
query never_forked($channel: String) {
    match {
        $c: Channel { slug: $channel }
        $s: Source
        $c channelWatchesSource $s
        $t: Touchpoint { action: "star" }
        $t touchpointOnSource $s
        $x: ExternalID
        $t touchpointByIdentity $x
        not {
            $t0: Touchpoint { action: "fork" }
            $t0 touchpointByIdentity $x
        }
    }
    return { $x.slug, count($t) as repos }
}

--- params
{"channel": "c1"}

--- expect unordered
{"x.slug": "x1", "repos": 1}
{"x.slug": "x2", "repos": 2}

--- expect shape
x.slug: String
repos: I64

--- expect plan
anti join $x: correlated
not pass anti_join_strategy

--- expect same as v1

--- query
query no_heavier_on_excluded($channel: String, $exclude: String) {
    match {
        $c: Channel { slug: $channel }
        $s: Source
        $c channelWatchesSource $s
        $t: Touchpoint { action: "star" }
        $t touchpointOnSource $s
        $x: ExternalID
        $t touchpointByIdentity $x
        not {
            $s0: Source { slug: $exclude }
            $t0: Touchpoint
            $t0 touchpointOnSource $s0
            $t0 touchpointByIdentity $x
            $t0.weight > $t.weight
        }
    }
    return { $x.slug, count($t) as repos }
}

