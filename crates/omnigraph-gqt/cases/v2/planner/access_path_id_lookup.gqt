# issue: none
# notes: The hash-join fixture with unreachable destinations must use id_lookup and preserve search membership and pair multiplicity.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Source {
    slug: String @key
}
node Doc {
    slug: String @key
    body: String @index
    summary: String @index
    state: String
}
edge Links: Source -> Doc

