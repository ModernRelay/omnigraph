--- query
set engine = v2;
query open_needles() {
    match {
        $s: Source
        $s links $d
        $d: Doc { state: "open" }
        search($d.body, "needle")
    }
    return { $s.slug, $d.slug }
}
--- expect unordered
{"s.slug":"s1","d.slug":"a"}
{"s.slug":"s2","d.slug":"a"}
{"s.slug":"s3","d.slug":"d"}
{"s.slug":"s3","d.slug":"f"}
{"s.slug":"s4","d.slug":"d"}
{"s.slug":"s4","d.slug":"f"}
--- expect shape
s.slug: String
d.slug: String
--- expect plan
scan Doc as $d: access id_lookup
scan Doc as $d: filter reads [d.state, d.body]
pass access_path

--- query
set engine = v2;
query every_link() {
    match {
        $s: Source
        $s links $d
    }
    return { $s.slug, $d.slug }
    order { $s.slug, $d.slug }
}
--- expect ordered
{"s.slug":"s1","d.slug":"a"}
{"s.slug":"s1","d.slug":"b"}
{"s.slug":"s2","d.slug":"a"}
{"s.slug":"s2","d.slug":"c"}
{"s.slug":"s3","d.slug":"d"}
{"s.slug":"s3","d.slug":"f"}
{"s.slug":"s4","d.slug":"d"}
{"s.slug":"s4","d.slug":"f"}
--- expect shape
s.slug: String
d.slug: String
--- expect plan
scan Doc as $d: access id_lookup
scan Doc as $d: no filter
pass access_path

--- query
set engine = v2;
query open_needle_beacons() {
    match {
        $s: Source
        $s links $d
        $d: Doc { state: "open" }
        search($d.body, "needle")
        match_text($d.summary, "beacon")
    }
    return { $s.slug, $d.slug }
}
--- expect unordered
{"s.slug":"s1","d.slug":"a"}
{"s.slug":"s2","d.slug":"a"}
{"s.slug":"s3","d.slug":"f"}
{"s.slug":"s4","d.slug":"f"}
--- expect shape
s.slug: String
d.slug: String
--- expect plan
scan Doc as $d: access id_lookup
scan Doc as $d: filter reads [d.state, d.body, d.summary]
pass access_path
