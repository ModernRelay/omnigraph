# issue: none
# notes: A key equality reduces the source frontier before expansion mode and destination access are chosen.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    name: String @key
}
edge Links: Person -> Person

