--- query
set engine = v2;
query one_start() {
    match { $a: Person { name: "p000" } $a links{1,2} $b }
    return { $b.name }
}
--- expect unordered
{"b.name":"p001"}
{"b.name":"p002"}
--- expect shape
b.name: String
--- expect plan
expand $a Links $b: mode indexed_scan
scan Person as $b: access id_lookup
