--- query
set engine = v2;
query any_reached() {
    match {
        $p: Person
        $p knows{1,2} $f
    }
    return { $f.role }
    limit 1
}

--- expect unordered
{"f.role":"reached"}
--- expect shape
f.role: String

--- query
set engine = v2;
query pair_count() {
    match {
        $p: Person
        $p knows{1,2} $f
    }
    return { count($f) as n }
}

--- expect unordered
{"n":1050624}
--- expect shape
n: I64
