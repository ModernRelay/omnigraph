# issue: none
# notes: A BM25 ordering must preserve a search filter on another property of the same binding.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    title: String @index
    body: String @index
}

--- seed
{"type":"Doc","data":{"slug":"doc-both","title":"alpha report","body":"needle filler"}}
{"type":"Doc","data":{"slug":"doc-body-only","title":"beta report","body":"needle needle filler"}}
{"type":"Doc","data":{"slug":"doc-title-only","title":"alpha memo","body":"plain filler"}}

--- query
set engine = v2;
query filtered_rank($t: String, $q: String) {
    match {
      from bm25({ match { $d: Doc } where search($d.title, $t) return { $d } }, $d.body, $q),
    }
    return { $d.slug }
    order { $score desc }
    limit 5
}

--- params
{"t": "alpha", "q": "needle"}

--- expect ordered
{"d.slug": "doc-both"}

--- expect shape
d.slug: String
