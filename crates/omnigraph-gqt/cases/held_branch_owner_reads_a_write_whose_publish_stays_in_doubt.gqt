# issue: none
# notes: On a branch its process holds, a publish left in doubt withdraws the owner's record of the head: the write
# notes: that landed is read, and the next write lands above it.
# writer: held

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Person {
    name: String @key
}

--- seed
{"type":"Person","data":{"name":"alice"}}

--- seam
at: publish.post_merge_pre_ack
occurrence: 1
action: fail
scope: next_step
--- seam
at: publish.read_back
occurrence: 1
action: fail
scope: next_step

--- mutate
query add_bob() { insert Person { name: "bob" } }
--- expect error: outcome is in doubt

--- query
query landed_write_is_read() { match { $p: Person } return { $p.name } }
--- expect unordered
{"p.name":"alice"}
{"p.name":"bob"}
--- expect shape
p.name: String

--- mutate
query add_carol() { insert Person { name: "carol" } }
--- expect affected: nodes=1 edges=0

--- query
query next_write_is_read() { match { $p: Person } return { $p.name } }
--- expect unordered
{"p.name":"alice"}
{"p.name":"bob"}
{"p.name":"carol"}
--- expect shape
p.name: String
