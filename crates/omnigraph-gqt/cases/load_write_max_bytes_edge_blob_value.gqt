# issue: none
# notes: Decoded base64: bytes on an edge property are bounded by the session's write_max_bytes: 4,097 bytes are refused at 4096.
# notes: Exactly one Cites row at the end shows the refused load wrote no edge.
# notes: No omnigraph-server environment: served runs refuse settings steps and the HTTP load routes take no setting.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Doc {
    slug: String @key
}
edge Cites: Doc -> Doc {
    attachment: Blob?
}

--- seed
{"type":"Doc","data":{"slug":"a"}}
{"type":"Doc","data":{"slug":"b"}}

--- mutate
set write_max_bytes = 4096;

--- expect ok

--- load generate: v1 seed: 1 mode: append
tables:
  - kind: edge
    name: Cites
    rows: 1
    commits: 1
    from: {kind: literal, value: a}
    to: {kind: literal, value: b}
    columns:
      attachment:
        kind: literal
        value: "base64:"
--- expect error: decoded blob input bytes

--- load generate: v1 seed: 1 mode: append
tables:
  - kind: edge
    name: Cites
    rows: 1
    commits: 1
    from: {kind: literal, value: a}
    to: {kind: literal, value: b}
    columns:
      attachment: {kind: literal, value: "base64:QUFB"}
--- expect ok

--- query
query cites() {
    match {
        $a: Doc
        $a cites $b
    }
    return { $a.slug, $b.slug }
}
--- expect unordered
{"a.slug": "a", "b.slug": "b"}
--- expect shape
a.slug: String
b.slug: String
