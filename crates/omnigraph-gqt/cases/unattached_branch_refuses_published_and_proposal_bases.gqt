# issue: none
# notes: A child base must be a live unattached snapshot: a published commit and an `as commit` proposal are
# notes: refused as the wrong kind, an unknown id is not found, and the recorded target only holds its own writes.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}

--- mutate
query add_bob() {
    insert Person { name: "bob", age: 41 }
}

--- expect affected: nodes=1 edges=0

--- bind commit $p

--- mutate
query child_of_published() as unattached branch on "${p}" {
    insert Person { name: "carol", age: 52 }
}

--- expect error: is not an unattached snapshot

--- mutate
query propose_dave() as commit {
    insert Person { name: "dave", age: 63 }
}

--- expect affected: nodes=1 edges=0

--- bind commit $q

--- mutate
query child_of_proposal() as unattached branch on "${q}" {
    insert Person { name: "carol", age: 52 }
}

--- expect error: is not an unattached snapshot

--- mutate
query child_of_unknown() as unattached branch on "01ARZ3NDEKTSV4RRFFQ69G5FAV" {
    insert Person { name: "carol", age: 52 }
}

--- expect error: not found

--- mutate
commit drop "${q}"

--- expect ok

--- query
query names_on_main() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "bob"}

--- expect shape
p.name: String
