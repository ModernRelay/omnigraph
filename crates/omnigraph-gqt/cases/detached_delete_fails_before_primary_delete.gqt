# issue: none
# notes: A node delete fails after its incident edges were staged and before the node delete; nothing is published.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Person {
    name: String @key
    age: I64
}
edge Knows: Person -> Person { @key(@src, @dst) }

--- seed
{"type":"Person","data":{"name":"alice","age":30}}
{"type":"Person","data":{"name":"bob","age":40}}
{"edge":"Knows","from":"alice","to":"bob"}
{"edge":"Knows","from":"bob","to":"alice"}

--- seam
at: mutation.delete_node_pre_primary_delete
occurrence: 1
action: fail
scope: next_step

--- mutate
query delete_bob() { delete Person where name = "bob" }
--- expect error: injected failpoint triggered: mutation.delete_node_pre_primary_delete

--- query branch: main
query people() { match { $p: Person } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"alice","p.age":30}
{"p.name":"bob","p.age":40}
--- expect shape
p.name: String
p.age: I64

--- query branch: main
query edges() { match { $p: Person $p $e:knows $q } return { $p.name, $q.name } }
--- expect unordered
{"p.name":"alice","q.name":"bob"}
{"p.name":"bob","q.name":"alice"}
--- expect shape
p.name: String
q.name: String

--- mutate
query delete_bob() { delete Person where name = "bob" }
--- expect affected: nodes=1 edges=2

--- restart

--- query branch: main
query people() { match { $p: Person } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"alice","p.age":30}
--- expect shape
p.name: String
p.age: I64

--- mutate
query readd() { insert Person { name: "bob", age: 41 } }
--- expect affected: nodes=1 edges=0

--- query branch: main
query people() { match { $p: Person } return { $p.name, $p.age } }
--- expect unordered
{"p.name":"alice","p.age":30}
{"p.name":"bob","p.age":41}
--- expect shape
p.name: String
p.age: I64
