# issue: none
# notes: s forks b at the seed commit; under set history_release_bytes = 2048; four bumps on b
# notes: release that fork point into __history; after a restart the merge of s finds its base there.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0]

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":0}}
{"type":"Person","data":{"name":"bob","age":0}}

--- mutate
set history_release_bytes = 2048;

--- expect ok

--- mutate
branch create b

--- expect ok

--- mutate
branch create s from b

--- expect ok

--- mutate branch: s
query set_bob_on_s() {
    update Person set { age: 7 } where name = "bob"
}

--- expect affected: nodes=1 edges=0

--- loop $i 1 5
--- mutate branch: b
query bump_alice($n: I32) {
    update Person set { age: $n } where name = "alice"
}
--- params
{"n": ${i}}
--- expect affected: nodes=1 edges=0
--- endloop

--- restart

--- mutate
branch merge s into b

--- expect outcome: merged

--- query branch: b
query people_after_merge() { match { $p: Person } return { $p.name, $p.age } }

--- expect unordered
{"p.name":"alice","p.age":4}
{"p.name":"bob","p.age":7}

--- expect shape
p.name: String
p.age: I32
