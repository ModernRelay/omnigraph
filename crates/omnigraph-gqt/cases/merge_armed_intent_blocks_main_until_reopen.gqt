# issue: none
# notes: A branch merge that fails after its table effects and whose in-process error recovery fails too leaves a rollback-eligible sidecar on main. The next write on main reports that exact pending operation; it does not commit a second effect and does not publish around the intent.
# notes: The known failure is the documented one-mutation-process boundary: a rollback-eligible intent waits for a read-write reopen (invariants.md, current support boundaries). RFC 0067 removes it when branch merge moves to detached staging and a failed merge leaves nothing behind; the healthy assertion stays in the case for that day.
--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- known_failure
step: 4
match:
  error: RecoveryRequired
  reason: "pending BranchMerge recovery operation on branch 'main' blocks the synchronous write/control recovery barrier (datasets dataset for node type 'Person'); reopen the graph read-write before retrying"
--- schema
node Person {
    name: String @key
}
--- seed
{"type":"Person","data":{"name":"alice"}}
--- mutate
branch create work
--- expect ok
--- mutate branch: work
query add() { insert Person { name: "bob" } }
--- expect affected: nodes=1 edges=0
--- seam
at: branch_merge.post_effects_pre_confirm
occurrence: 1
action: fail
scope: next_step
--- seam
at: branch_merge.pre_error_recovery
occurrence: 1
action: fail
scope: next_step
--- mutate
branch merge work into main
--- expect error: injected failpoint triggered: branch_merge.post_effects_pre_confirm
--- mutate
query retry() { insert Person { name: "carol" } }
--- expect affected: nodes=1 edges=0
--- query
query after_write() { match { $p: Person } return { $p.name } }
--- expect unordered
{"p.name":"alice"}
{"p.name":"carol"}
--- expect shape
p.name: String
--- restart
--- query
query after_reopen() { match { $p: Person } return { $p.name } }
--- expect unordered
{"p.name":"alice"}
{"p.name":"carol"}
--- expect shape
p.name: String
