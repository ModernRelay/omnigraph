--- query
query stmt_10() {
    match {
        $n: Test
        $n.pk = "ewm8ewnn ewweklnbgew888g@lew3:ewe"
        $n.prop1 = "model"
        $n.prop2 = 74
        $n.prop3 = "zones"
    }
    return { $n.pk, $n.prop1, $n.prop2, $n.prop3, $n.prop4 }
}

