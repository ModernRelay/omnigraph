# issue: none
# notes: An aggregate expression inside order is refused. Order by its
# notes: return alias instead.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    name: String @key
}

--- seed
{"type":"Person","data":{"name":"alice"}}

--- query
query count_ordered() {
    match { $p: Person }
    return { count($p) as total }
    order { count($p) }
}

--- expect error: unsupported ordering expression

--- query
query meta_aggregate_order_refused() {
    match { $p: Person }
    return { $p.name, count($p.@id) }
    order { max($p.@id) }
}

--- expect error: unsupported ordering expression
