# issue: none
# notes: One mutation inserts a Person whose @unique email a committed row holds and an edge to an
# notes: absent Person; the node table is judged before the edge table, so the refusal names the
# notes: @unique collision, not the orphan edge, on text keys.

# traversal: auto

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    id: String @key
    email: String @unique
}
node Tag {
    id: String @key
}
edge Knows: Person -> Person

--- seed generate: v1 seed: 42
tables:
  - kind: node
    name: Person
    rows: 8
    commits: 4
    columns:
      id: {kind: key, prefix: p, width: 6}
      email: {kind: key, prefix: e, width: 6}

--- mutate
query w() {
    insert Person { id: "n000000", email: "e000003" }
    insert Knows { from: "p000000", to: "zz0002" }
}
--- expect error: @unique violation on Person.email: value 'e000003' held by 'p000003' and 'n000000'
