# issue: none
# notes: A string or a comment may hold a character outside ASCII; a name holding one is refused with `Q001` at that character,
# notes: which the refusal table (`tests/integration/law_refusals.rs`) pins.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
interface Named { name: String }
node Person implements Named {
    handle: String @key
    name: String
    age: I32?
    city: String?
}
node Company implements Named {
    slug: String @key
    name: String
}
node Doc {
    id: String @key
    title: String
    body: String @index
    year: I32
    tags: [String]
    embedding: Vector(3)?
    payload: Blob?
}
node Collection {
    slug: String @key
    min_docs: I32
}
edge WorksAt: Person -> Company @card(0..1)
edge Knows: Person -> Person
edge Authored: Person -> Doc
edge Cites: Doc -> Doc
edge In: Doc -> Collection

--- seed
{"type":"Person","data":{"handle":"ada","name":"Zoë","age":36}}
{"type":"Company","data":{"slug":"acme","name":"Acme"}}

--- query
query q() { match { $p: Person } where $p.name = "Zoë" /* naïve */ return { $p.handle } }

--- expect unordered
{"p.handle":"ada"}

--- expect shape
p.handle: String
