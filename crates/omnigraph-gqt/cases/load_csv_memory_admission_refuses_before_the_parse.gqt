--- mutate
set query_memory_bytes = 32768;
load csv "items.csv" into node:Item mode overwrite header
--- expect error: query_memory_bytes

--- query
query unchanged() { match { $i: Item } return { $i.id, $i.n } }
--- expect unordered
{"i.id": "seed", "i.n": 0}
--- expect shape
i.id: String
i.n: I64

--- mutate
set query_memory_bytes = 1048576;
load csv "items.csv" into node:Item mode overwrite header
--- expect ok
--- expect plan
load executed: partitions 2 rows 100

--- query
query replaced() { match { $i: Item } return { count($i) as n } }
--- expect unordered
{"n": 100}
--- expect shape
n: I64
