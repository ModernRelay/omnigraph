# issue: none
# csv_slice_bytes: 4096
# notes: A `load csv` overwrite admits its memory once, before any partition reads: after the key sets are
# notes: charged, what `query_memory_bytes` leaves past the statement's holdings is shared out per parse partition
# notes: (two of 4096 bytes here), and a share under one partition's source admission plus one slice refuses
# notes: with the smallest admitting limit as `actual`, a figure from the plan's constants (48,670 for 32 KiB under
# notes: the DST), the same on every run and seed; nothing is read or staged and the type keeps its rows. A limit
# notes: that admits it loads.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 1]

--- schema
node Item {
    id: String @key
    n: I64
}

--- seed
{"type":"Item","data":{"id":"seed","n":0}}

