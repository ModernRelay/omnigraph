# issue: none
# notes: Skip the confirm put; the normal post-commit delete removes the Armed sidecar.
# notes: The committed rows remain readable after reopening.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0]

--- schema
node Person {
    name: String @key
}

--- seed
{"type":"Person","data":{"name":"alice"}}

--- seam
at: mutation.sidecar_confirm_put
occurrence: 1
action: skip
scope: next_step

--- mutate
query add_row() {
    insert Person { name: "bob" }
}

--- expect affected: nodes=1 edges=0

--- restart

--- query
query rows_after_reopen() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name":"alice"}
{"p.name":"bob"}

--- expect shape
p.name: String
