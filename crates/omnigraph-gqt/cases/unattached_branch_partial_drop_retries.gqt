# issue: none
# notes: A root drop that fails after its child's tag is gone and before its own answers the error and leaves the
# notes: root readable and the child not found; a second drop of the same root completes, and the target is unchanged.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}

--- mutate
query root_bob() as unattached branch {
    insert Person { name: "bob", age: 41 }
}

--- expect affected: nodes=1 edges=0

--- bind commit $r

--- mutate
query child_carol() as unattached branch on "${r}" {
    insert Person { name: "carol", age: 52 }
}

--- expect affected: nodes=1 edges=0

--- bind commit $c1

--- seam
at: unattached.drop_post_descendant_pre_parent
occurrence: 1
action: fail
scope: next_step

--- mutate
commit drop "${r}"

--- expect error: injected failpoint triggered: unattached.drop_post_descendant_pre_parent

--- query snapshot: $r
query names_at_root_after_partial_drop() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "bob"}

--- expect shape
p.name: String

--- query snapshot: $c1
query names_at_child_after_partial_drop() {
    match { $p: Person }
    return { $p.name }
}

--- expect error: not found

--- mutate
commit drop "${r}"

--- expect ok

--- query snapshot: $r
query names_at_dropped_root() {
    match { $p: Person }
    return { $p.name }
}

--- expect error: not found

--- query
query names_on_main() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}

--- expect shape
p.name: String
