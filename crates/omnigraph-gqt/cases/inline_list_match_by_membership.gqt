# issue: none
# notes: Membership in a `[String]` property is `<value> in $p.tags` in
# notes: `where`, with a literal and with a parameter; a list compared with
# notes: the property for equality is refused with T7, and a list parameter
# notes: as the needle of `in` is refused with T7.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Person {
    slug: String @key
    tags: [String]
}

--- seed
{"type":"Person","data":{"slug":"a","tags":["rust","go"]}}
{"type":"Person","data":{"slug":"b","tags":["go"]}}
{"type":"Person","data":{"slug":"c","tags":[]}}

--- query
query literal_membership() {
    match { $p: Person } where "rust" in $p.tags
    return { $p.slug }
}

--- expect unordered
{"p.slug": "a"}

--- expect shape
p.slug: String

--- query
query parameter_membership($tag: String) {
    match { $p: Person } where $tag in $p.tags
    return { $p.slug }
}

--- params
{"tag": "go"}

--- expect unordered
{"p.slug": "a"}
{"p.slug": "b"}

--- expect shape
p.slug: String

--- query
query list_literal_refused() {
    match { $p: Person } where $p.tags = ["rust"]
    return { $p.slug }
}

--- expect error: T7: list equality is not supported: cannot compare [String] with [String]

--- query
query list_parameter_refused($tags: [String]) {
    match { $p: Person } where $tags in $p.tags
    return { $p.slug }
}

--- expect error: T7: `in` tests membership in [String]: the needle must be String, got [String]
