# issue: 659
# red_on: 7f1233bb
# notes: RRF retains concrete edge multiplicity and orders equal IDs by type before applying a row limit: the
# notes: fusion yields one row per Person, the traversal after its `from` multiplies them by edge, and the
# notes: final sort's tie rule orders a selected edge by type then id.
# notes: The second arm ranks `hay` so the two arms differ; it selects only `b`, which has no outgoing edge, so the rows are `a`'s.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    text: String @index
}
edge Knows: Person -> Person
edge Likes: Person -> Person

--- seed
{"type":"Person","data":{"name":"a","text":"needle"}}
{"type":"Person","data":{"name":"b","text":"hay"}}
{"edge":"Likes","id":"shared","from":"a","to":"b"}
{"edge":"Knows","id":"shared","from":"a","to":"b"}

--- query
query fused_types() {
    match {
      let $all = { match { $p: Person } return { $p } },
      from rrf(bm25($all, $p.text, "needle"), bm25($all, $p.text, "hay"), k: 60) as $score,
      $p: Person,
      $p $e:(likes | knows) $q,
    }
    return { $e.@type as edge_type, $e.@id as edge_id }
    order { $score desc }
    limit 2
}

--- expect unordered
{"edge_type":"Knows","edge_id":"shared"}
{"edge_type":"Likes","edge_id":"shared"}

--- expect shape
edge_type: String
edge_id: String

--- expect plan
expand $p $q: selection alternation [Knows out, Likes out]
rank fuse no row tiebreak
sort tiebreak [$p, $q, $e.@type, $e.@id]

--- query
query fused_type_page() {
    match {
      let $all = { match { $p: Person } return { $p } },
      from rrf(bm25($all, $p.text, "needle"), bm25($all, $p.text, "hay"), k: 60) as $score,
      $p: Person,
      $p $e:(likes | knows) $q,
    }
    return { $e.@type as edge_type, $e.@id as edge_id }
    order { $score desc }
    limit 1
}

--- expect unordered
{"edge_type":"Knows","edge_id":"shared"}

--- expect shape
edge_type: String
edge_id: String

--- query
query fused_wildcard_type_page() {
    match {
      let $all = { match { $p: Person } return { $p } },
      from rrf(bm25($all, $p.text, "needle"), bm25($all, $p.text, "hay"), k: 60) as $score,
      $p: Person,
      $q: Person,
      $p $e:* $q,
    }
    return { $e.@type as edge_type, $e.@id as edge_id }
    order { $score desc }
    limit 1
}

--- expect unordered
{"edge_type":"Knows","edge_id":"shared"}

--- expect shape
edge_type: String
edge_id: String

--- expect plan
expand $p $q: selection wildcard [Knows out, Likes out]
rank fuse no row tiebreak
sort tiebreak [$p, $q, $e.@type, $e.@id]
