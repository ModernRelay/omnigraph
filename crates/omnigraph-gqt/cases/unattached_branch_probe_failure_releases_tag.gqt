# issue: none
# notes: A child write whose authority probe fails after its tag is written releases that tag and answers the
# notes: error; the next child on the same root succeeds with only its own rows, and the target is unchanged.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}

--- mutate
query root_bob() as unattached branch {
    insert Person { name: "bob", age: 41 }
}

--- expect affected: nodes=1 edges=0

--- bind commit $r

--- seam
at: propose.post_tag_pre_probe
occurrence: 1
action: fail
scope: next_step

--- mutate
query child_carol() as unattached branch on "${r}" {
    insert Person { name: "carol", age: 52 }
}

--- expect error: injected failpoint triggered: propose.post_tag_pre_probe

--- query snapshot: $r
query names_at_root_after_failure() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "bob"}

--- expect shape
p.name: String

--- mutate
query child_dave() as unattached branch on "${r}" {
    insert Person { name: "dave", age: 63 }
}

--- expect affected: nodes=1 edges=0

--- bind commit $c

--- query snapshot: $c
query names_at_child() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "bob"}
{"p.name": "dave"}

--- expect shape
p.name: String

--- query
query names_on_main() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}

--- expect shape
p.name: String
