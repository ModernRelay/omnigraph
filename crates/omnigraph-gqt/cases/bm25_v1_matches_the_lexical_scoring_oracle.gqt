--- query
query rare_variant() {
    match { let $pop = { match { $d: RareVariant } return { $d } }, from bm25($pop, $d.text, terms("beta", mode: any, max_edits: 1)) as $score }
    return { $d.slug, $score }
    order { $score desc, $d.slug }
}

--- expect ordered
