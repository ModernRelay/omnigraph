# issue: none
# notes: `bm25` on a field whose index declares an analyzer scores with `bm25_v1` (docs/rfcs/
# notes: 2026-11-07-gq-3.md, section 4, "bm25_v1"): F64, libm's `log1p` IDF over the field corpus
# notes: (every entity of the type with a non-empty analyzed value), alternatives within a query
# notes: term's edit budget sharing its group's IDF, the best of them weighted 1, 1/2 or 1/4,
# notes: parts summed in ascending query-term order; membership is the `terms` relation. Each type
# notes: holds one fixture of the RFC's lexical scoring oracle (the spike's
# notes: `lexical_scoring_v1.json`, scores computed in 80-digit decimal arithmetic): the expected
# notes: scores are that oracle's, rounded once to F64, and the reference interpreter agrees.
# notes: The ten edit-tolerant shapes are here (a rare variant, alternatives that do not add, one
# notes: term satisfying two groups, `all` and `any` over the same statistics, null and token-empty
# notes: values outside the corpus, two edits and a transposition, a Unicode scalar edit, and three
# notes: corpora with no match), beside the zero-edit ones.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node RareVariant {
    slug: String @key
    text: String? @index(fulltext, analyzer = "standard_v1")
}
node ZeroEdits {
    slug: String @key
    text: String? @index(fulltext, analyzer = "standard_v1")
}
node ZeroEditsMultiTerm {
    slug: String @key
    text: String? @index(fulltext, analyzer = "standard_v1")
}
node AlternativesDoNotAdd {
    slug: String @key
    text: String? @index(fulltext, analyzer = "standard_v1")
}
node OneTermSatisfiesTwoGroups {
    slug: String @key
    text: String? @index(fulltext, analyzer = "standard_v1")
}
node AllCountsEachFamilyBeforeQueryFilter {
    slug: String @key
    text: String? @index(fulltext, analyzer = "standard_v1")
}
node AnyUsesTheSameStatistics {
    slug: String @key
    text: String? @index(fulltext, analyzer = "standard_v1")
}
node NullAndTokenEmptyAreOutsideCorpus {
    slug: String @key
    text: String? @index(fulltext, analyzer = "standard_v1")
}
node TwoEditsAndTransposition {
    slug: String @key
    text: String? @index(fulltext, analyzer = "standard_v1")
}
node UnicodeScalarEdit {
    slug: String @key
    text: String? @index(fulltext, analyzer = "standard_v1")
}
node EmptyCorpus {
    slug: String @key
    text: String? @index(fulltext, analyzer = "standard_v1")
}
node OnlyMissingAndTokenEmpty {
    slug: String @key
    text: String? @index(fulltext, analyzer = "standard_v1")
}
node NoMatchingFamily {
    slug: String @key
    text: String? @index(fulltext, analyzer = "standard_v1")
}

