# issue: none
# notes: Under set history_release_bytes = 2048; the insert after the loop releases b's buffer
# notes: into __history/blocks/; rows read the same warm, after a restart and after the next write.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0]

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":0}}
{"type":"Person","data":{"name":"bob","age":0}}

--- mutate
set history_release_bytes = 2048;

--- expect ok

--- mutate
branch create b

--- expect ok

--- loop $i 1 4
--- mutate branch: b
query bump_alice($n: I32) {
    update Person set { age: $n } where name = "alice"
}
--- params
{"n": ${i}}
--- expect affected: nodes=1 edges=0
--- endloop

--- mutate branch: b
query releasing_publish() { insert Person { name: "carol", age: 1 } }

--- expect affected: nodes=1 edges=0

--- query branch: b
query people_after_release() { match { $p: Person } return { $p.name, $p.age } }

--- expect unordered
{"p.name":"alice","p.age":3}
{"p.name":"bob","p.age":0}
{"p.name":"carol","p.age":1}

--- expect shape
p.name: String
p.age: I32

--- restart

--- query branch: b
query people_after_reopen() { match { $p: Person } return { $p.name, $p.age } }

--- expect unordered
{"p.name":"alice","p.age":3}
{"p.name":"bob","p.age":0}
{"p.name":"carol","p.age":1}

--- expect shape
p.name: String
p.age: I32

--- mutate branch: b
query write_after_reopen() { insert Person { name: "dave", age: 2 } }

--- expect affected: nodes=1 edges=0

--- query branch: b
query people_after_write() { match { $p: Person } return { $p.name, $p.age } }

--- expect unordered
{"p.name":"alice","p.age":3}
{"p.name":"bob","p.age":0}
{"p.name":"carol","p.age":1}
{"p.name":"dave","p.age":2}

--- expect shape
p.name: String
p.age: I32
