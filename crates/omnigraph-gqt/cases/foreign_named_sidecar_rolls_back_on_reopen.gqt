# issue: none
# notes: Misdirect the arm put, then fail the confirm put: the foreign-named sidecar stays Armed.
# notes: Reopen must roll it back at its listed URI, omit bob, and allow the next write.
# notes: The issue_601_* cases cover the corresponding roll-forward path.
# notes: Red at fe9eb339 (2026-09-16): reopening left the foreign file and step 3 refused
# notes: with RecoveryRequired for pending Mutation recovery on main.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0]

--- schema
node Person {
    name: String @key
}

--- seed
{"type":"Person","data":{"name":"alice"}}

--- seam
at: recovery.sidecar_write
occurrence: 1
action: misdirect
scope: next_step

--- seam
at: mutation.sidecar_confirm_put
occurrence: 1
action: fail
scope: next_step

--- mutate
query add_row() {
    insert Person { name: "bob" }
}

--- expect error: injected failpoint triggered: mutation.sidecar_confirm_put

--- restart

--- mutate
query add_row_after_reopen() {
    insert Person { name: "carol" }
}

--- expect affected: nodes=1 edges=0

--- query
query rows_after_reopen() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name":"alice"}
{"p.name":"carol"}

--- expect shape
p.name: String
