# issue: none
# notes: A root on a fresh branch records that branch's captured head and incarnation: a write on main (which
# notes: shares the inherited head) does not expire it, a child without `branch:` extends it, a write on the branch does expire it.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}

--- mutate
branch create feature

--- expect ok

--- mutate branch: feature
query root_bob() as unattached branch {
    insert Person { name: "bob", age: 41 }
}

--- expect affected: nodes=1 edges=0

--- bind commit $r

--- mutate
query add_carol_on_main() {
    insert Person { name: "carol", age: 52 }
}

--- expect affected: nodes=1 edges=0

--- query snapshot: $r
query names_at_root_after_main_write() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "bob"}

--- expect shape
p.name: String

--- mutate branch: main
query child_on_wrong_target() as unattached branch on "${r}" {
    insert Person { name: "forbidden", age: 99 }
}

--- expect error: is not the recorded target

--- mutate
query child_dave() as unattached branch on "${r}" {
    insert Person { name: "dave", age: 63 }
}

--- expect affected: nodes=1 edges=0

--- bind commit $c

--- query snapshot: $c
query names_at_child() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "bob"}
{"p.name": "dave"}

--- expect shape
p.name: String

--- mutate branch: feature
query add_erin_on_feature() {
    insert Person { name: "erin", age: 27 }
}

--- expect affected: nodes=1 edges=0

--- query snapshot: $r
query names_at_expired_root() {
    match { $p: Person }
    return { $p.name }
}

--- expect error: not found: it expired

--- query snapshot: $c
query names_at_expired_child() {
    match { $p: Person }
    return { $p.name }
}

--- expect error: not found: it expired

--- query branch: feature
query names_on_feature() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "erin"}

--- expect shape
p.name: String

--- query
query names_on_main() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "carol"}

--- expect shape
p.name: String
