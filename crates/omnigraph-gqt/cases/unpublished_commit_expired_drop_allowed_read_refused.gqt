# issue: none
# notes: P4: an expired proposal is unavailable to new reads; the user docs say a commit past its parent can only be dropped.
# notes: P5: a repeated drop is not found. P20: the target keeps its own rows.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}

--- mutate
query propose_bob() as commit {
    insert Person { name: "bob", age: 41 }
}

--- expect affected: nodes=1 edges=0

--- bind commit $bob

--- mutate
query add_carol() {
    insert Person { name: "carol", age: 52 }
}

--- expect affected: nodes=1 edges=0

--- query snapshot: $bob
query names_at_bob() {
    match { $p: Person }
    return { $p.name }
}

--- expect error: not found

--- mutate
commit drop "${bob}"

--- expect ok

--- mutate
commit drop "${bob}"

--- expect error: not found

--- query
query names_on_main() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "carol"}

--- expect shape
p.name: String
