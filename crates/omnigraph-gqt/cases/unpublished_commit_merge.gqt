# issue: none
# notes: `branch merge … as commit` merges into an unpublished commit: the target head is unchanged
# notes: until `commit publish`, and the published merge leaves the source up to date.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}

--- mutate
branch create b0

--- expect ok

--- mutate branch: b0
query insert_on_b0() {
    insert Person { name: "bob", age: 41 }
}

--- expect affected: nodes=1 edges=0

--- mutate
query insert_on_main() {
    insert Person { name: "carol", age: 52 }
}

--- expect affected: nodes=1 edges=0

--- mutate
branch merge b0 into main as commit

--- expect outcome: merged

--- bind commit $merge

--- query
query names_on_main() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "carol"}

--- expect shape
p.name: String

--- query snapshot: $merge
query names_at_proposal() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "bob"}
{"p.name": "carol"}

--- expect shape
p.name: String

--- mutate
commit publish "${merge}"

--- expect ok

--- query
query names_after_publish() {
    match { $p: Person }
    return { $p.name }
}

--- expect unordered
{"p.name": "alice"}
{"p.name": "bob"}
{"p.name": "carol"}

--- expect shape
p.name: String

--- mutate
branch merge b0

--- expect outcome: already_up_to_date
