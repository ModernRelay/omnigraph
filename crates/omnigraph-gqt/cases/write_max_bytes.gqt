# issue: none
# notes: The configured write allowance independently bounds row data and Blob payloads.
# notes: Exact payloads coexist with scalar metadata; refused writes leave the accepted row intact.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    content: Blob?
    note: String
}

node Image {
    slug: String @key
    content: Blob?
}

--- seed

--- mutate
set write_max_bytes = 4093;
query exact($payload: Blob) {
    insert Doc { slug: "accepted", content: $payload, note: "scalar" }
}

--- params
{"payload": "base64:"}

--- expect affected: nodes=1 edges=0

--- mutate
set write_max_bytes = 4093;
query too_large($payload: Blob) {
    insert Doc { slug: "refused", content: $payload, note: "scalar" }
}

--- params
{"payload": "base64:"}

--- expect error: resource limit exceeded

--- mutate
set write_max_bytes = 4093;
query aggregate($payload: Blob) {
    insert Doc { slug: "a", content: $payload, note: "scalar" }
    insert Doc { slug: "b", content: $payload, note: "scalar" }
}

--- params
{"payload": "base64:"}

--- expect error: resource limit exceeded

--- mutate
set write_max_bytes = 4093;
query cross_table($payload: Blob) {
    insert Doc { slug: "cross-doc", content: $payload, note: "scalar" }
    insert Image { slug: "cross-image", content: $payload }
}

--- params
{"payload": "base64:"}

--- expect error: decoded blob input bytes per operation

--- query
query images() {
    match { $i: Image }
    return { $i.slug }
}

--- expect unordered

--- expect shape
i.slug: String

--- mutate
set write_max_bytes = 4093;
query wide_scalar($note: String) {
    insert Doc { slug: "wide", note: $note }
}

--- params
{"note": ""}

--- expect error: resource limit exceeded

--- mutate
set write_max_bytes = 4093;
query carry_payload() {
    update Doc set { note: "updated" } where slug = "accepted"
}

--- expect affected: nodes=1 edges=0

--- mutate
set write_max_bytes = 1;
query removed_ids() {
    delete Doc where slug = "accepted"
}

--- expect error: retained removed-id bytes per operation

--- query
query rows() {
    match { $d: Doc }
    return { $d.slug, $d.note }
}

--- expect unordered
{"d.slug":"accepted","d.note":"updated"}

--- expect shape
d.slug: String
d.note: String

--- mutate
set write_max_bytes = 8190;
query three_payloads($payload: Blob) {
    insert Doc { slug: "capacity-a", content: $payload, note: "first" }
    insert Doc { slug: "capacity-b", content: $payload, note: "second" }
    insert Doc { slug: "capacity-c", content: $payload, note: "third" }
}

--- params
{"payload": "base64:"}

--- expect affected: nodes=3 edges=0
