# issue: none
# notes: An update charges each assigned base64: value once per matched row, and an insert sums its Blob properties, under `decoded blob input bytes per operation`.
# notes: Each 15,999-byte value fits write_max_bytes = 30000; the two-row update and the two-property insert each total 31,998 and are refused, leaving the rows unchanged.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]

--- schema
node Doc {
    slug: String @key
    content: Blob?
    extra: Blob?
    note: String
}

--- seed

--- mutate
query seed_docs() {
    insert Doc { slug: "a", note: "n" }
    insert Doc { slug: "b", note: "n" }
}

--- expect affected: nodes=2 edges=0

--- mutate
set write_max_bytes = 30000;
query assign_both_rows($payload: Blob) {
    update Doc set { content: $payload } where note = "n"
}

--- params
{"payload": "base64:"}

--- expect error: decoded blob input bytes per operation

--- mutate
set write_max_bytes = 30000;
query two_properties($payload: Blob) {
    insert Doc { slug: "c", content: $payload, extra: $payload, note: "m" }
}

--- params
{"payload": "base64:"}

--- expect error: decoded blob input bytes per operation

--- query
query rows() {
    match { $d: Doc }
    return { $d.slug, $d.note }
}

--- expect unordered
{"d.slug":"a","d.note":"n"}
{"d.slug":"b","d.note":"n"}

--- expect shape
d.slug: String
d.note: String
