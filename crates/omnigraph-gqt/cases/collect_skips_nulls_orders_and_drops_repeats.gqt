# issue: none
# notes: `collect(x)` over a group is a non-null list of `x`'s type: null values are skipped,
# notes: elements follow the fixed value order (a float's total order puts -0.0 before 0.0, and
# notes: the two are distinct values), `collect(distinct x)` drops repeats, and empty input gives
# notes: the empty list: a read with no keys over no rows returns one row with `[]`, a keyed read
# notes: over no rows returns no rows. It sits beside keys and the other aggregates, over String,
# notes: integer, float, Date and Bool values.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Item {
    id: String @key
    grp: String?
    tag: String?
    score: F64?
    n: I32?
    day: Date?
    ok: Bool?
}

--- seed
{"type":"Item","data":{"id":"a","grp":"x","tag":"red","score":2.5,"n":3,"day":"2024-03-01","ok":true}}
{"type":"Item","data":{"id":"b","grp":"x","tag":"blue","score":-0.0,"n":1,"day":"2023-01-01","ok":false}}
{"type":"Item","data":{"id":"c","grp":"x","tag":"red","score":0.0,"n":3}}
{"type":"Item","data":{"id":"d","grp":"x","score":-1.5,"n":-2,"ok":true}}
{"type":"Item","data":{"id":"e","grp":"y","tag":"green"}}
{"type":"Item","data":{"id":"f","grp":"y"}}
{"type":"Item","data":{"id":"g","tag":"blue","score":7.0}}

--- query
query tags_per_group() {
    match { $i: Item }
    return { $i.grp as grp, collect($i.tag) as tags, collect(distinct $i.tag) as kinds, count($i) as items }
}

--- expect unordered
{"items":1,"kinds":["blue"],"tags":["blue"]}
{"grp":"x","items":4,"kinds":["blue","red"],"tags":["blue","red","red"]}
{"grp":"y","items":2,"kinds":["green"],"tags":["green"]}

--- expect shape
grp: String?
tags: [String]
kinds: [String]
items: I64

--- query
query every_value() {
    match { $i: Item }
    return {
        collect($i.score) as scores,
        collect(distinct $i.score) as distinct_scores,
        collect($i.n) as ns,
        collect(distinct $i.n) as distinct_ns,
        collect($i.day) as days,
        collect($i.ok) as oks
    }
}

--- expect unordered
{"days":["2023-01-01","2024-03-01"],"distinct_ns":[-2,1,3],"distinct_scores":[-1.5,-0.0,0.0,2.5,7.0],"ns":[-2,1,3,3],"oks":[false,true,true],"scores":[-1.5,-0.0,0.0,2.5,7.0]}

--- expect shape
scores: [F64]
distinct_scores: [F64]
ns: [I32]
distinct_ns: [I32]
days: [Date]
oks: [Bool]

--- query
query no_rows_no_keys() {
    match { $i: Item }
    where $i.id = "none"
    return { collect($i.tag) as tags, count($i) as items }
}

--- expect unordered
{"items":0,"tags":[]}

--- expect shape
tags: [String]
items: I64

--- query
query no_rows_with_keys() {
    match { $i: Item }
    where $i.id = "none"
    return { $i.grp as grp, collect($i.tag) as tags }
}

--- expect unordered

--- expect shape
grp: String?
tags: [String]

--- query
query only_nulls() {
    match { $i: Item }
    where $i.grp = "y"
    return { collect($i.score) as scores }
}

--- expect unordered
{"scores":[]}

--- expect shape
scores: [F64]
