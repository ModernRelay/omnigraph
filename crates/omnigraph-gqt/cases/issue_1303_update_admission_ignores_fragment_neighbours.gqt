--- mutate
set write_max_bytes = 2048;
query retitle_apart_doc_in_two_statements() {
    update ApartDocTwice set { title: "twice" } where slug = "row000"
    update ApartDocTwice set { title: "twice" } where slug = "nobody"
}

--- expect affected: nodes=1 edges=0

--- mutate
set write_max_bytes = 2048;
query retitle_shared_doc_in_two_statements() {
    update SharedDocTwice set { title: "twice" } where slug = "row000"
    update SharedDocTwice set { title: "twice" } where slug = "nobody"
}

--- expect affected: nodes=1 edges=0

--- query
query titles_after_updates() {
    match {
        $s: Shared { slug: "row000" }
        $a: Apart { slug: "row000" }
    }
    return { $s.title, $a.title }
}

--- expect unordered
{"s.title": "new", "a.title": "new"}

--- expect shape
s.title: String
a.title: String

--- query
query doc_titles_after_updates() {
    match {
        $s: SharedDoc { slug: "row000" }
        $a: ApartDoc { slug: "row000" }
        $sc: SharedDocCleared { slug: "row000" }
        $ac: ApartDocCleared { slug: "row000" }
        $st: SharedDocTwice { slug: "row000" }
        $at: ApartDocTwice { slug: "row000" }
    }
    return { $s.title, $a.title, $sc.title, $ac.title, $st.title, $at.title }
}

--- expect unordered
{"s.title": "new", "a.title": "new", "sc.title": "cleared", "ac.title": "cleared", "st.title": "twice", "at.title": "twice"}

--- expect shape
s.title: String
a.title: String
sc.title: String
ac.title: String
st.title: String
at.title: String
