# issue: 1303
# red_on: 2026-11-08, main ea4a16d5: step 4 `retitle_shared` fails with `resource limit exceeded for retained keyed batch bytes per operation: actual 6473, limit 2048`; steps 1-3 green. With step 4 removed, `retitle_shared_doc_carrying_its_blob` and then `clear_shared_doc` fail the same way, each with actual 6473.
# notes: Whether an update is admitted under write_max_bytes depends only on the request and the
# notes: matched rows, never on the rows stored beside them. `Shared` holds 301 rows in one fragment;
# notes: `Apart` holds the same rows in two (row000 alone, the 300 others appended later). The same
# notes: update of row000 is admitted on both at the same limit. A filtered scan returns the match as
# notes: a slice of its decoded fragment batch; charged as a slice, the shared fragment cost 6,473 bytes.
# notes: The `Doc` pair covers the two Blob scans: one carries the unassigned Blob (its pre-charge
# notes: measured the slice too), and one assigns every Blob, so the matched rows are carried as scanned.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Shared {
    slug: String @key
    title: String
}

node Apart {
    slug: String @key
    title: String
}

node SharedDoc {
    slug: String @key
    content: Blob?
    title: String
}

node ApartDoc {
    slug: String @key
    content: Blob?
    title: String
}

--- seed

--- load generate: v1 seed: 0 mode: append
tables:
  - kind: node
    name: Shared
    rows: 301
    commits: 1
    columns:
      slug: {kind: key, prefix: row, width: 3}
      title: {kind: repeat, text: old, count: 1}
  - kind: node
    name: Apart
    rows: 1
    commits: 1
    columns:
      slug: {kind: key, prefix: row, width: 3}
      title: {kind: repeat, text: old, count: 1}
  - kind: node
    name: ApartDoc
    rows: 1
    commits: 1
    columns:
      slug: {kind: key, prefix: row, width: 3}
      title: {kind: repeat, text: old, count: 1}
  - kind: node
    name: SharedDoc
    rows: 301
    commits: 1
    columns:
      slug: {kind: key, prefix: row, width: 3}
      title: {kind: repeat, text: old, count: 1}

--- expect ok

--- load generate: v1 seed: 0 mode: append
tables:
  - kind: node
    name: Apart
    rows: 300
    start: 1
    commits: 1
    columns:
      slug: {kind: key, prefix: row, width: 3}
      title: {kind: repeat, text: old, count: 1}
  - kind: node
    name: ApartDoc
    rows: 300
    start: 1
    commits: 1
    columns:
      slug: {kind: key, prefix: row, width: 3}
      title: {kind: repeat, text: old, count: 1}

--- expect ok

--- mutate
set write_max_bytes = 2048;
query retitle_apart() {
    update Apart set { title: "new" } where slug = "row000"
}

--- expect affected: nodes=1 edges=0

--- mutate
set write_max_bytes = 2048;
query retitle_shared() {
    update Shared set { title: "new" } where slug = "row000"
}

--- expect affected: nodes=1 edges=0

--- mutate
set write_max_bytes = 2048;
query retitle_apart_doc_carrying_its_blob() {
    update ApartDoc set { title: "new" } where slug = "row000"
}

--- expect affected: nodes=1 edges=0

--- mutate
set write_max_bytes = 2048;
query retitle_shared_doc_carrying_its_blob() {
    update SharedDoc set { title: "new" } where slug = "row000"
}

--- expect affected: nodes=1 edges=0

--- mutate
set write_max_bytes = 2048;
query clear_apart_doc($c: Blob?) {
    update ApartDoc set { content: $c, title: "cleared" } where slug = "row000"
}

--- params
{"c": null}

--- expect affected: nodes=1 edges=0

--- mutate
set write_max_bytes = 2048;
query clear_shared_doc($c: Blob?) {
    update SharedDoc set { content: $c, title: "cleared" } where slug = "row000"
}

--- params
{"c": null}

--- expect affected: nodes=1 edges=0

--- query
query titles_after_updates() {
    match {
        $s: Shared { slug: "row000" }
        $a: Apart { slug: "row000" }
    }
    return { $s.title, $a.title }
}

--- expect unordered
{"s.title": "new", "a.title": "new"}

--- expect shape
s.title: String
a.title: String

--- query
query doc_titles_after_updates() {
    match {
        $s: SharedDoc { slug: "row000" }
        $a: ApartDoc { slug: "row000" }
    }
    return { $s.title, $a.title }
}

--- expect unordered
{"s.title": "cleared", "a.title": "cleared"}

--- expect shape
s.title: String
a.title: String
