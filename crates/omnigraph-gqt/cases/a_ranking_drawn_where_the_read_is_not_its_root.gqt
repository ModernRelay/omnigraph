e.title: String
score: F64
dist: F32

--- query
query q($v: Vector(3)) { match { from { match { let $all = { match { $d: Doc } return { $d } }, from nearest($all, $d.embedding, $v, k: 3) as $s } return { $d, $s } } } return { $d.title, $s } }

--- params
{"v": [1.0, 0.0, 0.0]}

--- expect unordered
{"d.title":"graph basics","s":0}
{"d.title":"graphs again","s":0.5}
{"d.title":"vector search","s":0.020000005}

--- expect shape
d.title: String
s: F32

--- query
query q($v: Vector(3)) { match { $p: Person, optional { let $all = { match { $d: Doc, $p authored $d } return { $d } }, from nearest($all, $d.embedding, $v, k: 1) as $s } } return { $p.name, $d.title, $s } }

