query q($v: Vector(3)) { match { $c: Company, from nearest({ match { $d: Doc, $p: Person, $p authored $d } return { $d, $p } }, $d.embedding, $v, k: 1) as $s } return { $c.slug, $d.id, $p.handle, $s } }

