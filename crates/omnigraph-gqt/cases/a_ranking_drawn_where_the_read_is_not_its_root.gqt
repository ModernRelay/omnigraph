--- query
query q($v: Vector(3)) { match { let $all = { match { $d: Doc } return { $d } }, from union(nearest($all, $d.embedding, $v, k: 2), { match { $d: Doc } where $d.year = 2023 return { $d } }) } return { $d.title } }

