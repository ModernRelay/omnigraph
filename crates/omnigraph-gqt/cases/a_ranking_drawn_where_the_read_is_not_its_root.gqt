--- query
query q($v: Vector(3)) { match { $c: Company, from nearest({ match { $d: Doc, $p: Person, $p authored $d } return { $d, $p } }, $d.embedding, $v, k: 2) as $s } return { $c.slug, $d.id, $p.handle, $s } }

--- params
{"v": [0.0, 1.0, 0.0]}

--- expect unordered
{"c.slug":"acme","d.id":"d3","p.handle":"a","s":0}
{"c.slug":"acme","d.id":"d3","p.handle":"b","s":0}
{"c.slug":"acme","d.id":"d5","p.handle":"b","s":0.5}

--- expect shape
c.slug: String
d.id: String
p.handle: String
s: F32

--- query
query q($s: String, $v: Vector(3)) { match { $p: Person, let $pop = { match { $d: Doc } return { $d } }, from rrf(bm25($pop, $d.body, $s), nearest($pop, $d.embedding, $v, k: 3), k: 60) as $f } where $p.handle = "a" return { $p.name, $d.id, $f } }

--- params
{"s": "graph", "v": [1.0, 0.0, 0.0]}

--- expect unordered
{"d.id":"d1","f":0.032522474881,"p.name":"Ada"}
{"d.id":"d2","f":0.032002048131,"p.name":"Ada"}
{"d.id":"d3","f":0.015625,"p.name":"Ada"}
{"d.id":"d5","f":0.032266458496,"p.name":"Ada"}

--- expect shape
p.name: String
d.id: String
f: F64

--- query
query q($v: Vector(3)) { match { $p: Person, from distance({ match { $d: Doc, $p authored $d } return { $d, $d.year * 2 as y } }, $d.embedding, $v) as $s } where $y > 4042 return { $p.name, $d.id, $y, $s } }

--- params
{"v": [1.0, 0.0, 0.0]}

--- expect unordered
{"d.id":"d3","p.name":"Ada","s":2,"y":4044}
{"d.id":"d3","p.name":"Bob","s":2,"y":4044}
{"d.id":"d4","p.name":"Ada","s":2,"y":4046}
{"d.id":"d5","p.name":"Bob","s":0.5,"y":4048}

--- expect shape
p.name: String
d.id: String
y: I32
s: F32

--- query
query q($v: Vector(3)) { match { $p: Person } where count { from nearest({ match { $d: Doc, $p authored $d } return { $d } }, $d.embedding, $v, k: 1) as $s where $s < 0.1 } > 0 return { $p.name } }

--- params
{"v": [1.0, 0.0, 0.0]}

--- expect unordered
{"p.name":"Ada"}
{"p.name":"Bob"}

--- expect shape
p.name: String

--- query
query q($v: Vector(3)) { match { $p: Person, let $n = count { from nearest({ match { $d: Doc, $p authored $d } return { $d } }, $d.embedding, $v, k: 2) as $s } } return { $p.name, $n } }

--- params
{"v": [1.0, 0.0, 0.0]}

--- expect unordered
{"n":0,"p.name":"Cy"}
{"n":2,"p.name":"Ada"}
{"n":2,"p.name":"Bob"}

--- expect shape
p.name: String
n: I64

--- query
query q($v: Vector(3)) { match { $p: Person, from { match { from nearest({ match { $d: Doc, $p authored $d } return { $d } }, $d.embedding, $v, k: 2) as $s } return { count($d) as n, min($s) as best } } } return { $p.name, $n, $best } }

--- params
{"v": [1.0, 0.0, 0.0]}

--- expect unordered
{"best":0,"n":2,"p.name":"Ada"}
{"best":0.020000005,"n":2,"p.name":"Bob"}
{"n":0,"p.name":"Cy"}

--- expect shape
p.name: String
n: I64
best: F32?

--- query
query q($v: Vector(3)) { match { $p: Person, from nearest({ match { $d: Doc, $p authored $d } return distinct { $d } }, $d.embedding, $v, k: 1) as $s } return { $p.name, $d.id } order { $p.name } limit 2 }

--- params
{"v": [1.0, 0.0, 0.0]}

--- expect ordered
{"d.id":"d1","p.name":"Ada"}
{"d.id":"d2","p.name":"Bob"}

--- expect shape
