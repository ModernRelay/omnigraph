# issue: 801
# red_on: 8bc9aa5f; step 1 fails with `type error: T41: a filter must be Boolean, got String`: with no `in` operator the match body parses as three filter clauses `$m.number`, `in`, `$ms` (v0.11.0: parse error `expected comp_op` at `in`).
# notes: `expr in $list` and `expr in [..]` select the members of the set and push the test into the scan, on a plain
# notes: scan and a traversal destination; a null needle reads null and an empty set matches nothing, under `not` too,
# notes: in a read and in a mutation `where`. Both `in` and `=` use the declared numeric domain; F32 0.1 differs from the F64 literal 0.1.
# notes: The edge `In` is followed as `$p "in" $m`; a bare `$p in $m` is the membership test.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Matter {
    mid: String @key
    number: String
    code: I64?
    weight: F32?
}
node Passage {
    pid: String @key
}
edge PassageOf: Passage -> Matter
edge In: Passage -> Matter

--- seed
{"type":"Matter","data":{"mid":"m1","number":"M-1","code":1,"weight":0.1}}
{"type":"Matter","data":{"mid":"m2","number":"M-2","code":2}}
{"type":"Matter","data":{"mid":"m3","number":"M-3"}}
{"type":"Matter","data":{"mid":"m4","number":"M-4"}}
{"type":"Passage","data":{"pid":"p1"}}
{"type":"Passage","data":{"pid":"p2"}}
{"type":"Passage","data":{"pid":"p3"}}
{"edge":"PassageOf","from":"p1","to":"m1"}
{"edge":"PassageOf","from":"p2","to":"m2"}
{"edge":"PassageOf","from":"p3","to":"m3"}
{"edge":"In","from":"p1","to":"m2"}
{"edge":"In","from":"p2","to":"m4"}

--- query
set engine = v2;
query q($ms: [String]) { match { $m: Matter $m.number in $ms } return { $m.number } limit 5 }

--- params
{"ms": ["M-1", "M-3", "M-9"]}

--- expect unordered
{"m.number": "M-1"}
{"m.number": "M-3"}

--- expect shape
m.number: String

--- expect plan
scan Matter as $m: filter reads [m.number]

--- expect same as v1

--- query
set engine = v2;
query literal_list() {
    match {
        $m: Matter
        $m.number in ["M-1", "M-3", "M-9"]
    }
    return { $m.number }
}

--- expect unordered
{"m.number": "M-1"}
{"m.number": "M-3"}

--- expect shape
m.number: String

--- expect plan
scan Matter as $m: filter reads [m.number]

--- query
set engine = v2;
query traversal_destination($ms: [String]) {
    match {
        $p: Passage
        $p passageOf $m
        $m.number in $ms
    }
    return { $p.pid }
}

--- params
{"ms": ["M-1", "M-3", "M-9"]}

--- expect unordered
{"p.pid": "p1"}
{"p.pid": "p3"}

--- expect shape
p.pid: String

--- expect plan
scan Matter as $m: filter reads [m.number]

--- expect same as v1

--- query
set engine = v2;
query edge_a_reserved_word_names($ms: [String]) {
    match {
        $p: Passage
        $p "in" $m
        $m.number in $ms
    }
    return { $p.pid, $m.number }
}

--- params
{"ms": ["M-2", "M-9"]}

--- expect unordered
{"p.pid": "p1", "m.number": "M-2"}

--- expect shape
p.pid: String
m.number: String

--- query
set engine = v2;
query bare_word_is_the_membership_test() {
    match {
        $p: Passage
        $p in $m
    }
    return { $p.pid }
}

--- expect error: T7: `$p in $m` tests membership and `$p` is a node; to follow the edge `In` write `$p "in" $m`

--- query
set engine = v2;
query contains_spelling($ms: [String]) {
    match {
        $m: Matter
        ($ms contains $m.number)
    }
    return { $m.number }
}

--- params
{"ms": ["M-1", "M-3", "M-9"]}

--- expect unordered
{"m.number": "M-1"}
{"m.number": "M-3"}

--- expect shape
m.number: String

--- expect plan
scan Matter as $m: filter reads [m.number]

--- query
set engine = v2;
query null_needle_under_not($cs: [I64]) {
    match {
        $m: Matter
        not ($m.code in $cs)
    }
    return { $m.mid }
}

