# issue: none
# notes: Merge-back preserves deletions, updates and unchanged reinsertions after reopen.
# notes: merge_cost.rs separately checks that this merge uses lineage discovery.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0]

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}
{"type":"Person","data":{"name":"bob","age":40}}

--- mutate
branch create feature;

--- expect ok

--- mutate branch: feature
query add_carol() {
    insert Person { name: "carol", age: 50 }
}

--- expect affected: nodes=1 edges=0

--- mutate
query add_dave() {
    insert Person { name: "dave", age: 60 }
}

--- expect affected: nodes=1 edges=0

--- mutate
set merge_lineage = verify;
branch merge feature into main;

--- expect outcome: merged

--- mutate
query remove_bob() {
    delete Person where name = "bob"
}

--- expect affected: nodes=1 edges=0

--- mutate
query remove_carol() {
    delete Person where name = "carol"
}

--- expect affected: nodes=1 edges=0

--- mutate
query readd_carol() {
    insert Person { name: "carol", age: 50 }
}

--- expect affected: nodes=1 edges=0

--- mutate branch: feature
query birthday() {
    update Person set { age: 31 } where name = "alice"
}

--- expect affected: nodes=1 edges=0

--- restart

--- mutate
set merge_lineage = verify;
branch merge main into feature;

--- expect outcome: merged

--- restart

--- query branch: feature
query merge_back_rows_survive_reopen() {
    match { $p: Person }
    return { $p.name, $p.age }
}

--- expect unordered
{"p.name":"alice","p.age":31}
{"p.name":"carol","p.age":50}
{"p.name":"dave","p.age":60}

--- expect shape
p.name: String
p.age: I32

--- query
query source_rows_stay_unchanged() {
    match { $p: Person }
    return { $p.name, $p.age }
}

--- expect unordered
{"p.name":"alice","p.age":30}
{"p.name":"carol","p.age":50}
{"p.name":"dave","p.age":60}

--- expect shape
p.name: String
p.age: I32
