# issue: none
# notes: `branch create … from commit "<id>"` refuses, before any effect, a start that is not branch history: an
# notes: unpublished commit (publish it first) and an unattached snapshot, which never becomes branch history; an id no
# notes: commit has is not found.
# notes: The start path itself is in branch_create_at_a_commit.gqt.

--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0, 42]
  - target: omnigraph-server
    storage: local-filesystem

--- schema
node Person {
    name: String @key
    age: I32
}

--- seed
{"type":"Person","data":{"name":"alice","age":30}}
{"type":"Person","data":{"name":"bob","age":40}}

--- mutate
query propose_erin() as commit {
    insert Person { name: "erin", age: 5 }
}

--- expect affected: nodes=1 edges=0

--- bind commit $proposal

--- mutate
branch create from_proposal from commit "${proposal}"

--- expect error: is an unpublished commit

--- mutate
query park_frank() as unattached branch {
    insert Person { name: "frank", age: 6 }
}

--- expect affected: nodes=1 edges=0

--- bind commit $snapshot

--- mutate
branch create from_snapshot from commit "${snapshot}"

--- expect error: is an unattached snapshot, which never becomes branch history

--- mutate
branch create nowhere from commit "01ARZ3NDEKTSV4RRFFQ69G5FAV"

--- expect error: commit '01ARZ3NDEKTSV4RRFFQ69G5FAV' not found

--- query
branch list

--- expect unordered
{"name": "main"}

--- expect shape
name: String
