# issue: none
# red_on: a9aa2850 (v0.12.0); step 3 (query) fails with `resource limit exceeded for query_memory_bytes: actual 158237376, limit 157286400`, and step 4 run alone fails with `actual 158354916`, while engine v1 (`--- expect same as v1`) returns the expected rows for both.
# notes: 5,000 Doc rows whose `body` is one 40,000-byte string (the 16 characters
# notes: 0123456789abcdef repeated 2,500 times): 200 MB of `body` decoded, more than
# notes: the default 150 MiB query budget, while each answer is one 40 KB row.
# notes: Step 1 writes them: 100 loop iterations of 50 inserts, slugs d<i>_<kk> with
# notes: i in 0..100 and kk in 00..49. Step 2 counts them. Step 3 pins that an
# notes: unordered `limit 1` projecting the wide column answers under the budget;
# notes: every row carries the same body, so any one row is right. Step 4 pins the
# notes: same for a top-k (`order ... desc limit 1`): its winner is d9_49, the
# notes: greatest slug in byte order (`_` sorts after the digits), written in the
# notes: tenth of the 100 commits, so a sort that stopped early would miss it.
# notes: In both, the scan streams the narrow columns and the kept row's body is fetched
# notes: by row address above the limit (pass late_materialization).
# notes: Cheap tier: `a_wide_column_read_under_a_limit_follows_its_result` in
# notes: crates/omnigraph/tests/engine_v2_memory.rs (the same shapes, 16 MiB pool).
# notes: Rename to issue_<N>_wide_column_scan_limit_answers.gqt once the issue exists.

--- runner
timeout_ms: 60000
environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Doc {
    slug: String @key
    body: String?
}

--- seed

--- loop $i 0 100
--- mutate
query add_docs($s00: String, $s01: String, $s02: String, $s03: String, $s04: String, $s05: String, $s06: String, $s07: String, $s08: String, $s09: String, $s10: String, $s11: String, $s12: String, $s13: String, $s14: String, $s15: String, $s16: String, $s17: String, $s18: String, $s19: String, $s20: String, $s21: String, $s22: String, $s23: String, $s24: String, $s25: String, $s26: String, $s27: String, $s28: String, $s29: String, $s30: String, $s31: String, $s32: String, $s33: String, $s34: String, $s35: String, $s36: String, $s37: String, $s38: String, $s39: String, $s40: String, $s41: String, $s42: String, $s43: String, $s44: String, $s45: String, $s46: String, $s47: String, $s48: String, $s49: String, $body: String) {
    insert Doc { slug: $s00, body: $body }
    insert Doc { slug: $s01, body: $body }
    insert Doc { slug: $s02, body: $body }
    insert Doc { slug: $s03, body: $body }
    insert Doc { slug: $s04, body: $body }
    insert Doc { slug: $s05, body: $body }
    insert Doc { slug: $s06, body: $body }
    insert Doc { slug: $s07, body: $body }
    insert Doc { slug: $s08, body: $body }
    insert Doc { slug: $s09, body: $body }
    insert Doc { slug: $s10, body: $body }
    insert Doc { slug: $s11, body: $body }
    insert Doc { slug: $s12, body: $body }
    insert Doc { slug: $s13, body: $body }
    insert Doc { slug: $s14, body: $body }
    insert Doc { slug: $s15, body: $body }
    insert Doc { slug: $s16, body: $body }
    insert Doc { slug: $s17, body: $body }
    insert Doc { slug: $s18, body: $body }
    insert Doc { slug: $s19, body: $body }
    insert Doc { slug: $s20, body: $body }
    insert Doc { slug: $s21, body: $body }
    insert Doc { slug: $s22, body: $body }
    insert Doc { slug: $s23, body: $body }
    insert Doc { slug: $s24, body: $body }
    insert Doc { slug: $s25, body: $body }
    insert Doc { slug: $s26, body: $body }
    insert Doc { slug: $s27, body: $body }
    insert Doc { slug: $s28, body: $body }
    insert Doc { slug: $s29, body: $body }
    insert Doc { slug: $s30, body: $body }
    insert Doc { slug: $s31, body: $body }
    insert Doc { slug: $s32, body: $body }
    insert Doc { slug: $s33, body: $body }
    insert Doc { slug: $s34, body: $body }
    insert Doc { slug: $s35, body: $body }
    insert Doc { slug: $s36, body: $body }
    insert Doc { slug: $s37, body: $body }
    insert Doc { slug: $s38, body: $body }
    insert Doc { slug: $s39, body: $body }
    insert Doc { slug: $s40, body: $body }
    insert Doc { slug: $s41, body: $body }
    insert Doc { slug: $s42, body: $body }
    insert Doc { slug: $s43, body: $body }
    insert Doc { slug: $s44, body: $body }
    insert Doc { slug: $s45, body: $body }
    insert Doc { slug: $s46, body: $body }
    insert Doc { slug: $s47, body: $body }
    insert Doc { slug: $s48, body: $body }
    insert Doc { slug: $s49, body: $body }
}
--- params
{"s00": "d${i}_00", "s01": "d${i}_01", "s02": "d${i}_02", "s03": "d${i}_03", "s04": "d${i}_04", "s05": "d${i}_05", "s06": "d${i}_06", "s07": "d${i}_07", "s08": "d${i}_08", "s09": "d${i}_09", "s10": "d${i}_10", "s11": "d${i}_11", "s12": "d${i}_12", "s13": "d${i}_13", "s14": "d${i}_14", "s15": "d${i}_15", "s16": "d${i}_16", "s17": "d${i}_17", "s18": "d${i}_18", "s19": "d${i}_19", "s20": "d${i}_20", "s21": "d${i}_21", "s22": "d${i}_22", "s23": "d${i}_23", "s24": "d${i}_24", "s25": "d${i}_25", "s26": "d${i}_26", "s27": "d${i}_27", "s28": "d${i}_28", "s29": "d${i}_29", "s30": "d${i}_30", "s31": "d${i}_31", "s32": "d${i}_32", "s33": "d${i}_33", "s34": "d${i}_34", "s35": "d${i}_35", "s36": "d${i}_36", "s37": "d${i}_37", "s38": "d${i}_38", "s39": "d${i}_39", "s40": "d${i}_40", "s41": "d${i}_41", "s42": "d${i}_42", "s43": "d${i}_43", "s44": "d${i}_44", "s45": "d${i}_45", "s46": "d${i}_46", "s47": "d${i}_47", "s48": "d${i}_48", "s49": "d${i}_49", "body": ""}
--- expect affected: nodes=50 edges=0
--- endloop

--- query
query doc_count() {
    match { $d: Doc }
    return { count($d) as docs }
}

--- expect unordered
{"docs": 5000}

--- expect shape
docs: I64

--- query
query any_body() {
    match { $d: Doc }
    return { $d.body }
    limit 1
}

--- expect unordered
{"d.body": ""}

--- expect shape
d.body: String?

--- expect plan
pass late_materialization
hydrate $d: columns [body]

--- query
query greatest_slug() {
    match { $d: Doc }
    return { $d.slug, $d.body }
    order { $d.slug desc }
    limit 1
}

--- expect ordered
{"d.slug": "d9_49", "d.body": ""}

--- expect shape
d.slug: String
d.body: String?

--- expect plan
pass late_materialization
hydrate $d: columns [body]
