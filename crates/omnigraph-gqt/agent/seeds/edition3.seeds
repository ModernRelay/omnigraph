class: a positional option (edition 2's `fuzzy` budget)
code: T71

--- text
gq 3;
query mentions($s: String, $q: String) {
  match { $d: Doc  search($d.body, $s)  fuzzy($d.body, $q, 2) }
  return { $d.title }
}

--- seed
id: e3-04
task: t24
class: a ranking in `order` (edition 2's spelling)
code: T65

--- text
gq 3;
query similar($q: Vector(3)) {
  match { $d: Doc  $d.year >= 2025 }
  return { $d.title }
  order { nearest($d.embedding, $q) }
  limit 20
}

