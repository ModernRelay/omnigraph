id: e3-08
task: m3
class: `having` (SQL)
code: -

--- text
gq 3;
query big_employers($min: I64) {
  match { $c: Company  $p worksAt $c }
  return { $c.name, count($p) as n }
  having { n >= $min }
  order { n desc }
}

