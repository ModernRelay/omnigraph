--- seed
id: e3-24
task: t30
class: two rankings drawn into one scope
code: T68

--- text
gq 3;
query weighted($q: String, $v: Vector(3)) {
  match {
    from distance({ match { $d: Doc } return { $d } }, $d.embedding, $v)
    from bm25({ match { $d: Doc } return { $d } }, $d.body, $q)
  }
  return { $d.title, 0.7 * (1.0 / (1.0 + $distance)) + 0.3 * $score as s }
  order { s desc }
  limit 10
}

