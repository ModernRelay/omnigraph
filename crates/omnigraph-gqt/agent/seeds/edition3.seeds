id: e3-05
task: t27
class: a ranking in `return` and `order` (edition 2's spelling)
code: T65

--- text
gq 3;
query about($q: String) {
  match { $d: Doc }
  return { $d.title, bm25($d.body, $q) as s }
  order { bm25($d.body, $q) desc }
  limit 10
}

