--- seed
id: e3-28
task: m4
class: a space before a call's parenthesis
code: -

--- text
gq 3;
query colleagues($of: String) {
  match { $p: Person { handle: $of }  $p worksAt $c  $q worksAt $c  $q != $p }
  return { $q }
}

query colleagues_of_colleagues($of: String) {
  match {
    from { match { from colleagues ($of) } return { $q as c } }
    from { match { from colleagues ($c.handle) } return { $q as r } }
  }
  return distinct { $r.name }
}
