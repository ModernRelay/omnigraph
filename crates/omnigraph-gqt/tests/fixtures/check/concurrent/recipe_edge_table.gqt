      name: Knows
      rows: 2
      commits: 1
      id: {kind: key, prefix: e, width: 2}
      from: {kind: endpoint, prefix: n, width: 2, population: 2, distribution: {kind: ordinal}}
      to: {kind: endpoint, prefix: n, width: 2, population: 2, distribution: {kind: ordinal}}
      columns:
        weight: {kind: ordinal, start: 0, step: 1}
