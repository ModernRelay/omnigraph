environments:
  - target: omnigraph-engine
    storage: local-filesystem

--- schema
node Person {
    name: String @key
}
node Tag {
    name: String @key
}
--- seed
{"type":"Person","data":{"name":"alice"}}
--- concurrent
w1 x2: load generate: v1 seed: 42 mode: insert
  tables:
