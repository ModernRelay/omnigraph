# issue: none
# notes: A later open finds the clone's own state (the graph shallow clone RFC, What a caller observes). Run with --store <clone root> --base <base> on the clone root writes_behave_as_on_an_ordinary_root wrote bob into; the restart reopens that root over the same base.
--- runner
timeout_ms: 10000
environments:
  - target: omnigraph-engine
    storage: local-filesystem
  - target: omnigraph-engine
    storage: s3-compatible

--- query
query all() { match { $p: Person } return { $p.name } }
--- expect unordered
{"p.name":"alice"}
{"p.name":"bob"}
--- expect shape
p.name: String

--- restart

--- query
query all() { match { $p: Person } return { $p.name } }
--- expect unordered
{"p.name":"alice"}
{"p.name":"bob"}
--- expect shape
p.name: String
