# issue: none
--- runner
timeout_ms: 4000
environments:
  - target: omnigraph-engine-dst
    storage: in-memory-object-store
    seeds: [0]

--- schema
node Person {
    name: String @key
}
--- seed
{"type":"Person","data":{"name":"alice"}}
--- concurrent
w1: query add_bob() { insert Person { name: "bob" } }
w2: query add_carol() { insert Person { name: "carol" } }
order: w1 park put __manifest/_versions/, w2 start, w2, w1 put __manifest/_versions/
--- expect
w1: ok
w2: ok
